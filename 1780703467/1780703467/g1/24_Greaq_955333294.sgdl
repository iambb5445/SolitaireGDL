Greaq
$cards
DECK 4 SPADES

$initial
DRAW 2 DEAL {GRIX, TOUL}
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 8 FACE_HALF

TOUL 1 FACE_LAST
TOUL 3 FACE_LAST
TOUL 5 FACE_LAST
TOUL 4 FACE_ALTERNATE_LAST
TOUL 6 FACE_ALTERNATE_LAST
TOUL 5 FACE_ALTERNATE_LAST
TOUL 0 FACE_ALTERNATE_LAST

GRIX 0 FACE_HALF

$moves
MOVE COLUMN {COLUMN, GRIX}
DEST Empty
MOVE TOUL COLUMN
DESTSRC Rank add_13
MOVE_STACK {TOUL, GRIX, COLUMN} COLUMN
OR
    AND
        SRCSTACK Suit match_color
        DEST Size < 0
    DEST Rank 1
MOVE_STACK {COLUMN, GRIX, TOUL} TOUL
AND
    SRCSTACK Rank descending
    OR
        DESTSRC Rank equal
        DEST Empty
DRAW
PILE ANY TOUL Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL GRIX Empty
