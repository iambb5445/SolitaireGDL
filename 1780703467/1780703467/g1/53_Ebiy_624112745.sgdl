Ebiy
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EZEM 3 FACE_ALTERNATE_LAST
EZEM 3 FACE_ALTERNATE_LAST
EZEM 8 FACE_ALTERNATE_LAST
EZEM 4 FACE_ALTERNATE_LAST
EZEM 9 FACE_ALTERNATE_LAST
EZEM 0 FACE_ALTERNATE_LAST

COLUMN 0 FACE_ALL

XULOH 4 FACE_LAST
XULOH 7 FACE_LAST
XULOH 0 FACE_LAST
XULOH 3 FACE_LAST
XULOH 9 FACE_LAST
XULOH 2 FACE_HALF

$moves
MOVE {XULOH, EZEM} XULOH
DESTSRC Rank ascending
MOVE_STACK {COLUMN, EZEM} COLUMN
AND
    DEST Rank 1
    SRC Suit {DIAMONDS}
$win
PILE ALL XULOH Empty
