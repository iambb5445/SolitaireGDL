Couwag
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CROUZEW 7 FACE_ALTERNATE_LAST
CROUZEW 4 FACE_ALTERNATE_LAST
CROUZEW 2 FACE_ALTERNATE_LAST
CROUZEW 9 FACE_ALTERNATE_LAST
CROUZEW 3 FACE_ALTERNATE_LAST
CROUZEW 6 FACE_ALTERNATE_LAST
CROUZEW 10 FACE_ALTERNATE_LAST

COLUMN 0 FACE_LAST
COLUMN 5 FACE_HALF

VOTO 0 FACE_LAST
VOTO 2 FACE_LAST
VOTO 4 FACE_LAST

$moves
MOVE {COLUMN, VOTO, CROUZEW} VOTO
DESTSRC Suit match
MOVE CROUZEW COLUMN
DEST Rank 1
MOVE_STACK COLUMN CROUZEW
OR
    AND
        DEST Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
        DESTSRC Suit match_color
    SRCSTACK Suit match_color
MOVE_STACK {COLUMN, CROUZEW, VOTO} COLUMN
DEST Suit {DIAMONDS}
$win
PILE ALL CROUZEW Empty
