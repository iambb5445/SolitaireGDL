Uzu
$cards
DECK 4 SPADES

$initial
DRAW 24 DEAL {UQEAD, COLUMN}
UQEAD 2 FACE_HALF
UQEAD 1 FACE_ALTERNATE_LAST
UQEAD 3 FACE_ALTERNATE_LAST
UQEAD 3 FACE_ALTERNATE_LAST

COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 6 FACE_ALL

$moves
MOVE UQEAD COLUMN
OR
    AND
        DESTSRC Suit match_color
        DEST Size >= 10
    SRC Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
MOVE COLUMN UQEAD
DEST Suit {DIAMONDS, HEARTS, SPADES}
MOVE_STACK UQEAD {COLUMN, UQEAD}
OR
    AND
        SRC Rank 1
        SRCSTACK Suit match
    DEST Rank 1
$win
PILE ALL COLUMN Empty
