Diofin
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AXAEV 3 FACE_ALL
AXAEV 8 FACE_ALL
AXAEV 10 FACE_ALL
AXAEV 0 FACE_ALL
AXAEV 7 FACE_ALL
AXAEV 0 FACE_ALL

COLUMN 10 FACE_ALL

EYE 7 FACE_ALL
EYE 0 FACE_ALL
EYE 7 FACE_ALTERNATE_LAST

$moves
MOVE {AXAEV, COLUMN, EYE} EYE
OR
    AND
        DEST Suit {CLUBS}
        DEST Empty
    DEST Size >= 10
MOVE COLUMN AXAEV
DEST Rank K
$win
PILE ALL AXAEV Empty
