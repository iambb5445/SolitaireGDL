Xouvo
$cards
DECK 2 SPADES

$initial
TEASAM 7 FACE_ALL
TEASAM 5 FACE_ALL
TEASAM 8 FACE_ALTERNATE_LAST

COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALL

$moves
MOVE TEASAM COLUMN
SRC Suit {DIAMONDS}
MOVE TEASAM TEASAM
AND
    DEST Size <= 3
    DEST Empty
MOVE_STACK {COLUMN, TEASAM} COLUMN
SRC Suit {HEARTS, CLUBS, DIAMONDS}
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL TEASAM Empty
    OR
        PILE ALL TEASAM Empty
        PILE ALL COLUMN Empty
