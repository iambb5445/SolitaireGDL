Xape
$cards
DECK 2 SPADES

$initial
COLUMN 10 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 4 FACE_ALTERNATE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        DEST Rank K
    AND
        DESTSRC Rank ascending
        DEST Rank 1
$win
PILE ALL COLUMN Empty
