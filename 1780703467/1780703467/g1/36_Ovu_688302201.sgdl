Ovu
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 58 ROTATE 3 U 1
COLUMN 8 FACE_ALL
COLUMN 3 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 9 FACE_HALF

RUDUR 7 FACE_ALL
RUDUR 0 FACE_ALL
RUDUR 7 FACE_ALL
RUDUR 4 FACE_ALTERNATE_LAST
RUDUR 0 FACE_ALTERNATE_LAST

$moves
MOVE RUDUR RUDUR
OR
    AND
        DESTSRC Rank ascending
        DESTSRC Suit match
    DEST Suit {DIAMONDS, HEARTS, SPADES}
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Rank ascending
        DESTSRC Suit alternate_color
    AND
        SRC Suit {HEARTS}
        DEST Size > 3
$win
AND
    OR
        PILE ALL RUDUR Empty
        PILE ALL DRAW Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL RUDUR Empty
