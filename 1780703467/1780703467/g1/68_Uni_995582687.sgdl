Uni
$cards
DECK 1 {SPADES, HEARTS}

$initial
DRAW 19 ROTATE 1 1 U
BUYOX 6 FACE_ALTERNATE_LAST
BUYOX 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK BUYOX BUYOX
OR
    DESTSRC Suit match_color
    AND
        DESTSRC Suit match
        DEST Size <= 4
$win
AND
    OR
        PILE ALL BUYOX Empty
        PILE ALL DRAW Empty
    OR
        PILE ALL BUYOX Empty
        PILE ALL DRAW Empty
