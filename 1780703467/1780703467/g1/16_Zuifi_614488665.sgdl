Zuifi
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
GAD 0 FACE_LAST
GAD 4 FACE_LAST
GAD 4 FACE_LAST
GAD 7 FACE_LAST
GAD 1 FACE_LAST
GAD 2 FACE_LAST
GAD 2 FACE_LAST
GAD 2 FACE_LAST

COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

DIDE 8 FACE_ALTERNATE_LAST
DIDE 5 FACE_ALTERNATE_LAST
DIDE 1 FACE_ALTERNATE_LAST
DIDE 7 FACE_ALTERNATE_LAST
DIDE 0 FACE_ALTERNATE_LAST
DIDE 9 FACE_ALTERNATE_LAST
DIDE 1 FACE_ALTERNATE_LAST
DIDE 9 FACE_ALTERNATE_LAST
DIDE 6 FACE_ALTERNATE_LAST

ABAD 6 FACE_HALF

$moves
MOVE_STACK GAD COLUMN
DEST Size >= 5
MOVE_STACK GAD ABAD
OR
    SRC Rank K
    DESTSRC Rank descending
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
