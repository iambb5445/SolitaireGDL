Trazip
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 13 ROTATE 1 U 1
COLUMN 7 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 5 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 7 FACE_HALF

WIXOX 3 FACE_LAST
WIXOX 0 FACE_LAST
WIXOX 3 FACE_LAST
WIXOX 1 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    SRC Suit {SPADES}
    AND
        DEST Rank K
        DEST Empty
MOVE WIXOX {WIXOX, COLUMN}
SRC Suit {SPADES, HEARTS}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL WIXOX Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
