Prain
$cards
DECK 2 {SPADES, HEARTS}

$initial
RAWA 3 FACE_LAST
RAWA 8 FACE_LAST
RAWA 4 FACE_ALTERNATE_LAST

QAEX 1 FACE_HALF
QAEX 10 FACE_HALF
QAEX 9 FACE_HALF
QAEX 8 FACE_HALF
QAEX 6 FACE_HALF
QAEX 3 FACE_HALF

$moves
MOVE RAWA RAWA
DEST Size >= 8
MOVE RAWA QAEX
DEST Size >= 3
MOVE_STACK {QAEX, RAWA} RAWA
OR
    AND
        SRC Rank K
        DEST Size < 10
    DESTSRC Suit match
$win
OR
    AND
        PILE ALL RAWA Empty
        PILE ALL RAWA Empty
    PILE ALL RAWA Empty
