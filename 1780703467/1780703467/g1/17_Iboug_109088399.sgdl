Iboug
$cards
DECK 8 SPADES

$initial
TAIRO 1 FACE_ALL
TAIRO 10 FACE_ALL
TAIRO 5 FACE_ALL
TAIRO 7 FACE_ALL
TAIRO 10 FACE_ALL
TAIRO 5 FACE_ALL

COLUMN 6 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 8 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 0 FACE_HALF

REABA 7 FACE_LAST
REABA 7 FACE_LAST
REABA 8 FACE_LAST
REABA 2 FACE_ALL
REABA 3 FACE_ALL

$moves
MOVE_STACK TAIRO COLUMN
OR
    DEST Empty
    AND
        SRC Suit {CLUBS, HEARTS}
        SRCSTACK Size == 4
$win
AND
    AND
        PILE ALL TAIRO Empty
        PILE ALL REABA Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
