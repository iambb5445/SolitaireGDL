Waem
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 7 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
AND
    SRC Rank K
    OR
        DEST Rank 1
        SRC Rank K
MOVE_STACK COLUMN COLUMN
DEST Size <= 6
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
