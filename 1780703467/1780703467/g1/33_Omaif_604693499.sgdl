Omaif
$cards
DECK 2 SPADES

$initial
WAER 0 FACE_ALTERNATE_LAST
WAER 5 FACE_ALTERNATE_LAST
WAER 5 FACE_ALTERNATE_LAST
WAER 6 FACE_ALTERNATE_LAST
WAER 2 FACE_ALTERNATE_LAST
WAER 8 FACE_ALTERNATE_LAST

$moves
MOVE WAER WAER
DESTSRC Suit alternate_color
MOVE_STACK WAER WAER
OR
    AND
        SRCSTACK Suit alternate_color
        SRCSTACK Rank equal
    DEST Size == 6
$win
PILE ALL WAER Empty
