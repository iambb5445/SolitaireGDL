Eki
$cards
DECK 4 SPADES

$initial
IZEAJ 4 FACE_ALL
IZEAJ 6 FACE_ALL
IZEAJ 9 FACE_ALL
IZEAJ 0 FACE_ALL
IZEAJ 0 FACE_ALL
IZEAJ 4 FACE_ALL
IZEAJ 1 FACE_ALL
IZEAJ 3 FACE_ALL
IZEAJ 2 FACE_ALL
IZEAJ 4 FACE_ALL

COLUMN 8 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {COLUMN, IZEAJ} IZEAJ
AND
    OR
        SRCSTACK Size > 0
        DEST Size <= 10
    OR
        DESTSRC Suit match
        DESTSRC Suit match
$win
OR
    PILE ALL IZEAJ Empty
    PILE ALL COLUMN Empty
