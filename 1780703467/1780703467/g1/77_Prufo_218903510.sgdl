Prufo
$cards
DECK 2 SPADES

$initial
FUIRUR 3 FACE_ALL
FUIRUR 8 FACE_ALL
FUIRUR 1 FACE_ALL
FUIRUR 5 FACE_ALL
FUIRUR 6 FACE_HALF

QIOB 1 FACE_ALL
QIOB 2 FACE_ALTERNATE_LAST

$moves
MOVE QIOB FUIRUR
OR
    SRC Suit {CLUBS, HEARTS}
    AND
        DEST Size >= 0
        DESTSRC Rank equal
MOVE {QIOB, FUIRUR} QIOB
OR
    AND
        SRC Rank K
        SRC Rank K
    AND
        SRC Suit {DIAMONDS, SPADES}
        DEST Suit {CLUBS}
$win
PILE ALL QIOB Empty
