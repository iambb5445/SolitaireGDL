Ubeaz
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 8 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 8 FACE_ALL

NIOZI 7 FACE_LAST
NIOZI 1 FACE_LAST
NIOZI 10 FACE_LAST
NIOZI 4 FACE_LAST
NIOZI 6 FACE_LAST
NIOZI 1 FACE_LAST
NIOZI 6 FACE_LAST
NIOZI 3 FACE_LAST
NIOZI 4 FACE_LAST
NIOZI 8 FACE_LAST

TAIF 3 FACE_LAST
TAIF 2 FACE_ALTERNATE_LAST
TAIF 2 FACE_ALTERNATE_LAST

$moves
MOVE {NIOZI, TAIF, COLUMN} TAIF
OR
    AND
        DEST Size <= 2
        DEST Rank 1
    AND
        SRC Rank 1
        DESTSRC Rank equal
MOVE_STACK TAIF TAIF
AND
    AND
        SRCSTACK Size >= 4
        SRCSTACK Rank add_13
    AND
        DEST Size > 3
        DEST Rank 1
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL TAIF Empty
    PILE ALL TAIF Empty
