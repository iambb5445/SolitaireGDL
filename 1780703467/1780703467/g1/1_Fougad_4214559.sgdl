Fougad
$cards
DECK 4 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 193 DEAL COLUMN
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
