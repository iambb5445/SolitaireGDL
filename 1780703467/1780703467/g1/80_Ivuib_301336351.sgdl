Ivuib
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 90 DEAL COLUMN
COLUMN 7 FACE_ALL
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        SRC Rank K
        SRC Rank 1
    AND
        SRC Rank 1
        DEST Rank K
$win
PILE ALL COLUMN Empty
