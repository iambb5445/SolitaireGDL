Uzon
$cards
DECK 2 {SPADES, HEARTS}

$initial
TRAILEX 2 FACE_LAST
TRAILEX 6 FACE_LAST
TRAILEX 2 FACE_LAST
TRAILEX 5 FACE_LAST
TRAILEX 8 FACE_LAST
TRAILEX 10 FACE_LAST
TRAILEX 9 FACE_LAST
TRAILEX 8 FACE_LAST

UFAIN 2 FACE_LAST

$moves
MOVE UFAIN TRAILEX
DEST Suit {CLUBS}
MOVE_STACK TRAILEX UFAIN
AND
    DEST Rank K
    OR
        DEST Suit {HEARTS, CLUBS}
        DESTSRC Suit match_color
MOVE_STACK UFAIN TRAILEX
DEST Rank 1
$win
AND
    PILE ALL TRAILEX Empty
    PILE ALL TRAILEX Empty
