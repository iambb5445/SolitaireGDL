Xouq
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 79 DEAL COLUMN
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 6 FACE_ALL

$moves
MOVE COLUMN COLUMN
AND
    AND
        SRC Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
        SRC Suit {DIAMONDS}
    SRC Rank K
MOVE_STACK COLUMN COLUMN
OR
    DEST Size == 4
    AND
        DEST Rank 1
        DEST Suit {CLUBS}
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
