Jiok
$cards
DECK 8 SPADES

$initial
DRAW 54 DEAL COLUMN
COLUMN 9 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    OR
        DESTSRC Suit alternate_color
        SRC Rank 1
    AND
        DEST Suit {CLUBS}
        DEST Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
DRAW
PILE ALL COLUMN Size > 0
$win
PILE ALL DRAW Empty
