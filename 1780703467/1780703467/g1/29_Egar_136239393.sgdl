Egar
$cards
DECK 8 SPADES

$initial
DRAW 9 DEAL {COLUMN, GRAEZ, BRETA}
COLUMN 5 FACE_ALL
COLUMN 1 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 9 FACE_LAST

AYAEN 8 FACE_LAST
AYAEN 8 FACE_LAST
AYAEN 5 FACE_ALTERNATE_LAST
AYAEN 7 FACE_ALTERNATE_LAST

GRAEZ 3 FACE_ALL

BRETA 6 FACE_LAST
BRETA 9 FACE_LAST
BRETA 1 FACE_LAST
BRETA 2 FACE_LAST
BRETA 4 FACE_LAST
BRETA 1 FACE_LAST
BRETA 6 FACE_ALTERNATE_LAST
BRETA 4 FACE_ALTERNATE_LAST
BRETA 2 FACE_ALTERNATE_LAST
BRETA 6 FACE_ALTERNATE_LAST

$moves
