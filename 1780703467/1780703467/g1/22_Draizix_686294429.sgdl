Draizix
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 3 FACE_ALTERNATE_LAST

EBO 2 FACE_ALTERNATE_LAST
EBO 5 FACE_ALTERNATE_LAST
EBO 2 FACE_ALL
EBO 5 FACE_ALL
EBO 2 FACE_ALL

$moves
MOVE EBO COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        DEST Empty
    AND
        DEST Empty
        DESTSRC Suit match_color
$win
PILE ALL EBO Empty
