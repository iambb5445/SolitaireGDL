Dioxet
$cards
DECK 1 {SPADES, HEARTS}

$initial
BRUFE 1 FACE_LAST

COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

$moves
MOVE BRUFE COLUMN
OR
    AND
        SRC Suit {CLUBS, DIAMONDS, SPADES}
        DESTSRC Rank ascending
    AND
        SRC Rank K
        DEST Rank 1
MOVE_STACK COLUMN COLUMN
DEST Size == 4
$win
PILE ALL BRUFE Empty
