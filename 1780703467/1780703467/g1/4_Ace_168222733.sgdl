Ace
$cards
DECK 2 {SPADES, HEARTS}

$initial
BRUIZON 3 FACE_ALL
BRUIZON 9 FACE_ALTERNATE_LAST
BRUIZON 6 FACE_ALTERNATE_LAST
BRUIZON 2 FACE_ALTERNATE_LAST
BRUIZON 3 FACE_ALTERNATE_LAST

PRUIVOF 9 FACE_LAST
PRUIVOF 10 FACE_LAST
PRUIVOF 8 FACE_LAST
PRUIVOF 1 FACE_LAST
PRUIVOF 1 FACE_LAST

$moves
MOVE PRUIVOF BRUIZON
DESTSRC Rank ascending
MOVE BRUIZON PRUIVOF
AND
    DESTSRC Rank equal
    OR
        DEST Size == 2
        DESTSRC Suit match_color
MOVE_STACK PRUIVOF PRUIVOF
AND
    OR
        SRC Suit {SPADES}
        DESTSRC Suit match_color
    DEST Size < 10
$win
OR
    AND
        PILE ALL BRUIZON Empty
        PILE ALL PRUIVOF Empty
    PILE ALL BRUIZON Empty
