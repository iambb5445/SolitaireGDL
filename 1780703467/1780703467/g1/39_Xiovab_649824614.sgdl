Xiovab
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 33 ROTATE 3 U 3
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 2 FACE_HALF

SAENOZ 9 FACE_ALL
SAENOZ 3 FACE_ALL
SAENOZ 10 FACE_ALL
SAENOZ 3 FACE_ALL
SAENOZ 1 FACE_ALL

YIOLOJ 0 FACE_HALF
YIOLOJ 0 FACE_ALL

$moves
MOVE DRAW YIOLOJ
DEST Size >= 9
MOVE COLUMN COLUMN
OR
    AND
        DEST Empty
        SRC Suit {DIAMONDS, CLUBS}
    DESTSRC Rank add_13
MOVE_STACK {COLUMN, SAENOZ} YIOLOJ
AND
    OR
        SRC Rank 1
        DEST Suit {DIAMONDS, SPADES}
    OR
        DESTSRC Suit match_color
        SRC Suit {DIAMONDS, HEARTS}
MOVE_STACK YIOLOJ SAENOZ
AND
    AND
        SRC Rank K
        SRC Rank 1
    AND
        SRC Suit {CLUBS, DIAMONDS, SPADES}
        DEST Size < 6
$win
PILE ALL YIOLOJ Empty
