Efu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 15 DEAL COLUMN
COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 10 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    DEST Suit {DIAMONDS, CLUBS, SPADES}
    AND
        SRC Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
        SRC Suit {SPADES}
MOVE_STACK COLUMN COLUMN
OR
    DEST Rank 1
    SRC Rank K
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    PILE ALL DRAW Empty
