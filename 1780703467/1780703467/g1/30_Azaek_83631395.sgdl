Azaek
$cards
DECK 1 SPADES

$initial
HIDA 5 FACE_ALTERNATE_LAST
HIDA 2 FACE_ALTERNATE_LAST
HIDA 6 FACE_ALTERNATE_LAST

$moves
MOVE HIDA HIDA
OR
    AND
        DESTSRC Suit alternate_color
        DEST Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
    SRC Suit {CLUBS}
MOVE_STACK HIDA HIDA
AND
    OR
        DEST Size == 3
        SRCSTACK Rank ascending
    AND
        DEST Size <= 7
        SRCSTACK Suit alternate_color
$win
OR
    PILE ALL HIDA Empty
    AND
        PILE ALL HIDA Empty
        PILE ALL HIDA Empty
