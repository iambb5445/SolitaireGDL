Uyo
$cards
DECK 4 SPADES

$initial
COLUMN 1 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 10 FACE_HALF

ZAX 0 FACE_LAST
ZAX 2 FACE_ALTERNATE_LAST

$moves
MOVE_STACK ZAX ZAX
AND
    DEST Size >= 7
    SRCSTACK Suit alternate_color
$win
OR
    PILE ALL ZAX Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL ZAX Empty
