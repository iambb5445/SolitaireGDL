OR
    AND
        DESTSRC Suit match
        DEST Empty
    AND
        DESTSRC Rank add_13
        DEST Empty
$win
OR
    AND
        PILE ALL WEALE Empty
        PILE ALL WEALE Empty
    AND
        PILE ALL WEALE Empty
        PILE ALL WEALE Empty
