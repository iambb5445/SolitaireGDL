Ehe
$cards
DECK 2 {SPADES, HEARTS}

$initial
AWEF 8 FACE_ALTERNATE_LAST
AWEF 2 FACE_ALTERNATE_LAST
AWEF 6 FACE_ALTERNATE_LAST
AWEF 6 FACE_ALTERNATE_LAST
AWEF 4 FACE_ALTERNATE_LAST
AWEF 0 FACE_ALTERNATE_LAST
AWEF 3 FACE_ALTERNATE_LAST
AWEF 10 FACE_ALTERNATE_LAST
AWEF 9 FACE_ALTERNATE_LAST
AWEF 0 FACE_ALTERNATE_LAST

COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE AWEF AWEF
OR
    AND
        DESTSRC Rank ascending
        SRC Rank K
    AND
        DEST Suit {DIAMONDS, CLUBS, HEARTS}
        DEST Suit {DIAMONDS, CLUBS}
MOVE COLUMN AWEF
OR
    AND
        DEST Rank 1
        DEST Size >= 10
    SRC Suit {CLUBS}
MOVE_STACK COLUMN AWEF
OR
    DESTSRC Suit alternate_color
    AND
        DEST Rank K
        SRCSTACK Size <= 0
MOVE_STACK AWEF AWEF
SRCSTACK Rank descending
$win
PILE ALL AWEF Empty
