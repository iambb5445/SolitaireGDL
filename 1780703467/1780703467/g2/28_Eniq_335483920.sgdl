Eniq
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 9 ROTATE 3 U 2
COLUMN 7 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 2 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 4 FACE_ALL

$moves
MOVE {DRAW, COLUMN} COLUMN
OR
    DESTSRC Rank descending
    AND
        DEST Empty
        DEST Empty
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
