Ugu
$cards
DECK 1 {SPADES, CLUBS}

$initial
IZIOZ 7 FACE_ALTERNATE_LAST
IZIOZ 2 FACE_ALL

IVE 5 FACE_LAST
IVE 8 FACE_LAST
IVE 4 FACE_LAST
IVE 0 FACE_ALL

$moves
MOVE {IZIOZ, IVE} IZIOZ
DEST Empty
