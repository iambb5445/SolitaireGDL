MOVE_STACK {IZIOZ, IVE} IVE
OR
    AND
        SRCSTACK Suit alternate_color
        SRC Rank 1
    DEST Size < 5
$win
OR
    AND
        PILE ALL IVE Empty
        PILE ALL IVE Empty
    PILE ALL IVE Empty
