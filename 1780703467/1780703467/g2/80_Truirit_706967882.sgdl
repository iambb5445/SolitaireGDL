Truirit
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CRITOP 2 FACE_ALTERNATE_LAST
CRITOP 9 FACE_HALF

COLUMN 3 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF

OQU 10 FACE_LAST
OQU 5 FACE_LAST
OQU 5 FACE_LAST
OQU 2 FACE_LAST
OQU 1 FACE_LAST
OQU 7 FACE_LAST
OQU 3 FACE_LAST
OQU 3 FACE_LAST
OQU 0 FACE_LAST

ESI 8 FACE_ALTERNATE_LAST
ESI 9 FACE_ALTERNATE_LAST
ESI 8 FACE_ALTERNATE_LAST
ESI 1 FACE_ALTERNATE_LAST
ESI 1 FACE_ALTERNATE_LAST
ESI 10 FACE_ALTERNATE_LAST

INE 6 FACE_LAST
INE 1 FACE_ALL

$moves
MOVE ESI ESI
OR
    AND
        DEST Size == 1
        DESTSRC Suit alternate_color
    AND
        SRC Rank K
        DESTSRC Rank add_14
MOVE_STACK ESI INE
SRCSTACK Size < 8
MOVE_STACK COLUMN ESI
AND
    OR
        SRC Suit {HEARTS, CLUBS}
        SRC Rank 1
    AND
        SRC Suit {SPADES, CLUBS, DIAMONDS}
        SRCSTACK Rank add_14
$win
PILE ALL COLUMN Empty
