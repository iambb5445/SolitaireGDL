Sior
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 58 ROTATE 1 U 2
COLUMN 0 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 5 FACE_LAST

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE DRAW COLUMN
OR
    AND
        DEST Size > 5
        SRC Rank 1
    AND
        DEST Size < 9
        SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE_STACK COLUMN COLUMN
OR
    SRCSTACK Size == 7
    DEST Rank K
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
