Oba
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 35 DEAL COLUMN
COLUMN 8 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 1 FACE_HALF

SAD 5 FACE_ALTERNATE_LAST
SAD 9 FACE_ALTERNATE_LAST
SAD 7 FACE_ALTERNATE_LAST
SAD 2 FACE_ALTERNATE_LAST
SAD 9 FACE_ALL

$moves
MOVE SAD SAD
OR
    DEST Empty
    SRC Suit {DIAMONDS, HEARTS}
DRAW
PILE ANY COLUMN Empty
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
