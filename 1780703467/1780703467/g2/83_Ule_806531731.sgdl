Ule
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 46 ROTATE 1 1 U
AQO 1 FACE_HALF
AQO 0 FACE_HALF
AQO 5 FACE_HALF
AQO 10 FACE_HALF
AQO 10 FACE_HALF
AQO 3 FACE_ALTERNATE_LAST
AQO 1 FACE_ALTERNATE_LAST
AQO 5 FACE_ALTERNATE_LAST
AQO 2 FACE_ALTERNATE_LAST

COLUMN 0 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 9 FACE_ALL

$moves
MOVE {AQO, COLUMN, DRAW} COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        SRC Rank K
    AND
        DEST Suit {DIAMONDS, HEARTS, CLUBS}
        SRC Rank 1
MOVE_STACK COLUMN COLUMN
DESTSRC Suit match_color
MOVE_STACK AQO AQO
DEST Rank 1
$win
PILE ALL AQO Empty
