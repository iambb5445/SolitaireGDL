Udiy
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 25 DEAL {ISAEM, MEAVUB}
ISAEM 0 FACE_LAST
ISAEM 5 FACE_LAST
ISAEM 8 FACE_ALTERNATE_LAST
ISAEM 10 FACE_ALTERNATE_LAST
ISAEM 10 FACE_ALTERNATE_LAST

MEAVUB 6 FACE_ALTERNATE_LAST
MEAVUB 1 FACE_ALTERNATE_LAST
MEAVUB 6 FACE_ALL
MEAVUB 5 FACE_ALL
MEAVUB 8 FACE_ALL
MEAVUB 10 FACE_ALL
MEAVUB 10 FACE_ALL

$moves
MOVE MEAVUB MEAVUB
AND
    OR
        DEST Size >= 4
        DEST Size < 3
    DESTSRC Rank descending
MOVE ISAEM MEAVUB
AND
    SRC Suit {HEARTS, SPADES, CLUBS}
    AND
        SRC Rank 1
        DEST Rank K
MOVE_STACK {ISAEM, MEAVUB} ISAEM
OR
    AND
        DEST Suit {DIAMONDS}
        SRCSTACK Size <= 3
    AND
        SRCSTACK Size > 10
        SRCSTACK Size < 4
MOVE_STACK ISAEM MEAVUB
AND
    OR
        DEST Empty
        SRCSTACK Size >= 10
    SRC Rank 1
DRAW
PILE ANY DRAW Empty
$win
PILE ALL DRAW Empty
