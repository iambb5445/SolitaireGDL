Qul
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 5 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF

FUIMIY 2 FACE_LAST
FUIMIY 7 FACE_LAST
FUIMIY 4 FACE_ALL

$moves
MOVE {FUIMIY, COLUMN} FUIMIY
OR
    SRC Rank 1
    AND
        DEST Size >= 4
        SRC Suit {SPADES, DIAMONDS, HEARTS}
MOVE FUIMIY COLUMN
DEST Rank 1
MOVE_STACK COLUMN FUIMIY
OR
    AND
        SRCSTACK Size > 5
        SRCSTACK Suit alternate_color
    DEST Suit {DIAMONDS}
$win
AND
    AND
        PILE ALL FUIMIY Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL FUIMIY Empty
        PILE ALL FUIMIY Empty
