Craw
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 5 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 5 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 3 FACE_LAST

KIOYI 10 FACE_HALF
KIOYI 2 FACE_HALF
KIOYI 5 FACE_HALF

$moves
MOVE KIOYI {KIOYI, COLUMN}
OR
    AND
        DEST Suit {HEARTS, SPADES}
        SRC Rank K
    AND
        DESTSRC Rank add_13
        SRC Suit {CLUBS}
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Rank K
        SRCSTACK Suit alternate_color
    DEST Rank 1
MOVE_STACK KIOYI COLUMN
SRCSTACK Suit match
$win
PILE ALL KIOYI Empty
