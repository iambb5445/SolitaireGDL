Odin
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 10 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF

OJA 5 FACE_LAST

GUMOH 2 FACE_ALTERNATE_LAST

$moves
MOVE {OJA, COLUMN, GUMOH} OJA
OR
    DESTSRC Suit match
    AND
        SRC Rank 1
        DEST Suit {CLUBS}
MOVE_STACK {OJA, COLUMN} GUMOH
SRCSTACK Suit match_color
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL OJA Empty
