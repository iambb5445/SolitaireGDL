Muci
$cards
DECK 4 SPADES

$initial
COLUMN 10 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 3 FACE_HALF

$moves
MOVE COLUMN COLUMN
SRC Suit {CLUBS}
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Size >= 8
        SRC Rank K
    DESTSRC Rank equal
$win
PILE ALL COLUMN Empty
