Uwa
$cards
DECK 8 SPADES

$initial
DRAW 49 DEAL COLUMN
KAIQ 5 FACE_LAST
KAIQ 9 FACE_LAST
KAIQ 4 FACE_LAST
KAIQ 1 FACE_LAST
KAIQ 7 FACE_LAST
KAIQ 2 FACE_LAST
KAIQ 10 FACE_LAST
KAIQ 7 FACE_LAST
KAIQ 1 FACE_LAST
KAIQ 0 FACE_LAST

COLUMN 9 FACE_ALTERNATE_LAST

$moves
MOVE KAIQ KAIQ
DESTSRC Rank add_14
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Suit {SPADES}
    DEST Rank 1
MOVE_STACK KAIQ COLUMN
DESTSRC Suit match_color
DRAW
PILE ALL COLUMN Empty
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL KAIQ Empty
