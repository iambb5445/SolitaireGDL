Esu
$cards
DECK 1 SPADES

$initial
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DESTSRC Rank add_13
    AND
        DEST Rank 1
        DESTSRC Rank add_13
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Size >= 9
        DEST Rank 1
    DEST Size < 8
$win
PILE ALL COLUMN Empty
