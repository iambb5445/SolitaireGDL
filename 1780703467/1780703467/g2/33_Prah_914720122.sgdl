Prah
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 54 DEAL {COLUMN, BAEG}
COLUMN 9 FACE_HALF

BAEG 7 FACE_LAST
BAEG 3 FACE_LAST
BAEG 7 FACE_LAST
BAEG 6 FACE_LAST
BAEG 3 FACE_LAST
BAEG 2 FACE_LAST
BAEG 9 FACE_LAST
BAEG 0 FACE_LAST
BAEG 0 FACE_LAST
BAEG 4 FACE_LAST

$moves
MOVE {BAEG, COLUMN} BAEG
OR
    AND
        DEST Suit {CLUBS}
        DEST Size == 3
    DEST Rank K
MOVE_STACK COLUMN COLUMN
AND
    DEST Suit {SPADES}
    OR
        DEST Rank 1
        DEST Rank 1
MOVE_STACK COLUMN BAEG
DEST Suit {SPADES, CLUBS, DIAMONDS}
$win
OR
    AND
        PILE ALL BAEG Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
