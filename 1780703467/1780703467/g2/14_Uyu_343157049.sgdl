Uyu
$cards
DECK 2 {SPADES, CLUBS}

$initial
ZURE 5 FACE_HALF
ZURE 9 FACE_HALF
ZURE 8 FACE_HALF
ZURE 0 FACE_HALF
ZURE 7 FACE_HALF
ZURE 2 FACE_HALF
ZURE 1 FACE_HALF
ZURE 9 FACE_ALTERNATE_LAST
ZURE 6 FACE_ALTERNATE_LAST
ZURE 4 FACE_ALTERNATE_LAST

ETU 1 FACE_ALL

$moves
MOVE_STACK ETU ETU
SRC Suit {CLUBS}
MOVE_STACK ZURE ETU
OR
    AND
        SRCSTACK Suit match
        DEST Suit {CLUBS, DIAMONDS, HEARTS}
    AND
        DEST Suit {CLUBS, DIAMONDS, SPADES, HEARTS}
        SRCSTACK Size < 5
$win
OR
    PILE ALL ZURE Empty
    AND
        PILE ALL ETU Empty
        PILE ALL ETU Empty
