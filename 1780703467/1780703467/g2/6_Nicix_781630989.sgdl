Nicix
$cards
DECK 1 {SPADES, HEARTS}

$initial
DRAW 20 DEAL COLUMN
COLUMN 1 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 1 FACE_ALL

$moves
MOVE COLUMN COLUMN
DEST Size < 4
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Suit match
        DEST Rank K
    DEST Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
$win
PILE ALL DRAW Empty
