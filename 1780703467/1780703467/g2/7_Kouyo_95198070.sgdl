Kouyo
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

BEDEW 2 FACE_LAST

$moves
MOVE_STACK {BEDEW, COLUMN} BEDEW
AND
    SRCSTACK Rank add_14
    OR
        DESTSRC Rank add_14
        SRC Rank K
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL BEDEW Empty
    PILE ALL COLUMN Empty
