Saiqo
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 2 DEAL {ACIOP, COLUMN}
COLUMN 3 FACE_ALL
COLUMN 4 FACE_ALTERNATE_LAST

ACIOP 0 FACE_LAST
ACIOP 3 FACE_LAST
ACIOP 7 FACE_LAST
ACIOP 6 FACE_ALTERNATE_LAST
ACIOP 8 FACE_ALTERNATE_LAST
ACIOP 2 FACE_ALTERNATE_LAST
ACIOP 9 FACE_ALTERNATE_LAST
ACIOP 0 FACE_ALTERNATE_LAST
ACIOP 3 FACE_ALTERNATE_LAST
ACIOP 5 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN ACIOP
AND
    OR
        DEST Rank K
        SRC Suit {HEARTS}
    OR
        DESTSRC Suit match_color
        DESTSRC Suit alternate_color
MOVE ACIOP ACIOP
OR
    SRC Rank K
    AND
        SRC Suit {CLUBS, HEARTS}
        DEST Empty
DRAW
PILE ANY COLUMN Empty
$win
PILE ALL ACIOP Empty
