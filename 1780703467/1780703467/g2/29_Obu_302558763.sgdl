Obu
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 70 DEAL COLUMN
COLUMN 4 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_LAST

$moves
MOVE_STACK COLUMN COLUMN
SRC Suit {DIAMONDS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
