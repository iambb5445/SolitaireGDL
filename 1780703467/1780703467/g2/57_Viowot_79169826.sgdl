Viowot
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 10 FACE_HALF

COUDE 9 FACE_LAST

OME 0 FACE_ALTERNATE_LAST
OME 1 FACE_ALTERNATE_LAST
OME 6 FACE_ALTERNATE_LAST

$moves
MOVE {COUDE, OME, COLUMN} OME
DEST Rank K
MOVE COLUMN COLUMN
OR
    SRC Rank K
    AND
        DESTSRC Suit match
        DESTSRC Suit match
$win
OR
    PILE ALL COUDE Empty
    PILE ALL OME Empty
