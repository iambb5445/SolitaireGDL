Osuib
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 3 ROTATE 1 U 1
IWO 3 FACE_ALTERNATE_LAST
IWO 9 FACE_ALTERNATE_LAST
IWO 9 FACE_ALTERNATE_LAST
IWO 4 FACE_ALTERNATE_LAST
IWO 7 FACE_HALF
IWO 5 FACE_HALF
IWO 4 FACE_HALF
IWO 6 FACE_HALF
IWO 8 FACE_HALF
IWO 4 FACE_HALF

COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

ANA 1 FACE_HALF
ANA 2 FACE_HALF
ANA 2 FACE_HALF
ANA 10 FACE_HALF

$moves
MOVE {ANA, IWO, DRAW, COLUMN} IWO
OR
    DESTSRC Suit match
    DEST Size > 6
MOVE IWO ANA
AND
    OR
        DEST Size < 10
        DESTSRC Rank descending
    OR
        DEST Rank K
        SRC Rank 1
MOVE_STACK ANA COLUMN
OR
    SRC Suit {CLUBS, SPADES, HEARTS}
    AND
        SRCSTACK Suit alternate_color
        SRCSTACK Size < 9
MOVE_STACK IWO COLUMN
AND
    SRCSTACK Size == 4
    SRCSTACK Rank descending
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL DRAW Empty
