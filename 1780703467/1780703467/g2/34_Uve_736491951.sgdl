Uve
$cards
DECK 4 {SPADES, CLUBS}

$initial
RAK 1 FACE_HALF
RAK 7 FACE_HALF
RAK 0 FACE_LAST
RAK 9 FACE_LAST
RAK 8 FACE_LAST
RAK 10 FACE_LAST
RAK 9 FACE_LAST
RAK 2 FACE_LAST

REFU 7 FACE_HALF
REFU 10 FACE_HALF
REFU 6 FACE_HALF
REFU 5 FACE_HALF
REFU 0 FACE_HALF
REFU 2 FACE_HALF
REFU 5 FACE_HALF
REFU 10 FACE_HALF
REFU 5 FACE_HALF

MOUZO 2 FACE_LAST
MOUZO 5 FACE_LAST

COLUMN 1 FACE_ALL

$moves
MOVE_STACK MOUZO COLUMN
DEST Size <= 2
$win
OR
    AND
        PILE ALL RAK Empty
        PILE ALL MOUZO Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL MOUZO Empty
