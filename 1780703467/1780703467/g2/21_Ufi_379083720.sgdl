Ufi
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 3 FACE_LAST

BRIOP 9 FACE_HALF
BRIOP 1 FACE_HALF

YAIDOJ 9 FACE_LAST

$moves
MOVE YAIDOJ {COLUMN, BRIOP}
DESTSRC Rank ascending
MOVE_STACK COLUMN YAIDOJ
AND
    DEST Rank 1
    SRCSTACK Suit alternate_color
$win
OR
    PILE ALL YAIDOJ Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
