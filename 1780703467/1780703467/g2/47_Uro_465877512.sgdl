Uro
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CROUB 2 FACE_LAST
CROUB 10 FACE_LAST
CROUB 0 FACE_LAST

IYAIR 10 FACE_ALL
IYAIR 6 FACE_ALL
IYAIR 4 FACE_ALL
IYAIR 3 FACE_ALL
IYAIR 10 FACE_ALL
IYAIR 7 FACE_ALL

$moves
MOVE IYAIR CROUB
DESTSRC Rank add_14
MOVE CROUB CROUB
OR
    AND
        DEST Size == 3
        DEST Empty
    AND
        DEST Empty
        DEST Suit {DIAMONDS, CLUBS, SPADES}
MOVE_STACK CROUB CROUB
OR
    DEST Rank K
    AND
        SRC Suit {DIAMONDS, CLUBS}
        DESTSRC Rank add_13
$win
PILE ALL CROUB Empty
