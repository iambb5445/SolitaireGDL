Akiok
$cards
DECK 1 {SPADES, HEARTS}

$initial
BRIOW 7 FACE_HALF
BRIOW 3 FACE_HALF
BRIOW 2 FACE_HALF
BRIOW 8 FACE_HALF
BRIOW 6 FACE_HALF
BRIOW 0 FACE_HALF

$moves
MOVE BRIOW BRIOW
OR
    SRC Suit {CLUBS, SPADES, HEARTS}
    SRC Suit {DIAMONDS, CLUBS}
MOVE_STACK BRIOW BRIOW
SRC Suit {HEARTS, SPADES, DIAMONDS}
$win
AND
    PILE ALL BRIOW Empty
    OR
        PILE ALL BRIOW Empty
        PILE ALL BRIOW Empty
