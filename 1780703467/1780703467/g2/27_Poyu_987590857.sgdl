Poyu
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 10 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 9 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 2 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        SRC Suit {CLUBS, SPADES, DIAMONDS}
        SRC Suit {DIAMONDS}
    SRC Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
MOVE_STACK COLUMN COLUMN
DEST Size < 10
$win
PILE ALL COLUMN Empty
