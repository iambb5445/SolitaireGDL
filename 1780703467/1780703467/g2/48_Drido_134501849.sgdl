Drido
$cards
DECK 4 SPADES

$initial
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 5 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    DEST Empty
    DEST Size <= 3
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
