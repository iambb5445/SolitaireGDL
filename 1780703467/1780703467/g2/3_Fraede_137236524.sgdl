Fraede
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 7 ROTATE 1 U 1
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 6 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 5 FACE_HALF

KEW 2 FACE_LAST
KEW 3 FACE_LAST
KEW 2 FACE_ALTERNATE_LAST
KEW 7 FACE_ALTERNATE_LAST

WUIQO 6 FACE_LAST
WUIQO 4 FACE_LAST
WUIQO 5 FACE_LAST
WUIQO 9 FACE_LAST
WUIQO 0 FACE_LAST
WUIQO 2 FACE_HALF

ORUX 1 FACE_ALL
ORUX 3 FACE_ALL
ORUX 8 FACE_ALL
ORUX 1 FACE_ALL
ORUX 7 FACE_ALL

$moves
MOVE DRAW KEW
OR
    AND
        DEST Size >= 7
        DESTSRC Suit match
    DEST Size < 5
MOVE DRAW WUIQO
DEST Suit {CLUBS, DIAMONDS, HEARTS}
MOVE_STACK {COLUMN, WUIQO} WUIQO
DESTSRC Rank descending
MOVE_STACK KEW KEW
AND
    DEST Size < 2
    OR
        DEST Size > 9
        SRC Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
$win
PILE ALL DRAW Empty
