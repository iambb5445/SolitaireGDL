Ovi
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 69 DEAL {EZOUX, TREADIF}
TREADIF 4 FACE_ALL
TREADIF 5 FACE_ALL

EZOUX 4 FACE_ALTERNATE_LAST
EZOUX 5 FACE_ALTERNATE_LAST
EZOUX 10 FACE_ALTERNATE_LAST
EZOUX 7 FACE_ALTERNATE_LAST

$moves
MOVE TREADIF TREADIF
OR
    AND
        DEST Size < 2
        DEST Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
    DEST Suit {DIAMONDS}
MOVE EZOUX TREADIF
DESTSRC Suit alternate_color
$win
OR
    PILE ALL TREADIF Empty
    AND
        PILE ALL EZOUX Empty
        PILE ALL TREADIF Empty
