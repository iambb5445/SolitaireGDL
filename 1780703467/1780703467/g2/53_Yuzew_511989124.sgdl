Yuzew
$cards
DECK 2 SPADES

$initial
COLUMN 8 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Suit match_color
        SRC Suit {SPADES, HEARTS, CLUBS}
    AND
        SRCSTACK Rank equal
        DEST Rank 1
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
