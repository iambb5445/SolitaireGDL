Couxoc
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 83 ROTATE 3 U U
DRUIQA 0 FACE_LAST
DRUIQA 2 FACE_LAST
DRUIQA 6 FACE_ALTERNATE_LAST
DRUIQA 3 FACE_ALTERNATE_LAST
DRUIQA 10 FACE_ALTERNATE_LAST

$moves
MOVE DRAW DRUIQA
OR
    AND
        SRC Suit {CLUBS}
        DEST Empty
    AND
        DEST Suit {DIAMONDS, SPADES, HEARTS}
        DEST Empty
MOVE DRUIQA DRUIQA
AND
    OR
        DESTSRC Suit match
        DEST Suit {CLUBS, SPADES}
    OR
        SRC Rank 1
        DEST Rank K
$win
PILE ALL DRUIQA Empty
