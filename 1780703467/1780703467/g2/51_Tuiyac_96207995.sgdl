Tuiyac
$cards
DECK 2 {SPADES, CLUBS}

$initial
PAW 1 FACE_LAST
PAW 1 FACE_ALL
PAW 8 FACE_ALL

STIVE 7 FACE_HALF
STIVE 4 FACE_HALF
STIVE 9 FACE_HALF
STIVE 8 FACE_HALF
STIVE 8 FACE_HALF
STIVE 6 FACE_HALF

$moves
MOVE PAW STIVE
SRC Suit {HEARTS}
MOVE_STACK STIVE STIVE
AND
    OR
        SRCSTACK Size >= 6
        DEST Size > 7
    SRCSTACK Size == 7
MOVE_STACK PAW STIVE
AND
    DEST Empty
    DEST Empty
$win
OR
    AND
        PILE ALL STIVE Empty
        PILE ALL STIVE Empty
    AND
        PILE ALL PAW Empty
        PILE ALL STIVE Empty
