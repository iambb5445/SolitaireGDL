Mucax
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 0 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 4 FACE_ALL

PIHA 0 FACE_ALTERNATE_LAST
PIHA 7 FACE_ALTERNATE_LAST
PIHA 10 FACE_ALTERNATE_LAST
PIHA 4 FACE_ALTERNATE_LAST
PIHA 3 FACE_ALTERNATE_LAST
PIHA 3 FACE_ALTERNATE_LAST
PIHA 3 FACE_HALF

$moves
MOVE_STACK PIHA COLUMN
DEST Size >= 4
MOVE_STACK COLUMN PIHA
AND
    DEST Empty
    SRC Suit {HEARTS, CLUBS, SPADES}
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL PIHA Empty
        PILE ALL PIHA Empty
