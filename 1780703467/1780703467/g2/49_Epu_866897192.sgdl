Epu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 2 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 0 FACE_ALL

RAIGU 0 FACE_ALTERNATE_LAST
RAIGU 10 FACE_LAST
RAIGU 5 FACE_LAST
RAIGU 7 FACE_LAST

$moves
MOVE RAIGU RAIGU
SRC Suit {HEARTS, CLUBS, DIAMONDS}
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank descending
        SRC Rank K
    DEST Size >= 6
MOVE_STACK RAIGU RAIGU
SRC Suit {DIAMONDS}
MOVE_STACK COLUMN RAIGU
DEST Rank 1
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
