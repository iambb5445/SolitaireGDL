Vomo
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
ZAERA 1 FACE_HALF
ZAERA 0 FACE_HALF
ZAERA 8 FACE_HALF
ZAERA 8 FACE_HALF
ZAERA 6 FACE_HALF
ZAERA 1 FACE_HALF
ZAERA 6 FACE_HALF
ZAERA 6 FACE_HALF
ZAERA 6 FACE_HALF
ZAERA 7 FACE_HALF

ANAEM 3 FACE_ALTERNATE_LAST

$moves
MOVE_STACK ANAEM ZAERA
DEST Suit {CLUBS}
MOVE_STACK {ANAEM, ZAERA} ANAEM
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
        DESTSRC Rank add_14
    AND
        DEST Suit {SPADES}
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
$win
OR
    PILE ALL ZAERA Empty
    AND
        PILE ALL ANAEM Empty
        PILE ALL ZAERA Empty
