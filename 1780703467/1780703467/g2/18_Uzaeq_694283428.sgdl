Uzaeq
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 10 FACE_ALL
COLUMN 4 FACE_ALL

ASAEQ 1 FACE_LAST
ASAEQ 3 FACE_LAST
ASAEQ 3 FACE_LAST
ASAEQ 4 FACE_ALTERNATE_LAST
ASAEQ 1 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN ASAEQ
AND
    OR
        DEST Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
        DESTSRC Suit match_color
    AND
        DESTSRC Rank descending
        DEST Suit {DIAMONDS, HEARTS, SPADES, CLUBS}
$win
AND
    PILE ALL ASAEQ Empty
    PILE ALL ASAEQ Empty
