Oqa
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 24 ROTATE 1 U U
COLUMN 7 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 9 FACE_ALL

FREABUL 9 FACE_ALTERNATE_LAST
FREABUL 10 FACE_ALTERNATE_LAST
FREABUL 7 FACE_LAST
FREABUL 0 FACE_LAST

DOWIY 1 FACE_HALF
DOWIY 5 FACE_HALF
DOWIY 0 FACE_HALF
DOWIY 10 FACE_HALF

$moves
MOVE COLUMN {FREABUL, COLUMN, DOWIY}
DEST Suit {DIAMONDS}
MOVE {DOWIY, DRAW} FREABUL
DEST Empty
MOVE_STACK DOWIY {FREABUL, COLUMN, DOWIY}
DEST Size <= 8
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL DOWIY Empty
