Eza
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EQO 9 FACE_HALF
EQO 4 FACE_HALF
EQO 2 FACE_HALF
EQO 10 FACE_HALF
EQO 3 FACE_HALF
EQO 7 FACE_HALF
EQO 4 FACE_HALF

COLUMN 7 FACE_ALL

DRAIWIB 6 FACE_LAST
DRAIWIB 5 FACE_LAST
DRAIWIB 1 FACE_LAST
DRAIWIB 1 FACE_LAST
DRAIWIB 6 FACE_LAST

UWEAM 10 FACE_ALTERNATE_LAST
UWEAM 9 FACE_ALTERNATE_LAST
UWEAM 1 FACE_ALTERNATE_LAST
UWEAM 5 FACE_ALTERNATE_LAST
UWEAM 10 FACE_ALTERNATE_LAST
UWEAM 4 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN UWEAM
AND
    AND
        SRC Suit {HEARTS}
        SRC Rank K
    SRC Suit {DIAMONDS, HEARTS, CLUBS}
MOVE EQO {EQO, COLUMN, DRAIWIB}
OR
    AND
        SRC Suit {SPADES}
        DEST Rank 1
    DEST Empty
MOVE_STACK {UWEAM, EQO, DRAIWIB, COLUMN} DRAIWIB
AND
    DEST Size >= 6
    OR
        DEST Rank K
        DEST Suit {CLUBS, DIAMONDS, SPADES, HEARTS}
MOVE_STACK EQO EQO
OR
    SRC Rank K
    SRCSTACK Size >= 0
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL DRAIWIB Empty
