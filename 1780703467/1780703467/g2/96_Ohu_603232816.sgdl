Ohu
$cards
DECK 2 {SPADES, CLUBS}

$initial
AQAS 1 FACE_ALL
AQAS 1 FACE_ALL
AQAS 0 FACE_ALL
AQAS 4 FACE_ALTERNATE_LAST

DROMED 3 FACE_ALL
DROMED 7 FACE_ALL
DROMED 7 FACE_LAST
DROMED 2 FACE_LAST
DROMED 0 FACE_LAST
DROMED 8 FACE_LAST
DROMED 6 FACE_LAST
DROMED 5 FACE_LAST
DROMED 3 FACE_LAST
DROMED 5 FACE_LAST

$moves
MOVE_STACK DROMED DROMED
AND
    OR
        DESTSRC Suit alternate_color
        DEST Size == 2
    AND
        SRC Suit {DIAMONDS, HEARTS}
        SRC Rank K
$win
AND
    PILE ALL AQAS Empty
    PILE ALL DROMED Empty
