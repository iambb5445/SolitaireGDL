Gruva
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AWO 1 FACE_ALTERNATE_LAST
AWO 8 FACE_ALTERNATE_LAST
AWO 10 FACE_ALTERNATE_LAST
AWO 9 FACE_ALTERNATE_LAST
AWO 9 FACE_ALTERNATE_LAST
AWO 3 FACE_ALTERNATE_LAST
AWO 2 FACE_ALTERNATE_LAST
AWO 6 FACE_ALTERNATE_LAST
AWO 4 FACE_ALTERNATE_LAST

$moves
MOVE AWO AWO
OR
    AND
        DEST Suit {HEARTS, CLUBS}
        DEST Suit {SPADES}
    AND
        DESTSRC Suit match
        DEST Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
MOVE_STACK AWO AWO
OR
    SRCSTACK Rank ascending
    SRCSTACK Size < 8
$win
AND
    OR
        PILE ALL AWO Empty
        PILE ALL AWO Empty
    OR
        PILE ALL AWO Empty
        PILE ALL AWO Empty
