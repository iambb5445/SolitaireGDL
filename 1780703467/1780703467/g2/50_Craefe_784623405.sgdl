Craefe
$cards
DECK 2 {SPADES, HEARTS}

$initial
EBAIC 2 FACE_LAST
EBAIC 6 FACE_LAST
EBAIC 1 FACE_ALTERNATE_LAST
EBAIC 4 FACE_ALTERNATE_LAST
EBAIC 9 FACE_ALTERNATE_LAST

AGIOX 7 FACE_HALF
AGIOX 10 FACE_HALF
AGIOX 2 FACE_HALF
AGIOX 0 FACE_HALF

COLUMN 10 FACE_HALF
COLUMN 1 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
AND
    OR
        DESTSRC Suit match
        DESTSRC Suit alternate_color
    OR
        DESTSRC Suit match_color
        DEST Suit {DIAMONDS, HEARTS, CLUBS}
MOVE EBAIC AGIOX
SRC Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
$win
PILE ALL EBAIC Empty
