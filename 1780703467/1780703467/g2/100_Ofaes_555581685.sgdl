Ofaes
$cards
DECK 8 SPADES

$initial
DRAW 8 DEAL {QUIBUF, BAKA, UDAEC}
COLUMN 2 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 9 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 8 FACE_HALF

BAKA 10 FACE_ALL
BAKA 5 FACE_ALL
BAKA 8 FACE_ALL
BAKA 5 FACE_ALL
BAKA 6 FACE_ALL
BAKA 5 FACE_LAST

QUIBUF 2 FACE_ALTERNATE_LAST
QUIBUF 3 FACE_ALTERNATE_LAST

UDAEC 7 FACE_LAST

$moves
MOVE_STACK BAKA BAKA
SRCSTACK Size == 7
MOVE_STACK BAKA UDAEC
AND
    AND
        DESTSRC Suit match_color
        DEST Size == 3
    SRCSTACK Suit alternate_color
DRAW
PILE ALL QUIBUF Size > 0
$win
PILE ALL QUIBUF Empty
