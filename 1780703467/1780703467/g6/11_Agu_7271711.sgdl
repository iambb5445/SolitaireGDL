Agu
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 99 DEAL COLUMN
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE COLUMN COLUMN
OR
    DEST Rank 1
    AND
        DEST Suit {SPADES, DIAMONDS, CLUBS}
        DEST Suit {SPADES, DIAMONDS, HEARTS}
    DEST Empty
MOVE_STACK ETEAJ ETEAJ
AND
    DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
    SRCSTACK Rank ascending
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
