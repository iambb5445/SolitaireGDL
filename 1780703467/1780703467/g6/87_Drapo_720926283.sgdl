Drapo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 3 ROTATE 1 U 3
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 4 FACE_HALF

JIR 3 FACE_ALTERNATE_LAST
JIR 10 FACE_ALTERNATE_LAST
JIR 5 FACE_ALTERNATE_LAST
JIR 4 FACE_ALTERNATE_LAST
JIR 10 FACE_ALTERNATE_LAST
JIR 0 FACE_ALTERNATE_LAST
JIR 0 FACE_ALTERNATE_LAST
JIR 9 FACE_ALTERNATE_LAST
JIR 0 FACE_ALTERNATE_LAST

RAVE 8 FACE_ALTERNATE_LAST
RAVE 0 FACE_ALTERNATE_LAST
RAVE 2 FACE_LAST

$moves
MOVE DRAW JIR
AND
    AND
        DEST Size <= 1
        DEST Rank 1
    OR
        DEST Suit {DIAMONDS}
        DEST Rank 1
MOVE DRAW RAVE
SRC Suit {HEARTS, CLUBS}
MOVE_STACK {COLUMN, JIR, RAVE} COLUMN
DEST Size < 4
MOVE_STACK {RAVE, JIR, COLUMN} JIR
OR
    AND
        DESTSRC Suit alternate_color
        DEST Size == 9
    SRC Rank K
$win
PILE ALL DRAW Empty
