Griocus
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 65 ROTATE 3 U 2
COLUMN 0 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, DRAW} COLUMN
SRC Rank 1
MOVE_STACK COLUMN COLUMN
AND
    OR
        SRC Rank K
        DEST Size == 7
    OR
        SRCSTACK Rank add_14
        SRCSTACK Suit alternate_color
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL DRAW Empty
