Eqi
$cards
DECK 1 {SPADES, HEARTS}

$initial
CRAIBA 0 FACE_ALTERNATE_LAST
CRAIBA 7 FACE_ALTERNATE_LAST
CRAIBA 7 FACE_ALTERNATE_LAST
CRAIBA 3 FACE_ALTERNATE_LAST
CRAIBA 9 FACE_ALTERNATE_LAST

$moves
MOVE CRAIBA CRAIBA
AND
    AND
        DESTSRC Suit match
        DEST Size < 7
    DEST Size <= 5
MOVE_STACK CRAIBA CRAIBA
OR
    DEST Rank K
    AND
        DESTSRC Rank add_14
        DEST Size < 0
$win
PILE ALL CRAIBA Empty
