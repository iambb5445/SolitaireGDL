Quizo
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 6 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL

$moves
MOVE COLUMN COLUMN
AND
    OR
        DEST Size >= 10
        DESTSRC Rank add_13
    OR
        DESTSRC Rank equal
        SRC Suit {HEARTS, SPADES, DIAMONDS}
MOVE_STACK COLUMN COLUMN
SRC Rank 1
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
