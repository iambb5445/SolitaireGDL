Pream
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 10 FACE_ALL

ONUB 1 FACE_ALL
ONUB 1 FACE_ALL
ONUB 2 FACE_ALL
ONUB 3 FACE_ALL
ONUB 9 FACE_ALL
ONUB 3 FACE_ALL
ONUB 9 FACE_ALL
ONUB 8 FACE_ALL
ONUB 6 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, ONUB} ONUB
OR
    AND
        SRC Rank K
        DEST Rank 1
    SRC Rank K
MOVE COLUMN COLUMN
DESTSRC Rank add_14
MOVE_STACK COLUMN {COLUMN, ONUB}
SRCSTACK Rank equal
$win
OR
    PILE ALL ONUB Empty
    AND
        PILE ALL ONUB Empty
        PILE ALL COLUMN Empty
