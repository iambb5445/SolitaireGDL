Umo
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 51 DEAL UVAET
UVAET 6 FACE_ALTERNATE_LAST
UVAET 4 FACE_ALTERNATE_LAST
UVAET 7 FACE_ALTERNATE_LAST
UVAET 9 FACE_ALTERNATE_LAST
UVAET 2 FACE_ALTERNATE_LAST
UVAET 0 FACE_ALTERNATE_LAST
UVAET 9 FACE_ALTERNATE_LAST
UVAET 0 FACE_ALTERNATE_LAST
UVAET 9 FACE_ALL
UVAET 7 FACE_ALL

$moves
MOVE UVAET UVAET
OR
    AND
        DEST Empty
        SRC Suit {SPADES, HEARTS, DIAMONDS, CLUBS}
    DEST Size >= 9
MOVE_STACK UVAET UVAET
AND
    OR
        DEST Empty
        SRC Rank K
    OR
        SRCSTACK Rank add_14
        DEST Rank 1
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL UVAET Empty
    AND
        PILE ALL UVAET Empty
        PILE ALL UVAET Empty
