Tuil
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AMO 9 FACE_ALTERNATE_LAST
AMO 5 FACE_ALTERNATE_LAST
AMO 6 FACE_ALL

GUWOP 3 FACE_ALL
GUWOP 3 FACE_ALL
GUWOP 10 FACE_ALL
GUWOP 0 FACE_ALL
GUWOP 5 FACE_ALL
GUWOP 10 FACE_ALL
GUWOP 1 FACE_ALL

$moves
MOVE AMO {AMO, GUWOP}
OR
    DEST Empty
    AND
        SRC Suit {DIAMONDS, HEARTS, CLUBS}
        DESTSRC Rank add_13
MOVE GUWOP {AMO, GUWOP}
OR
    AND
        DESTSRC Rank equal
        DESTSRC Rank equal
    AND
        SRC Suit {SPADES, CLUBS, DIAMONDS}
        DESTSRC Suit match
$win
OR
    PILE ALL GUWOP Empty
    AND
        PILE ALL GUWOP Empty
        PILE ALL GUWOP Empty
