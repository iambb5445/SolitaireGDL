Okour
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 8 DEAL OKOUX
OKOUX 2 FACE_HALF
OKOUX 10 FACE_ALL
OKOUX 6 FACE_ALL
OKOUX 0 FACE_ALL
OKOUX 8 FACE_ALL
OKOUX 6 FACE_ALL
OKOUX 9 FACE_ALL
OKOUX 5 FACE_ALL
OKOUX 3 FACE_ALL
OKOUX 3 FACE_ALL

COLUMN 6 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 6 FACE_HALF

$moves
MOVE COLUMN COLUMN
DESTSRC Rank descending
MOVE OKOUX {COLUMN, OKOUX}
OR
    DEST Empty
    AND
        SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
        DEST Empty
MOVE_STACK COLUMN {COLUMN, OKOUX}
OR
    AND
        DEST Empty
        DESTSRC Suit match
    AND
        DEST Rank 1
        SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE_STACK OKOUX OKOUX
SRC Rank K
DRAW
PILE ANY DRAW Empty
$win
PILE ALL DRAW Empty
