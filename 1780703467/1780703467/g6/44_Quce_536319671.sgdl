Quce
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
ECUIL 8 FACE_ALTERNATE_LAST
ECUIL 6 FACE_ALTERNATE_LAST
ECUIL 8 FACE_ALTERNATE_LAST

AGAT 0 FACE_HALF
AGAT 5 FACE_HALF
AGAT 2 FACE_HALF

POUQOB 4 FACE_LAST
POUQOB 3 FACE_LAST
POUQOB 7 FACE_LAST
POUQOB 3 FACE_LAST
POUQOB 6 FACE_LAST

$moves
MOVE AGAT POUQOB
OR
    AND
        DEST Empty
        SRC Suit {CLUBS, DIAMONDS, HEARTS}
    AND
        DEST Rank 1
        SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE ECUIL ECUIL
AND
    DEST Rank K
    DEST Size >= 1
MOVE_STACK POUQOB POUQOB
AND
    OR
        SRCSTACK Rank add_13
        SRC Suit {HEARTS}
    AND
        SRCSTACK Suit match_color
        DESTSRC Rank add_14
$win
AND
    PILE ALL POUQOB Empty
    OR
        PILE ALL POUQOB Empty
        PILE ALL AGAT Empty
