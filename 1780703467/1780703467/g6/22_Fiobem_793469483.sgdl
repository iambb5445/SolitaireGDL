Fiobem
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 46 DEAL UNUG
OYUIC 10 FACE_HALF
OYUIC 7 FACE_HALF

COLUMN 4 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 0 FACE_HALF

UNUG 8 FACE_ALL

$moves
MOVE OYUIC UNUG
OR
    AND
        DEST Rank K
        DEST Size > 5
    DEST Size < 10
MOVE_STACK OYUIC COLUMN
OR
    AND
        SRC Suit {SPADES}
        SRCSTACK Suit match
    AND
        SRCSTACK Rank add_13
        DEST Rank 1
DRAW
PILE ALL UNUG Empty
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL UNUG Empty
        PILE ALL OYUIC Empty
