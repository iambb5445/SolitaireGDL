Meahi
$cards
DECK 2 {SPADES, HEARTS}

$initial
UJOK 0 FACE_ALL
UJOK 6 FACE_ALL
UJOK 2 FACE_ALL
UJOK 1 FACE_ALL
UJOK 5 FACE_ALL
UJOK 1 FACE_ALL

XOXUP 9 FACE_LAST
XOXUP 10 FACE_LAST
XOXUP 6 FACE_LAST
XOXUP 7 FACE_ALTERNATE_LAST
XOXUP 1 FACE_ALTERNATE_LAST
XOXUP 3 FACE_ALTERNATE_LAST
XOXUP 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {XOXUP, UJOK} XOXUP
AND
    OR
        SRCSTACK Size == 9
        SRCSTACK Size < 7
    AND
        DEST Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
        DEST Rank 1
$win
AND
    OR
        PILE ALL XOXUP Empty
        PILE ALL UJOK Empty
    OR
        PILE ALL XOXUP Empty
        PILE ALL UJOK Empty
