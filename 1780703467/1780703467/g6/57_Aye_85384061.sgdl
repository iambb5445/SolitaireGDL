Aye
$cards
DECK 2 SPADES

$initial
XIC 1 FACE_ALTERNATE_LAST
XIC 6 FACE_ALTERNATE_LAST
XIC 6 FACE_ALTERNATE_LAST
XIC 4 FACE_HALF
XIC 7 FACE_HALF
XIC 2 FACE_HALF

$moves
MOVE XIC XIC
AND
    DEST Suit {CLUBS, SPADES, HEARTS}
    AND
        DESTSRC Suit alternate_color
        DEST Suit {HEARTS, CLUBS, SPADES}
MOVE_STACK XIC XIC
OR
    DESTSRC Suit alternate_color
    DESTSRC Suit match_color
$win
AND
    PILE ALL XIC Empty
    OR
        PILE ALL XIC Empty
        PILE ALL XIC Empty
