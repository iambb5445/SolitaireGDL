Yij
$cards
DECK 4 SPADES

$initial
STAXI 5 FACE_ALL

COLUMN 7 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 5 FACE_ALL
COLUMN 0 FACE_ALL

NOGI 1 FACE_HALF
NOGI 2 FACE_HALF
NOGI 8 FACE_ALTERNATE_LAST
NOGI 1 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN STAXI
SRC Rank 1
MOVE NOGI {COLUMN, NOGI}
OR
    AND
        DEST Size <= 1
        DEST Rank 1
    AND
        SRC Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
        DESTSRC Rank add_13
$win
OR
    AND
        PILE ALL STAXI Empty
        PILE ALL STAXI Empty
    PILE ALL COLUMN Empty
