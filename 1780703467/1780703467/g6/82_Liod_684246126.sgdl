Liod
$cards
DECK 8 SPADES

$initial
DRAW 2 DEAL {OCAD, XEJA, ZUIW, ACUV}
XEJA 0 FACE_LAST
XEJA 4 FACE_LAST
XEJA 0 FACE_LAST
XEJA 3 FACE_LAST
XEJA 4 FACE_LAST
XEJA 10 FACE_LAST
XEJA 3 FACE_LAST
XEJA 8 FACE_LAST
XEJA 2 FACE_LAST

ZUIW 7 FACE_ALTERNATE_LAST

ACUV 3 FACE_ALTERNATE_LAST
ACUV 3 FACE_HALF

OCAD 7 FACE_ALTERNATE_LAST
OCAD 0 FACE_ALTERNATE_LAST
OCAD 9 FACE_ALTERNATE_LAST
OCAD 5 FACE_ALTERNATE_LAST
OCAD 8 FACE_ALTERNATE_LAST
OCAD 10 FACE_ALTERNATE_LAST
OCAD 6 FACE_ALTERNATE_LAST
OCAD 8 FACE_ALTERNATE_LAST
OCAD 2 FACE_ALTERNATE_LAST

$moves
MOVE ACUV XEJA
DESTSRC Suit match
MOVE ZUIW OCAD
AND
    DEST Rank 1
    OR
        DEST Rank K
        SRC Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
MOVE_STACK {ACUV, ZUIW, XEJA, OCAD} OCAD
DEST Suit {DIAMONDS, SPADES}
DRAW
PILE ALL OCAD Size > 0
$win
PILE ALL DRAW Empty
