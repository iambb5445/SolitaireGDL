Zujuh
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_HALF

$moves
MOVE COLUMN COLUMN
AND
    OR
        DEST Empty
        DEST Empty
    AND
        DEST Size == 5
        DEST Size <= 9
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
