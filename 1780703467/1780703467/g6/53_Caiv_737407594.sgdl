Caiv
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DIOV 7 FACE_ALTERNATE_LAST
DIOV 1 FACE_ALTERNATE_LAST
DIOV 2 FACE_ALL
DIOV 10 FACE_ALL
DIOV 9 FACE_ALL
DIOV 10 FACE_ALL
DIOV 5 FACE_ALL
DIOV 1 FACE_ALL
DIOV 0 FACE_ALL
DIOV 5 FACE_ALL

HAEKU 2 FACE_HALF

$moves
MOVE DIOV HAEKU
SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
MOVE HAEKU DIOV
DESTSRC Suit match
MOVE_STACK HAEKU DIOV
OR
    DEST Size <= 1
    SRC Suit {CLUBS, HEARTS, DIAMONDS}
MOVE_STACK HAEKU HAEKU
OR
    DEST Rank K
    DEST Suit {HEARTS}
$win
AND
    OR
        PILE ALL HAEKU Empty
        PILE ALL DIOV Empty
    PILE ALL HAEKU Empty
