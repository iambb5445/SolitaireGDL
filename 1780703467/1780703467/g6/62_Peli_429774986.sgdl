Peli
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 10 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 2 FACE_HALF

EZE 3 FACE_LAST
EZE 7 FACE_LAST
EZE 6 FACE_LAST
EZE 2 FACE_LAST
EZE 8 FACE_LAST
EZE 5 FACE_LAST

HUIS 5 FACE_ALL
HUIS 8 FACE_ALL
HUIS 1 FACE_LAST

$moves
MOVE EZE HUIS
AND
    DESTSRC Suit match_color
    SRC Rank K
MOVE_STACK HUIS COLUMN
OR
    DESTSRC Suit match_color
    AND
        SRCSTACK Rank add_13
        SRC Suit {DIAMONDS, HEARTS, CLUBS}
$win
PILE ALL HUIS Empty
