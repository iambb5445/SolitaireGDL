Iju
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 8 FACE_HALF

UPES 8 FACE_ALL
UPES 5 FACE_ALL
UPES 6 FACE_ALL
UPES 6 FACE_ALL
UPES 4 FACE_ALL
UPES 8 FACE_ALL
UPES 6 FACE_ALL
UPES 0 FACE_ALL
UPES 5 FACE_ALL
UPES 1 FACE_ALL

UPI 3 FACE_HALF
UPI 1 FACE_HALF
UPI 9 FACE_HALF
UPI 8 FACE_HALF
UPI 4 FACE_ALTERNATE_LAST
UPI 7 FACE_ALTERNATE_LAST

QEY 3 FACE_ALL

$moves
MOVE COLUMN UPES
OR
    AND
        SRC Rank K
        DEST Size > 1
    AND
        DESTSRC Suit match_color
        DEST Size > 2
MOVE UPES COLUMN
OR
    DEST Size < 2
    AND
        DEST Rank K
        DESTSRC Suit match_color
MOVE_STACK {UPI, COLUMN, UPES} COLUMN
OR
    AND
        DEST Empty
        SRCSTACK Rank descending
    AND
        SRCSTACK Suit alternate_color
        DEST Empty
MOVE_STACK {COLUMN, QEY, UPI} UPI
OR
    AND
        DEST Rank 1
        DESTSRC Rank add_14
    DEST Size > 7
$win
PILE ALL UPES Empty
