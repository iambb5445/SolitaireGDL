Mid
$cards
DECK 8 SPADES

$initial
UMAEC 4 FACE_LAST
UMAEC 3 FACE_LAST
UMAEC 5 FACE_LAST
UMAEC 1 FACE_LAST
UMAEC 5 FACE_LAST
UMAEC 1 FACE_LAST
UMAEC 1 FACE_LAST

COLUMN 2 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 6 FACE_LAST

BALOC 3 FACE_ALTERNATE_LAST
BALOC 10 FACE_ALTERNATE_LAST
BALOC 10 FACE_ALTERNATE_LAST
BALOC 8 FACE_ALTERNATE_LAST
BALOC 2 FACE_ALTERNATE_LAST
BALOC 4 FACE_ALTERNATE_LAST
BALOC 8 FACE_ALTERNATE_LAST
BALOC 2 FACE_ALTERNATE_LAST
BALOC 6 FACE_ALTERNATE_LAST

JAMI 4 FACE_HALF

$moves
MOVE {JAMI, COLUMN, BALOC} UMAEC
AND
    OR
        DEST Rank K
        DESTSRC Suit alternate_color
    OR
        DEST Suit {HEARTS}
        SRC Rank K
MOVE UMAEC UMAEC
DEST Rank 1
MOVE_STACK COLUMN COLUMN
SRC Suit {CLUBS, HEARTS, DIAMONDS}
$win
OR
    PILE ALL UMAEC Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL UMAEC Empty
