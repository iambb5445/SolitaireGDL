Wom
$cards
DECK 2 SPADES

$initial
SACU 6 FACE_ALTERNATE_LAST
SACU 8 FACE_ALTERNATE_LAST
SACU 1 FACE_ALTERNATE_LAST
SACU 1 FACE_ALTERNATE_LAST
SACU 1 FACE_ALTERNATE_LAST
SACU 8 FACE_ALTERNATE_LAST
SACU 1 FACE_ALTERNATE_LAST
SACU 0 FACE_ALL

$moves
MOVE_STACK SACU SACU
AND
    OR
        SRC Rank K
        DESTSRC Suit match_color
    OR
        DEST Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
        SRCSTACK Suit alternate_color
$win
AND
    OR
        PILE ALL SACU Empty
        PILE ALL SACU Empty
    OR
        PILE ALL SACU Empty
        PILE ALL SACU Empty
