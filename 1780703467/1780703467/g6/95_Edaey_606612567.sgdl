Edaey
$cards
DECK 1 SPADES

$initial
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE COLUMN COLUMN
DEST Suit {CLUBS, SPADES}
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Suit {SPADES, HEARTS, CLUBS}
        SRCSTACK Size == 7
    SRCSTACK Suit alternate_color
$win
PILE ALL COLUMN Empty
