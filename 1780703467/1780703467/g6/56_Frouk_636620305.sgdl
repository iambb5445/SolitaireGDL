Frouk
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
TAP 8 FACE_ALTERNATE_LAST
TAP 9 FACE_ALTERNATE_LAST
TAP 6 FACE_ALTERNATE_LAST
TAP 5 FACE_ALTERNATE_LAST
TAP 5 FACE_LAST

ZUIN 0 FACE_ALL
ZUIN 9 FACE_LAST
ZUIN 7 FACE_LAST
ZUIN 0 FACE_LAST
ZUIN 3 FACE_LAST

$moves
MOVE_STACK TAP ZUIN
AND
    AND
        DEST Size <= 2
        DEST Rank K
    OR
        DEST Empty
        SRC Rank 1
$win
PILE ALL ZUIN Empty
