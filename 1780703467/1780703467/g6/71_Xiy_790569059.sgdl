Xiy
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 7 ROTATE 1 U 2
EXA 5 FACE_ALTERNATE_LAST
EXA 8 FACE_ALTERNATE_LAST
EXA 4 FACE_ALTERNATE_LAST
EXA 7 FACE_ALTERNATE_LAST
EXA 6 FACE_ALTERNATE_LAST
EXA 10 FACE_ALTERNATE_LAST
EXA 9 FACE_LAST

CAES 0 FACE_HALF

OKA 10 FACE_HALF
OKA 5 FACE_HALF
OKA 1 FACE_HALF
OKA 7 FACE_HALF
OKA 9 FACE_HALF
OKA 10 FACE_HALF
OKA 4 FACE_HALF
OKA 2 FACE_HALF

$moves
MOVE CAES EXA
AND
    AND
        SRC Rank K
        DEST Empty
    OR
        SRC Suit {SPADES}
        DEST Size <= 3
$win
OR
    PILE ALL EXA Empty
    AND
        PILE ALL EXA Empty
        PILE ALL DRAW Empty
