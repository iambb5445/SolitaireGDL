Cova
$cards
DECK 4 {SPADES, HEARTS}

$initial
ASAR 0 FACE_ALTERNATE_LAST
ASAR 6 FACE_ALTERNATE_LAST
ASAR 10 FACE_ALTERNATE_LAST
ASAR 3 FACE_HALF

CASE 10 FACE_LAST
CASE 5 FACE_LAST
CASE 4 FACE_HALF
CASE 8 FACE_HALF
CASE 9 FACE_HALF
CASE 9 FACE_HALF
CASE 6 FACE_HALF

ARI 3 FACE_ALTERNATE_LAST
ARI 6 FACE_ALTERNATE_LAST
ARI 6 FACE_ALTERNATE_LAST
ARI 3 FACE_ALTERNATE_LAST
ARI 7 FACE_ALTERNATE_LAST

COLUMN 9 FACE_LAST

$moves
MOVE COLUMN ARI
DESTSRC Suit alternate_color
MOVE COLUMN CASE
DEST Empty
$win
AND
    PILE ALL ARI Empty
    OR
        PILE ALL CASE Empty
        PILE ALL ASAR Empty
