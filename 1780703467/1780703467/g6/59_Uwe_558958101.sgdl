Uwe
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 29 ROTATE 1 U 1
BOUB 1 FACE_LAST
BOUB 7 FACE_LAST
BOUB 6 FACE_LAST
BOUB 1 FACE_LAST
BOUB 6 FACE_LAST
BOUB 0 FACE_LAST
BOUB 2 FACE_LAST

IDEV 8 FACE_ALTERNATE_LAST
IDEV 1 FACE_ALTERNATE_LAST
IDEV 5 FACE_ALTERNATE_LAST
IDEV 1 FACE_ALTERNATE_LAST
IDEV 6 FACE_ALTERNATE_LAST
IDEV 6 FACE_ALTERNATE_LAST
IDEV 7 FACE_ALTERNATE_LAST
IDEV 1 FACE_ALTERNATE_LAST
IDEV 7 FACE_ALTERNATE_LAST

COLUMN 10 FACE_ALL

$moves
MOVE IDEV BOUB
OR
    AND
        DESTSRC Rank ascending
        DEST Empty
    DEST Suit {DIAMONDS, SPADES, CLUBS}
MOVE_STACK IDEV IDEV
SRCSTACK Rank descending
MOVE_STACK COLUMN BOUB
OR
    AND
        DEST Empty
        SRCSTACK Size >= 4
    AND
        DESTSRC Suit alternate_color
        SRCSTACK Rank descending
$win
OR
    AND
        PILE ALL BOUB Empty
        PILE ALL DRAW Empty
    PILE ALL BOUB Empty
