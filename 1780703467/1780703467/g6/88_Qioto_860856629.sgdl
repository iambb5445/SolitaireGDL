Qioto
$cards
DECK 2 {SPADES, HEARTS}

$initial
FRAEM 8 FACE_LAST
FRAEM 0 FACE_LAST
FRAEM 4 FACE_LAST
FRAEM 4 FACE_LAST
FRAEM 4 FACE_LAST

COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 7 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 1 FACE_LAST

$moves
MOVE {COLUMN, FRAEM} FRAEM
DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL FRAEM Empty
        PILE ALL COLUMN Empty
