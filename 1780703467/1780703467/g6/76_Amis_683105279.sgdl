Amis
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 3 U 3
CAECEP 5 FACE_ALL
CAECEP 3 FACE_ALL

KUIQAW 2 FACE_LAST
KUIQAW 0 FACE_LAST

COLUMN 2 FACE_HALF

TREAYUD 6 FACE_HALF
TREAYUD 7 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, DRAW, CAECEP, TREAYUD} TREAYUD
AND
    OR
        DESTSRC Rank descending
        DEST Suit {SPADES, CLUBS, HEARTS}
    DEST Suit {SPADES}
MOVE TREAYUD COLUMN
DEST Rank 1
MOVE_STACK CAECEP {COLUMN, KUIQAW, TREAYUD, CAECEP}
OR
    DESTSRC Suit alternate_color
    SRC Suit {SPADES}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL TREAYUD Empty
