Praewa
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 37 DEAL {ULO, DEAG}
FOULIT 7 FACE_ALTERNATE_LAST
FOULIT 5 FACE_ALTERNATE_LAST
FOULIT 7 FACE_ALTERNATE_LAST

YEB 0 FACE_LAST
YEB 6 FACE_LAST
YEB 4 FACE_LAST
YEB 3 FACE_LAST
YEB 2 FACE_LAST
YEB 3 FACE_LAST
YEB 3 FACE_LAST
YEB 8 FACE_LAST

ULO 9 FACE_LAST

DEAG 0 FACE_HALF
DEAG 10 FACE_LAST

$moves
MOVE DEAG ULO
DEST Empty
MOVE {DEAG, FOULIT} DEAG
DEST Empty
MOVE_STACK YEB FOULIT
OR
    AND
        DEST Size >= 2
        DESTSRC Rank ascending
    AND
        DESTSRC Suit match
        DEST Suit {HEARTS}
DRAW
PILE ALL ULO Size > 0
$win
AND
    OR
        PILE ALL ULO Empty
        PILE ALL ULO Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
