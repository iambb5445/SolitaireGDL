Zuixob
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 3 DEAL EHIOM
DEH 9 FACE_ALL
DEH 9 FACE_ALL
DEH 0 FACE_ALL
DEH 5 FACE_ALL
DEH 1 FACE_ALL
DEH 1 FACE_ALTERNATE_LAST
DEH 5 FACE_ALTERNATE_LAST

EHIOM 6 FACE_ALTERNATE_LAST
EHIOM 2 FACE_ALTERNATE_LAST
EHIOM 8 FACE_ALTERNATE_LAST
EHIOM 2 FACE_ALTERNATE_LAST
EHIOM 10 FACE_ALTERNATE_LAST
EHIOM 6 FACE_ALTERNATE_LAST
EHIOM 0 FACE_ALTERNATE_LAST
EHIOM 7 FACE_ALTERNATE_LAST
EHIOM 2 FACE_ALTERNATE_LAST
EHIOM 6 FACE_ALTERNATE_LAST

ADIC 8 FACE_HALF
ADIC 10 FACE_HALF
ADIC 4 FACE_HALF

$moves
MOVE {EHIOM, DEH, ADIC} DEH
OR
    AND
        DEST Size == 7
        SRC Suit {HEARTS}
    AND
        SRC Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
        DESTSRC Rank descending
DRAW
PILE ANY DEH Empty
$win
PILE ALL DEH Empty
