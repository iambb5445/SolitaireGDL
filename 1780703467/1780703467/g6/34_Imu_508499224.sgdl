Imu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CIOWE 0 FACE_LAST
CIOWE 10 FACE_LAST
CIOWE 1 FACE_ALTERNATE_LAST
CIOWE 6 FACE_ALTERNATE_LAST

COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF

AKIT 10 FACE_HALF
AKIT 8 FACE_HALF
AKIT 7 FACE_HALF
AKIT 0 FACE_HALF

$moves
MOVE_STACK {COLUMN, AKIT} AKIT
DEST Size == 10
MOVE_STACK CIOWE CIOWE
AND
    OR
        DEST Empty
        SRCSTACK Suit alternate_color
    SRC Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
$win
AND
    OR
        PILE ALL AKIT Empty
        PILE ALL AKIT Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL CIOWE Empty
