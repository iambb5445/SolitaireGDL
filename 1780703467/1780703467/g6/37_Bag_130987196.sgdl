Bag
$cards
DECK 2 {SPADES, HEARTS}

$initial
ANE 1 FACE_LAST
ANE 6 FACE_LAST
ANE 7 FACE_LAST
ANE 0 FACE_LAST

COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALL
COLUMN 10 FACE_ALL

UCAIM 9 FACE_ALL
UCAIM 8 FACE_LAST
UCAIM 0 FACE_LAST

$moves
MOVE {COLUMN, UCAIM} UCAIM
AND
    DESTSRC Rank add_14
    OR
        DEST Size > 0
        DESTSRC Suit alternate_color
MOVE_STACK UCAIM ANE
SRCSTACK Suit match
MOVE_STACK COLUMN ANE
OR
    AND
        DEST Rank 1
        SRC Rank 1
    AND
        DESTSRC Suit match_color
        SRCSTACK Suit match_color
$win
PILE ALL UCAIM Empty
