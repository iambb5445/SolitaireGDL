Yel
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 3 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
