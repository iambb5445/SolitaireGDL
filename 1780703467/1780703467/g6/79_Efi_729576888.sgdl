Efi
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 15 ROTATE 3 U 2
COLUMN 9 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 1 FACE_LAST

TUIQIN 1 FACE_HALF

$moves
MOVE DRAW TUIQIN
OR
    AND
        DEST Size < 4
        DEST Empty
    AND
        SRC Suit {CLUBS, DIAMONDS, HEARTS}
        DEST Size > 2
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL TUIQIN Empty
    PILE ALL COLUMN Empty
