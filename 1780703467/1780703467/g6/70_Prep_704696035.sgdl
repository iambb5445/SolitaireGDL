Prep
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 6 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 10 FACE_HALF

BUICE 1 FACE_LAST
BUICE 7 FACE_LAST
BUICE 3 FACE_LAST
BUICE 8 FACE_LAST
BUICE 6 FACE_LAST
BUICE 1 FACE_LAST
BUICE 6 FACE_LAST

$moves
MOVE BUICE BUICE
OR
    AND
        DESTSRC Rank add_14
        DEST Rank K
    AND
        SRC Suit {HEARTS, CLUBS, DIAMONDS}
        DEST Size == 2
MOVE_STACK BUICE COLUMN
OR
    SRC Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
    AND
        SRCSTACK Suit alternate_color
        DEST Rank K
$win
PILE ALL COLUMN Empty
