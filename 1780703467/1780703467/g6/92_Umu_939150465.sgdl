Umu
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 4 DEAL {BRAIS, ACA, COLUMN, VAEBU, CRAESUV}
BRAIS 6 FACE_HALF
BRAIS 0 FACE_HALF
BRAIS 1 FACE_HALF
BRAIS 5 FACE_HALF
BRAIS 2 FACE_HALF
BRAIS 9 FACE_HALF
BRAIS 9 FACE_HALF

CRAESUV 8 FACE_HALF
CRAESUV 6 FACE_ALL
CRAESUV 4 FACE_ALL

COLUMN 1 FACE_ALL
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST

VAEBU 6 FACE_LAST
VAEBU 8 FACE_LAST
VAEBU 10 FACE_HALF
VAEBU 3 FACE_HALF

ACA 5 FACE_HALF
ACA 4 FACE_LAST

$moves
MOVE ACA VAEBU
SRC Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
MOVE_STACK {COLUMN, BRAIS, VAEBU, CRAESUV} VAEBU
OR
    AND
        DEST Size <= 0
        DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
    DEST Rank K
$win
PILE ALL COLUMN Empty
