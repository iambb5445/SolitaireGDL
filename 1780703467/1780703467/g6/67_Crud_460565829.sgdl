Crud
$cards
DECK 8 SPADES

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL

GREAPEJ 6 FACE_HALF
GREAPEJ 6 FACE_LAST
GREAPEJ 5 FACE_LAST
GREAPEJ 5 FACE_LAST

GAIZA 0 FACE_HALF
GAIZA 6 FACE_ALL
GAIZA 7 FACE_ALL
GAIZA 10 FACE_ALL
GAIZA 3 FACE_ALL
GAIZA 2 FACE_ALL
GAIZA 0 FACE_ALL
GAIZA 3 FACE_ALL
GAIZA 3 FACE_ALL
GAIZA 8 FACE_ALL

UCE 4 FACE_ALTERNATE_LAST

$moves
MOVE GREAPEJ UCE
AND
    OR
        SRC Suit {HEARTS, SPADES, DIAMONDS}
        DEST Rank K
    SRC Rank 1
MOVE {COLUMN, GAIZA} COLUMN
SRC Suit {CLUBS, DIAMONDS, HEARTS}
MOVE_STACK GREAPEJ GREAPEJ
SRCSTACK Rank descending
$win
OR
    PILE ALL GAIZA Empty
    PILE ALL COLUMN Empty
