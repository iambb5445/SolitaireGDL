Fema
$cards
DECK 1 {SPADES, CLUBS}

$initial
FRUIME 5 FACE_ALTERNATE_LAST
FRUIME 6 FACE_ALTERNATE_LAST
FRUIME 9 FACE_ALTERNATE_LAST
FRUIME 1 FACE_ALTERNATE_LAST
FRUIME 5 FACE_ALTERNATE_LAST

$moves
MOVE_STACK FRUIME FRUIME
AND
    OR
        SRCSTACK Size > 8
        DEST Suit {DIAMONDS}
    SRC Suit {HEARTS, SPADES}
$win
AND
    OR
        PILE ALL FRUIME Empty
        PILE ALL FRUIME Empty
    OR
        PILE ALL FRUIME Empty
        PILE ALL FRUIME Empty
