Stouk
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 61 DEAL COLUMN
COLUMN 0 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Rank equal
        SRCSTACK Suit match
    DESTSRC Suit match_color
$win
PILE ALL COLUMN Empty
