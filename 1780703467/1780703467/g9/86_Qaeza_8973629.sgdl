Qaeza
$cards
DECK 4 {SPADES, HEARTS}

$initial
HUTU 3 FACE_ALTERNATE_LAST
HUTU 2 FACE_ALTERNATE_LAST
HUTU 4 FACE_ALTERNATE_LAST
HUTU 7 FACE_HALF
HUTU 1 FACE_HALF
HUTU 0 FACE_HALF
HUTU 1 FACE_HALF
HUTU 5 FACE_HALF
HUTU 8 FACE_HALF
HUTU 7 FACE_HALF

COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_LAST

BALIQ 0 FACE_LAST
BALIQ 8 FACE_LAST
BALIQ 2 FACE_LAST
BALIQ 3 FACE_LAST
BALIQ 4 FACE_LAST
BALIQ 4 FACE_LAST
BALIQ 8 FACE_LAST

$moves
MOVE HUTU HUTU
DESTSRC Rank ascending
MOVE {BALIQ, COLUMN} COLUMN
DESTSRC Rank add_14
MOVE_STACK BALIQ {COLUMN, HUTU}
AND
    AND
        DESTSRC Suit match
        DESTSRC Suit match_color
    AND
        DEST Rank 1
        SRCSTACK Suit alternate_color
MOVE_STACK HUTU {COLUMN, BALIQ}
DEST Empty
$win
PILE ALL BALIQ Empty
