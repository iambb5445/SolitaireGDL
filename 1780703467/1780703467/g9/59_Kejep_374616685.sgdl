Kejep
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 47 DEAL COLUMN
COLUMN 4 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Suit match_color
        SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
    DEST Empty
DRAW
PILE ANY COLUMN Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
