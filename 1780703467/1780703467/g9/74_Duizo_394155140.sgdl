Duizo
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 42 DEAL {COLUMN, DOUBO}
COLUMN 7 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 6 FACE_HALF

DOUBO 9 FACE_HALF
DOUBO 7 FACE_LAST
DOUBO 8 FACE_LAST
DOUBO 7 FACE_LAST
DOUBO 6 FACE_LAST
DOUBO 1 FACE_LAST
DOUBO 2 FACE_LAST
DOUBO 1 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Suit {HEARTS, CLUBS}
        SRC Rank 1
    AND
        DESTSRC Suit alternate_color
        DESTSRC Suit alternate_color
MOVE_STACK {COLUMN, DOUBO} DOUBO
DEST Suit {HEARTS, CLUBS}
MOVE_STACK DOUBO COLUMN
AND
    SRC Rank K
    SRCSTACK Suit alternate_color
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DOUBO Empty
    AND
        PILE ALL DOUBO Empty
        PILE ALL DOUBO Empty
