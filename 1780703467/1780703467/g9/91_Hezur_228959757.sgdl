Hezur
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
OR
    DEST Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
    AND
        SRCSTACK Size >= 9
        SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
