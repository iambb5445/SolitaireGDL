Yuf
$cards
DECK 4 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 198 DEAL COLUMN
COLUMN 10 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
AND
    AND
        SRCSTACK Rank ascending
        DEST Empty
    SRC Suit {HEARTS, CLUBS, DIAMONDS}
    DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
