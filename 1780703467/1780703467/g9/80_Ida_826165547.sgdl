Ida
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 4 FACE_HALF

LAIME 1 FACE_ALTERNATE_LAST
LAIME 8 FACE_ALL
LAIME 7 FACE_ALL
LAIME 1 FACE_ALL
LAIME 9 FACE_ALL
LAIME 5 FACE_ALL
LAIME 7 FACE_ALL
LAIME 1 FACE_ALL
LAIME 3 FACE_ALL

OZEP 10 FACE_ALL
OZEP 3 FACE_ALL
OZEP 5 FACE_LAST
OZEP 4 FACE_LAST

ALO 3 FACE_HALF
ALO 5 FACE_HALF
ALO 4 FACE_HALF
ALO 8 FACE_HALF
ALO 3 FACE_HALF
ALO 4 FACE_HALF
ALO 6 FACE_HALF
ALO 2 FACE_HALF
ALO 1 FACE_HALF

$moves
MOVE {COLUMN, LAIME, OZEP} COLUMN
AND
    DESTSRC Suit match
    DESTSRC Rank add_14
MOVE_STACK COLUMN OZEP
OR
    DESTSRC Rank add_14
    AND
        SRCSTACK Suit match
        DESTSRC Rank ascending
$win
OR
    PILE ALL OZEP Empty
    AND
        PILE ALL OZEP Empty
        PILE ALL COLUMN Empty
