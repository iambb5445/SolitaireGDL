Saeqit
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 3 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

MAIZ 0 FACE_HALF
MAIZ 10 FACE_HALF

ZONEW 0 FACE_HALF
ZONEW 8 FACE_HALF
ZONEW 0 FACE_HALF

$moves
MOVE {COLUMN, ZONEW, MAIZ} MAIZ
OR
    AND
        DESTSRC Rank add_13
        DEST Size < 6
    AND
        DEST Size > 4
        SRC Suit {CLUBS, SPADES, HEARTS}
MOVE ZONEW COLUMN
DEST Empty
MOVE_STACK MAIZ {MAIZ, ZONEW, COLUMN}
DEST Size < 10
MOVE_STACK ZONEW COLUMN
AND
    DEST Empty
    DESTSRC Suit match_color
$win
PILE ALL MAIZ Empty
