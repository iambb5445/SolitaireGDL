Irour
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 1 2 U
COLUMN 8 FACE_LAST
COLUMN 5 FACE_LAST

ADAB 3 FACE_LAST
ADAB 2 FACE_ALL
ADAB 7 FACE_ALL

$moves
MOVE DRAW COLUMN
DEST Size > 5
MOVE_STACK COLUMN {ADAB, COLUMN}
OR
    DEST Suit {DIAMONDS, SPADES, CLUBS}
    SRCSTACK Suit match_color
$win
AND
    PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
