Stubo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 52 DEAL OVEP
OVEP 0 FACE_ALTERNATE_LAST
OVEP 10 FACE_ALTERNATE_LAST
OVEP 8 FACE_LAST
OVEP 2 FACE_LAST
OVEP 6 FACE_LAST

COLUMN 5 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 3 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    AND
        DEST Size < 3
        DEST Rank 1
    OR
        DEST Rank K
        DEST Suit {CLUBS}
MOVE OVEP OVEP
DESTSRC Suit match_color
DRAW
PILE ANY DRAW Size > 0
$win
OR
    PILE ALL OVEP Empty
    PILE ALL DRAW Empty
