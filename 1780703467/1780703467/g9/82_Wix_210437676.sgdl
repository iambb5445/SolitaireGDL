Wix
$cards
DECK 4 SPADES

$initial
RIOPAX 4 FACE_HALF
RIOPAX 1 FACE_HALF
RIOPAX 1 FACE_HALF
RIOPAX 2 FACE_HALF
RIOPAX 8 FACE_HALF

ORIOJ 2 FACE_ALL
ORIOJ 9 FACE_ALL
ORIOJ 1 FACE_ALL
ORIOJ 5 FACE_ALL
ORIOJ 1 FACE_ALL
ORIOJ 8 FACE_ALL
ORIOJ 6 FACE_ALL
ORIOJ 4 FACE_ALL

$moves
MOVE ORIOJ RIOPAX
OR
    AND
        DESTSRC Suit match
        SRC Rank 1
    AND
        DESTSRC Rank add_14
        SRC Rank 1
MOVE ORIOJ ORIOJ
OR
    AND
        DESTSRC Rank descending
        DEST Suit {DIAMONDS}
    AND
        DESTSRC Suit alternate_color
        DEST Suit {CLUBS}
$win
PILE ALL RIOPAX Empty
