Cral
$cards
DECK 8 SPADES

$initial
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 6 FACE_ALL

BRUIPO 7 FACE_HALF
BRUIPO 9 FACE_HALF
BRUIPO 8 FACE_HALF
BRUIPO 2 FACE_HALF
BRUIPO 5 FACE_HALF
BRUIPO 1 FACE_HALF
BRUIPO 8 FACE_HALF

ZAEFOF 3 FACE_LAST
ZAEFOF 8 FACE_LAST
ZAEFOF 8 FACE_LAST
ZAEFOF 7 FACE_LAST
ZAEFOF 6 FACE_LAST
ZAEFOF 4 FACE_LAST
ZAEFOF 0 FACE_LAST

$moves
MOVE COLUMN ZAEFOF
OR
    AND
        DEST Suit {SPADES, DIAMONDS}
        SRC Suit {SPADES, CLUBS, HEARTS}
    AND
        DESTSRC Suit alternate_color
        DEST Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL BRUIPO Empty
