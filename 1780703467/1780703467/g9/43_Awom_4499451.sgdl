Awom
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 76 DEAL COLUMN
OBI 4 FACE_ALTERNATE_LAST
OBI 6 FACE_ALTERNATE_LAST
OBI 6 FACE_ALTERNATE_LAST
OBI 4 FACE_ALTERNATE_LAST
OBI 3 FACE_ALTERNATE_LAST
OBI 3 FACE_ALTERNATE_LAST
OBI 2 FACE_ALTERNATE_LAST

$moves
MOVE OBI OBI
OR
    AND
        DESTSRC Suit match_color
        SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
    DEST Empty
DRAW
PILE ANY OBI Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL OBI Empty
