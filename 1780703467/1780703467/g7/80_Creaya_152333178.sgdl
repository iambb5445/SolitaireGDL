Creaya
$cards
DECK 4 SPADES

$initial
DRAW 9 DEAL COLUMN
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 5 FACE_ALL

$moves
MOVE COLUMN COLUMN
SRC Suit {CLUBS, SPADES}
MOVE_STACK COLUMN COLUMN
AND
    AND
        SRCSTACK Suit match
        DEST Empty
    DESTSRC Suit match_color
DRAW
PILE ANY COLUMN Size > 0
$win
OR
    PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
