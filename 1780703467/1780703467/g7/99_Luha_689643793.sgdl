Luha
$cards
DECK 8 SPADES

$initial
DRAW 34 DEAL ODIG
COLUMN 2 FACE_ALL

ODIG 9 FACE_HALF
ODIG 0 FACE_HALF
ODIG 6 FACE_HALF
ODIG 7 FACE_HALF
ODIG 7 FACE_HALF
ODIG 10 FACE_HALF
ODIG 9 FACE_HALF
ODIG 8 FACE_HALF
ODIG 5 FACE_HALF
ODIG 7 FACE_ALTERNATE_LAST

$moves
MOVE_STACK ODIG {ODIG, COLUMN}
AND
    SRC Rank K
    AND
        SRC Suit {CLUBS, DIAMONDS}
        DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE_STACK COLUMN COLUMN
DEST Suit {SPADES, HEARTS, DIAMONDS, CLUBS}
DRAW
PILE ANY ODIG Size > 0
$win
AND
    OR
        PILE ALL ODIG Empty
        PILE ALL DRAW Empty
    PILE ALL DRAW Empty
