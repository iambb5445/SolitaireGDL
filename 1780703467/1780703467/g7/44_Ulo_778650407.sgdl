Ulo
$cards
DECK 2 {SPADES, CLUBS}

$initial
VUIBU 4 FACE_LAST
VUIBU 10 FACE_LAST
VUIBU 9 FACE_LAST
VUIBU 2 FACE_LAST
VUIBU 8 FACE_LAST
VUIBU 5 FACE_LAST
VUIBU 7 FACE_HALF

COLUMN 7 FACE_ALL

$moves
MOVE_STACK COLUMN VUIBU
DESTSRC Suit alternate_color
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL VUIBU Empty
