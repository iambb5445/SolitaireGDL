Acu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 28 ROTATE 1 U 3
UNIOB 6 FACE_HALF
UNIOB 1 FACE_HALF
UNIOB 9 FACE_HALF
UNIOB 0 FACE_HALF
UNIOB 8 FACE_HALF

$moves
MOVE UNIOB UNIOB
SRC Suit {SPADES}
MOVE DRAW UNIOB
OR
    AND
        DESTSRC Rank add_14
        DEST Size > 8
    AND
        DEST Empty
        SRC Rank 1
MOVE_STACK UNIOB UNIOB
DEST Suit {HEARTS}
$win
AND
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL DRAW Empty
