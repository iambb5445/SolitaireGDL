Ufel
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 64 ROTATE 1 2 U
COLUMN 8 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 1 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE_STACK COLUMN COLUMN
OR
    SRC Rank K
    SRC Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    PILE ALL DRAW Empty
