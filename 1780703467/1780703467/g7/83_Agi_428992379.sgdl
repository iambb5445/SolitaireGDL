Agi
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 2 DEAL {QIORU, AYOX, OBET}
QIORU 0 FACE_LAST
QIORU 4 FACE_ALTERNATE_LAST
QIORU 5 FACE_ALTERNATE_LAST
QIORU 5 FACE_ALTERNATE_LAST
QIORU 3 FACE_ALTERNATE_LAST

OBET 0 FACE_ALL
OBET 1 FACE_LAST
OBET 5 FACE_LAST
OBET 1 FACE_LAST
OBET 6 FACE_LAST

AYOX 9 FACE_HALF
AYOX 0 FACE_HALF
AYOX 1 FACE_ALTERNATE_LAST

OGA 10 FACE_LAST

$moves
MOVE OBET AYOX
DESTSRC Rank equal
MOVE OBET {QIORU, OBET, OGA}
AND
    DEST Rank 1
    AND
        DEST Empty
        DESTSRC Suit alternate_color
MOVE_STACK {QIORU, OBET, OGA} QIORU
SRCSTACK Suit match
MOVE_STACK OGA {OBET, OGA}
SRCSTACK Size <= 5
DRAW
PILE ALL DRAW Size > 0
$win
PILE ALL AYOX Empty
