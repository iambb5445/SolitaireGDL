Rude
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 6 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 5 FACE_LAST

$moves
MOVE COLUMN COLUMN
DEST Suit {SPADES, DIAMONDS}
MOVE_STACK COLUMN COLUMN
OR
    SRC Rank K
    AND
        SRC Suit {SPADES, DIAMONDS}
        SRCSTACK Size < 0
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
