Paewi
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 80 ROTATE 3 U 2
COLUMN 0 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 3 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 1 FACE_LAST

$moves
MOVE DRAW COLUMN
OR
    DEST Size <= 8
    DESTSRC Rank add_14
MOVE COLUMN COLUMN
DEST Suit {CLUBS, DIAMONDS, SPADES}
MOVE_STACK COLUMN COLUMN
SRCSTACK Rank ascending
$win
PILE ALL DRAW Empty
