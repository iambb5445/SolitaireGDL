Touw
$cards
DECK 2 {SPADES, CLUBS}

$initial
TRIOYO 10 FACE_ALL
TRIOYO 8 FACE_ALL
TRIOYO 4 FACE_ALL
TRIOYO 7 FACE_ALL
TRIOYO 4 FACE_ALL
TRIOYO 7 FACE_ALTERNATE_LAST
TRIOYO 5 FACE_ALTERNATE_LAST
TRIOYO 6 FACE_ALTERNATE_LAST

STABAN 1 FACE_ALTERNATE_LAST

$moves
MOVE TRIOYO STABAN
AND
    DEST Suit {CLUBS, HEARTS, DIAMONDS}
    AND
        SRC Rank 1
        DEST Empty
MOVE STABAN STABAN
SRC Suit {HEARTS}
MOVE_STACK STABAN STABAN
OR
    AND
        SRC Rank K
        SRCSTACK Size < 9
    SRCSTACK Suit match
MOVE_STACK {STABAN, TRIOYO} TRIOYO
DEST Suit {CLUBS, HEARTS}
$win
OR
    PILE ALL STABAN Empty
    PILE ALL TRIOYO Empty
