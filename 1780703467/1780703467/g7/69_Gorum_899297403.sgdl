Gorum
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
USAEQ 8 FACE_ALL
USAEQ 6 FACE_ALL
USAEQ 1 FACE_ALL
USAEQ 10 FACE_ALL
USAEQ 2 FACE_ALL
USAEQ 0 FACE_ALL

ZIOTUC 4 FACE_LAST
ZIOTUC 10 FACE_LAST
ZIOTUC 0 FACE_LAST
ZIOTUC 4 FACE_LAST
ZIOTUC 9 FACE_LAST
ZIOTUC 4 FACE_LAST
ZIOTUC 7 FACE_LAST
ZIOTUC 7 FACE_LAST

TRUIPUH 6 FACE_HALF

COLUMN 3 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 1 FACE_ALL

$moves
MOVE {COLUMN, USAEQ, ZIOTUC} ZIOTUC
DESTSRC Rank add_14
MOVE_STACK ZIOTUC {TRUIPUH, USAEQ, ZIOTUC}
AND
    OR
        DEST Rank K
        DEST Suit {SPADES}
    OR
        DEST Suit {DIAMONDS, HEARTS}
        SRC Suit {SPADES, HEARTS, CLUBS}
MOVE_STACK COLUMN {ZIOTUC, USAEQ}
SRCSTACK Suit alternate_color
$win
OR
    PILE ALL TRUIPUH Empty
    AND
        PILE ALL USAEQ Empty
        PILE ALL COLUMN Empty
