Trizug
$cards
DECK 2 {SPADES, HEARTS}

$initial
ULAF 5 FACE_ALTERNATE_LAST
ULAF 8 FACE_ALTERNATE_LAST
ULAF 1 FACE_ALTERNATE_LAST

UXEAN 0 FACE_LAST
UXEAN 7 FACE_LAST
UXEAN 6 FACE_LAST
UXEAN 4 FACE_LAST
UXEAN 2 FACE_LAST
UXEAN 9 FACE_LAST
UXEAN 1 FACE_LAST
UXEAN 8 FACE_LAST
UXEAN 1 FACE_LAST

$moves
MOVE_STACK UXEAN ULAF
AND
    DEST Suit {SPADES, DIAMONDS, CLUBS}
    AND
        DESTSRC Rank equal
        SRC Rank K
MOVE_STACK UXEAN UXEAN
OR
    AND
        SRCSTACK Size > 5
        DESTSRC Suit match
    DESTSRC Rank equal
$win
PILE ALL UXEAN Empty
