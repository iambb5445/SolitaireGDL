Upeg
$cards
DECK 2 {SPADES, HEARTS}

$initial
EFEAZ 9 FACE_HALF
EFEAZ 7 FACE_HALF
EFEAZ 0 FACE_HALF
EFEAZ 3 FACE_HALF

TROFUS 5 FACE_LAST
TROFUS 4 FACE_LAST
TROFUS 8 FACE_LAST
TROFUS 7 FACE_LAST
TROFUS 5 FACE_LAST
TROFUS 4 FACE_LAST
TROFUS 0 FACE_LAST

$moves
MOVE EFEAZ {TROFUS, EFEAZ}
OR
    DESTSRC Suit match
    AND
        DESTSRC Suit alternate_color
        DEST Rank K
MOVE_STACK TROFUS EFEAZ
OR
    SRCSTACK Rank add_14
    AND
        DEST Empty
        DESTSRC Rank descending
MOVE_STACK EFEAZ TROFUS
DEST Rank 1
$win
PILE ALL TROFUS Empty
