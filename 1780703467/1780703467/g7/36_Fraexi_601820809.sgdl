Fraexi
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 20 DEAL GRIOR
GRIOR 4 FACE_LAST

LAIV 3 FACE_HALF
LAIV 9 FACE_HALF
LAIV 8 FACE_HALF
LAIV 8 FACE_HALF

$moves
MOVE {LAIV, GRIOR} GRIOR
AND
    DESTSRC Rank add_14
    OR
        DESTSRC Rank add_13
        DEST Suit {SPADES, DIAMONDS, CLUBS}
MOVE_STACK LAIV GRIOR
SRC Suit {DIAMONDS, SPADES, HEARTS}
$win
AND
    OR
        PILE ALL LAIV Empty
        PILE ALL DRAW Empty
    OR
        PILE ALL GRIOR Empty
        PILE ALL DRAW Empty
