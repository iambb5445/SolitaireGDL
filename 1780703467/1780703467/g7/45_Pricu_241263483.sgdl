Pricu
$cards
DECK 1 {SPADES, CLUBS}

$initial
GRAEGU 4 FACE_ALL
GRAEGU 8 FACE_ALL
GRAEGU 7 FACE_ALTERNATE_LAST
GRAEGU 5 FACE_ALTERNATE_LAST
GRAEGU 2 FACE_ALTERNATE_LAST

$moves
MOVE GRAEGU GRAEGU
DESTSRC Suit alternate_color
MOVE_STACK GRAEGU GRAEGU
OR
    AND
        DEST Size < 1
        SRCSTACK Rank add_14
    AND
        SRCSTACK Rank add_14
        DEST Size <= 1
$win
OR
    PILE ALL GRAEGU Empty
    PILE ALL GRAEGU Empty
