Ato
$cards
DECK 4 SPADES

$initial
COLUMN 10 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 8 FACE_ALL

PRUIBI 3 FACE_LAST
PRUIBI 1 FACE_LAST
PRUIBI 8 FACE_LAST
PRUIBI 5 FACE_LAST
PRUIBI 2 FACE_LAST

$moves
MOVE COLUMN PRUIBI
AND
    SRC Suit {HEARTS, SPADES, DIAMONDS}
    AND
        DESTSRC Rank ascending
        SRC Rank 1
MOVE_STACK {PRUIBI, COLUMN} PRUIBI
SRC Rank 1
$win
PILE ALL PRUIBI Empty
