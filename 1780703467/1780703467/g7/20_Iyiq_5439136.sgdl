Iyiq
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 88 DEAL COLUMN
COLUMN 0 FACE_HALF

ODA 4 FACE_LAST
ODA 3 FACE_ALTERNATE_LAST
ODA 1 FACE_ALTERNATE_LAST
ODA 4 FACE_ALTERNATE_LAST
ODA 1 FACE_ALTERNATE_LAST

VAECUX 0 FACE_ALL
VAECUX 1 FACE_LAST

DROZER 2 FACE_LAST
DROZER 0 FACE_ALL

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
