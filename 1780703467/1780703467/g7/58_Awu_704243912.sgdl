$moves
MOVE COLUMN KIWE
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank add_14
        DEST Empty
MOVE COLUMN COLUMN
AND
    AND
        SRC Rank 1
        DEST Empty
    AND
        DEST Rank K
        SRC Rank K
MOVE_STACK {COLUMN, KIWE} KIWE
DEST Rank 1
MOVE_STACK KIWE COLUMN
OR
    AND
        SRC Rank K
        SRCSTACK Rank add_14
    DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
DRAW
PILE ANY KIWE Empty
$win
PILE ALL KIWE Empty
