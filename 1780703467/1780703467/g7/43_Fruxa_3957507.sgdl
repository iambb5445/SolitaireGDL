Fruxa
$cards
DECK 8 SPADES

$initial
DRAW 30 DEAL {STAIJI, IKO}
STAIJI 1 FACE_ALL
STAIJI 7 FACE_ALL
STAIJI 3 FACE_ALL
STAIJI 7 FACE_ALL
STAIJI 10 FACE_ALL
STAIJI 1 FACE_HALF
STAIJI 10 FACE_HALF
STAIJI 7 FACE_HALF

IKO 6 FACE_LAST
IKO 5 FACE_LAST
IKO 7 FACE_LAST
IKO 10 FACE_ALTERNATE_LAST

$moves
MOVE STAIJI STAIJI
AND
    DESTSRC Rank add_13
    OR
        DEST Size == 7
        DEST Suit {HEARTS, DIAMONDS}
DRAW
PILE ANY IKO Size > 0
$win
AND
    PILE ALL IKO Empty
    AND
        PILE ALL IKO Empty
        PILE ALL DRAW Empty
