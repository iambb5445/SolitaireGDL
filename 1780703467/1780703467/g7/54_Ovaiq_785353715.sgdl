Ovaiq
$cards
DECK 2 {SPADES, CLUBS}

$initial
APEAY 2 FACE_LAST
APEAY 8 FACE_LAST
APEAY 4 FACE_LAST
APEAY 8 FACE_LAST

SAELU 4 FACE_ALTERNATE_LAST
SAELU 6 FACE_ALTERNATE_LAST
SAELU 0 FACE_ALTERNATE_LAST
SAELU 0 FACE_ALTERNATE_LAST
SAELU 0 FACE_ALTERNATE_LAST
SAELU 0 FACE_ALTERNATE_LAST
SAELU 10 FACE_ALTERNATE_LAST
SAELU 8 FACE_LAST
SAELU 1 FACE_LAST
SAELU 1 FACE_LAST

$moves
MOVE_STACK SAELU APEAY
OR
    DESTSRC Suit match
    SRCSTACK Suit match_color
MOVE_STACK SAELU SAELU
OR
    SRCSTACK Size == 1
    AND
        DESTSRC Rank descending
        DEST Suit {HEARTS}
$win
OR
    AND
        PILE ALL APEAY Empty
        PILE ALL SAELU Empty
    AND
        PILE ALL APEAY Empty
        PILE ALL APEAY Empty
