Crixo
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 7 FACE_ALL
COLUMN 9 FACE_LAST
COLUMN 2 FACE_LAST

DAIKAR 6 FACE_LAST
DAIKAR 10 FACE_LAST
DAIKAR 6 FACE_LAST
DAIKAR 6 FACE_LAST
DAIKAR 6 FACE_LAST
DAIKAR 8 FACE_LAST
DAIKAR 9 FACE_LAST

GRAEMI 4 FACE_ALL
GRAEMI 6 FACE_ALL
GRAEMI 1 FACE_HALF

OSU 1 FACE_LAST
OSU 9 FACE_LAST
OSU 5 FACE_LAST
OSU 8 FACE_HALF
OSU 1 FACE_HALF

$moves
MOVE {OSU, GRAEMI, DAIKAR, COLUMN} COLUMN
OR
    AND
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
        DESTSRC Suit alternate_color
    AND
        SRC Suit {DIAMONDS, HEARTS}
        DEST Size == 4
MOVE_STACK OSU COLUMN
DEST Size > 3
MOVE_STACK {DAIKAR, COLUMN} GRAEMI
SRCSTACK Suit match
$win
OR
    AND
        PILE ALL OSU Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL OSU Empty
        PILE ALL COLUMN Empty
