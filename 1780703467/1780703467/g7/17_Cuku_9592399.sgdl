Cuku
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 20 DEAL GRIOR
GRIOR 4 FACE_LAST

LAIV 3 FACE_HALF
LAIV 9 FACE_HALF
LAIV 8 FACE_HALF
LAIV 8 FACE_HALF

$moves
MOVE {LAIV, GRIOR} GRIOR
OR
    DEST Rank K
    DEST Suit {SPADES, DIAMONDS, CLUBS}
MOVE_STACK LAIV GRIOR
SRC Suit {DIAMONDS, SPADES, HEARTS}
MOVE_STACK LAIV LAIV
OR
    AND
        DEST Empty
        DEST Empty
    DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
$win
AND
    OR
        PILE ALL LAIV Empty
        PILE ALL DRAW Empty
    OR
        PILE ALL GRIOR Empty
        PILE ALL DRAW Empty
