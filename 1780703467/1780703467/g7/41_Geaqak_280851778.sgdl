Geaqak
$cards
DECK 4 {SPADES, HEARTS}

$initial
VAIVU 7 FACE_ALL
VAIVU 4 FACE_ALL
VAIVU 0 FACE_ALL
VAIVU 0 FACE_ALL
VAIVU 10 FACE_ALL
VAIVU 7 FACE_ALL
VAIVU 7 FACE_ALL
VAIVU 0 FACE_ALL

QEAMO 8 FACE_ALTERNATE_LAST
QEAMO 4 FACE_ALTERNATE_LAST
QEAMO 10 FACE_ALL
QEAMO 5 FACE_ALL
QEAMO 7 FACE_ALL
QEAMO 7 FACE_ALL

BEAGA 0 FACE_HALF
BEAGA 1 FACE_HALF
BEAGA 4 FACE_HALF
BEAGA 6 FACE_HALF
BEAGA 8 FACE_HALF
BEAGA 2 FACE_HALF
BEAGA 5 FACE_HALF
BEAGA 2 FACE_ALL

$moves
MOVE QEAMO {QEAMO, BEAGA}
DEST Size == 7
MOVE {BEAGA, VAIVU} BEAGA
OR
    DESTSRC Rank add_13
    DEST Rank K
MOVE_STACK {QEAMO, BEAGA} VAIVU
OR
