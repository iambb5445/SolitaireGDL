Une
$cards
DECK 8 SPADES

$initial
COLUMN 8 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 10 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 7 FACE_LAST

STIODE 1 FACE_ALL
STIODE 10 FACE_ALL
STIODE 5 FACE_LAST
STIODE 7 FACE_LAST
STIODE 5 FACE_LAST
STIODE 10 FACE_LAST

WELOK 1 FACE_ALL
WELOK 5 FACE_ALL
WELOK 9 FACE_HALF
WELOK 6 FACE_HALF

$moves
MOVE STIODE STIODE
OR
    AND
        DEST Empty
        DEST Suit {CLUBS, SPADES}
    DEST Suit {DIAMONDS, SPADES}
MOVE_STACK {STIODE, COLUMN, WELOK} COLUMN
OR
    DEST Empty
    AND
        DESTSRC Suit match_color
        DESTSRC Suit match
$win
PILE ALL COLUMN Empty
