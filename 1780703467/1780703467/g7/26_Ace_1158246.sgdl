Ace
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE COLUMN COLUMN
OR
    DEST Rank 1
    AND
        DEST Suit {SPADES, DIAMONDS, CLUBS}
        DEST Suit {SPADES, DIAMONDS, HEARTS}
    DEST Empty
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
