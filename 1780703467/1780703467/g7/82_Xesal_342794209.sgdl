Xesal
$cards
DECK 2 {SPADES, HEARTS}

$initial
JULOV 1 FACE_LAST
JULOV 10 FACE_LAST
JULOV 1 FACE_LAST
JULOV 2 FACE_LAST
JULOV 9 FACE_LAST
JULOV 5 FACE_LAST
JULOV 8 FACE_LAST

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DEST Empty
    DEST Rank 1
MOVE {JULOV, COLUMN} JULOV
OR
    AND
        DESTSRC Rank ascending
        DEST Rank K
    AND
        DEST Size > 9
        DEST Empty
MOVE_STACK COLUMN JULOV
SRC Suit {HEARTS}
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL JULOV Empty
        PILE ALL COLUMN Empty
