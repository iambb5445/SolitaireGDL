Ekaiv
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 2 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    DEST Empty
    SRC Suit {SPADES, DIAMONDS}
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
