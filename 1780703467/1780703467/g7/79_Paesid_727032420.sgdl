Paesid
$cards
DECK 1 {SPADES, HEARTS}

$initial
DRAW 11 ROTATE 1 U 3
COLUMN 1 FACE_HALF
COLUMN 4 FACE_HALF

DAEF 3 FACE_ALTERNATE_LAST
DAEF 1 FACE_ALTERNATE_LAST
DAEF 6 FACE_ALL

$moves
MOVE DAEF {DAEF, COLUMN}
AND
    AND
        DESTSRC Suit match
        DEST Suit {HEARTS, DIAMONDS}
    OR
        DEST Empty
        DEST Empty
MOVE_STACK {DAEF, COLUMN} COLUMN
AND
    DEST Rank K
    OR
        DESTSRC Suit match
        DESTSRC Rank ascending
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL DAEF Empty
