Udo
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DEST Size >= 1
    AND
        DESTSRC Rank add_14
        DEST Empty
$win
PILE ALL COLUMN Empty
