Onub
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 69 ROTATE 3 U 2
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE DRAW COLUMN
OR
    AND
        SRC Suit {SPADES}
        DESTSRC Suit match
    DESTSRC Suit match
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
