Maido
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
XEAL 4 FACE_ALL
XEAL 0 FACE_ALL
XEAL 3 FACE_ALL
XEAL 5 FACE_ALL
XEAL 3 FACE_ALL
XEAL 4 FACE_HALF
XEAL 6 FACE_HALF

OZOUT 3 FACE_ALTERNATE_LAST
OZOUT 9 FACE_ALTERNATE_LAST
OZOUT 6 FACE_LAST
OZOUT 7 FACE_LAST

COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

BRIQIC 7 FACE_ALL
BRIQIC 0 FACE_HALF

$moves
MOVE {XEAL, BRIQIC} XEAL
AND
    AND
        DESTSRC Suit alternate_color
        DEST Rank 1
    DEST Suit {HEARTS}
MOVE BRIQIC OZOUT
OR
    AND
        DESTSRC Suit match_color
        SRC Suit {HEARTS, CLUBS}
    AND
        DEST Rank 1
        DEST Suit {CLUBS, DIAMONDS, HEARTS}
$win
OR
    AND
        PILE ALL BRIQIC Empty
        PILE ALL COLUMN Empty
    PILE ALL BRIQIC Empty
