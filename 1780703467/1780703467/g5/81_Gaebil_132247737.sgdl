Gaebil
$cards
DECK 8 SPADES

$initial
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 0 FACE_HALF

OKU 10 FACE_LAST
OKU 7 FACE_LAST
OKU 3 FACE_LAST
OKU 5 FACE_ALL
OKU 7 FACE_ALL
OKU 1 FACE_ALL
OKU 5 FACE_ALL
OKU 7 FACE_ALL
OKU 1 FACE_ALL
OKU 8 FACE_ALL

HORO 8 FACE_ALTERNATE_LAST
HORO 3 FACE_ALTERNATE_LAST
HORO 3 FACE_ALTERNATE_LAST
HORO 8 FACE_ALTERNATE_LAST
HORO 8 FACE_ALTERNATE_LAST
HORO 7 FACE_ALTERNATE_LAST
HORO 6 FACE_ALTERNATE_LAST
HORO 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN HORO
AND
    SRC Rank K
    DESTSRC Suit match_color
MOVE_STACK {OKU, COLUMN, HORO} HORO
AND
    SRCSTACK Size == 4
    AND
        SRCSTACK Rank add_14
        DESTSRC Suit match
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL HORO Empty
    PILE ALL HORO Empty
