Kaifa
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 34 DEAL COLUMN
COLUMN 10 FACE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

STIX 5 FACE_ALL
STIX 3 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Suit {DIAMONDS, HEARTS, SPADES}
        SRC Rank K
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank add_14
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL STIX Empty
