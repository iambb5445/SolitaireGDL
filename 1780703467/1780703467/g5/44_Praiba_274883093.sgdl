Praiba
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 15 ROTATE 3 U 2
COLUMN 3 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 9 FACE_LAST

$moves
MOVE COLUMN COLUMN
SRC Rank 1
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Suit {HEARTS, DIAMONDS, SPADES}
        SRCSTACK Rank descending
    AND
        SRCSTACK Size >= 1
        DEST Rank K
$win
PILE ALL COLUMN Empty
