Jouc
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
MOVUW 0 FACE_LAST
MOVUW 6 FACE_LAST
MOVUW 9 FACE_LAST
MOVUW 5 FACE_LAST
MOVUW 2 FACE_LAST
MOVUW 9 FACE_LAST
MOVUW 5 FACE_LAST
MOVUW 4 FACE_LAST
MOVUW 0 FACE_LAST
MOVUW 4 FACE_LAST

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

HAEL 1 FACE_HALF
HAEL 1 FACE_HALF
HAEL 7 FACE_LAST
HAEL 7 FACE_LAST
HAEL 8 FACE_LAST
HAEL 4 FACE_LAST

$moves
MOVE COLUMN MOVUW
OR
    AND
        DESTSRC Rank descending
        SRC Suit {SPADES, HEARTS}
    AND
        DEST Rank 1
        DESTSRC Rank equal
MOVE COLUMN COLUMN
AND
    DEST Rank 1
    AND
        DESTSRC Rank add_13
        DESTSRC Suit match
$win
OR
    PILE ALL MOVUW Empty
    PILE ALL HAEL Empty
