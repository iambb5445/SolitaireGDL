Ajo
$cards
DECK 1 {SPADES, HEARTS}

$initial
OVEAZ 0 FACE_HALF
OVEAZ 1 FACE_ALTERNATE_LAST
OVEAZ 2 FACE_ALTERNATE_LAST
OVEAZ 10 FACE_ALTERNATE_LAST
OVEAZ 0 FACE_ALTERNATE_LAST
OVEAZ 7 FACE_ALTERNATE_LAST
OVEAZ 5 FACE_ALTERNATE_LAST

HAJAN 1 FACE_HALF

$moves
MOVE HAJAN HAJAN
AND
    OR
        DEST Size > 7
        DEST Size >= 3
    DEST Empty
MOVE {HAJAN, OVEAZ} OVEAZ
DEST Empty
$win
OR
    PILE ALL OVEAZ Empty
    PILE ALL OVEAZ Empty
