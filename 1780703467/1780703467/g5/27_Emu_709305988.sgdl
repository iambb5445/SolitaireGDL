Emu
$cards
DECK 1 {SPADES, CLUBS}

$initial
BUIPI 6 FACE_ALTERNATE_LAST
BUIPI 8 FACE_HALF
BUIPI 0 FACE_HALF
BUIPI 6 FACE_HALF
BUIPI 1 FACE_HALF

COLUMN 5 FACE_LAST

$moves
MOVE COLUMN COLUMN
DESTSRC Suit match
MOVE BUIPI {COLUMN, BUIPI}
OR
    AND
        DEST Empty
        DEST Suit {SPADES, CLUBS, HEARTS, DIAMONDS}
    DEST Empty
$win
PILE ALL COLUMN Empty
