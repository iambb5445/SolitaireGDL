Iyuih
$cards
DECK 8 SPADES

$initial
DRAW 63 ROTATE 3 U 1
GUIBUY 8 FACE_LAST
GUIBUY 7 FACE_LAST
GUIBUY 0 FACE_LAST
GUIBUY 4 FACE_LAST
GUIBUY 3 FACE_LAST
GUIBUY 0 FACE_ALTERNATE_LAST
GUIBUY 3 FACE_ALTERNATE_LAST
GUIBUY 8 FACE_ALTERNATE_LAST
GUIBUY 8 FACE_ALTERNATE_LAST

$moves
MOVE GUIBUY GUIBUY
DESTSRC Suit match
MOVE DRAW GUIBUY
DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
MOVE_STACK GUIBUY GUIBUY
OR
    AND
        DEST Empty
        DEST Suit {DIAMONDS, HEARTS, CLUBS}
    AND
        SRC Rank K
        DEST Rank K
$win
PILE ALL GUIBUY Empty
