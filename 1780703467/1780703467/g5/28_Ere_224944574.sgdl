Ere
$cards
DECK 4 {SPADES, HEARTS}

$initial
STAITIJ 4 FACE_HALF

VUF 10 FACE_ALTERNATE_LAST
VUF 9 FACE_LAST
VUF 2 FACE_LAST
VUF 9 FACE_LAST
VUF 10 FACE_LAST
VUF 7 FACE_LAST
VUF 5 FACE_LAST
VUF 0 FACE_LAST

OPAIX 7 FACE_LAST
OPAIX 8 FACE_LAST
OPAIX 8 FACE_LAST
OPAIX 2 FACE_LAST
OPAIX 1 FACE_LAST
OPAIX 0 FACE_LAST
OPAIX 0 FACE_LAST
OPAIX 9 FACE_LAST

WURIN 1 FACE_ALL

COLUMN 4 FACE_ALL
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE WURIN OPAIX
AND
    OR
        DEST Size <= 6
        DEST Size >= 7
    OR
        DESTSRC Suit match_color
        DEST Empty
MOVE_STACK {STAITIJ, OPAIX, WURIN} VUF
OR
    DEST Suit {DIAMONDS, SPADES, CLUBS}
    SRCSTACK Rank ascending
MOVE_STACK OPAIX OPAIX
AND
    OR
        SRC Rank K
        DEST Size > 5
    DESTSRC Suit match
$win
PILE ALL VUF Empty
