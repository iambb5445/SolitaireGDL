Cuim
$cards
DECK 1 {SPADES, HEARTS}

$initial
PRAIR 7 FACE_ALTERNATE_LAST
PRAIR 5 FACE_ALTERNATE_LAST
PRAIR 3 FACE_ALTERNATE_LAST
PRAIR 6 FACE_ALTERNATE_LAST
PRAIR 5 FACE_ALL

$moves
MOVE_STACK PRAIR PRAIR
AND
    DEST Suit {HEARTS, DIAMONDS}
    OR
        DEST Size == 10
        DEST Empty
$win
PILE ALL PRAIR Empty
