Brexad
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 8 DEAL COLUMN
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 4 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Size == 3
        DESTSRC Rank equal
    AND
        SRC Suit {SPADES, DIAMONDS, CLUBS}
        DEST Size >= 3
DRAW
PILE ALL DRAW Size > 0
$win
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty
