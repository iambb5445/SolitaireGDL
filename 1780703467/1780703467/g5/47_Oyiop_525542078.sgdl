Oyiop
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 7 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF

TAEYEN 2 FACE_HALF
TAEYEN 6 FACE_HALF
TAEYEN 0 FACE_HALF
TAEYEN 6 FACE_HALF
TAEYEN 6 FACE_HALF
TAEYEN 6 FACE_HALF
TAEYEN 0 FACE_HALF
TAEYEN 9 FACE_HALF
TAEYEN 2 FACE_HALF

TIZ 8 FACE_ALTERNATE_LAST
TIZ 8 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Empty
        DEST Empty
    AND
        DEST Rank 1
        SRC Rank K
MOVE TIZ {TIZ, TAEYEN, COLUMN}
DEST Size > 7
MOVE_STACK COLUMN TAEYEN
OR
    SRC Rank K
    AND
        DESTSRC Rank add_14
        SRC Rank 1
MOVE_STACK {TIZ, TAEYEN, COLUMN} TIZ
DEST Rank 1
$win
OR
    PILE ALL TIZ Empty
    PILE ALL COLUMN Empty
