Raixa
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 4 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 1 FACE_HALF

ICE 7 FACE_LAST
ICE 4 FACE_LAST
ICE 4 FACE_LAST
ICE 0 FACE_LAST
ICE 10 FACE_LAST

DREVOS 7 FACE_HALF
DREVOS 6 FACE_HALF

$moves
MOVE_STACK COLUMN DREVOS
OR
    AND
        SRCSTACK Size <= 0
        DEST Rank K
    AND
        DEST Suit {SPADES}
        SRCSTACK Rank descending
MOVE_STACK {DREVOS, ICE} DREVOS
SRCSTACK Rank ascending
$win
AND
    PILE ALL ICE Empty
    OR
        PILE ALL ICE Empty
        PILE ALL DREVOS Empty
