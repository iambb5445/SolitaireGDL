Joxu
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 3 DEAL {COLUMN, TEAC}
COLUMN 3 FACE_LAST

TEAC 7 FACE_ALTERNATE_LAST
TEAC 9 FACE_ALTERNATE_LAST
TEAC 7 FACE_ALTERNATE_LAST
TEAC 6 FACE_ALTERNATE_LAST
TEAC 3 FACE_ALTERNATE_LAST
TEAC 4 FACE_ALL
TEAC 0 FACE_ALL
TEAC 3 FACE_ALL
TEAC 7 FACE_ALL

$moves
MOVE {TEAC, COLUMN} TEAC
AND
    OR
        DEST Suit {CLUBS}
        DEST Rank 1
    DEST Suit {DIAMONDS}
DRAW
PILE ANY DRAW Size > 0
$win
PILE ALL COLUMN Empty
