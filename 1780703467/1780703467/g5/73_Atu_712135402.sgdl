Atu
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 2 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 9 FACE_ALL

ZIOGE 0 FACE_LAST
ZIOGE 6 FACE_LAST
ZIOGE 3 FACE_LAST
ZIOGE 2 FACE_LAST
ZIOGE 8 FACE_LAST
ZIOGE 2 FACE_LAST
ZIOGE 6 FACE_LAST
ZIOGE 1 FACE_LAST

JUIWE 1 FACE_ALTERNATE_LAST
JUIWE 3 FACE_ALTERNATE_LAST
JUIWE 8 FACE_HALF
JUIWE 6 FACE_HALF

IVA 0 FACE_ALTERNATE_LAST
IVA 7 FACE_ALTERNATE_LAST
IVA 0 FACE_ALTERNATE_LAST
IVA 9 FACE_ALTERNATE_LAST
IVA 0 FACE_ALTERNATE_LAST
IVA 5 FACE_ALTERNATE_LAST
IVA 5 FACE_ALTERNATE_LAST

$moves
MOVE IVA ZIOGE
OR
    AND
        DESTSRC Suit match
        DEST Rank 1
    DEST Empty
MOVE {ZIOGE, IVA} COLUMN
AND
    DESTSRC Suit match
    AND
        DEST Rank K
        DEST Size == 2
MOVE_STACK IVA IVA
AND
    OR
        DEST Size > 2
        DEST Rank K
    AND
        DESTSRC Rank equal
        SRCSTACK Rank add_13
$win
PILE ALL JUIWE Empty
