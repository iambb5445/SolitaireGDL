Raxe
$cards
DECK 4 SPADES

$initial
DRAW 8 ROTATE 3 U U
FRAIZ 10 FACE_ALTERNATE_LAST
FRAIZ 5 FACE_ALTERNATE_LAST
FRAIZ 5 FACE_ALTERNATE_LAST
FRAIZ 8 FACE_ALTERNATE_LAST
FRAIZ 6 FACE_ALTERNATE_LAST
FRAIZ 4 FACE_ALTERNATE_LAST
FRAIZ 5 FACE_ALTERNATE_LAST
FRAIZ 1 FACE_ALTERNATE_LAST

$moves
MOVE FRAIZ FRAIZ
SRC Suit {HEARTS, SPADES, DIAMONDS}
MOVE_STACK FRAIZ FRAIZ
OR
    AND
        DEST Size == 0
        DEST Size < 9
    AND
        DEST Suit {SPADES, DIAMONDS, CLUBS}
        SRC Suit {SPADES, CLUBS}
$win
OR
    AND
        PILE ALL FRAIZ Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL FRAIZ Empty
        PILE ALL DRAW Empty
