Osi
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST

SAICIW 3 FACE_ALL
SAICIW 1 FACE_ALL
SAICIW 3 FACE_ALL

$moves
MOVE_STACK {SAICIW, COLUMN} COLUMN
DEST Size <= 7
MOVE_STACK SAICIW SAICIW
DESTSRC Suit match
$win
OR
    AND
        PILE ALL SAICIW Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
