Trere
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 76 DEAL COLUMN
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 7 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF

$moves
MOVE COLUMN COLUMN
DESTSRC Rank ascending
MOVE_STACK COLUMN COLUMN
SRC Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
DRAW
PILE ANY DRAW Empty
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
