Laifuw
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 10 FACE_ALL

WEKUV 7 FACE_ALL
WEKUV 1 FACE_ALL

JEC 5 FACE_ALTERNATE_LAST
JEC 5 FACE_ALTERNATE_LAST
JEC 8 FACE_ALTERNATE_LAST
JEC 8 FACE_ALTERNATE_LAST
JEC 0 FACE_ALTERNATE_LAST
JEC 9 FACE_ALTERNATE_LAST
JEC 2 FACE_ALTERNATE_LAST

$moves
MOVE_STACK WEKUV {JEC, COLUMN}
DESTSRC Suit match_color
MOVE_STACK JEC {WEKUV, COLUMN, JEC}
OR
    AND
        SRCSTACK Rank equal
        SRC Suit {SPADES, CLUBS, DIAMONDS}
    AND
        DEST Empty
        DEST Size == 8
$win
AND
    OR
        PILE ALL WEKUV Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL WEKUV Empty
        PILE ALL COLUMN Empty
