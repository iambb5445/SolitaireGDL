Daeze
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 18 ROTATE 3 U 2
AWEAP 1 FACE_ALTERNATE_LAST
AWEAP 2 FACE_LAST

COLUMN 2 FACE_HALF
COLUMN 3 FACE_HALF

$moves
MOVE DRAW AWEAP
OR
    AND
        DESTSRC Suit alternate_color
        SRC Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
    DEST Empty
MOVE_STACK AWEAP COLUMN
AND
    SRC Rank K
    OR
        DEST Rank K
        DEST Suit {SPADES, HEARTS, CLUBS}
MOVE_STACK COLUMN AWEAP
AND
    DEST Size <= 4
    AND
        DESTSRC Rank add_13
        DEST Empty
$win
PILE ALL COLUMN Empty
