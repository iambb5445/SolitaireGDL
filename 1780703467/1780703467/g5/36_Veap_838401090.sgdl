Veap
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 31 ROTATE 3 U U
ZUIHOC 2 FACE_ALL
ZUIHOC 0 FACE_ALL
ZUIHOC 9 FACE_ALL
ZUIHOC 6 FACE_ALL

INU 4 FACE_ALL
INU 0 FACE_ALL

$moves
MOVE ZUIHOC INU
DEST Suit {DIAMONDS, HEARTS, CLUBS, SPADES}
MOVE {INU, DRAW} INU
DEST Suit {HEARTS}
MOVE_STACK INU ZUIHOC
DEST Suit {HEARTS}
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
