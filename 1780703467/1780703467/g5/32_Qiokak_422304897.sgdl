Qiokak
$cards
DECK 1 {SPADES, HEARTS}

$initial
WIOY 9 FACE_ALTERNATE_LAST
WIOY 6 FACE_ALL

LIBU 4 FACE_ALL
LIBU 7 FACE_ALL

$moves
MOVE_STACK WIOY WIOY
SRCSTACK Size == 2
MOVE_STACK {WIOY, LIBU} LIBU
AND
    SRC Rank 1
    SRC Rank K
$win
OR
    PILE ALL WIOY Empty
    AND
        PILE ALL LIBU Empty
        PILE ALL WIOY Empty
