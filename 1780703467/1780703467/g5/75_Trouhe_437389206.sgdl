Trouhe
$cards
DECK 2 {SPADES, CLUBS}

$initial
AFAIY 0 FACE_ALL
AFAIY 1 FACE_ALL
AFAIY 7 FACE_ALL

COLUMN 0 FACE_HALF

PUF 8 FACE_HALF
PUF 1 FACE_HALF
PUF 1 FACE_LAST
PUF 5 FACE_LAST

GOUH 10 FACE_LAST
GOUH 7 FACE_HALF
GOUH 5 FACE_HALF
GOUH 2 FACE_HALF
GOUH 5 FACE_HALF

$moves
MOVE GOUH GOUH
AND
    AND
        DEST Size < 1
        DESTSRC Rank add_13
    DEST Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
MOVE_STACK COLUMN COLUMN
DESTSRC Suit alternate_color
MOVE_STACK PUF AFAIY
AND
    OR
        SRC Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
        SRCSTACK Rank descending
    AND
        DEST Empty
        DEST Rank K
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL PUF Empty
        PILE ALL GOUH Empty
