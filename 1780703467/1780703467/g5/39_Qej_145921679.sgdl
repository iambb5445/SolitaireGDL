Qej
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
APUS 8 FACE_ALL
APUS 0 FACE_ALL
APUS 10 FACE_LAST

COLUMN 6 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALL

URO 7 FACE_ALTERNATE_LAST
URO 0 FACE_HALF

$moves
MOVE URO APUS
OR
    AND
        DEST Size <= 6
        DESTSRC Rank descending
    AND
        DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
        SRC Rank 1
$win
OR
    AND
        PILE ALL URO Empty
        PILE ALL COLUMN Empty
    PILE ALL URO Empty
