Anuif
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 10 FACE_HALF

STAETA 8 FACE_LAST
STAETA 5 FACE_LAST
STAETA 7 FACE_LAST
STAETA 1 FACE_LAST

$moves
MOVE {STAETA, COLUMN} STAETA
DEST Suit {SPADES, HEARTS, CLUBS}
MOVE COLUMN COLUMN
OR
    DEST Suit {CLUBS, SPADES}
    AND
        DEST Empty
        DEST Rank K
MOVE_STACK {STAETA, COLUMN} COLUMN
DEST Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
$win
PILE ALL STAETA Empty
