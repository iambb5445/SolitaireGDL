Mous
$cards
DECK 2 {SPADES, HEARTS}

$initial
TREB 7 FACE_ALTERNATE_LAST
TREB 0 FACE_ALTERNATE_LAST
TREB 4 FACE_ALTERNATE_LAST
TREB 7 FACE_ALTERNATE_LAST
TREB 1 FACE_ALTERNATE_LAST

COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 7 FACE_LAST

EYE 6 FACE_HALF

$moves
MOVE {TREB, EYE, COLUMN} TREB
DESTSRC Suit match
MOVE TREB EYE
OR
    DEST Suit {CLUBS}
    AND
        DEST Size <= 3
        DEST Empty
$win
PILE ALL COLUMN Empty
