Evi
$cards
DECK 2 {SPADES, HEARTS}

$initial
STIOKIR 4 FACE_LAST
STIOKIR 7 FACE_LAST
STIOKIR 8 FACE_LAST
STIOKIR 1 FACE_LAST
STIOKIR 8 FACE_LAST
STIOKIR 2 FACE_LAST
STIOKIR 5 FACE_LAST
STIOKIR 4 FACE_LAST
STIOKIR 0 FACE_LAST

COLUMN 3 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_ALTERNATE_LAST

$moves
MOVE {STIOKIR, COLUMN} COLUMN
DESTSRC Suit match
MOVE_STACK STIOKIR COLUMN
OR
    AND
        SRC Suit {SPADES, DIAMONDS, HEARTS}
        DEST Suit {HEARTS, SPADES}
    SRC Suit {CLUBS, HEARTS}
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Suit {CLUBS}
        SRC Suit {CLUBS, HEARTS, SPADES}
    AND
        DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
        SRC Suit {SPADES, HEARTS}
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL STIOKIR Empty
    OR
        PILE ALL STIOKIR Empty
        PILE ALL STIOKIR Empty
