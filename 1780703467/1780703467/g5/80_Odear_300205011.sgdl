Odear
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 13 DEAL COLUMN
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 5 FACE_LAST
COLUMN 8 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        SRC Rank K
        SRC Rank K
    AND
        DESTSRC Rank equal
        DEST Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
MOVE_STACK COLUMN COLUMN
SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
