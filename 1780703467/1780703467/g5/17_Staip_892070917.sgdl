Staip
$cards
DECK 1 {SPADES, CLUBS}

$initial
DIOYIF 0 FACE_HALF
DIOYIF 4 FACE_LAST
DIOYIF 0 FACE_LAST

AQA 1 FACE_HALF
AQA 0 FACE_ALL
AQA 8 FACE_ALL

UYIJ 9 FACE_ALTERNATE_LAST
UYIJ 0 FACE_ALL
UYIJ 1 FACE_ALL
UYIJ 3 FACE_ALL

$moves
MOVE_STACK UYIJ AQA
OR
    AND
        SRCSTACK Size <= 5
        DESTSRC Suit match
    SRCSTACK Size < 8
MOVE_STACK UYIJ {DIOYIF, UYIJ}
OR
    AND
        SRCSTACK Rank add_14
        DEST Suit {DIAMONDS}
    DEST Rank K
$win
OR
    AND
        PILE ALL AQA Empty
        PILE ALL DIOYIF Empty
    AND
        PILE ALL AQA Empty
        PILE ALL UYIJ Empty
