Azu
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 63 DEAL PAIMI
PAIMI 7 FACE_ALL
PAIMI 2 FACE_ALL
PAIMI 4 FACE_ALL
PAIMI 3 FACE_ALL
PAIMI 7 FACE_ALL
PAIMI 10 FACE_ALL
PAIMI 4 FACE_ALL

JIOZEW 2 FACE_ALTERNATE_LAST
JIOZEW 2 FACE_ALTERNATE_LAST

$moves
MOVE JIOZEW PAIMI
DEST Suit {DIAMONDS, CLUBS}
MOVE_STACK JIOZEW PAIMI
OR
    AND
        DESTSRC Suit match_color
        DEST Suit {SPADES, HEARTS, CLUBS}
    AND
        SRCSTACK Size >= 8
        SRCSTACK Suit match
DRAW
PILE ALL PAIMI Size > 0
$win
OR
    PILE ALL DRAW Empty
    PILE ALL DRAW Empty
