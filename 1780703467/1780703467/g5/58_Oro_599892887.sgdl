Oro
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 3 FACE_ALL

YOUJUS 2 FACE_LAST
YOUJUS 9 FACE_ALTERNATE_LAST
YOUJUS 3 FACE_ALTERNATE_LAST

PRAIG 0 FACE_ALTERNATE_LAST
PRAIG 0 FACE_ALTERNATE_LAST
PRAIG 6 FACE_ALTERNATE_LAST
PRAIG 3 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, PRAIG, YOUJUS} PRAIG
OR
    DESTSRC Rank add_14
    AND
        DEST Empty
        DEST Rank K
MOVE PRAIG YOUJUS
OR
    DEST Rank 1
    AND
        SRC Suit {DIAMONDS, CLUBS, SPADES}
        DESTSRC Rank add_13
$win
OR
    AND
        PILE ALL PRAIG Empty
        PILE ALL PRAIG Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL YOUJUS Empty
