Jap
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 11 ROTATE 3 U 3
NIYA 5 FACE_ALTERNATE_LAST
NIYA 0 FACE_ALTERNATE_LAST
NIYA 3 FACE_ALL
NIYA 5 FACE_ALL

EZIOM 4 FACE_HALF
EZIOM 9 FACE_HALF
EZIOM 0 FACE_HALF
EZIOM 9 FACE_ALTERNATE_LAST
EZIOM 10 FACE_ALTERNATE_LAST
EZIOM 7 FACE_ALTERNATE_LAST
EZIOM 7 FACE_ALTERNATE_LAST

WOUCAK 5 FACE_ALL

EFE 5 FACE_LAST
EFE 6 FACE_LAST
EFE 3 FACE_LAST
EFE 5 FACE_LAST
EFE 1 FACE_LAST
EFE 4 FACE_LAST
EFE 0 FACE_LAST
EFE 5 FACE_ALTERNATE_LAST

$moves
MOVE DRAW WOUCAK
AND
    OR
        DEST Size >= 2
        DESTSRC Suit match_color
    OR
        DESTSRC Suit match_color
        DESTSRC Suit match
MOVE_STACK {EZIOM, EFE, NIYA, WOUCAK} EFE
OR
    AND
        DEST Empty
        DEST Rank 1
    AND
        SRCSTACK Rank add_14
        SRCSTACK Size == 10
$win
OR
    PILE ALL NIYA Empty
    AND
        PILE ALL WOUCAK Empty
        PILE ALL EZIOM Empty
