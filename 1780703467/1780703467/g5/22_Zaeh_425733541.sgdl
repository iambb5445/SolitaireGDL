Zaeh
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 63 ROTATE 1 U 3
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

$moves
MOVE DRAW COLUMN
AND
    DESTSRC Suit alternate_color
    OR
        SRC Suit {CLUBS}
        DEST Empty
MOVE COLUMN COLUMN
AND
    AND
        DESTSRC Rank equal
        DESTSRC Rank add_14
    AND
        DEST Rank 1
        DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    DEST Rank K
    SRC Rank 1
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
