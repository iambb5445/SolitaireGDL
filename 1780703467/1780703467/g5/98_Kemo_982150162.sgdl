Kemo
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 35 ROTATE 3 U 2
COLUMN 8 FACE_LAST
COLUMN 9 FACE_HALF

$moves
MOVE DRAW COLUMN
DEST Size == 5
MOVE COLUMN COLUMN
OR
    SRC Suit {SPADES, DIAMONDS}
    DEST Suit {HEARTS, DIAMONDS, SPADES}
MOVE_STACK COLUMN COLUMN
AND
    DEST Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
    OR
        DEST Suit {DIAMONDS, SPADES, CLUBS}
        SRC Rank 1
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
