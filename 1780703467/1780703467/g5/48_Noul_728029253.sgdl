Noul
$cards
DECK 2 {SPADES, HEARTS}

$initial
EBE 0 FACE_LAST
EBE 3 FACE_LAST
EBE 8 FACE_LAST
EBE 7 FACE_ALTERNATE_LAST
EBE 10 FACE_ALTERNATE_LAST
EBE 4 FACE_ALTERNATE_LAST

AFO 10 FACE_ALTERNATE_LAST
AFO 10 FACE_ALTERNATE_LAST
AFO 0 FACE_ALTERNATE_LAST

$moves
MOVE AFO AFO
OR
    DESTSRC Rank equal
    SRC Suit {CLUBS}
$win
AND
    OR
        PILE ALL EBE Empty
        PILE ALL AFO Empty
    AND
        PILE ALL EBE Empty
        PILE ALL AFO Empty
