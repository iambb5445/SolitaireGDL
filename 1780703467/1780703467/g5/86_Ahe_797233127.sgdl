Ahe
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST

UVO 4 FACE_ALL

$moves
MOVE {UVO, COLUMN} UVO
OR
    DESTSRC Suit alternate_color
    SRC Rank 1
MOVE {UVO, COLUMN} COLUMN
DEST Size <= 3
MOVE_STACK UVO COLUMN
OR
    AND
        DEST Size > 0
        SRC Rank K
    DESTSRC Suit alternate_color
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL UVO Empty
