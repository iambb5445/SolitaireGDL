Nuip
$cards
DECK 8 SPADES

$initial
DRAW 47 ROTATE 1 2 U
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        SRC Rank K
        DEST Size > 0
    AND
        SRC Suit {SPADES, CLUBS, DIAMONDS}
        SRC Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
MOVE DRAW COLUMN
OR
    AND
        DEST Empty
        DEST Size <= 10
    DEST Rank 1
MOVE_STACK COLUMN COLUMN
AND
    DEST Suit {HEARTS, SPADES}
    SRCSTACK Rank add_14
$win
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty
