Fuitu
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 9 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 7 FACE_HALF
COLUMN 4 FACE_HALF

$moves
MOVE COLUMN COLUMN
SRC Suit {CLUBS}
MOVE_STACK COLUMN COLUMN
DEST Empty
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
