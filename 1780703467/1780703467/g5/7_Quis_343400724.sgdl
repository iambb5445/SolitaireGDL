Quis
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 76 DEAL COLUMN
COLUMN 2 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
DEST Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Rank add_14
        SRCSTACK Size < 10
    AND
        SRCSTACK Suit alternate_color
        DESTSRC Rank ascending
$win
PILE ALL DRAW Empty
