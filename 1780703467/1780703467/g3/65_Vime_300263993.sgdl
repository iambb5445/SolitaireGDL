Vime
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 74 ROTATE 3 U 3
DRAIM 2 FACE_LAST
DRAIM 9 FACE_LAST
DRAIM 7 FACE_LAST
DRAIM 9 FACE_LAST
DRAIM 2 FACE_ALL
DRAIM 1 FACE_ALL

$moves
MOVE DRAIM DRAIM
OR
    AND
        DEST Rank 1
        DEST Empty
    AND
        DEST Empty
        DESTSRC Suit match
MOVE DRAW DRAIM
OR
    SRC Rank K
    AND
        DEST Suit {CLUBS, DIAMONDS, HEARTS}
        DEST Rank 1
MOVE_STACK DRAIM DRAIM
DEST Suit {SPADES}
$win
PILE ALL DRAIM Empty
