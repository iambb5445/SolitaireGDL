Puy
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 2 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 8 FACE_HALF

MIOREJ 5 FACE_LAST

$moves
MOVE COLUMN {COLUMN, MIOREJ}
SRC Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
MOVE MIOREJ COLUMN
DESTSRC Suit alternate_color
MOVE_STACK MIOREJ COLUMN
OR
    SRCSTACK Size < 5
    AND
        SRCSTACK Suit match_color
        DESTSRC Suit match_color
MOVE_STACK MIOREJ MIOREJ
SRC Suit {HEARTS, CLUBS}
$win
PILE ALL COLUMN Empty
