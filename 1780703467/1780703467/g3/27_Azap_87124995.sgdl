Azap
$cards
DECK 8 SPADES

$initial
DRAW 10 ROTATE 3 U U
GROHA 0 FACE_HALF
GROHA 5 FACE_HALF
GROHA 0 FACE_HALF

COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 0 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST

IMA 3 FACE_ALL
IMA 10 FACE_ALL
IMA 6 FACE_ALL
IMA 3 FACE_ALL

SECA 10 FACE_ALL

FRERU 4 FACE_LAST
FRERU 9 FACE_LAST

BRIOXA 3 FACE_LAST
BRIOXA 2 FACE_HALF

ODI 3 FACE_HALF
ODI 4 FACE_HALF
ODI 10 FACE_HALF
ODI 10 FACE_HALF
ODI 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {ODI, IMA, SECA, GROHA, COLUMN} IMA
OR
    DEST Size < 10
    AND
        SRC Suit {CLUBS}
        DEST Suit {HEARTS, SPADES}
$win
OR
    PILE ALL IMA Empty
    PILE ALL FRERU Empty
