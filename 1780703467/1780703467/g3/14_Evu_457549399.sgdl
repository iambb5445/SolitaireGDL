Evu
$cards
DECK 2 {SPADES, HEARTS}

$initial
FAIQ 4 FACE_HALF
FAIQ 2 FACE_ALL

COLUMN 2 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF

VEL 0 FACE_HALF
VEL 7 FACE_HALF
VEL 2 FACE_HALF
VEL 6 FACE_HALF

UBO 6 FACE_ALL

$moves
MOVE {VEL, FAIQ} COLUMN
OR
    AND
        DESTSRC Suit match
        DESTSRC Suit match_color
    AND
        DESTSRC Suit match_color
        DEST Empty
MOVE_STACK UBO COLUMN
AND
    OR
        DEST Rank 1
        DEST Empty
    SRC Suit {DIAMONDS, SPADES, CLUBS}
$win
OR
    PILE ALL FAIQ Empty
    AND
        PILE ALL VEL Empty
        PILE ALL UBO Empty
