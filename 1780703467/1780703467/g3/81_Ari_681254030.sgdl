Ari
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 47 DEAL COLUMN
COLUMN 10 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 3 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 8 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
AND
    OR
        DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
        SRCSTACK Size >= 0
    OR
        SRCSTACK Suit match_color
        SRC Rank 1
DRAW
PILE ALL COLUMN Empty
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
