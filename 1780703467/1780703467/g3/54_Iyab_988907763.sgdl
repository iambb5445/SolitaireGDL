Iyab
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 43 ROTATE 3 U U
EWE 6 FACE_HALF
EWE 3 FACE_HALF
EWE 9 FACE_ALTERNATE_LAST
EWE 2 FACE_ALTERNATE_LAST
EWE 6 FACE_ALTERNATE_LAST

CRUG 4 FACE_LAST
CRUG 6 FACE_HALF

XAIZIH 3 FACE_ALTERNATE_LAST
XAIZIH 0 FACE_ALTERNATE_LAST
XAIZIH 9 FACE_ALTERNATE_LAST
XAIZIH 7 FACE_ALTERNATE_LAST
XAIZIH 6 FACE_ALTERNATE_LAST

$moves
MOVE_STACK CRUG {EWE, CRUG, XAIZIH}
AND
    SRCSTACK Rank ascending
    OR
        SRC Rank 1
        DEST Suit {CLUBS}
MOVE_STACK EWE XAIZIH
OR
    AND
        SRCSTACK Suit alternate_color
        DEST Size < 7
    AND
        DEST Size >= 1
        DESTSRC Rank descending
$win
PILE ALL XAIZIH Empty
