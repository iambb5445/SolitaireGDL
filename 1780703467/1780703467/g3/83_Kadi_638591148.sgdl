Kadi
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 4 FACE_HALF

OGAZ 2 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Size >= 2
        DEST Empty
    AND
        DESTSRC Rank add_13
        DEST Empty
MOVE_STACK {OGAZ, COLUMN} COLUMN
DESTSRC Rank add_13
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
