Beani
$cards
DECK 2 {SPADES, HEARTS}

$initial
CUJI 1 FACE_ALTERNATE_LAST
CUJI 9 FACE_ALTERNATE_LAST
CUJI 2 FACE_HALF
CUJI 6 FACE_HALF
CUJI 0 FACE_HALF
CUJI 4 FACE_HALF

UQUT 1 FACE_HALF
UQUT 6 FACE_HALF

DREPU 10 FACE_ALL
DREPU 3 FACE_ALL
DREPU 9 FACE_ALTERNATE_LAST
DREPU 1 FACE_ALTERNATE_LAST

$moves
MOVE CUJI {DREPU, UQUT}
AND
    SRC Rank K
    OR
        DEST Suit {CLUBS}
        DEST Suit {HEARTS}
MOVE UQUT CUJI
OR
    AND
        DEST Suit {DIAMONDS, CLUBS, HEARTS}
        SRC Rank K
    DESTSRC Rank descending
MOVE_STACK DREPU DREPU
OR
    AND
        SRCSTACK Rank add_14
        SRC Rank 1
    SRCSTACK Size <= 4
$win
PILE ALL UQUT Empty
