Enon
$cards
DECK 8 SPADES

$initial
COLUMN 1 FACE_HALF
COLUMN 9 FACE_HALF

ATIOC 7 FACE_ALTERNATE_LAST
ATIOC 9 FACE_ALTERNATE_LAST
ATIOC 4 FACE_ALTERNATE_LAST
ATIOC 5 FACE_ALTERNATE_LAST
ATIOC 7 FACE_ALTERNATE_LAST
ATIOC 8 FACE_ALTERNATE_LAST
ATIOC 6 FACE_ALTERNATE_LAST
ATIOC 7 FACE_ALTERNATE_LAST
ATIOC 3 FACE_ALTERNATE_LAST
ATIOC 0 FACE_ALTERNATE_LAST

OZAIB 9 FACE_ALTERNATE_LAST
OZAIB 4 FACE_ALTERNATE_LAST
OZAIB 2 FACE_ALTERNATE_LAST
OZAIB 8 FACE_LAST
OZAIB 0 FACE_LAST
OZAIB 5 FACE_LAST
OZAIB 9 FACE_LAST
OZAIB 1 FACE_LAST

$moves
MOVE ATIOC COLUMN
OR
    AND
        DEST Empty
        DEST Size == 8
    AND
        DESTSRC Suit alternate_color
        DEST Empty
MOVE OZAIB {ATIOC, OZAIB}
DEST Rank K
MOVE_STACK OZAIB COLUMN
AND
    OR
        SRCSTACK Size == 2
        DEST Size >= 6
    SRC Suit {SPADES, CLUBS}
MOVE_STACK COLUMN OZAIB
DEST Suit {CLUBS, DIAMONDS}
$win
OR
    PILE ALL OZAIB Empty
    PILE ALL COLUMN Empty
