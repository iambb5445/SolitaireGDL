Etip
$cards
DECK 2 SPADES

$initial
DRAW 22 DEAL AWAIW
AWAIW 2 FACE_ALTERNATE_LAST
AWAIW 2 FACE_ALTERNATE_LAST

$moves
MOVE AWAIW AWAIW
OR
    AND
        DEST Empty
        SRC Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
    DEST Rank K
MOVE_STACK AWAIW AWAIW
OR
    SRC Rank K
    AND
        SRCSTACK Size >= 5
        DEST Empty
DRAW
PILE ALL AWAIW Size > 0
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
