Eweb
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 9 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
DEST Size == 6
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
