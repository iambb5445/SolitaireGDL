Maete
$cards
DECK 2 {SPADES, CLUBS}

$initial
IWOV 2 FACE_ALTERNATE_LAST
IWOV 4 FACE_ALTERNATE_LAST
IWOV 1 FACE_ALTERNATE_LAST
IWOV 5 FACE_ALTERNATE_LAST
IWOV 4 FACE_ALTERNATE_LAST
IWOV 5 FACE_ALTERNATE_LAST
IWOV 8 FACE_ALTERNATE_LAST
IWOV 7 FACE_ALTERNATE_LAST

COLUMN 7 FACE_LAST
COLUMN 9 FACE_HALF

$moves
MOVE_STACK IWOV IWOV
OR
    AND
        DESTSRC Suit match
        SRC Rank 1
    AND
        SRC Rank 1
        DEST Suit {SPADES, DIAMONDS, CLUBS}
$win
PILE ALL COLUMN Empty
