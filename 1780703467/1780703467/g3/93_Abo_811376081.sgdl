Abo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 1 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 4 FACE_ALL

EZI 9 FACE_LAST
EZI 9 FACE_LAST
EZI 3 FACE_LAST
EZI 7 FACE_HALF
EZI 0 FACE_HALF
EZI 7 FACE_HALF
EZI 4 FACE_HALF
EZI 8 FACE_HALF
EZI 3 FACE_HALF

GRUINIJ 6 FACE_HALF
GRUINIJ 9 FACE_HALF
GRUINIJ 4 FACE_HALF
GRUINIJ 2 FACE_HALF
GRUINIJ 9 FACE_ALTERNATE_LAST
GRUINIJ 2 FACE_ALTERNATE_LAST
GRUINIJ 4 FACE_ALTERNATE_LAST

$moves
MOVE GRUINIJ COLUMN
DESTSRC Rank equal
MOVE_STACK {COLUMN, GRUINIJ, EZI} COLUMN
DEST Suit {CLUBS}
MOVE_STACK EZI EZI
OR
    AND
        DEST Rank K
        SRCSTACK Suit match
    AND
        DEST Rank 1
        DEST Suit {CLUBS, HEARTS, DIAMONDS}
$win
OR
    PILE ALL GRUINIJ Empty
    PILE ALL EZI Empty
