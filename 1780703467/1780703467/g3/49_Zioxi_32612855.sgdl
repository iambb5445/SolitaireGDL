Zioxi
$cards
DECK 8 SPADES

$initial
DRAW 49 ROTATE 1 2 U
OWU 2 FACE_LAST
OWU 10 FACE_LAST
OWU 3 FACE_LAST
OWU 0 FACE_LAST
OWU 8 FACE_LAST
OWU 8 FACE_LAST
OWU 4 FACE_LAST
OWU 4 FACE_LAST

VAL 3 FACE_LAST

AVE 3 FACE_LAST
AVE 0 FACE_LAST
AVE 1 FACE_LAST
AVE 7 FACE_LAST
AVE 2 FACE_LAST

$moves
MOVE_STACK AVE VAL
OR
    SRCSTACK Suit match_color
    AND
        DEST Suit {SPADES, DIAMONDS}
        SRCSTACK Rank add_13
MOVE_STACK VAL {VAL, OWU}
OR
    DESTSRC Rank add_14
    AND
        DEST Suit {CLUBS, DIAMONDS}
        DEST Suit {HEARTS, CLUBS}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL VAL Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL AVE Empty
