Yoti
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

QIOJ 5 FACE_ALL
QIOJ 9 FACE_ALL
QIOJ 0 FACE_ALTERNATE_LAST
QIOJ 5 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Suit match_color
        DEST Suit {DIAMONDS}
    AND
        DEST Size <= 4
        DESTSRC Suit match_color
MOVE QIOJ QIOJ
AND
    DEST Rank K
    OR
        DEST Suit {DIAMONDS, CLUBS, HEARTS}
        DEST Rank 1
$win
PILE ALL QIOJ Empty
