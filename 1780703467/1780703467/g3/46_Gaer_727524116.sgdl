Gaer
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 8 DEAL COLUMN
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

ABO 5 FACE_LAST
ABO 5 FACE_ALTERNATE_LAST
ABO 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN ABO
AND
    DEST Size <= 8
    DESTSRC Suit alternate_color
MOVE {COLUMN, ABO} COLUMN
OR
    DEST Empty
    DESTSRC Suit alternate_color
MOVE_STACK COLUMN ABO
AND
    AND
        SRCSTACK Rank add_13
        SRC Suit {HEARTS, SPADES}
    OR
        DEST Suit {SPADES, CLUBS, HEARTS, DIAMONDS}
        DESTSRC Rank equal
DRAW
PILE ANY ABO Empty
$win
PILE ALL DRAW Empty
