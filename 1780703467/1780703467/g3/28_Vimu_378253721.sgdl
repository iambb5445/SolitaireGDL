Vimu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
IJE 3 FACE_LAST
IJE 6 FACE_LAST
IJE 1 FACE_LAST
IJE 5 FACE_LAST
IJE 1 FACE_LAST
IJE 4 FACE_LAST
IJE 10 FACE_LAST
IJE 8 FACE_LAST
IJE 6 FACE_LAST

COLUMN 8 FACE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN IJE
AND
    OR
        DEST Suit {DIAMONDS, HEARTS, CLUBS, SPADES}
        DESTSRC Suit match
    DEST Empty
MOVE_STACK {COLUMN, IJE} COLUMN
OR
    SRC Rank K
    SRCSTACK Rank ascending
$win
PILE ALL IJE Empty
