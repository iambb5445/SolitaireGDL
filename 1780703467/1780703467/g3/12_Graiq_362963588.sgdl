Graiq
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 32 DEAL {IJAN, COLUMN}
COLUMN 0 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 7 FACE_HALF

IJAN 5 FACE_ALTERNATE_LAST
IJAN 8 FACE_ALTERNATE_LAST
IJAN 4 FACE_ALTERNATE_LAST
IJAN 2 FACE_ALTERNATE_LAST
IJAN 0 FACE_HALF
IJAN 6 FACE_HALF
IJAN 10 FACE_HALF
IJAN 5 FACE_HALF
IJAN 8 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
AND
    SRCSTACK Suit match
    OR
        SRCSTACK Suit match
        SRCSTACK Suit alternate_color
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL IJAN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
