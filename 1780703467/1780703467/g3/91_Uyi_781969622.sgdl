Uyi
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AFOZ 1 FACE_HALF
AFOZ 3 FACE_HALF
AFOZ 8 FACE_HALF
AFOZ 0 FACE_HALF
AFOZ 9 FACE_HALF
AFOZ 6 FACE_HALF
AFOZ 3 FACE_LAST
AFOZ 1 FACE_LAST
AFOZ 5 FACE_LAST
AFOZ 5 FACE_LAST

NAIW 5 FACE_ALTERNATE_LAST

UYE 1 FACE_LAST

RAIWU 10 FACE_ALL
RAIWU 3 FACE_ALTERNATE_LAST

AHAER 10 FACE_ALL
AHAER 0 FACE_ALL
AHAER 0 FACE_ALL
AHAER 9 FACE_ALL
AHAER 10 FACE_ALL
AHAER 3 FACE_ALL

COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE_STACK COLUMN UYE
OR
    AND
        DEST Size < 9
        DESTSRC Suit alternate_color
    DEST Rank 1
MOVE_STACK {NAIW, COLUMN} AFOZ
DESTSRC Suit alternate_color
$win
OR
    PILE ALL UYE Empty
    AND
        PILE ALL AHAER Empty
        PILE ALL RAIWU Empty
