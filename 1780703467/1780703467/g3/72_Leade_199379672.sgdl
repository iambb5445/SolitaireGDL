Leade
$cards
DECK 4 {SPADES, CLUBS}

$initial
PRAEZ 3 FACE_HALF
PRAEZ 3 FACE_HALF
PRAEZ 4 FACE_HALF
PRAEZ 3 FACE_HALF
PRAEZ 2 FACE_HALF
PRAEZ 9 FACE_HALF
PRAEZ 9 FACE_HALF
PRAEZ 4 FACE_HALF

COLUMN 3 FACE_HALF
COLUMN 8 FACE_ALTERNATE_LAST

INO 8 FACE_ALTERNATE_LAST
INO 9 FACE_ALTERNATE_LAST
INO 3 FACE_ALTERNATE_LAST
INO 7 FACE_ALTERNATE_LAST

STIOJ 3 FACE_ALTERNATE_LAST
STIOJ 8 FACE_ALTERNATE_LAST
STIOJ 3 FACE_ALTERNATE_LAST
STIOJ 10 FACE_LAST
STIOJ 5 FACE_LAST

$moves
MOVE STIOJ PRAEZ
AND
    DEST Empty
    OR
        DESTSRC Rank add_14
        DEST Rank K
MOVE_STACK STIOJ COLUMN
AND
    OR
        DESTSRC Rank descending
        SRCSTACK Rank equal
    SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
$win
PILE ALL COLUMN Empty
