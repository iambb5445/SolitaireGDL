Aseaq
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 19 ROTATE 3 U 1
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

$moves
MOVE DRAW COLUMN
OR
    DESTSRC Suit match_color
    AND
        SRC Suit {SPADES, HEARTS, CLUBS}
        DEST Suit {CLUBS, HEARTS}
MOVE COLUMN COLUMN
OR
    AND
        SRC Rank K
        DEST Rank K
    DESTSRC Suit alternate_color
$win
PILE ALL DRAW Empty
