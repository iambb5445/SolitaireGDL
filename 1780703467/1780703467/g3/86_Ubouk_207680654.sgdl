Ubouk
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
FUCO 8 FACE_HALF
FUCO 0 FACE_HALF
FUCO 10 FACE_HALF
FUCO 7 FACE_HALF

COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Size > 5
        DESTSRC Rank equal
    AND
        SRC Rank K
        DEST Rank K
MOVE_STACK COLUMN FUCO
OR
    AND
        SRCSTACK Rank add_13
        SRCSTACK Rank ascending
    AND
        DEST Rank 1
        DESTSRC Rank ascending
MOVE_STACK {FUCO, COLUMN} COLUMN
AND
    DESTSRC Rank equal
    OR
        DEST Suit {SPADES, DIAMONDS}
        DEST Empty
$win
PILE ALL COLUMN Empty
