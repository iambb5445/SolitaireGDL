Ohoux
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 4 FACE_HALF
COLUMN 4 FACE_LAST

PREP 0 FACE_LAST
PREP 6 FACE_LAST
PREP 0 FACE_LAST
PREP 3 FACE_LAST
PREP 9 FACE_LAST
PREP 9 FACE_LAST
PREP 1 FACE_LAST
PREP 7 FACE_LAST

DRATEH 3 FACE_LAST

PRUIYI 6 FACE_ALL
PRUIYI 0 FACE_LAST

$moves
MOVE_STACK {PRUIYI, PREP, COLUMN} COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        SRC Suit {SPADES, HEARTS, CLUBS}
    AND
        DEST Size == 1
        SRCSTACK Suit alternate_color
MOVE_STACK {PREP, COLUMN, DRATEH, PRUIYI} PRUIYI
SRCSTACK Suit match_color
$win
OR
    AND
        PILE ALL PRUIYI Empty
        PILE ALL DRATEH Empty
    PILE ALL PRUIYI Empty
