Hiofuq
$cards
DECK 4 SPADES

$initial
ISAZ 6 FACE_ALL
ISAZ 2 FACE_ALL
ISAZ 5 FACE_ALL
ISAZ 10 FACE_ALL
ISAZ 2 FACE_ALL
ISAZ 1 FACE_ALL
ISAZ 7 FACE_HALF
ISAZ 5 FACE_HALF
ISAZ 7 FACE_HALF

OYEH 0 FACE_ALTERNATE_LAST
OYEH 4 FACE_ALTERNATE_LAST
OYEH 3 FACE_HALF

$moves
MOVE ISAZ {OYEH, ISAZ}
AND
    DEST Size <= 8
    AND
        DEST Size > 0
        SRC Rank K
MOVE OYEH OYEH
DEST Size <= 4
MOVE_STACK ISAZ ISAZ
OR
    AND
        SRCSTACK Size > 1
        DEST Suit {SPADES, CLUBS, HEARTS}
    DEST Suit {CLUBS, SPADES, DIAMONDS}
MOVE_STACK OYEH ISAZ
OR
    DEST Empty
    AND
        SRCSTACK Size == 0
        SRC Rank 1
$win
OR
    AND
        PILE ALL ISAZ Empty
        PILE ALL ISAZ Empty
    AND
        PILE ALL OYEH Empty
        PILE ALL ISAZ Empty
