Ohu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AHOUL 7 FACE_ALL
AHOUL 6 FACE_LAST
AHOUL 1 FACE_LAST
AHOUL 10 FACE_LAST
AHOUL 5 FACE_LAST
AHOUL 2 FACE_LAST
AHOUL 10 FACE_LAST
AHOUL 4 FACE_LAST
AHOUL 7 FACE_LAST

$moves
MOVE AHOUL AHOUL
OR
    AND
        DEST Size < 1
        DESTSRC Rank add_13
    DESTSRC Rank descending
MOVE_STACK AHOUL AHOUL
OR
    DEST Rank K
    AND
        SRCSTACK Suit match_color
        SRC Rank K
$win
AND
    OR
        PILE ALL AHOUL Empty
        PILE ALL AHOUL Empty
    PILE ALL AHOUL Empty
