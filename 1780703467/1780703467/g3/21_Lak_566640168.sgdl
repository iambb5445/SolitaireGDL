Lak
$cards
DECK 1 SPADES

$initial
DRAW 2 DEAL {AHEAY, AVAIP}
AHEAY 3 FACE_LAST

AVAIP 7 FACE_HALF
AVAIP 1 FACE_LAST

$moves
MOVE AHEAY AHEAY
DEST Rank K
MOVE AVAIP AHEAY
OR
    AND
        DEST Suit {SPADES, HEARTS, CLUBS}
        DEST Empty
    AND
        SRC Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
        SRC Suit {DIAMONDS, SPADES}
MOVE_STACK AHEAY {AHEAY, AVAIP}
SRCSTACK Size > 7
MOVE_STACK AVAIP {AHEAY, AVAIP}
DEST Suit {HEARTS, SPADES}
DRAW
PILE ALL AVAIP Empty
$win
PILE ALL AVAIP Empty
