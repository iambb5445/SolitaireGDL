Fraica
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 10 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 10 FACE_LAST

GRIZA 0 FACE_LAST
GRIZA 9 FACE_ALTERNATE_LAST
GRIZA 10 FACE_ALTERNATE_LAST
GRIZA 4 FACE_ALTERNATE_LAST

$moves
MOVE {GRIZA, COLUMN} COLUMN
OR
    AND
        DEST Size > 2
        DEST Suit {CLUBS}
    AND
        DEST Size > 7
        DESTSRC Suit match
MOVE {GRIZA, COLUMN} GRIZA
OR
    AND
        DEST Size >= 1
        SRC Rank 1
    SRC Rank 1
MOVE_STACK GRIZA COLUMN
OR
    AND
        SRCSTACK Suit match_color
        DEST Empty
    DEST Suit {CLUBS, SPADES, HEARTS}
MOVE_STACK GRIZA GRIZA
OR
    SRCSTACK Size == 2
    SRC Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL GRIZA Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
