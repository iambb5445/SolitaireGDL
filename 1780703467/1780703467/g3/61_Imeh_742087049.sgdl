Imeh
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
XIOXOH 9 FACE_LAST
XIOXOH 1 FACE_LAST
XIOXOH 1 FACE_LAST
XIOXOH 0 FACE_LAST
XIOXOH 10 FACE_LAST
XIOXOH 5 FACE_LAST
XIOXOH 4 FACE_LAST
XIOXOH 10 FACE_LAST
XIOXOH 10 FACE_LAST

CRAEG 2 FACE_LAST

$moves
MOVE XIOXOH XIOXOH
OR
    AND
        DESTSRC Rank equal
        DEST Rank K
    DEST Suit {SPADES, CLUBS}
MOVE {CRAEG, XIOXOH} CRAEG
DESTSRC Suit alternate_color
MOVE_STACK CRAEG CRAEG
OR
    SRC Rank K
    AND
        SRCSTACK Suit match_color
        DESTSRC Rank add_14
$win
OR
    AND
        PILE ALL CRAEG Empty
        PILE ALL CRAEG Empty
    AND
        PILE ALL XIOXOH Empty
        PILE ALL CRAEG Empty
