Ava
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

OKAEY 10 FACE_HALF
OKAEY 9 FACE_HALF
OKAEY 3 FACE_ALL
OKAEY 1 FACE_ALL
OKAEY 2 FACE_ALL
OKAEY 2 FACE_ALL
OKAEY 5 FACE_ALL

IPO 0 FACE_ALTERNATE_LAST
IPO 3 FACE_ALTERNATE_LAST
IPO 9 FACE_ALTERNATE_LAST
IPO 4 FACE_ALTERNATE_LAST
IPO 1 FACE_ALTERNATE_LAST
IPO 0 FACE_ALTERNATE_LAST
IPO 2 FACE_ALTERNATE_LAST
IPO 6 FACE_LAST
IPO 9 FACE_LAST

$moves
MOVE_STACK OKAEY {IPO, COLUMN, OKAEY}
DEST Empty
MOVE_STACK COLUMN COLUMN
SRCSTACK Suit alternate_color
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL OKAEY Empty
        PILE ALL IPO Empty
