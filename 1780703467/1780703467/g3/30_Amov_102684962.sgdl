Amov
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 13 DEAL PROURA
PROURA 10 FACE_HALF
PROURA 0 FACE_ALTERNATE_LAST
PROURA 4 FACE_ALTERNATE_LAST
PROURA 2 FACE_ALTERNATE_LAST

COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST

$moves
MOVE PROURA COLUMN
OR
    AND
        DEST Suit {CLUBS, HEARTS}
        DEST Size >= 4
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank add_14
MOVE_STACK {COLUMN, PROURA} PROURA
AND
    OR
        SRCSTACK Rank add_13
        DEST Empty
    OR
        SRCSTACK Size < 0
        DEST Suit {CLUBS, SPADES, DIAMONDS}
MOVE_STACK COLUMN COLUMN
SRC Rank K
DRAW
PILE ANY COLUMN Size > 0
$win
OR
    AND
        PILE ALL PROURA Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
