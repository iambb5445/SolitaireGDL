Seca
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 4 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF

VIOKEN 9 FACE_LAST
VIOKEN 2 FACE_LAST
VIOKEN 2 FACE_LAST
VIOKEN 0 FACE_LAST
VIOKEN 0 FACE_LAST
VIOKEN 0 FACE_LAST
VIOKEN 0 FACE_LAST

$moves
MOVE {COLUMN, VIOKEN} VIOKEN
OR
    AND
        DEST Empty
        DESTSRC Suit match
    AND
        DESTSRC Rank ascending
        DESTSRC Rank add_14
MOVE COLUMN COLUMN
OR
    AND
        DEST Suit {DIAMONDS, SPADES, CLUBS}
        SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
    AND
        DESTSRC Suit match
        DESTSRC Rank equal
$win
AND
    PILE ALL VIOKEN Empty
    OR
        PILE ALL VIOKEN Empty
        PILE ALL COLUMN Empty
