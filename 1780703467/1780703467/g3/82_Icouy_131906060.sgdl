Icouy
$cards
DECK 2 SPADES

$initial
COLUMN 5 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 7 FACE_ALL
COLUMN 4 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    DEST Size > 9
    AND
        DEST Empty
        DEST Suit {DIAMONDS, SPADES}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
