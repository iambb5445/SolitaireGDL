Ase
$cards
DECK 4 {SPADES, HEARTS}

$initial
TREWAK 7 FACE_ALTERNATE_LAST
TREWAK 3 FACE_ALTERNATE_LAST
TREWAK 10 FACE_ALTERNATE_LAST
TREWAK 9 FACE_ALTERNATE_LAST

COLUMN 3 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 2 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 3 FACE_HALF

EVA 4 FACE_LAST
EVA 10 FACE_LAST
EVA 1 FACE_LAST
EVA 2 FACE_ALL
EVA 8 FACE_ALL

AZU 5 FACE_ALTERNATE_LAST
AZU 0 FACE_ALTERNATE_LAST

$moves
MOVE AZU TREWAK
DEST Size >= 8
MOVE_STACK {COLUMN, TREWAK, EVA, AZU} AZU
AND
    DESTSRC Suit alternate_color
    OR
        DESTSRC Rank ascending
        SRCSTACK Size >= 2
MOVE_STACK {AZU, COLUMN} COLUMN
OR
    AND
        DESTSRC Rank descending
        DESTSRC Suit match_color
    AND
        DESTSRC Suit match_color
        SRCSTACK Suit match_color
$win
PILE ALL AZU Empty
