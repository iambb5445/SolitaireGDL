Ebiw
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
DEST Rank 1
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Size == 7
        SRC Rank K
    AND
        DESTSRC Rank add_14
        DEST Suit {SPADES, CLUBS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
