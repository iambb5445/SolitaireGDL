Akioj
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 28 DEAL COLUMN
COLUMN 3 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 9 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Suit {SPADES, CLUBS}
        DEST Empty
    AND
        DEST Rank K
        DESTSRC Rank add_13
MOVE_STACK COLUMN COLUMN
DEST Suit {HEARTS, SPADES, CLUBS}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    PILE ALL DRAW Empty
