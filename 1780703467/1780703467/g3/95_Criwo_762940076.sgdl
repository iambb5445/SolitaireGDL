Criwo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 67 DEAL {COLUMN, IJI}
IJI 4 FACE_LAST

COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE_STACK IJI IJI
OR
    AND
        DESTSRC Suit alternate_color
        SRC Rank 1
    AND
        SRC Suit {SPADES}
        SRC Rank 1
$win
PILE ALL COLUMN Empty
