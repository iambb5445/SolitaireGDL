Equ
$cards
DECK 8 SPADES

$initial
DRAW 16 DEAL {UROG, RUIP, GUIRU}
RUIP 7 FACE_LAST
RUIP 5 FACE_LAST
RUIP 5 FACE_LAST
RUIP 8 FACE_LAST
RUIP 10 FACE_LAST
RUIP 2 FACE_LAST
RUIP 6 FACE_LAST

UROG 2 FACE_ALL

GUIRU 5 FACE_ALTERNATE_LAST

COLUMN 5 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 1 FACE_LAST

$moves
MOVE {COLUMN, GUIRU} RUIP
SRC Rank 1
MOVE UROG COLUMN
OR
    SRC Rank K
    AND
        DEST Empty
        DESTSRC Suit alternate_color
DRAW
PILE ALL UROG Size > 0
$win
OR
    AND
        PILE ALL UROG Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
