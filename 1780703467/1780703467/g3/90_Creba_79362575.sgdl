Creba
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
BUIVA 2 FACE_ALL
BUIVA 8 FACE_ALL
BUIVA 3 FACE_ALL
BUIVA 8 FACE_ALL
BUIVA 0 FACE_ALTERNATE_LAST

COLUMN 8 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 0 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 1 FACE_LAST

ADU 4 FACE_HALF
ADU 1 FACE_HALF

$moves
MOVE_STACK {COLUMN, BUIVA} ADU
OR
    SRCSTACK Size > 0
    DESTSRC Rank add_14
MOVE_STACK BUIVA BUIVA
AND
    AND
        DEST Empty
        SRC Rank K
    DESTSRC Suit alternate_color
$win
OR
    PILE ALL BUIVA Empty
    AND
        PILE ALL BUIVA Empty
        PILE ALL BUIVA Empty
