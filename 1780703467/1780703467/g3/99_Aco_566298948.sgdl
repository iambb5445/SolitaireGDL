Aco
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 10 FACE_ALL

CAEK 0 FACE_HALF
CAEK 1 FACE_HALF
CAEK 9 FACE_HALF
CAEK 7 FACE_ALTERNATE_LAST
CAEK 1 FACE_ALTERNATE_LAST
CAEK 5 FACE_ALTERNATE_LAST
CAEK 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK CAEK CAEK
OR
    DEST Empty
    AND
        DESTSRC Suit alternate_color
        DEST Size == 10
MOVE_STACK CAEK COLUMN
SRC Suit {DIAMONDS, SPADES, CLUBS}
$win
PILE ALL CAEK Empty
