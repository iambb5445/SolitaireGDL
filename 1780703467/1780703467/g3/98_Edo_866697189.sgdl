Edo
$cards
DECK 4 {SPADES, CLUBS}

$initial
MAEQU 4 FACE_LAST
MAEQU 4 FACE_LAST
MAEQU 10 FACE_LAST
MAEQU 9 FACE_HALF
MAEQU 2 FACE_HALF

UHE 8 FACE_ALTERNATE_LAST

COLUMN 5 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 4 FACE_ALL

ITI 6 FACE_LAST

PRIOX 3 FACE_ALL
PRIOX 4 FACE_ALL

$moves
MOVE ITI PRIOX
AND
    AND
        SRC Suit {DIAMONDS, HEARTS}
        SRC Rank K
    OR
        DEST Suit {SPADES, HEARTS}
        SRC Rank K
MOVE {UHE, ITI, MAEQU, PRIOX, COLUMN} MAEQU
OR
    AND
        DEST Rank K
        SRC Rank 1
    DEST Suit {CLUBS, HEARTS, SPADES}
MOVE_STACK MAEQU UHE
OR
    AND
        DESTSRC Rank add_13
        SRC Rank K
    AND
        DEST Size >= 5
        DEST Empty
$win
OR
    PILE ALL ITI Empty
    PILE ALL UHE Empty
