Bres
$cards
DECK 1 SPADES

$initial
FEAPIW 9 FACE_ALTERNATE_LAST
FEAPIW 4 FACE_ALTERNATE_LAST

$moves
MOVE FEAPIW FEAPIW
OR
    AND
        SRC Suit {SPADES}
        SRC Rank 1
    DESTSRC Suit match_color
MOVE_STACK FEAPIW FEAPIW
OR
    DEST Size > 7
    AND
        DEST Size < 9
        SRCSTACK Rank ascending
$win
OR
    PILE ALL FEAPIW Empty
    AND
        PILE ALL FEAPIW Empty
        PILE ALL FEAPIW Empty
