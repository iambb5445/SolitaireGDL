Ewuis
$cards
DECK 1 SPADES

$initial
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 3 FACE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    SRCSTACK Size >= 1
    AND
        SRC Rank 1
        DEST Rank K
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
