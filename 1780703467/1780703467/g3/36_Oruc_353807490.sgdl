Oruc
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 66 ROTATE 3 U 3
XOD 1 FACE_ALL
XOD 5 FACE_LAST
XOD 0 FACE_LAST
XOD 7 FACE_LAST
XOD 5 FACE_LAST
XOD 2 FACE_LAST
XOD 4 FACE_LAST
XOD 9 FACE_LAST
XOD 1 FACE_LAST
XOD 4 FACE_LAST

$moves
MOVE_STACK XOD XOD
OR
    AND
        SRCSTACK Suit match_color
        DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
    AND
        SRC Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
        SRC Suit {SPADES, HEARTS}
$win
PILE ALL DRAW Empty
