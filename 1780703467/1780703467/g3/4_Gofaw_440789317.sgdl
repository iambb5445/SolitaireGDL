Gofaw
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 8 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DEST Size > 3
    DEST Size <= 0
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
