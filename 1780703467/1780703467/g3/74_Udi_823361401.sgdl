Udi
$cards
DECK 2 {SPADES, HEARTS}

$initial
VUIKAK 4 FACE_ALL

NAITA 0 FACE_HALF
NAITA 0 FACE_HALF

DRUYUD 3 FACE_HALF
DRUYUD 3 FACE_HALF
DRUYUD 7 FACE_HALF
DRUYUD 0 FACE_HALF
DRUYUD 8 FACE_HALF
DRUYUD 8 FACE_HALF
DRUYUD 0 FACE_HALF
DRUYUD 9 FACE_HALF
DRUYUD 5 FACE_HALF

GROCOK 0 FACE_HALF
GROCOK 1 FACE_HALF
GROCOK 0 FACE_HALF
GROCOK 2 FACE_ALL
GROCOK 1 FACE_ALL
GROCOK 1 FACE_ALL

$moves
MOVE {VUIKAK, GROCOK} VUIKAK
AND
    SRC Suit {HEARTS, DIAMONDS, SPADES}
    AND
        DEST Empty
        DESTSRC Suit match
MOVE VUIKAK GROCOK
OR
    DEST Rank K
    AND
        SRC Rank K
        DEST Size > 2
$win
OR
    AND
        PILE ALL DRUYUD Empty
        PILE ALL DRUYUD Empty
    PILE ALL GROCOK Empty
