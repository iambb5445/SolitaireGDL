Asaem
$cards
DECK 4 {SPADES, HEARTS}

$initial
ZEAH 3 FACE_ALL
ZEAH 5 FACE_ALL
ZEAH 6 FACE_ALL
ZEAH 5 FACE_ALL
ZEAH 9 FACE_ALL
ZEAH 5 FACE_ALL
ZEAH 9 FACE_ALL

COLUMN 5 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST

GRAZ 2 FACE_ALL
GRAZ 0 FACE_ALL
GRAZ 3 FACE_ALL
GRAZ 1 FACE_LAST
GRAZ 1 FACE_LAST

CRAINU 6 FACE_HALF
CRAINU 10 FACE_HALF
CRAINU 6 FACE_HALF
CRAINU 7 FACE_HALF
CRAINU 0 FACE_HALF
CRAINU 2 FACE_HALF

$moves
MOVE GRAZ ZEAH
OR
    AND
        DESTSRC Rank equal
        SRC Suit {SPADES, CLUBS}
    SRC Suit {CLUBS}
MOVE COLUMN COLUMN
AND
    OR
        SRC Suit {DIAMONDS, HEARTS, CLUBS}
        DESTSRC Suit match_color
    DEST Rank 1
MOVE_STACK ZEAH GRAZ
OR
    DEST Empty
    AND
        DESTSRC Rank equal
        DEST Empty
$win
PILE ALL CRAINU Empty
