Oku
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CUTEK 10 FACE_ALTERNATE_LAST
CUTEK 8 FACE_ALTERNATE_LAST
CUTEK 5 FACE_ALTERNATE_LAST
CUTEK 1 FACE_ALTERNATE_LAST
CUTEK 7 FACE_ALTERNATE_LAST
CUTEK 0 FACE_ALTERNATE_LAST
CUTEK 0 FACE_HALF
CUTEK 10 FACE_HALF

COLUMN 9 FACE_ALL
COLUMN 2 FACE_ALL

$moves
MOVE {COLUMN, CUTEK} CUTEK
AND
    OR
        DEST Size <= 3
        DEST Empty
    DEST Size >= 7
$win
OR
    PILE ALL CUTEK Empty
    PILE ALL COLUMN Empty
