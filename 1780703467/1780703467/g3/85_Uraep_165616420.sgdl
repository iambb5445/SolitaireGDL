Uraep
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 51 ROTATE 1 2 U
FEAL 5 FACE_ALTERNATE_LAST
FEAL 3 FACE_ALTERNATE_LAST
FEAL 3 FACE_ALTERNATE_LAST
FEAL 0 FACE_ALTERNATE_LAST
FEAL 9 FACE_ALTERNATE_LAST
FEAL 6 FACE_ALTERNATE_LAST
FEAL 7 FACE_ALTERNATE_LAST
FEAL 4 FACE_ALTERNATE_LAST
FEAL 1 FACE_ALTERNATE_LAST

COLUMN 8 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 6 FACE_ALL

$moves
MOVE_STACK {COLUMN, FEAL} COLUMN
AND
    DEST Suit {DIAMONDS, HEARTS, SPADES}
    AND
        SRCSTACK Rank descending
        SRCSTACK Suit alternate_color
MOVE_STACK FEAL FEAL
DESTSRC Rank descending
$win
OR
    AND
        PILE ALL FEAL Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
