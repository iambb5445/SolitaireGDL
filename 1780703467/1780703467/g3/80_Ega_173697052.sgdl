Ega
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

PROQES 10 FACE_ALL
PROQES 4 FACE_ALL
PROQES 8 FACE_ALL
PROQES 7 FACE_ALL
PROQES 6 FACE_ALL
PROQES 10 FACE_ALL
PROQES 0 FACE_ALL

$moves
MOVE PROQES COLUMN
OR
    AND
        SRC Suit {CLUBS, SPADES, DIAMONDS}
        DEST Size <= 6
    DEST Empty
MOVE_STACK {COLUMN, PROQES} COLUMN
DESTSRC Rank add_13
MOVE_STACK COLUMN PROQES
OR
    AND
        SRCSTACK Suit alternate_color
        SRC Suit {SPADES, HEARTS, DIAMONDS}
    AND
        DEST Rank 1
        DEST Empty
$win
AND
    AND
        PILE ALL PROQES Empty
        PILE ALL PROQES Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
