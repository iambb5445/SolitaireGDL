Buih
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
ENO 4 FACE_HALF
ENO 2 FACE_HALF
ENO 9 FACE_LAST
ENO 5 FACE_LAST
ENO 5 FACE_LAST

STITO 9 FACE_ALL
STITO 8 FACE_ALL
STITO 4 FACE_ALL
STITO 4 FACE_LAST
STITO 2 FACE_LAST

$moves
MOVE {ENO, STITO} ENO
DEST Rank 1
MOVE ENO STITO
AND
    AND
        DESTSRC Rank ascending
        SRC Rank 1
    DEST Suit {DIAMONDS}
$win
OR
    AND
        PILE ALL ENO Empty
        PILE ALL STITO Empty
    AND
        PILE ALL ENO Empty
        PILE ALL ENO Empty
