Waiy
$cards
DECK 4 SPADES

$initial
AHUIF 10 FACE_ALL
AHUIF 10 FACE_ALL
AHUIF 7 FACE_LAST
AHUIF 10 FACE_LAST
AHUIF 6 FACE_LAST

COLUMN 2 FACE_HALF
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL

$moves
MOVE AHUIF AHUIF
OR
    AND
        DESTSRC Suit match_color
        DEST Suit {DIAMONDS, HEARTS, CLUBS}
    AND
        DEST Suit {DIAMONDS}
        DEST Empty
MOVE_STACK {COLUMN, AHUIF} COLUMN
DESTSRC Rank equal
$win
PILE ALL AHUIF Empty
