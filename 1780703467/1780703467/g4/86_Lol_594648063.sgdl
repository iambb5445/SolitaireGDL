Lol
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
FRUIY 4 FACE_ALL
FRUIY 8 FACE_HALF
FRUIY 7 FACE_HALF
FRUIY 3 FACE_HALF
FRUIY 7 FACE_HALF
FRUIY 3 FACE_HALF
FRUIY 7 FACE_HALF
FRUIY 9 FACE_HALF

COLUMN 0 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 5 FACE_LAST

OZIOY 2 FACE_ALL
OZIOY 2 FACE_ALL
OZIOY 2 FACE_ALL
OZIOY 7 FACE_ALL
OZIOY 0 FACE_ALL
OZIOY 1 FACE_ALL
OZIOY 2 FACE_ALL

$moves
MOVE {COLUMN, FRUIY} COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        SRC Suit {SPADES}
    DEST Rank K
MOVE_STACK OZIOY FRUIY
OR
    AND
        SRC Suit {HEARTS, DIAMONDS, CLUBS}
        DEST Size <= 0
    AND
        SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
        DESTSRC Suit match_color
MOVE_STACK OZIOY OZIOY
OR
    DEST Empty
    SRC Suit {SPADES}
$win
PILE ALL FRUIY Empty
