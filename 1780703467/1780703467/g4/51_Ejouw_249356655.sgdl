Ejouw
$cards
DECK 4 SPADES

$initial
PEQI 6 FACE_LAST
PEQI 0 FACE_LAST
PEQI 1 FACE_LAST
PEQI 0 FACE_LAST

UTOL 5 FACE_ALTERNATE_LAST
UTOL 7 FACE_ALTERNATE_LAST
UTOL 8 FACE_ALTERNATE_LAST
UTOL 2 FACE_ALTERNATE_LAST

ODI 6 FACE_HALF
ODI 3 FACE_ALTERNATE_LAST

COLUMN 9 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 2 FACE_ALL

$moves
MOVE {PEQI, COLUMN, ODI, UTOL} UTOL
OR
    AND
        SRC Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
        DEST Rank 1
    AND
        DEST Empty
        SRC Suit {CLUBS, SPADES, DIAMONDS}
MOVE_STACK ODI {ODI, UTOL}
DEST Suit {DIAMONDS, HEARTS, CLUBS}
$win
AND
    OR
        PILE ALL ODI Empty
        PILE ALL ODI Empty
    PILE ALL UTOL Empty
