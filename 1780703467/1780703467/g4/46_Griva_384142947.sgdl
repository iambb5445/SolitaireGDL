Griva
$cards
DECK 8 SPADES

$initial
DRAW 56 DEAL COLUMN
COLUMN 9 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 9 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank ascending
        DEST Empty
    AND
        DEST Rank 1
        DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
SRC Suit {HEARTS}
DRAW
PILE ANY DRAW Size > 0
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty
