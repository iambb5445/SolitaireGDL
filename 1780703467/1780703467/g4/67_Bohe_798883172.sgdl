Bohe
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 46 ROTATE 1 U 1
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 9 FACE_ALL

SAR 6 FACE_LAST
SAR 6 FACE_HALF
SAR 7 FACE_HALF
SAR 1 FACE_HALF
SAR 10 FACE_HALF
SAR 6 FACE_HALF

$moves
MOVE_STACK SAR COLUMN
OR
    SRCSTACK Suit match_color
    AND
        SRCSTACK Suit match
        SRC Suit {SPADES}
MOVE_STACK COLUMN COLUMN
DEST Rank 1
$win
OR
    PILE ALL SAR Empty
    AND
        PILE ALL SAR Empty
        PILE ALL DRAW Empty
