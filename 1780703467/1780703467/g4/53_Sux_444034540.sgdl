Sux
$cards
DECK 1 {SPADES, HEARTS}

$initial
DRAW 14 DEAL PAIHUJ
PAIHUJ 3 FACE_ALL
PAIHUJ 0 FACE_ALTERNATE_LAST
PAIHUJ 0 FACE_ALTERNATE_LAST
PAIHUJ 9 FACE_ALTERNATE_LAST

$moves
MOVE PAIHUJ PAIHUJ
SRC Rank 1
MOVE_STACK PAIHUJ PAIHUJ
OR
    SRCSTACK Suit match
    AND
        SRCSTACK Rank add_13
        DEST Rank K
DRAW
PILE ALL PAIHUJ Size > 0
$win
OR
    PILE ALL DRAW Empty
    PILE ALL PAIHUJ Empty
