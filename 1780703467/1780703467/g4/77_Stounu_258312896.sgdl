Stounu
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    SRC Suit {CLUBS, SPADES, DIAMONDS}
    AND
        DESTSRC Suit alternate_color
        DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
DESTSRC Rank ascending
$win
AND
    PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
