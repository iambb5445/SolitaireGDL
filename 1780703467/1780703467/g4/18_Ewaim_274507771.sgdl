Ewaim
$cards
DECK 8 SPADES

$initial
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST

OYI 1 FACE_ALL
OYI 7 FACE_ALL
OYI 9 FACE_ALTERNATE_LAST
OYI 10 FACE_ALTERNATE_LAST
OYI 5 FACE_ALTERNATE_LAST
OYI 3 FACE_ALTERNATE_LAST

VAES 0 FACE_ALTERNATE_LAST
VAES 0 FACE_ALTERNATE_LAST
VAES 8 FACE_ALTERNATE_LAST
VAES 9 FACE_ALL
VAES 3 FACE_ALL
VAES 3 FACE_ALL
VAES 2 FACE_ALL
VAES 5 FACE_ALL
VAES 10 FACE_ALL
VAES 5 FACE_ALL

EKE 6 FACE_HALF
EKE 5 FACE_HALF

$moves
MOVE_STACK VAES COLUMN
SRCSTACK Suit alternate_color
MOVE_STACK COLUMN {COLUMN, VAES, EKE, OYI}
DESTSRC Suit match_color
$win
AND
    PILE ALL EKE Empty
    AND
        PILE ALL OYI Empty
        PILE ALL OYI Empty
