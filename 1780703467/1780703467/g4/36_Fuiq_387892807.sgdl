Fuiq
$cards
DECK 2 SPADES

$initial
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
AND
    DEST Suit {CLUBS, HEARTS, SPADES}
    OR
        DESTSRC Rank add_14
        DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    DESTSRC Rank add_14
    SRCSTACK Size <= 10
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
