Ixu
$cards
DECK 8 SPADES

$initial
DRAW 30 ROTATE 1 U 1
UCI 8 FACE_LAST
UCI 4 FACE_LAST
UCI 9 FACE_LAST
UCI 6 FACE_LAST
UCI 2 FACE_LAST

COLUMN 8 FACE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {COLUMN, UCI} COLUMN
OR
    AND
        SRCSTACK Rank equal
        DEST Empty
    SRC Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
$win
OR
    AND
        PILE ALL UCI Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL UCI Empty
        PILE ALL DRAW Empty
