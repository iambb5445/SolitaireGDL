Driw
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 27 DEAL {COLUMN, IGAIB}
IPIOH 2 FACE_ALTERNATE_LAST
IPIOH 4 FACE_ALTERNATE_LAST
IPIOH 4 FACE_ALTERNATE_LAST
IPIOH 7 FACE_ALTERNATE_LAST
IPIOH 1 FACE_ALTERNATE_LAST
IPIOH 3 FACE_ALTERNATE_LAST

ODU 2 FACE_LAST
ODU 3 FACE_LAST
ODU 8 FACE_LAST
ODU 4 FACE_LAST
ODU 4 FACE_LAST
ODU 0 FACE_LAST
ODU 3 FACE_LAST
ODU 8 FACE_LAST

COLUMN 1 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 5 FACE_ALL

IGAIB 1 FACE_LAST
IGAIB 5 FACE_HALF
IGAIB 4 FACE_HALF

$moves
MOVE {IGAIB, COLUMN, IPIOH, ODU} COLUMN
DESTSRC Suit match
MOVE IGAIB ODU
DEST Size >= 3
$win
PILE ALL DRAW Empty
