Puikic
$cards
DECK 4 SPADES

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALL
COLUMN 10 FACE_ALL

CROUME 9 FACE_ALTERNATE_LAST
CROUME 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK CROUME COLUMN
OR
    AND
        DEST Suit {HEARTS, CLUBS, SPADES}
        SRC Suit {DIAMONDS}
    AND
        DEST Size > 2
        SRCSTACK Rank add_13
$win
PILE ALL CROUME Empty
