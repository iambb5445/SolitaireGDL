Inoc
$cards
DECK 4 SPADES

$initial
DRAW 21 ROTATE 3 U 3
OCE 4 FACE_ALTERNATE_LAST
OCE 7 FACE_ALTERNATE_LAST
OCE 8 FACE_ALTERNATE_LAST
OCE 6 FACE_ALTERNATE_LAST
OCE 6 FACE_ALTERNATE_LAST

$moves
MOVE OCE OCE
OR
    SRC Suit {SPADES, DIAMONDS}
    DESTSRC Rank add_13
MOVE DRAW OCE
DESTSRC Rank descending
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL OCE Empty
        PILE ALL DRAW Empty
