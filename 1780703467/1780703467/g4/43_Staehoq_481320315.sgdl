Staehoq
$cards
DECK 4 {SPADES, CLUBS}

$initial
USI 0 FACE_ALTERNATE_LAST
USI 0 FACE_ALTERNATE_LAST
USI 0 FACE_ALTERNATE_LAST
USI 8 FACE_ALTERNATE_LAST
USI 3 FACE_ALTERNATE_LAST
USI 3 FACE_ALTERNATE_LAST
USI 5 FACE_ALTERNATE_LAST
USI 0 FACE_ALTERNATE_LAST
USI 7 FACE_ALTERNATE_LAST
USI 1 FACE_ALTERNATE_LAST

HEKIS 4 FACE_ALL
HEKIS 10 FACE_ALL
HEKIS 3 FACE_ALL
HEKIS 4 FACE_LAST

COLUMN 2 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 0 FACE_LAST

EGET 4 FACE_LAST
EGET 1 FACE_LAST
EGET 0 FACE_LAST
EGET 2 FACE_LAST

ADOP 2 FACE_LAST
ADOP 0 FACE_LAST
ADOP 2 FACE_LAST
ADOP 2 FACE_LAST
ADOP 9 FACE_LAST
ADOP 7 FACE_LAST
ADOP 5 FACE_LAST
ADOP 1 FACE_LAST

$moves
MOVE_STACK {EGET, HEKIS, USI} EGET
AND
    DEST Size >= 8
    AND
        SRCSTACK Suit match_color
        SRCSTACK Size > 2
$win
AND
    PILE ALL ADOP Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL HEKIS Empty
