Dig
$cards
DECK 1 {SPADES, HEARTS}

$initial
DOUCA 4 FACE_ALTERNATE_LAST
DOUCA 3 FACE_ALTERNATE_LAST
DOUCA 8 FACE_ALTERNATE_LAST
DOUCA 9 FACE_ALTERNATE_LAST
DOUCA 2 FACE_ALTERNATE_LAST

$moves
MOVE DOUCA DOUCA
SRC Suit {SPADES, HEARTS}
MOVE_STACK DOUCA DOUCA
OR
    AND
        DEST Suit {DIAMONDS, HEARTS, CLUBS, SPADES}
        DEST Rank 1
    AND
        DESTSRC Rank equal
        SRC Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
$win
OR
    PILE ALL DOUCA Empty
    AND
        PILE ALL DOUCA Empty
        PILE ALL DOUCA Empty
