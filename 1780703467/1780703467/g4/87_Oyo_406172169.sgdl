Oyo
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 0 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 7 FACE_LAST

EDAIX 8 FACE_LAST
EDAIX 0 FACE_ALTERNATE_LAST
EDAIX 3 FACE_ALTERNATE_LAST

$moves
MOVE EDAIX COLUMN
OR
    SRC Suit {DIAMONDS, CLUBS}
    AND
        SRC Rank 1
        SRC Rank K
MOVE_STACK COLUMN COLUMN
AND
    DEST Empty
    OR
        SRCSTACK Size < 2
        SRCSTACK Suit match
MOVE_STACK EDAIX COLUMN
SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
