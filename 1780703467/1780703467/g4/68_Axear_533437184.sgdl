Axear
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
PRUVO 8 FACE_ALL
PRUVO 10 FACE_ALL
PRUVO 0 FACE_ALL
PRUVO 3 FACE_ALL
PRUVO 3 FACE_ALL
PRUVO 10 FACE_ALL
PRUVO 2 FACE_ALL
PRUVO 9 FACE_ALL

PRAIYES 0 FACE_HALF
PRAIYES 4 FACE_HALF
PRAIYES 1 FACE_HALF
PRAIYES 2 FACE_HALF

BEJI 4 FACE_ALL
BEJI 8 FACE_ALL
BEJI 2 FACE_ALL
BEJI 0 FACE_ALL
BEJI 3 FACE_LAST

DUIZ 5 FACE_ALTERNATE_LAST

SAIGOM 9 FACE_ALL
SAIGOM 4 FACE_ALL
SAIGOM 1 FACE_ALL
SAIGOM 0 FACE_ALL
SAIGOM 2 FACE_ALL
SAIGOM 3 FACE_ALL
SAIGOM 5 FACE_ALL

KAIGAS 1 FACE_ALTERNATE_LAST
KAIGAS 5 FACE_ALTERNATE_LAST

$moves
MOVE {KAIGAS, SAIGOM, PRUVO, DUIZ, PRAIYES} KAIGAS
DEST Suit {HEARTS, SPADES, DIAMONDS}
MOVE BEJI {DUIZ, KAIGAS, BEJI}
OR
    AND
        DESTSRC Suit match
        DESTSRC Rank equal
    AND
        SRC Suit {HEARTS, DIAMONDS}
        DESTSRC Rank add_13
$win
AND
    PILE ALL PRAIYES Empty
    PILE ALL BEJI Empty
