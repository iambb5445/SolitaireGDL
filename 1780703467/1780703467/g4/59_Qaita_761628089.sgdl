Qaita
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 41 ROTATE 1 1 U
TIOFO 0 FACE_ALTERNATE_LAST
TIOFO 1 FACE_ALL

COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

$moves
MOVE DRAW TIOFO
AND
    OR
        DESTSRC Rank equal
        DEST Size <= 1
    OR
        DEST Rank K
        DEST Size < 4
MOVE {COLUMN, DRAW} COLUMN
OR
    DEST Suit {DIAMONDS, CLUBS}
    AND
        DEST Size < 5
        DEST Rank K
MOVE_STACK TIOFO TIOFO
DESTSRC Rank equal
$win
OR
    PILE ALL TIOFO Empty
    AND
        PILE ALL TIOFO Empty
        PILE ALL DRAW Empty
