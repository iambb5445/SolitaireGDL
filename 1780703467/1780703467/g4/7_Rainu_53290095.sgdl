Rainu
$cards
DECK 2 SPADES

$initial
LUDI 4 FACE_ALL
LUDI 0 FACE_LAST

COLUMN 0 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST

$moves
MOVE LUDI LUDI
DEST Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    SRC Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
    SRCSTACK Size >= 1
MOVE_STACK {COLUMN, LUDI} LUDI
OR
    AND
        SRC Rank K
        SRCSTACK Suit alternate_color
    SRC Suit {HEARTS, CLUBS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
