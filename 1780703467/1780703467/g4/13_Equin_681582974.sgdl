Equin
$cards
DECK 2 {SPADES, CLUBS}

$initial
XOUVOH 4 FACE_ALTERNATE_LAST
XOUVOH 9 FACE_ALTERNATE_LAST
XOUVOH 7 FACE_ALL
XOUVOH 1 FACE_ALL
XOUVOH 8 FACE_ALL
XOUVOH 5 FACE_ALL
XOUVOH 0 FACE_ALL
XOUVOH 2 FACE_ALL

DIQA 8 FACE_LAST
DIQA 8 FACE_LAST

$moves
MOVE {XOUVOH, DIQA} DIQA
DEST Empty
MOVE {DIQA, XOUVOH} XOUVOH
DEST Suit {CLUBS}
MOVE_STACK XOUVOH DIQA
OR
    SRC Suit {DIAMONDS}
    AND
        DESTSRC Suit alternate_color
        DESTSRC Suit alternate_color
MOVE_STACK XOUVOH XOUVOH
OR
    AND
        SRCSTACK Size == 7
        DESTSRC Rank equal
    AND
        DESTSRC Suit alternate_color
        DEST Suit {SPADES, DIAMONDS, HEARTS}
$win
PILE ALL DIQA Empty
