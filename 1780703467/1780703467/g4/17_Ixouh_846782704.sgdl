Ixouh
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EBOB 10 FACE_HALF

COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

AGAER 3 FACE_LAST
AGAER 6 FACE_LAST
AGAER 6 FACE_LAST

EZI 9 FACE_ALL
EZI 5 FACE_HALF
EZI 1 FACE_HALF

$moves
MOVE COLUMN AGAER
AND
    DESTSRC Suit match
    OR
        DEST Suit {HEARTS, CLUBS, SPADES}
        DEST Rank K
MOVE_STACK EBOB COLUMN
OR
    SRC Rank K
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank descending
MOVE_STACK {AGAER, EZI, COLUMN} EZI
DESTSRC Suit match
$win
AND
    OR
        PILE ALL EBOB Empty
        PILE ALL EZI Empty
    OR
        PILE ALL AGAER Empty
        PILE ALL AGAER Empty
