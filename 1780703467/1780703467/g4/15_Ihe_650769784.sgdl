Ihe
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 0 FACE_LAST
COLUMN 7 FACE_LAST

OKE 9 FACE_ALTERNATE_LAST
OKE 9 FACE_ALTERNATE_LAST
OKE 10 FACE_ALTERNATE_LAST
OKE 3 FACE_ALTERNATE_LAST
OKE 4 FACE_ALL
OKE 7 FACE_ALL

BEVAT 1 FACE_HALF
BEVAT 3 FACE_HALF
BEVAT 9 FACE_HALF
BEVAT 6 FACE_HALF
BEVAT 4 FACE_HALF
BEVAT 2 FACE_HALF
BEVAT 10 FACE_HALF
BEVAT 9 FACE_HALF
BEVAT 2 FACE_HALF

SEAGE 1 FACE_LAST
SEAGE 2 FACE_LAST
SEAGE 1 FACE_LAST
SEAGE 0 FACE_LAST
SEAGE 2 FACE_HALF
SEAGE 3 FACE_HALF

$moves
MOVE_STACK {COLUMN, SEAGE, OKE, BEVAT} BEVAT
OR
    SRCSTACK Size < 9
    SRCSTACK Size > 6
MOVE_STACK COLUMN OKE
OR
    SRCSTACK Size <= 5
    AND
        DEST Size < 8
        DEST Rank 1
$win
PILE ALL OKE Empty
