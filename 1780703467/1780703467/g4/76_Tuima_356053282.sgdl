Tuima
$cards
DECK 2 {SPADES, CLUBS}

$initial
VOUSIL 8 FACE_LAST
VOUSIL 6 FACE_LAST
VOUSIL 4 FACE_LAST
VOUSIL 10 FACE_LAST
VOUSIL 5 FACE_LAST
VOUSIL 0 FACE_LAST
VOUSIL 4 FACE_LAST

VUINAF 1 FACE_HALF
VUINAF 2 FACE_HALF
VUINAF 3 FACE_HALF

COLUMN 9 FACE_HALF
COLUMN 0 FACE_LAST

$moves
MOVE VUINAF VUINAF
DEST Suit {CLUBS, DIAMONDS, SPADES}
MOVE {VUINAF, COLUMN} COLUMN
DESTSRC Rank add_13
MOVE_STACK {COLUMN, VOUSIL, VUINAF} COLUMN
OR
    AND
        SRC Rank 1
        DESTSRC Suit match_color
    AND
        DEST Empty
        SRCSTACK Suit alternate_color
MOVE_STACK VOUSIL VUINAF
DESTSRC Rank add_14
$win
OR
    PILE ALL VOUSIL Empty
    AND
        PILE ALL VUINAF Empty
        PILE ALL COLUMN Empty
