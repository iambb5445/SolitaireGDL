Ivi
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 65 ROTATE 1 U 2
HOY 8 FACE_ALL
HOY 10 FACE_ALTERNATE_LAST
HOY 1 FACE_ALTERNATE_LAST
HOY 4 FACE_ALTERNATE_LAST
HOY 0 FACE_ALTERNATE_LAST
HOY 5 FACE_ALTERNATE_LAST
HOY 2 FACE_ALTERNATE_LAST
HOY 9 FACE_ALTERNATE_LAST

$moves
MOVE HOY HOY
OR
    DEST Rank 1
    AND
        SRC Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
        SRC Suit {HEARTS, CLUBS}
$win
PILE ALL DRAW Empty
