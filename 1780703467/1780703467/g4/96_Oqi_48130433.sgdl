Oqi
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 2 FACE_ALL

MUXOW 7 FACE_ALTERNATE_LAST
MUXOW 6 FACE_ALTERNATE_LAST
MUXOW 5 FACE_ALTERNATE_LAST
MUXOW 10 FACE_ALTERNATE_LAST
MUXOW 0 FACE_ALTERNATE_LAST
MUXOW 8 FACE_ALTERNATE_LAST
MUXOW 5 FACE_ALTERNATE_LAST
MUXOW 8 FACE_ALTERNATE_LAST
MUXOW 1 FACE_ALTERNATE_LAST

$moves
MOVE MUXOW COLUMN
DEST Rank 1
MOVE_STACK MUXOW COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        DEST Suit {CLUBS, DIAMONDS, HEARTS}
    AND
        SRCSTACK Size >= 2
        DESTSRC Suit alternate_color
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL MUXOW Empty
