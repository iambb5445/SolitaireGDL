Gaex
$cards
DECK 8 SPADES

$initial
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF

OPIOL 3 FACE_HALF
OPIOL 9 FACE_HALF
OPIOL 10 FACE_HALF
OPIOL 4 FACE_HALF

RISEF 6 FACE_ALL
RISEF 10 FACE_ALL
RISEF 4 FACE_ALL
RISEF 6 FACE_ALL
RISEF 6 FACE_ALL
RISEF 0 FACE_ALL
RISEF 7 FACE_ALL
RISEF 4 FACE_ALL
RISEF 6 FACE_ALL

EJO 2 FACE_ALL
EJO 9 FACE_ALL
EJO 4 FACE_LAST
EJO 5 FACE_LAST
EJO 4 FACE_LAST

$moves
MOVE RISEF EJO
SRC Rank K
MOVE COLUMN RISEF
OR
    AND
        DEST Empty
        DEST Empty
    AND
        DEST Suit {CLUBS, SPADES, DIAMONDS}
        SRC Suit {DIAMONDS, SPADES, HEARTS}
MOVE_STACK COLUMN {COLUMN, OPIOL}
SRC Rank 1
MOVE_STACK OPIOL {OPIOL, EJO, RISEF}
OR
    AND
        SRCSTACK Suit alternate_color
        DESTSRC Rank equal
    SRC Rank 1
$win
PILE ALL RISEF Empty
