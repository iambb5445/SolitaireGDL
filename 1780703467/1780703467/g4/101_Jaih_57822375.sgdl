Jaih
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 76 DEAL AXAIM
AXAIM 0 FACE_LAST
AXAIM 3 FACE_LAST
AXAIM 3 FACE_HALF
AXAIM 2 FACE_HALF
AXAIM 5 FACE_HALF
AXAIM 5 FACE_HALF
AXAIM 7 FACE_HALF
AXAIM 3 FACE_HALF

$moves
MOVE AXAIM AXAIM
OR
    AND
        SRC Suit {SPADES, CLUBS, HEARTS, DIAMONDS}
        SRC Suit {HEARTS, CLUBS}
    AND
        DEST Empty
        DEST Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
MOVE_STACK AXAIM AXAIM
SRC Rank 1
DRAW
PILE ALL DRAW Size > 0
$win
PILE ALL AXAIM Empty
