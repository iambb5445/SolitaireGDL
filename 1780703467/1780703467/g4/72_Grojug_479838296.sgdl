Grojug
$cards
DECK 4 SPADES

$initial
NENOQ 3 FACE_HALF
NENOQ 0 FACE_ALTERNATE_LAST
NENOQ 7 FACE_ALTERNATE_LAST
NENOQ 2 FACE_ALTERNATE_LAST
NENOQ 6 FACE_ALTERNATE_LAST
NENOQ 5 FACE_ALTERNATE_LAST
NENOQ 10 FACE_ALTERNATE_LAST
NENOQ 7 FACE_ALTERNATE_LAST
NENOQ 5 FACE_ALTERNATE_LAST

COLUMN 6 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE {COLUMN, NENOQ} NENOQ
OR
    AND
        DEST Suit {CLUBS, SPADES}
        DESTSRC Suit match_color
    AND
        DEST Rank 1
        DEST Empty
MOVE {NENOQ, COLUMN} COLUMN
DEST Size > 4
$win
PILE ALL NENOQ Empty
