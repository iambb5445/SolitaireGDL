Roufu
$cards
DECK 2 {SPADES, CLUBS}

$initial
IPOUJ 7 FACE_ALTERNATE_LAST
IPOUJ 4 FACE_ALTERNATE_LAST
IPOUJ 10 FACE_ALTERNATE_LAST
IPOUJ 1 FACE_ALTERNATE_LAST
IPOUJ 8 FACE_ALTERNATE_LAST

WOGAP 7 FACE_ALTERNATE_LAST
WOGAP 3 FACE_ALTERNATE_LAST
WOGAP 2 FACE_ALTERNATE_LAST
WOGAP 10 FACE_ALTERNATE_LAST
WOGAP 0 FACE_ALTERNATE_LAST

$moves
MOVE IPOUJ WOGAP
AND
    OR
        DESTSRC Suit match_color
        DEST Empty
    SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE_STACK IPOUJ IPOUJ
AND
    OR
        DESTSRC Rank ascending
        DESTSRC Suit match_color
    OR
        SRC Rank K
        SRCSTACK Suit match_color
$win
OR
    PILE ALL IPOUJ Empty
    AND
        PILE ALL IPOUJ Empty
        PILE ALL WOGAP Empty
