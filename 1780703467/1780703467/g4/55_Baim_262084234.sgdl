Baim
$cards
DECK 8 SPADES

$initial
XOUBO 4 FACE_HALF
XOUBO 9 FACE_HALF
XOUBO 4 FACE_ALTERNATE_LAST
XOUBO 0 FACE_ALTERNATE_LAST
XOUBO 10 FACE_ALTERNATE_LAST

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF

HAGIY 2 FACE_ALL
HAGIY 6 FACE_ALL
HAGIY 0 FACE_ALL
HAGIY 8 FACE_ALL
HAGIY 4 FACE_ALL
HAGIY 6 FACE_ALL
HAGIY 8 FACE_ALL

PUIYUS 7 FACE_ALL

EVEG 8 FACE_LAST

QAICID 5 FACE_HALF
QAICID 0 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {HAGIY, QAICID, XOUBO, COLUMN, PUIYUS, EVEG} HAGIY
DEST Empty
MOVE_STACK {XOUBO, EVEG, HAGIY} QAICID
OR
    DEST Suit {DIAMONDS, HEARTS, SPADES}
    AND
        DEST Empty
        SRC Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
$win
PILE ALL PUIYUS Empty
