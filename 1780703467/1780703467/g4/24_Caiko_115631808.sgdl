Caiko
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 14 DEAL {COLUMN, STOUMIP}
COLUMN 10 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL

STOUMIP 2 FACE_ALTERNATE_LAST
STOUMIP 8 FACE_ALTERNATE_LAST
STOUMIP 5 FACE_ALTERNATE_LAST
STOUMIP 9 FACE_ALTERNATE_LAST
STOUMIP 6 FACE_ALTERNATE_LAST
STOUMIP 8 FACE_ALTERNATE_LAST
STOUMIP 10 FACE_ALTERNATE_LAST
STOUMIP 4 FACE_LAST
STOUMIP 6 FACE_LAST
STOUMIP 6 FACE_LAST

$moves
MOVE {COLUMN, STOUMIP} COLUMN
OR
    AND
        DESTSRC Rank ascending
        DEST Size < 10
    DEST Size == 5
MOVE STOUMIP STOUMIP
AND
    OR
        DESTSRC Rank add_14
        DEST Empty
    DESTSRC Suit match_color
MOVE_STACK STOUMIP STOUMIP
AND
    AND
        SRCSTACK Rank add_13
        DESTSRC Suit match
    DEST Empty
$win
PILE ALL STOUMIP Empty
