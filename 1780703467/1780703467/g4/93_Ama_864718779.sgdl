Ama
$cards
DECK 2 SPADES

$initial
CUQE 3 FACE_LAST

COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 4 FACE_LAST

$moves
MOVE_STACK CUQE CUQE
OR
    AND
        DEST Empty
        SRCSTACK Size > 1
    SRC Suit {HEARTS, SPADES}
MOVE_STACK CUQE COLUMN
AND
    DEST Suit {SPADES, HEARTS, DIAMONDS, CLUBS}
    AND
        SRC Rank 1
        SRCSTACK Rank ascending
$win
PILE ALL CUQE Empty
