Qivum
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 3 FACE_HALF

ESU 6 FACE_ALTERNATE_LAST
ESU 10 FACE_ALTERNATE_LAST
ESU 10 FACE_ALTERNATE_LAST
ESU 6 FACE_ALTERNATE_LAST
ESU 7 FACE_ALTERNATE_LAST
ESU 2 FACE_ALTERNATE_LAST
ESU 6 FACE_ALTERNATE_LAST

XUIJ 1 FACE_LAST
XUIJ 10 FACE_LAST
XUIJ 6 FACE_LAST
XUIJ 3 FACE_HALF
XUIJ 7 FACE_HALF

GROUL 10 FACE_ALTERNATE_LAST
GROUL 5 FACE_ALTERNATE_LAST
GROUL 2 FACE_HALF

$moves
MOVE ESU XUIJ
OR
    AND
        DEST Rank 1
        DEST Rank K
    DEST Suit {HEARTS, SPADES}
MOVE COLUMN GROUL
AND
    AND
        SRC Suit {SPADES, DIAMONDS}
        DESTSRC Suit match_color
    OR
        SRC Suit {SPADES, HEARTS, DIAMONDS, CLUBS}
        DESTSRC Suit alternate_color
MOVE_STACK GROUL GROUL
SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
MOVE_STACK COLUMN ESU
OR
    SRCSTACK Suit match_color
    SRCSTACK Rank ascending
$win
OR
    PILE ALL ESU Empty
    PILE ALL COLUMN Empty
