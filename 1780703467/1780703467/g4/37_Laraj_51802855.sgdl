Laraj
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 2 ROTATE 3 U 1
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

IGE 1 FACE_ALL
IGE 0 FACE_ALL
IGE 10 FACE_ALL

$moves
MOVE {IGE, DRAW} COLUMN
OR
    DEST Rank 1
    AND
        DESTSRC Rank add_13
        SRC Rank K
MOVE_STACK IGE COLUMN
DEST Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
MOVE_STACK IGE IGE
DEST Size == 5
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL IGE Empty
    PILE ALL COLUMN Empty
