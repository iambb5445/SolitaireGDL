Oto
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
DEST Size == 5
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
