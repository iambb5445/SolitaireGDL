Kuijus
$cards
DECK 2 SPADES

$initial
COLUMN 2 FACE_ALTERNATE_LAST

IPE 1 FACE_ALL
IPE 5 FACE_ALL
IPE 5 FACE_ALL
IPE 5 FACE_ALL

LIOZUG 7 FACE_LAST
LIOZUG 1 FACE_LAST

$moves
MOVE {IPE, COLUMN, LIOZUG} IPE
AND
    DEST Size == 4
    DEST Size <= 3
MOVE_STACK {LIOZUG, COLUMN} IPE
OR
    AND
        SRCSTACK Suit alternate_color
        DESTSRC Suit match_color
    DEST Rank K
MOVE_STACK IPE LIOZUG
DEST Suit {SPADES}
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL IPE Empty
