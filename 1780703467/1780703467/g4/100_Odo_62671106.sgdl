Odo
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 58 DEAL QEFA
QEFA 10 FACE_ALL
QEFA 0 FACE_ALL
QEFA 0 FACE_ALL
QEFA 0 FACE_ALL
QEFA 3 FACE_ALL
QEFA 2 FACE_ALL
QEFA 0 FACE_ALL
QEFA 6 FACE_ALL
QEFA 10 FACE_ALL
QEFA 7 FACE_ALTERNATE_LAST

COLUMN 3 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 5 FACE_LAST

$moves
MOVE QEFA COLUMN
OR
    DEST Suit {HEARTS}
    SRC Suit {SPADES, DIAMONDS, CLUBS}
MOVE_STACK QEFA QEFA
OR
    AND
        DESTSRC Rank add_13
        SRC Suit {HEARTS, SPADES}
    DESTSRC Rank add_14
MOVE_STACK {COLUMN, QEFA} COLUMN
DEST Suit {CLUBS}
DRAW
PILE ALL QEFA Size > 0
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL QEFA Empty
