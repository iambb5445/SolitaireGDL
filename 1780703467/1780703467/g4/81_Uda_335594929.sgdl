Uda
$cards
DECK 8 SPADES

$initial
COLUMN 2 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 9 FACE_LAST

ETU 5 FACE_ALL
ETU 1 FACE_ALL
ETU 3 FACE_ALL
ETU 9 FACE_ALL

ORU 4 FACE_LAST
ORU 9 FACE_LAST
ORU 2 FACE_LAST
ORU 4 FACE_LAST
ORU 5 FACE_LAST
ORU 4 FACE_LAST
ORU 5 FACE_LAST

FIOG 10 FACE_LAST
FIOG 7 FACE_LAST

$moves
MOVE_STACK {FIOG, ETU, ORU, COLUMN} ETU
OR
    AND
        SRCSTACK Size > 3
        SRCSTACK Size < 1
    AND
        DEST Rank 1
        DEST Suit {CLUBS, DIAMONDS}
$win
PILE ALL COLUMN Empty
