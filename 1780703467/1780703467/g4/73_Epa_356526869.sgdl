Epa
$cards
DECK 4 {SPADES, CLUBS}

$initial
UXEN 8 FACE_HALF
UXEN 4 FACE_ALL
UXEN 8 FACE_ALL
UXEN 6 FACE_ALL
UXEN 0 FACE_ALL
UXEN 1 FACE_ALL
UXEN 6 FACE_ALL
UXEN 6 FACE_ALL

COLUMN 10 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST

KOKE 8 FACE_ALL
KOKE 9 FACE_ALL
KOKE 3 FACE_ALL
KOKE 4 FACE_ALL
KOKE 6 FACE_ALL
KOKE 9 FACE_ALL

TEAQI 0 FACE_LAST
TEAQI 2 FACE_LAST

$moves
MOVE {TEAQI, UXEN, KOKE} TEAQI
OR
    DEST Size > 10
    AND
        DEST Rank 1
        DEST Rank K
MOVE {COLUMN, UXEN, KOKE} KOKE
DESTSRC Suit match_color
$win
OR
    AND
        PILE ALL KOKE Empty
        PILE ALL KOKE Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL UXEN Empty
