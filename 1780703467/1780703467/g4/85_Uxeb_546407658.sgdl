Uxeb
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 1 DEAL COLUMN
COLUMN 9 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 4 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 8 FACE_LAST

$moves
MOVE COLUMN COLUMN
DESTSRC Suit match
MOVE_STACK COLUMN COLUMN
OR
    SRCSTACK Size == 7
    DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
