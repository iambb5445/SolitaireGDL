Nojoj
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 33 ROTATE 3 U 2
COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 5 FACE_ALTERNATE_LAST

$moves
MOVE_STACK COLUMN COLUMN
AND
    SRCSTACK Size <= 7
    OR
        DESTSRC Suit match
        SRCSTACK Rank equal
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
