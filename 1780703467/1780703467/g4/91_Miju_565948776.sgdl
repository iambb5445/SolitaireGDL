Miju
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 9 DEAL {IZUIG, CAIB, UDO, COLUMN}
UDO 10 FACE_ALL

IZUIG 1 FACE_LAST
IZUIG 4 FACE_LAST
IZUIG 1 FACE_LAST
IZUIG 9 FACE_LAST
IZUIG 2 FACE_LAST
IZUIG 2 FACE_LAST
IZUIG 5 FACE_LAST
IZUIG 5 FACE_LAST

CAIB 3 FACE_LAST
CAIB 9 FACE_LAST
CAIB 0 FACE_LAST
CAIB 10 FACE_LAST
CAIB 8 FACE_HALF
CAIB 4 FACE_HALF
CAIB 4 FACE_HALF

COLUMN 8 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE {COLUMN, UDO, IZUIG} COLUMN
DEST Rank K
MOVE {CAIB, IZUIG, UDO, COLUMN} UDO
SRC Rank K
MOVE_STACK {COLUMN, IZUIG} COLUMN
DEST Size <= 1
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL CAIB Empty
    PILE ALL COLUMN Empty
