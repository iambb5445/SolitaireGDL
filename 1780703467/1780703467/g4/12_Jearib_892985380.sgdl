Jearib
$cards
DECK 2 SPADES

$initial
COLUMN 3 FACE_ALL
COLUMN 0 FACE_HALF
COLUMN 5 FACE_HALF

URAC 8 FACE_ALTERNATE_LAST
URAC 8 FACE_LAST
URAC 0 FACE_LAST
URAC 2 FACE_LAST

$moves
MOVE COLUMN URAC
DEST Empty
MOVE URAC COLUMN
SRC Rank K
MOVE_STACK URAC COLUMN
SRC Rank K
MOVE_STACK URAC URAC
DESTSRC Suit alternate_color
$win
OR
    PILE ALL URAC Empty
    AND
        PILE ALL URAC Empty
        PILE ALL COLUMN Empty
