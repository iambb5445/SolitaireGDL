Muiy
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 64 ROTATE 1 2 U
KIOL 6 FACE_LAST
KIOL 8 FACE_LAST
KIOL 1 FACE_ALTERNATE_LAST

IFIH 0 FACE_ALL
IFIH 0 FACE_ALL
IFIH 2 FACE_ALL
IFIH 7 FACE_ALL
IFIH 0 FACE_ALL
IFIH 10 FACE_ALL
IFIH 6 FACE_HALF

$moves
MOVE_STACK KIOL KIOL
DEST Size == 7
MOVE_STACK KIOL IFIH
OR
    AND
        DEST Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
        DEST Suit {SPADES}
    AND
        DEST Rank K
        DEST Suit {CLUBS}
$win
AND
    OR
        PILE ALL IFIH Empty
        PILE ALL KIOL Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
