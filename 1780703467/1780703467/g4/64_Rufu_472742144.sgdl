Rufu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 4 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 7 FACE_LAST

NUL 1 FACE_ALL

$moves
MOVE {COLUMN, NUL} COLUMN
AND
    DEST Suit {DIAMONDS}
    OR
        DEST Empty
        DEST Rank 1
MOVE_STACK COLUMN COLUMN
AND
    DEST Suit {SPADES, CLUBS, DIAMONDS}
    SRCSTACK Suit match_color
MOVE_STACK COLUMN NUL
AND
    OR
        SRCSTACK Size > 8
        DEST Size <= 3
    SRCSTACK Rank add_14
$win
PILE ALL NUL Empty
