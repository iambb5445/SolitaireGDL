Priodaf
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 10 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    DESTSRC Rank equal
    AND
        DEST Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
        SRCSTACK Suit match
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
