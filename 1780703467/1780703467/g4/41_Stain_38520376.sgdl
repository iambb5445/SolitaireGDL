Stain
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 56 DEAL COLUMN
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank add_14
        DESTSRC Rank equal
    AND
        DEST Size > 8
        DEST Suit {CLUBS}
MOVE_STACK COLUMN COLUMN
SRC Suit {DIAMONDS, HEARTS}
DRAW
PILE ANY COLUMN Empty
$win
PILE ALL DRAW Empty
