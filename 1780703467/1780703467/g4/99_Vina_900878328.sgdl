Vina
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 44 DEAL DROUV
DROUV 8 FACE_ALL

$moves
MOVE DROUV DROUV
AND
    AND
        DEST Size <= 4
        DEST Suit {DIAMONDS, CLUBS, SPADES}
    DEST Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
MOVE_STACK DROUV DROUV
AND
    OR
        DEST Empty
        SRC Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
    OR
        DEST Rank 1
        DESTSRC Rank equal
DRAW
PILE ALL DROUV Size > 0
$win
PILE ALL DRAW Empty
