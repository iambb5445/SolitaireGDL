Qahev
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 2 ROTATE 3 U 1
COLUMN 3 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 2 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Empty
        DESTSRC Suit alternate_color
    AND
        DEST Empty
        DESTSRC Suit match
MOVE_STACK COLUMN COLUMN
DEST Size < 3
$win
AND
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
