OLAEG 7 FACE_HALF
OLAEG 1 FACE_HALF

$moves
MOVE_STACK {OLAEG, EPAIL, EXEG, COLUMN} EXEG
OR
    AND
        SRC Rank K
        SRCSTACK Size > 6
    DESTSRC Suit match_color
MOVE_STACK EXEG OLAEG
OR
    AND
        DEST Rank 1
        SRC Suit {HEARTS}
    SRCSTACK Suit match_color
$win
OR
    PILE ALL EXEG Empty
    AND
        PILE ALL OLAEG Empty
        PILE ALL EXEG Empty
