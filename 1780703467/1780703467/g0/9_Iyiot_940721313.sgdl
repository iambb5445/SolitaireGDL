Iyiot
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 6 DEAL YEAK
COLUMN 3 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 7 FACE_HALF

YEAK 9 FACE_ALTERNATE_LAST
YEAK 4 FACE_ALTERNATE_LAST
YEAK 9 FACE_LAST
YEAK 10 FACE_LAST
YEAK 8 FACE_LAST

HUGU 0 FACE_HALF
HUGU 9 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN YEAK
OR
    AND
        DESTSRC Rank equal
        DEST Size <= 8
    AND
        DEST Size < 4
        DEST Suit {CLUBS}
MOVE COLUMN {COLUMN, HUGU}
AND
    OR
        DEST Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
        SRC Suit {DIAMONDS, CLUBS}
    DEST Suit {DIAMONDS, SPADES}
MOVE_STACK COLUMN COLUMN
SRC Rank K
$win
AND
    PILE ALL YEAK Empty
    PILE ALL COLUMN Empty
