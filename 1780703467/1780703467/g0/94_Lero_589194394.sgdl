Lero
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 16 ROTATE 1 U 1
COLUMN 2 FACE_ALL
COLUMN 7 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 10 FACE_HALF

OLEAV 8 FACE_ALTERNATE_LAST
OLEAV 3 FACE_ALTERNATE_LAST
OLEAV 4 FACE_ALTERNATE_LAST
OLEAV 8 FACE_HALF
OLEAV 6 FACE_HALF
OLEAV 10 FACE_HALF
OLEAV 6 FACE_HALF
OLEAV 0 FACE_HALF
OLEAV 3 FACE_HALF
OLEAV 8 FACE_HALF

$moves
MOVE COLUMN COLUMN
DESTSRC Rank add_13
MOVE DRAW COLUMN
AND
    AND
        SRC Suit {SPADES}
        SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
    DESTSRC Suit match_color
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL OLEAV Empty
        PILE ALL DRAW Empty
