Xiteb
$cards
DECK 1 {SPADES, CLUBS}

$initial
ELIM 2 FACE_LAST

COLUMN 9 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 3 FACE_ALL

OVUIL 2 FACE_HALF
OVUIL 6 FACE_HALF
OVUIL 0 FACE_HALF
OVUIL 4 FACE_HALF

$moves
MOVE {ELIM, OVUIL, COLUMN} ELIM
OR
    DESTSRC Rank ascending
    DEST Size > 7
MOVE_STACK {ELIM, COLUMN, OVUIL} ELIM
OR
    DESTSRC Rank add_13
    AND
        SRC Suit {DIAMONDS, CLUBS, HEARTS}
        DESTSRC Rank equal
$win
PILE ALL COLUMN Empty
