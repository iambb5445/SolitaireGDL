Troru
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 4 FACE_ALL

$moves
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Rank add_13
        DESTSRC Rank add_13
    SRC Rank 1
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
