Ari
$cards
DECK 2 SPADES

$initial
TREAZUP 5 FACE_LAST
TREAZUP 8 FACE_ALTERNATE_LAST
TREAZUP 1 FACE_ALTERNATE_LAST
TREAZUP 5 FACE_ALTERNATE_LAST
TREAZUP 0 FACE_ALTERNATE_LAST
TREAZUP 7 FACE_ALTERNATE_LAST

$moves
MOVE TREAZUP TREAZUP
OR
    DEST Suit {HEARTS, SPADES, DIAMONDS}
    SRC Suit {DIAMONDS}
MOVE_STACK TREAZUP TREAZUP
OR
    AND
        DEST Rank K
        DESTSRC Rank add_13
    AND
        SRCSTACK Rank add_13
        SRCSTACK Suit match_color
$win
OR
    AND
        PILE ALL TREAZUP Empty
        PILE ALL TREAZUP Empty
    PILE ALL TREAZUP Empty
