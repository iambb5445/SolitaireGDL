Staeju
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 16 DEAL {COLUMN, STAG}
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 8 FACE_HALF
COLUMN 2 FACE_HALF

STAG 5 FACE_ALL
STAG 3 FACE_ALL
STAG 1 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    DESTSRC Suit match_color
    DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE STAG COLUMN
OR
    AND
        DEST Size < 2
        DEST Empty
    AND
        SRC Rank K
        DEST Suit {SPADES}
MOVE_STACK STAG COLUMN
AND
    OR
        DESTSRC Rank add_13
        DEST Empty
    OR
        SRCSTACK Suit match_color
        DEST Size <= 10
MOVE_STACK STAG STAG
DEST Rank 1
DRAW
PILE ALL STAG Size > 0
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL STAG Empty
        PILE ALL STAG Empty
