Louze
$cards
DECK 8 SPADES

$initial
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 5 FACE_LAST

UCA 2 FACE_ALTERNATE_LAST
UCA 8 FACE_ALTERNATE_LAST
UCA 0 FACE_ALTERNATE_LAST
UCA 7 FACE_ALTERNATE_LAST
UCA 10 FACE_ALTERNATE_LAST
UCA 8 FACE_HALF
UCA 6 FACE_HALF

NAEC 1 FACE_HALF
NAEC 7 FACE_HALF
NAEC 4 FACE_HALF
NAEC 4 FACE_ALTERNATE_LAST
NAEC 4 FACE_ALTERNATE_LAST
NAEC 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK NAEC UCA
SRC Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
MOVE_STACK COLUMN {COLUMN, NAEC, UCA}
DEST Suit {CLUBS, DIAMONDS}
$win
OR
    PILE ALL NAEC Empty
    PILE ALL NAEC Empty
