Esac
$cards
DECK 4 SPADES

$initial
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 8 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 9 FACE_HALF

UCUP 9 FACE_ALL
UCUP 1 FACE_HALF

$moves
MOVE {COLUMN, UCUP} UCUP
OR
    AND
        DEST Suit {CLUBS}
        DEST Empty
    AND
        DEST Rank 1
        DESTSRC Suit match_color
$win
AND
    OR
        PILE ALL UCUP Empty
        PILE ALL UCUP Empty
    PILE ALL COLUMN Empty
