Azeag
$cards
DECK 2 SPADES

$initial
COLUMN 9 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 2 FACE_ALL

$moves
MOVE COLUMN COLUMN
AND
    OR
        DEST Size > 4
        DEST Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
    OR
        SRC Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
        DEST Rank K
$win
PILE ALL COLUMN Empty
