Oru
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 9 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 8 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
OR
    DEST Empty
    AND
        DEST Size > 6
        DEST Size >= 2
$win
PILE ALL COLUMN Empty
