Osos
$cards
DECK 4 SPADES

$initial
IDAEV 5 FACE_HALF
IDAEV 4 FACE_HALF
IDAEV 0 FACE_HALF
IDAEV 3 FACE_HALF
IDAEV 2 FACE_HALF
IDAEV 1 FACE_HALF
IDAEV 7 FACE_HALF
IDAEV 8 FACE_HALF
IDAEV 5 FACE_HALF
IDAEV 9 FACE_HALF

TREAZIQ 2 FACE_HALF
TREAZIQ 3 FACE_HALF
TREAZIQ 3 FACE_HALF

$moves
MOVE IDAEV TREAZIQ
SRC Suit {CLUBS, DIAMONDS}
MOVE_STACK TREAZIQ TREAZIQ
SRCSTACK Suit match
MOVE_STACK IDAEV {IDAEV, TREAZIQ}
OR
    AND
        DEST Size > 10
        SRCSTACK Size < 6
    DEST Empty
$win
PILE ALL TREAZIQ Empty
