Eguir
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 79 DEAL FRAKIX
FRAKIX 9 FACE_HALF
FRAKIX 3 FACE_HALF
FRAKIX 9 FACE_HALF
FRAKIX 3 FACE_HALF
FRAKIX 1 FACE_HALF

$moves
MOVE FRAKIX FRAKIX
OR
    DEST Suit {DIAMONDS, SPADES, CLUBS}
    AND
        SRC Suit {CLUBS}
        DESTSRC Suit match_color
MOVE_STACK FRAKIX FRAKIX
SRCSTACK Size < 4
DRAW
PILE ALL DRAW Empty
$win
OR
    PILE ALL FRAKIX Empty
    PILE ALL DRAW Empty
