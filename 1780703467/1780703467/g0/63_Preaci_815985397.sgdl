Preaci
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 11 ROTATE 1 U 2
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 6 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
SRC Rank K
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
