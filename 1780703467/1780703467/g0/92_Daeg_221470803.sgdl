Daeg
$cards
DECK 2 {SPADES, HEARTS}

$initial
GAICA 2 FACE_ALL
GAICA 5 FACE_ALL
GAICA 2 FACE_ALL
GAICA 10 FACE_ALTERNATE_LAST

WOUQA 1 FACE_ALTERNATE_LAST
WOUQA 9 FACE_ALTERNATE_LAST
WOUQA 3 FACE_ALTERNATE_LAST
WOUQA 9 FACE_ALTERNATE_LAST
WOUQA 5 FACE_ALTERNATE_LAST
WOUQA 6 FACE_ALTERNATE_LAST

$moves
MOVE {GAICA, WOUQA} WOUQA
OR
    AND
        DESTSRC Suit match
        DESTSRC Rank equal
    DESTSRC Rank ascending
$win
OR
    AND
        PILE ALL GAICA Empty
        PILE ALL GAICA Empty
    AND
        PILE ALL WOUQA Empty
        PILE ALL WOUQA Empty
