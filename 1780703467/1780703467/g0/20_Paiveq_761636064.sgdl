Paiveq
$cards
DECK 4 SPADES

$initial
DRAW 8 DEAL {COLUMN, UFU, JOC}
JOC 6 FACE_HALF
JOC 1 FACE_HALF
JOC 8 FACE_HALF
JOC 7 FACE_ALTERNATE_LAST
JOC 1 FACE_ALTERNATE_LAST
JOC 1 FACE_ALTERNATE_LAST
JOC 1 FACE_ALTERNATE_LAST
JOC 6 FACE_ALTERNATE_LAST
JOC 1 FACE_ALTERNATE_LAST

UFU 5 FACE_ALL
UFU 3 FACE_LAST

COLUMN 1 FACE_LAST
COLUMN 3 FACE_LAST

$moves
MOVE JOC {COLUMN, UFU, JOC}
OR
    AND
        DESTSRC Suit alternate_color
        DEST Suit {CLUBS, HEARTS, DIAMONDS}
    AND
        DEST Size >= 10
        DEST Suit {CLUBS}
MOVE_STACK COLUMN JOC
AND
    SRCSTACK Suit match_color
    OR
        SRC Rank K
        DESTSRC Rank descending
MOVE_STACK UFU COLUMN
OR
    SRCSTACK Rank add_13
    AND
        SRC Suit {CLUBS, DIAMONDS, SPADES}
        SRC Rank 1
$win
PILE ALL COLUMN Empty
