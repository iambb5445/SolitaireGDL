Libev
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 22 DEAL COLUMN
COLUMN 9 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 2 FACE_ALL

$moves
MOVE_STACK COLUMN COLUMN
DEST Suit {HEARTS}
DRAW
PILE ANY DRAW Empty
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
