Oya
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 0 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 0 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL

ROXIK 6 FACE_LAST
ROXIK 1 FACE_LAST
ROXIK 1 FACE_LAST
ROXIK 5 FACE_LAST
ROXIK 6 FACE_LAST
ROXIK 0 FACE_LAST
ROXIK 2 FACE_LAST

UXA 2 FACE_HALF

$moves
MOVE_STACK ROXIK ROXIK
AND
    AND
        SRC Rank 1
        SRCSTACK Suit match
    DEST Rank 1
MOVE_STACK COLUMN {UXA, ROXIK, COLUMN}
OR
    AND
        DEST Size >= 4
        SRCSTACK Suit match_color
    SRCSTACK Size >= 0
$win
AND
    PILE ALL COLUMN Empty
    AND
        PILE ALL ROXIK Empty
        PILE ALL ROXIK Empty
