Xouta
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 93 ROTATE 3 U U
COLUMN 3 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 4 FACE_ALL

$moves
MOVE_STACK COLUMN COLUMN
SRCSTACK Suit alternate_color
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
