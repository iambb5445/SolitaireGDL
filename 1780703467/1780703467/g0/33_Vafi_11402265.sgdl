Vafi
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 5 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 0 FACE_ALL

$moves
MOVE COLUMN COLUMN
AND
    SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
    OR
        DEST Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
        DESTSRC Rank add_14
MOVE_STACK COLUMN COLUMN
OR
    SRCSTACK Size == 3
    DEST Size <= 4
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
