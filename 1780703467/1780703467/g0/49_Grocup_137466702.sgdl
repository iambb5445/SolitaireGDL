Grocup
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 12 ROTATE 3 U 2
APE 1 FACE_ALTERNATE_LAST
APE 0 FACE_ALTERNATE_LAST
APE 9 FACE_ALTERNATE_LAST
APE 7 FACE_HALF
APE 10 FACE_HALF
APE 7 FACE_HALF
APE 2 FACE_HALF
APE 3 FACE_HALF
APE 1 FACE_HALF

$moves
MOVE APE APE
DESTSRC Suit match
MOVE DRAW APE
SRC Suit {DIAMONDS, HEARTS}
$win
OR
    PILE ALL APE Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL APE Empty
