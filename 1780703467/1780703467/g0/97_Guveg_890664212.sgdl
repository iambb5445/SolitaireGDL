Guveg
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
OKAEF 1 FACE_ALTERNATE_LAST

XAFIR 5 FACE_ALTERNATE_LAST
XAFIR 1 FACE_ALTERNATE_LAST
XAFIR 5 FACE_ALTERNATE_LAST
XAFIR 3 FACE_ALTERNATE_LAST
XAFIR 7 FACE_ALTERNATE_LAST
XAFIR 3 FACE_ALTERNATE_LAST
XAFIR 7 FACE_ALTERNATE_LAST
XAFIR 9 FACE_ALTERNATE_LAST
XAFIR 4 FACE_ALTERNATE_LAST
XAFIR 7 FACE_ALTERNATE_LAST

$moves
MOVE XAFIR XAFIR
OR
    AND
        DEST Size <= 9
        DESTSRC Suit alternate_color
    DEST Suit {SPADES, HEARTS, CLUBS}
MOVE OKAEF OKAEF
DEST Size >= 2
MOVE_STACK XAFIR OKAEF
OR
    DESTSRC Rank add_14
    AND
        DEST Size == 6
        SRC Rank K
MOVE_STACK OKAEF XAFIR
AND
    OR
        DEST Size < 8
        SRCSTACK Size <= 6
    SRC Suit {CLUBS}
$win
PILE ALL XAFIR Empty
