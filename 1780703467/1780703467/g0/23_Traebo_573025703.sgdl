Traebo
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 4 FACE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

YUIGIQ 0 FACE_LAST
YUIGIQ 8 FACE_LAST
YUIGIQ 0 FACE_LAST
YUIGIQ 5 FACE_LAST
YUIGIQ 4 FACE_LAST
YUIGIQ 2 FACE_LAST
YUIGIQ 3 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DEST Rank 1
    AND
        DEST Size >= 2
        DEST Rank 1
MOVE_STACK COLUMN YUIGIQ
OR
    AND
        DEST Suit {CLUBS, SPADES}
        SRCSTACK Size <= 1
    AND
        DESTSRC Suit match_color
        SRCSTACK Size > 8
$win
PILE ALL YUIGIQ Empty
