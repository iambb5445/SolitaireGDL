Qounad
$cards
DECK 2 SPADES

$initial
DRAW 1 ROTATE 3 U U
COLUMN 8 FACE_HALF
COLUMN 10 FACE_ALTERNATE_LAST

TROUX 5 FACE_ALTERNATE_LAST
TROUX 2 FACE_ALL

$moves
MOVE COLUMN {TROUX, COLUMN}
OR
    AND
        DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
        DESTSRC Suit match
    DESTSRC Suit match
MOVE TROUX TROUX
OR
    SRC Rank K
    AND
        DEST Empty
        DEST Size > 2
MOVE_STACK {TROUX, COLUMN} TROUX
OR
    AND
        SRC Rank 1
        DEST Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
    DESTSRC Rank add_13
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Rank 1
        SRCSTACK Rank ascending
    AND
        DEST Rank 1
        DEST Empty
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
