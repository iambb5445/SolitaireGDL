Pomed
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 52 ROTATE 1 U 2
VIC 7 FACE_LAST
VIC 10 FACE_LAST
VIC 7 FACE_LAST
VIC 6 FACE_LAST
VIC 5 FACE_LAST
VIC 5 FACE_LAST
VIC 0 FACE_LAST
VIC 7 FACE_LAST
VIC 5 FACE_LAST

$moves
MOVE VIC VIC
AND
    DEST Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
    DESTSRC Rank ascending
MOVE_STACK VIC VIC
OR
    SRCSTACK Size == 9
    AND
        SRCSTACK Size >= 1
        SRC Rank K
$win
PILE ALL DRAW Empty
