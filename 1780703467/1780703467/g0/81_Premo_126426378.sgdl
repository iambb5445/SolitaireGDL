Premo
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 2 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

UBEAS 2 FACE_ALTERNATE_LAST

GEAF 3 FACE_LAST
GEAF 9 FACE_LAST

$moves
MOVE UBEAS UBEAS
OR
    AND
        DEST Size <= 6
        DEST Size == 6
    DEST Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
$win
AND
    OR
        PILE ALL UBEAS Empty
        PILE ALL COLUMN Empty
    PILE ALL GEAF Empty
