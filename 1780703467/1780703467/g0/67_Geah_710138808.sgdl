Geah
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

ANOUS 5 FACE_LAST
ANOUS 7 FACE_ALTERNATE_LAST

UPE 2 FACE_ALTERNATE_LAST
UPE 7 FACE_ALTERNATE_LAST
UPE 9 FACE_ALTERNATE_LAST

BIOPOW 6 FACE_HALF
BIOPOW 0 FACE_HALF
BIOPOW 8 FACE_HALF
BIOPOW 6 FACE_LAST
BIOPOW 2 FACE_LAST
BIOPOW 3 FACE_LAST

ULA 10 FACE_ALTERNATE_LAST
ULA 2 FACE_ALTERNATE_LAST
ULA 6 FACE_ALTERNATE_LAST

GIOCU 10 FACE_LAST
GIOCU 5 FACE_LAST
GIOCU 3 FACE_ALTERNATE_LAST

$moves
MOVE ANOUS UPE
DESTSRC Rank ascending
MOVE UPE GIOCU
AND
    AND
        DESTSRC Suit match
        DESTSRC Suit match_color
    OR
        DESTSRC Suit match
        DESTSRC Rank add_14
MOVE_STACK GIOCU GIOCU
OR
    SRC Rank 1
    AND
        SRC Rank K
        DEST Rank 1
MOVE_STACK ULA ANOUS
AND
    AND
        DEST Rank K
        SRC Rank K
    AND
        DESTSRC Suit match_color
        SRC Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
$win
PILE ALL BIOPOW Empty
