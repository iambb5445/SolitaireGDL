Maev
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 1 ROTATE 1 1 U
ADI 7 FACE_HALF
ADI 5 FACE_HALF
ADI 9 FACE_HALF
ADI 0 FACE_HALF
ADI 10 FACE_HALF
ADI 6 FACE_HALF
ADI 8 FACE_HALF
ADI 10 FACE_HALF

RAHEB 2 FACE_ALL
RAHEB 6 FACE_LAST

EPAW 3 FACE_ALTERNATE_LAST
EPAW 4 FACE_ALTERNATE_LAST
EPAW 0 FACE_ALL

COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 0 FACE_ALL

$moves
MOVE COLUMN RAHEB
AND
    DESTSRC Rank equal
    AND
        DESTSRC Rank ascending
        DESTSRC Suit match
MOVE_STACK {RAHEB, COLUMN} ADI
OR
    DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
    AND
        DEST Size > 9
        DEST Size <= 0
MOVE_STACK ADI RAHEB
DEST Empty
$win
OR
    PILE ALL EPAW Empty
    AND
        PILE ALL ADI Empty
        PILE ALL ADI Empty
