Muilu
$cards
DECK 1 SPADES

$initial
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALL

$moves
MOVE COLUMN COLUMN
AND
    DEST Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
    DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
OR
    SRC Rank 1
    AND
        SRC Rank 1
        DESTSRC Suit match
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
