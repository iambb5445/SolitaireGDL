Opah
$cards
DECK 2 {SPADES, CLUBS}

$initial
UBIV 6 FACE_HALF
UBIV 4 FACE_HALF
UBIV 5 FACE_HALF
UBIV 4 FACE_HALF
UBIV 6 FACE_HALF

OQUG 1 FACE_ALL
OQUG 3 FACE_ALL
OQUG 0 FACE_ALL
OQUG 7 FACE_ALL
OQUG 4 FACE_ALL

COLUMN 5 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 5 FACE_ALL

$moves
MOVE OQUG {UBIV, OQUG, COLUMN}
OR
    DEST Empty
    DEST Size <= 10
$win
OR
    AND
        PILE ALL UBIV Empty
        PILE ALL OQUG Empty
    PILE ALL OQUG Empty
