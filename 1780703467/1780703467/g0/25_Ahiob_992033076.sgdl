Ahiob
$cards
DECK 4 SPADES

$initial
FREQEF 2 FACE_HALF
FREQEF 2 FACE_HALF
FREQEF 9 FACE_HALF
FREQEF 5 FACE_HALF
FREQEF 10 FACE_HALF
FREQEF 10 FACE_HALF
FREQEF 6 FACE_HALF
FREQEF 6 FACE_HALF
FREQEF 2 FACE_HALF

$moves
MOVE FREQEF FREQEF
AND
    DESTSRC Suit match
    AND
        DEST Empty
        DESTSRC Rank ascending
$win
OR
    AND
        PILE ALL FREQEF Empty
        PILE ALL FREQEF Empty
    PILE ALL FREQEF Empty
