Waeq
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 46 ROTATE 1 1 U
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 5 FACE_HALF

TEAX 6 FACE_HALF
TEAX 1 FACE_HALF
TEAX 2 FACE_HALF
TEAX 5 FACE_HALF
TEAX 0 FACE_HALF

ABAQ 4 FACE_ALTERNATE_LAST
ABAQ 2 FACE_ALTERNATE_LAST
ABAQ 6 FACE_ALTERNATE_LAST
ABAQ 9 FACE_ALTERNATE_LAST

$moves
MOVE_STACK ABAQ COLUMN
AND
    SRCSTACK Suit match_color
    OR
        DEST Size < 2
        SRCSTACK Suit alternate_color
MOVE_STACK COLUMN TEAX
DEST Rank K
$win
AND
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL TEAX Empty
