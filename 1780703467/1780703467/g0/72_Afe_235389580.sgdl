Afe
$cards
DECK 8 SPADES

$initial
DRAW 54 ROTATE 1 U 3
COLUMN 8 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 2 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 10 FACE_ALL

$moves
MOVE DRAW COLUMN
SRC Suit {HEARTS, SPADES, CLUBS}
MOVE COLUMN COLUMN
OR
    DEST Rank K
    AND
        SRC Rank 1
        DEST Rank 1
MOVE_STACK COLUMN COLUMN
AND
    OR
        SRCSTACK Size == 1
        SRCSTACK Size <= 8
    AND
        DEST Suit {SPADES}
        SRCSTACK Size == 4
$win
AND
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
