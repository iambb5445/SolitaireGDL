Ide
$cards
DECK 8 SPADES

$initial
DRAW 14 ROTATE 1 2 U
EYEAJ 1 FACE_ALTERNATE_LAST
EYEAJ 10 FACE_ALTERNATE_LAST
EYEAJ 6 FACE_ALTERNATE_LAST
EYEAJ 7 FACE_ALTERNATE_LAST
EYEAJ 1 FACE_ALTERNATE_LAST
EYEAJ 10 FACE_ALTERNATE_LAST
EYEAJ 8 FACE_ALTERNATE_LAST
EYEAJ 0 FACE_ALTERNATE_LAST
EYEAJ 7 FACE_ALTERNATE_LAST

COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALL
COLUMN 8 FACE_ALL

JAHU 6 FACE_ALL
JAHU 8 FACE_LAST
JAHU 7 FACE_LAST

$moves
MOVE DRAW {EYEAJ, JAHU, COLUMN}
OR
    AND
        DEST Empty
        SRC Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
    AND
        DESTSRC Rank ascending
        DESTSRC Suit alternate_color
MOVE_STACK EYEAJ {EYEAJ, COLUMN}
OR
    DEST Rank 1
    AND
        DEST Rank K
        SRCSTACK Rank equal
$win
PILE ALL DRAW Empty
