Xaihow
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 15 DEAL {UVEB, COLUMN}
UVEB 1 FACE_HALF
UVEB 1 FACE_HALF
UVEB 5 FACE_ALTERNATE_LAST
UVEB 0 FACE_ALTERNATE_LAST
UVEB 4 FACE_ALTERNATE_LAST
UVEB 5 FACE_ALTERNATE_LAST
UVEB 8 FACE_ALTERNATE_LAST
UVEB 0 FACE_ALTERNATE_LAST
UVEB 8 FACE_ALTERNATE_LAST
UVEB 10 FACE_ALTERNATE_LAST

COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 4 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 7 FACE_HALF

$moves
MOVE UVEB COLUMN
AND
    AND
        DEST Suit {DIAMONDS, SPADES, HEARTS}
        DESTSRC Suit match
    DESTSRC Suit alternate_color
MOVE COLUMN COLUMN
OR
    SRC Rank 1
    SRC Rank K
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL UVEB Empty
        PILE ALL DRAW Empty
