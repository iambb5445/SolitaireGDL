Ido
$cards
DECK 8 SPADES

$initial
COLUMN 10 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 10 FACE_ALL

FROQ 1 FACE_LAST
FROQ 10 FACE_LAST
FROQ 1 FACE_HALF

DAIFI 3 FACE_ALL
DAIFI 9 FACE_ALL
DAIFI 0 FACE_ALL
DAIFI 4 FACE_ALL
DAIFI 6 FACE_ALL
DAIFI 4 FACE_LAST

