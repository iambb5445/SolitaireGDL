$moves
MOVE COLUMN {FROQ, COLUMN, DAIFI}
AND
    AND
        DEST Size == 8
        DEST Size <= 0
    AND
        DESTSRC Rank add_13
        DEST Rank 1
$win
PILE ALL DAIFI Empty
