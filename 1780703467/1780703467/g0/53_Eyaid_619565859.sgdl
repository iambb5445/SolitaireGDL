Eyaid
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 33 DEAL WOKUM
WOKUM 6 FACE_LAST
WOKUM 1 FACE_LAST
WOKUM 9 FACE_LAST
WOKUM 3 FACE_ALTERNATE_LAST

$moves
MOVE_STACK WOKUM WOKUM
AND
    DEST Suit {HEARTS, CLUBS, DIAMONDS}
    SRC Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
DRAW
PILE ANY DRAW Empty
$win
AND
    PILE ALL WOKUM Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
