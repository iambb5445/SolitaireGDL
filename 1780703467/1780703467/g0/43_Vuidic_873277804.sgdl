Vuidic
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 29 ROTATE 1 2 U
UYU 2 FACE_ALTERNATE_LAST
UYU 9 FACE_ALTERNATE_LAST
UYU 2 FACE_ALTERNATE_LAST
UYU 0 FACE_ALTERNATE_LAST
UYU 5 FACE_ALTERNATE_LAST
UYU 5 FACE_ALTERNATE_LAST

$moves
MOVE_STACK UYU UYU
OR
    AND
        SRC Suit {SPADES}
        DEST Size == 3
    AND
        SRC Rank 1
        DESTSRC Rank ascending
$win
PILE ALL DRAW Empty
