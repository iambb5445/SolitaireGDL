Ulaif
$cards
DECK 8 SPADES

$initial
DRAW 82 ROTATE 1 U 3
CRAIVOG 9 FACE_LAST
CRAIVOG 8 FACE_LAST
CRAIVOG 5 FACE_LAST
CRAIVOG 0 FACE_ALTERNATE_LAST

$moves
MOVE CRAIVOG CRAIVOG
OR
    DEST Size < 8
    DEST Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
MOVE DRAW CRAIVOG
OR
    AND
        SRC Rank K
        DESTSRC Suit alternate_color
    DESTSRC Suit match
MOVE_STACK CRAIVOG CRAIVOG
OR
    SRCSTACK Suit match_color
    AND
        DESTSRC Suit match
        SRC Suit {CLUBS, SPADES}
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL CRAIVOG Empty
