Eme
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 61 DEAL COLUMN
ZUN 7 FACE_LAST
ZUN 6 FACE_LAST
ZUN 1 FACE_LAST
ZUN 10 FACE_LAST

COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

$moves
MOVE ZUN {COLUMN, ZUN}
OR
    AND
        DESTSRC Suit match
        DEST Rank 1
    DEST Suit {DIAMONDS}
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL ZUN Empty
    PILE ALL ZUN Empty
