Ata
$cards
DECK 4 SPADES

$initial
PRUW 3 FACE_LAST
PRUW 0 FACE_LAST
PRUW 0 FACE_LAST
PRUW 2 FACE_LAST
PRUW 4 FACE_LAST
PRUW 2 FACE_LAST
PRUW 0 FACE_LAST
PRUW 10 FACE_LAST
PRUW 1 FACE_LAST

COLUMN 5 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 3 FACE_ALL

$moves
MOVE {COLUMN, PRUW} PRUW
OR
    DEST Suit {HEARTS}
    AND
        DEST Size == 1
        DEST Size >= 5
MOVE PRUW COLUMN
DESTSRC Suit alternate_color
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL PRUW Empty
