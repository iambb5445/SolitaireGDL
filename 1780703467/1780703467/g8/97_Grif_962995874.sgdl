Grif
$cards
DECK 4 SPADES

$initial
DRAW 14 DEAL UJUB
UJUB 1 FACE_HALF
UJUB 2 FACE_HALF
UJUB 10 FACE_HALF
UJUB 10 FACE_HALF
UJUB 6 FACE_ALTERNATE_LAST
UJUB 7 FACE_ALTERNATE_LAST
UJUB 2 FACE_ALTERNATE_LAST

$moves
MOVE UJUB UJUB
OR
    AND
        DEST Size >= 5
        DEST Rank 1
    AND
        SRC Rank K
        DESTSRC Suit alternate_color
$win
PILE ALL UJUB Empty
