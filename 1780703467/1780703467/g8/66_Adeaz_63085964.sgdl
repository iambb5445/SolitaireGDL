Adeaz
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 33 DEAL COLUMN
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 10 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    OR
        DEST Rank 1
        DESTSRC Suit match_color
    OR
        DEST Empty
        DEST Suit {HEARTS, SPADES}
$win
AND
    PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
