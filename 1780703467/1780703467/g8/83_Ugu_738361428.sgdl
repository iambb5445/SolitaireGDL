Ugu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
PAISI 10 FACE_HALF
PAISI 8 FACE_HALF
PAISI 2 FACE_HALF
PAISI 3 FACE_HALF
PAISI 5 FACE_HALF
PAISI 1 FACE_HALF
PAISI 9 FACE_HALF
PAISI 0 FACE_HALF
PAISI 1 FACE_HALF

QAEK 0 FACE_ALTERNATE_LAST
QAEK 10 FACE_HALF
QAEK 2 FACE_HALF
QAEK 1 FACE_HALF

$moves
MOVE QAEK QAEK
OR
    AND
        DEST Size > 7
        SRC Suit {HEARTS}
    DESTSRC Suit match_color
MOVE {QAEK, PAISI} PAISI
OR
    AND
        SRC Suit {CLUBS}
        DEST Size > 8
    SRC Suit {CLUBS, DIAMONDS, SPADES}
MOVE_STACK QAEK {QAEK, PAISI}
AND
    OR
        SRC Rank K
        DEST Suit {HEARTS}
    AND
        DEST Empty
        DEST Size <= 7
MOVE_STACK PAISI QAEK
OR
    AND
        SRC Rank K
        DESTSRC Suit alternate_color
    SRC Suit {CLUBS}
$win
AND
    PILE ALL QAEK Empty
    PILE ALL PAISI Empty
