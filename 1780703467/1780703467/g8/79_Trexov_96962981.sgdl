Trexov
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 27 ROTATE 3 U 3
GOD 10 FACE_ALTERNATE_LAST
GOD 9 FACE_ALTERNATE_LAST
GOD 9 FACE_ALTERNATE_LAST
GOD 9 FACE_ALTERNATE_LAST
GOD 1 FACE_ALTERNATE_LAST

QUILOZ 1 FACE_LAST
QUILOZ 3 FACE_LAST
QUILOZ 5 FACE_LAST
QUILOZ 9 FACE_LAST
QUILOZ 7 FACE_LAST
QUILOZ 3 FACE_LAST
QUILOZ 8 FACE_LAST
QUILOZ 3 FACE_LAST

$moves
MOVE {GOD, DRAW, QUILOZ} GOD
DEST Rank 1
MOVE DRAW QUILOZ
AND
    DESTSRC Rank equal
    AND
        DEST Rank K
        SRC Rank K
MOVE_STACK QUILOZ GOD
OR
    DESTSRC Rank add_14
    SRC Rank K
$win
AND
    OR
        PILE ALL QUILOZ Empty
        PILE ALL QUILOZ Empty
    PILE ALL QUILOZ Empty
