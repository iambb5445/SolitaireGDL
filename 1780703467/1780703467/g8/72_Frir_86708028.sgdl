Frir
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 4 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 9 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    OR
        SRC Rank 1
        DEST Size >= 10
    DEST Rank 1
MOVE_STACK COLUMN COLUMN
SRC Rank 1
$win
PILE ALL COLUMN Empty
