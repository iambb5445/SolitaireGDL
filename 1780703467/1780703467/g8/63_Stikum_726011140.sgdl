Stikum
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 41 DEAL QET
COLUMN 9 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST

QET 6 FACE_LAST
QET 5 FACE_LAST
QET 4 FACE_LAST
QET 9 FACE_LAST

$moves
MOVE QET COLUMN
DEST Size == 7
MOVE {QET, COLUMN} QET
DEST Rank 1
MOVE_STACK {QET, COLUMN} COLUMN
OR
    AND
        SRCSTACK Size <= 7
        DEST Size == 10
    AND
        DEST Suit {HEARTS}
        DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
DRAW
PILE ALL COLUMN Size > 0
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL QET Empty
        PILE ALL DRAW Empty
