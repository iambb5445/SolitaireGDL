Piol
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 45 DEAL {EGEAV, RIFEZ}
EGEAV 2 FACE_ALL
EGEAV 5 FACE_ALL
EGEAV 8 FACE_ALL

COLUMN 5 FACE_ALL
COLUMN 2 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 6 FACE_LAST

RIFEZ 9 FACE_ALL
RIFEZ 10 FACE_ALL
RIFEZ 9 FACE_LAST

$moves
MOVE EGEAV EGEAV
OR
    DEST Empty
    AND
        DEST Suit {SPADES, HEARTS}
        DESTSRC Suit match
MOVE RIFEZ {RIFEZ, EGEAV}
DEST Suit {HEARTS}
MOVE_STACK COLUMN EGEAV
AND
    OR
        SRCSTACK Size >= 7
        DESTSRC Suit match_color
    SRC Suit {HEARTS, DIAMONDS}
MOVE_STACK EGEAV EGEAV
DEST Rank 1
$win
PILE ALL COLUMN Empty
