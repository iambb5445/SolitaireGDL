Groumuh
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 35 DEAL DAZE
DRANOG 5 FACE_LAST
DRANOG 10 FACE_LAST
DRANOG 0 FACE_ALTERNATE_LAST
DRANOG 0 FACE_ALTERNATE_LAST
DRANOG 5 FACE_ALTERNATE_LAST
DRANOG 9 FACE_ALTERNATE_LAST
DRANOG 5 FACE_ALTERNATE_LAST
DRANOG 2 FACE_ALTERNATE_LAST
DRANOG 10 FACE_ALTERNATE_LAST

DAZE 7 FACE_ALTERNATE_LAST
DAZE 0 FACE_LAST
DAZE 10 FACE_LAST
DAZE 6 FACE_LAST

$moves
MOVE DAZE DAZE
DEST Size > 3
MOVE_STACK DRANOG DRANOG
OR
    AND
        SRC Rank 1
        DESTSRC Suit match_color
    DEST Rank K
MOVE_STACK DRANOG DAZE
OR
    AND
        DEST Rank K
        DESTSRC Suit match_color
    AND
        DEST Size == 0
        SRC Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DAZE Empty
    AND
        PILE ALL DAZE Empty
        PILE ALL DRANOG Empty
