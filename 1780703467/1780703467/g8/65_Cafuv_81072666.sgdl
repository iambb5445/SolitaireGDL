Cafuv
$cards
DECK 1 {SPADES, CLUBS}

$initial
UTAIQ 1 FACE_ALL
UTAIQ 2 FACE_ALL

EZU 3 FACE_ALTERNATE_LAST
EZU 7 FACE_ALTERNATE_LAST
EZU 0 FACE_ALTERNATE_LAST
EZU 2 FACE_ALTERNATE_LAST
EZU 0 FACE_ALTERNATE_LAST
EZU 0 FACE_LAST
EZU 9 FACE_LAST
EZU 1 FACE_LAST
EZU 1 FACE_LAST

$moves
MOVE_STACK UTAIQ UTAIQ
OR
    SRC Suit {HEARTS, CLUBS}
    AND
        SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
        SRC Rank 1
$win
OR
    PILE ALL EZU Empty
    AND
        PILE ALL EZU Empty
        PILE ALL UTAIQ Empty
