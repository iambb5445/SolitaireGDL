Quixi
$cards
DECK 4 SPADES

$initial
DRAW 10 ROTATE 1 2 U
LAIR 1 FACE_ALTERNATE_LAST
LAIR 6 FACE_ALTERNATE_LAST
LAIR 2 FACE_ALL

COLUMN 8 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 1 FACE_ALL

$moves
MOVE_STACK {COLUMN, LAIR} COLUMN
SRCSTACK Size >= 10
$win
AND
    PILE ALL LAIR Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
