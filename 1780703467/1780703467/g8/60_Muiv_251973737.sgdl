Muiv
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 44 DEAL {COLUMN, LOUJO}
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

LOUJO 1 FACE_ALL
LOUJO 5 FACE_ALL
LOUJO 10 FACE_ALL
LOUJO 8 FACE_ALL

$moves
MOVE LOUJO COLUMN
OR
    DEST Size == 9
    AND
        DEST Rank 1
        DESTSRC Rank equal
MOVE COLUMN LOUJO
DESTSRC Suit match_color
MOVE_STACK {COLUMN, LOUJO} COLUMN
OR
    DESTSRC Rank add_14
    AND
        SRCSTACK Suit alternate_color
        SRCSTACK Rank equal
MOVE_STACK LOUJO LOUJO
OR
    DESTSRC Suit alternate_color
    SRC Rank 1
DRAW
PILE ALL DRAW Size > 0
$win
PILE ALL COLUMN Empty
