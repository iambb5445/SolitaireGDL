Iza
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 0 DEAL COLUMN
CRAIJAP 0 FACE_HALF
CRAIJAP 0 FACE_HALF
CRAIJAP 0 FACE_HALF
CRAIJAP 10 FACE_HALF
CRAIJAP 0 FACE_HALF
CRAIJAP 2 FACE_HALF

COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

GOUKU 0 FACE_ALTERNATE_LAST
GOUKU 0 FACE_ALTERNATE_LAST
GOUKU 2 FACE_ALTERNATE_LAST
GOUKU 1 FACE_ALTERNATE_LAST
GOUKU 3 FACE_ALTERNATE_LAST
GOUKU 2 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
