Draso
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 64 DEAL {MUQAW, COLUMN}
MUQAW 6 FACE_HALF
MUQAW 2 FACE_HALF
MUQAW 8 FACE_LAST
MUQAW 0 FACE_LAST

COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE COLUMN MUQAW
AND
    AND
        DEST Rank K
        DEST Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRC Suit {SPADES, HEARTS, DIAMONDS}
MOVE_STACK COLUMN MUQAW
OR
    AND
        DESTSRC Suit match_color
        SRC Rank 1
    AND
        SRCSTACK Rank descending
        DEST Suit {HEARTS, SPADES}
DRAW
PILE ALL DRAW Empty
$win
PILE ALL DRAW Empty
