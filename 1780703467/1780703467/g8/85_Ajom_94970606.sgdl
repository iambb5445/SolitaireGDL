Ajom
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 3 ROTATE 3 U 3
CROKIC 6 FACE_ALTERNATE_LAST
CROKIC 2 FACE_ALTERNATE_LAST
CROKIC 5 FACE_ALTERNATE_LAST
CROKIC 10 FACE_ALL

$moves
MOVE {DRAW, CROKIC} CROKIC
DEST Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL CROKIC Empty
    OR
        PILE ALL CROKIC Empty
        PILE ALL DRAW Empty
