Zaim
$cards
DECK 4 {SPADES, HEARTS}

$initial
AHOJ 9 FACE_LAST

VOUK 7 FACE_ALL
VOUK 2 FACE_HALF
VOUK 0 FACE_HALF

COLUMN 4 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 2 FACE_HALF

TAIKU 6 FACE_LAST
TAIKU 8 FACE_LAST
TAIKU 6 FACE_HALF
TAIKU 6 FACE_HALF
TAIKU 6 FACE_HALF
TAIKU 7 FACE_HALF
TAIKU 5 FACE_HALF

$moves
MOVE {COLUMN, VOUK, TAIKU, AHOJ} VOUK
AND
    OR
        DESTSRC Suit alternate_color
        DEST Size == 3
    SRC Suit {CLUBS, HEARTS, SPADES}
MOVE_STACK COLUMN VOUK
OR
    SRCSTACK Size > 7
    AND
        SRC Rank 1
        DESTSRC Suit match_color
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL TAIKU Empty
    AND
        PILE ALL TAIKU Empty
        PILE ALL TAIKU Empty
