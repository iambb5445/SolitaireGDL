Taiqoh
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 0 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 8 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 10 FACE_LAST

EHI 3 FACE_HALF
EHI 7 FACE_HALF
EHI 4 FACE_HALF
EHI 10 FACE_HALF
EHI 9 FACE_HALF
EHI 4 FACE_LAST
EHI 1 FACE_LAST

ABAS 5 FACE_ALL
ABAS 7 FACE_ALL
ABAS 5 FACE_ALL
ABAS 5 FACE_ALL
ABAS 3 FACE_ALL
ABAS 6 FACE_ALL
ABAS 0 FACE_ALL

$moves
MOVE {ABAS, EHI} ABAS
DEST Rank K
MOVE_STACK EHI EHI
AND
    AND
        SRCSTACK Suit match
        DESTSRC Rank equal
    SRCSTACK Size >= 8
MOVE_STACK ABAS ABAS
OR
    DESTSRC Suit match_color
    AND
        SRCSTACK Suit alternate_color
        DEST Empty
$win
PILE ALL ABAS Empty
