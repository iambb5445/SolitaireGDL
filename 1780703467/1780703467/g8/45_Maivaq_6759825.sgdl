Maivaq
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 0 DEAL COLUMN
UYIY 0 FACE_LAST
UYIY 0 FACE_ALL
UYIY 0 FACE_ALL
UYIY 8 FACE_ALL
UYIY 2 FACE_ALL
UYIY 1 FACE_ALL
UYIY 3 FACE_ALL
UYIY 1 FACE_ALL
UYIY 0 FACE_ALL

IYAC 1 FACE_LAST
IYAC 6 FACE_LAST
IYAC 2 FACE_LAST
IYAC 4 FACE_LAST
IYAC 3 FACE_LAST
IYAC 10 FACE_HALF
IYAC 8 FACE_HALF

UCE 0 FACE_HALF
UCE 0 FACE_HALF
UCE 0 FACE_HALF
UCE 0 FACE_HALF

$moves
MOVE UCE IYAC
AND
    DESTSRC Suit match_color
    DEST Rank 1
MOVE_STACK IYAC IYAC
DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL IYAC Empty
