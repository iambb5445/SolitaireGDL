Acaz
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 3 ROTATE 1 U 3
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 4 FACE_LAST

$moves
MOVE {DRAW, COLUMN} COLUMN
AND
    OR
        SRC Suit {DIAMONDS}
        SRC Rank 1
    OR
        SRC Suit {SPADES, CLUBS, HEARTS}
        DESTSRC Rank ascending
MOVE_STACK COLUMN COLUMN
SRC Rank 1
$win
PILE ALL DRAW Empty
