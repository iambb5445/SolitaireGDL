Greq
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 15 DEAL COLUMN
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    SRC Rank K
    AND
        DEST Size == 9
        DESTSRC Suit match
MOVE_STACK COLUMN COLUMN
DEST Size >= 10
$win
PILE ALL DRAW Empty
