Trime
$cards
DECK 4 {SPADES, CLUBS}

$initial
TRIGU 2 FACE_ALL
TRIGU 7 FACE_ALL
TRIGU 2 FACE_ALL

GOHE 8 FACE_LAST
GOHE 3 FACE_LAST
GOHE 5 FACE_LAST
GOHE 6 FACE_LAST
GOHE 9 FACE_LAST
GOHE 1 FACE_LAST
GOHE 9 FACE_LAST
GOHE 4 FACE_LAST

OME 6 FACE_HALF
OME 1 FACE_HALF
OME 3 FACE_HALF
OME 1 FACE_HALF

COLUMN 5 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 10 FACE_HALF

ISA 1 FACE_LAST
ISA 5 FACE_LAST
ISA 3 FACE_LAST
ISA 2 FACE_LAST
ISA 3 FACE_LAST
ISA 4 FACE_LAST
ISA 3 FACE_LAST

$moves
MOVE OME TRIGU
DEST Empty
MOVE_STACK {COLUMN, ISA, GOHE} TRIGU
OR
    AND
        DEST Empty
        SRCSTACK Size < 10
    DEST Size >= 7
MOVE_STACK OME {ISA, COLUMN, TRIGU, OME}
SRC Suit {SPADES, HEARTS}
$win
PILE ALL OME Empty
