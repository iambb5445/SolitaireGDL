Ocic
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 21 DEAL COLUMN
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE COLUMN COLUMN
OR
    DEST Empty
    AND
        SRC Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
        DEST Size >= 6
MOVE_STACK COLUMN COLUMN
DEST Size < 2
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
