Brop
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 47 DEAL COLUMN
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
AND
    AND
        DEST Size < 2
        DESTSRC Rank add_13
    DEST Empty
$win
AND
    PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
