Qeasad
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
ATA 9 FACE_ALL
ATA 3 FACE_ALL
ATA 1 FACE_ALTERNATE_LAST
ATA 5 FACE_ALTERNATE_LAST
ATA 1 FACE_ALTERNATE_LAST

MAIDE 10 FACE_ALL
MAIDE 2 FACE_ALL
MAIDE 7 FACE_ALTERNATE_LAST
MAIDE 9 FACE_ALTERNATE_LAST

COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE_STACK COLUMN ATA
DESTSRC Suit match_color
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL MAIDE Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL MAIDE Empty
