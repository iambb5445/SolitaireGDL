Vaet
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 45 DEAL YIOTIR
YIOTIR 9 FACE_HALF
YIOTIR 6 FACE_HALF
YIOTIR 2 FACE_HALF
YIOTIR 6 FACE_HALF
YIOTIR 10 FACE_HALF
YIOTIR 10 FACE_HALF
YIOTIR 5 FACE_HALF
YIOTIR 9 FACE_HALF
YIOTIR 2 FACE_HALF

$moves
MOVE YIOTIR YIOTIR
DESTSRC Suit match_color
MOVE_STACK YIOTIR YIOTIR
AND
    OR
        SRCSTACK Size < 3
        DEST Size < 8
    AND
        DEST Empty
        SRCSTACK Suit match_color
DRAW
PILE ALL DRAW Size > 0
$win
OR
    AND
        PILE ALL YIOTIR Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL YIOTIR Empty
        PILE ALL DRAW Empty
