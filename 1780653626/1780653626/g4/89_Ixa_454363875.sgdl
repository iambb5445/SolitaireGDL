Ixa
$cards
DECK 8 SPADES

$initial
DRAW 57 DEAL {BRAIGI, UFEAY}
BRAIGI 10 FACE_ALTERNATE_LAST
BRAIGI 3 FACE_ALTERNATE_LAST
BRAIGI 10 FACE_ALTERNATE_LAST
BRAIGI 6 FACE_ALTERNATE_LAST
BRAIGI 4 FACE_LAST
BRAIGI 3 FACE_LAST

UFEAY 9 FACE_ALTERNATE_LAST

HIYAC 1 FACE_HALF
HIYAC 1 FACE_HALF
HIYAC 0 FACE_HALF

$moves
MOVE {UFEAY, BRAIGI} BRAIGI
SRC Suit {HEARTS}
MOVE HIYAC HIYAC
OR
    AND
        DEST Suit {CLUBS, HEARTS}
        DEST Rank 1
    DESTSRC Suit match
MOVE_STACK HIYAC HIYAC
SRC Rank 1
MOVE_STACK BRAIGI HIYAC
AND
    SRC Rank 1
    OR
        DEST Suit {SPADES}
        SRC Suit {CLUBS, HEARTS, DIAMONDS}
DRAW
PILE ANY BRAIGI Empty
$win
AND
    AND
        PILE ALL BRAIGI Empty
        PILE ALL HIYAC Empty
    OR
        PILE ALL HIYAC Empty
        PILE ALL HIYAC Empty
