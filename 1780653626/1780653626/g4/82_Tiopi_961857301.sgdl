Tiopi
$cards
DECK 1 {SPADES, CLUBS}

$initial
NOVUJ 9 FACE_ALTERNATE_LAST
NOVUJ 4 FACE_ALTERNATE_LAST
NOVUJ 0 FACE_ALTERNATE_LAST
NOVUJ 7 FACE_ALTERNATE_LAST
NOVUJ 6 FACE_ALTERNATE_LAST

$moves
MOVE_STACK NOVUJ NOVUJ
OR
    SRC Suit {DIAMONDS}
    DESTSRC Rank descending
$win
OR
    AND
        PILE ALL NOVUJ Empty
        PILE ALL NOVUJ Empty
    AND
        PILE ALL NOVUJ Empty
        PILE ALL NOVUJ Empty
