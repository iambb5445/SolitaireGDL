Oreap
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 66 DEAL BAEJAG
BAEJAG 8 FACE_ALL
BAEJAG 5 FACE_ALL
BAEJAG 9 FACE_ALL
BAEJAG 9 FACE_ALL
BAEJAG 7 FACE_ALL

$moves
MOVE BAEJAG BAEJAG
OR
    SRC Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
    DEST Size >= 8
MOVE_STACK BAEJAG BAEJAG
OR
    AND
        DEST Size >= 1
        SRCSTACK Suit alternate_color
    DEST Suit {DIAMONDS, HEARTS}
DRAW
PILE ALL DRAW Empty
$win
PILE ALL DRAW Empty
