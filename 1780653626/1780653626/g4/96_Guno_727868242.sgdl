Guno
$cards
DECK 1 {SPADES, HEARTS}

$initial
ILO 2 FACE_HALF
ILO 7 FACE_HALF

AVAEQ 6 FACE_ALL

FUIGEH 1 FACE_ALTERNATE_LAST
FUIGEH 5 FACE_ALTERNATE_LAST
FUIGEH 0 FACE_ALTERNATE_LAST
FUIGEH 5 FACE_LAST

$moves
MOVE {ILO, AVAEQ} AVAEQ
AND
    DESTSRC Rank ascending
    DESTSRC Rank add_13
MOVE {ILO, AVAEQ} ILO
OR
    AND
        DEST Suit {CLUBS, HEARTS, DIAMONDS}
        DEST Empty
    AND
        SRC Rank 1
        DEST Suit {CLUBS}
MOVE_STACK ILO FUIGEH
OR
    AND
        SRCSTACK Suit match
        DEST Empty
    DEST Suit {SPADES}
MOVE_STACK ILO ILO
AND
    OR
        SRC Rank 1
        DEST Suit {SPADES}
    OR
        DEST Suit {DIAMONDS, SPADES, HEARTS}
        DESTSRC Rank add_13
$win
PILE ALL FUIGEH Empty
