Opi
$cards
DECK 4 {SPADES, CLUBS}

$initial
GREAYOR 10 FACE_ALTERNATE_LAST
GREAYOR 8 FACE_ALTERNATE_LAST
GREAYOR 4 FACE_ALTERNATE_LAST
GREAYOR 7 FACE_ALTERNATE_LAST
GREAYOR 7 FACE_ALTERNATE_LAST

IYAEH 1 FACE_ALL
IYAEH 10 FACE_ALL
IYAEH 6 FACE_ALL
IYAEH 4 FACE_HALF
IYAEH 5 FACE_HALF
IYAEH 10 FACE_HALF
IYAEH 8 FACE_HALF
IYAEH 1 FACE_HALF
IYAEH 9 FACE_HALF
IYAEH 3 FACE_HALF

COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALL
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN IYAEH
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {GREAYOR, IYAEH, COLUMN} COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {IYAEH, GREAYOR, COLUMN} IYAEH
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {IYAEH, COLUMN} COLUMN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL IYAEH Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL GREAYOR Empty
        PILE ALL GREAYOR Empty
