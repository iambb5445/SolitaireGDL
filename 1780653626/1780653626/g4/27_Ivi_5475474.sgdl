Ivi
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 27 ROTATE 3 U 2
ERI 4 FACE_LAST
ERI 7 FACE_LAST
ERI 9 FACE_ALL
ERI 6 FACE_ALL
ERI 2 FACE_LAST

AQOR 0 FACE_LAST
AQOR 7 FACE_LAST
AQOR 2 FACE_LAST

IQUC 3 FACE_ALTERNATE_LAST
IQUC 6 FACE_ALTERNATE_LAST
IQUC 10 FACE_ALTERNATE_LAST
IQUC 4 FACE_ALTERNATE_LAST
IQUC 4 FACE_ALTERNATE_LAST
IQUC 9 FACE_ALTERNATE_LAST

FRIBAT 4 FACE_ALTERNATE_LAST
FRIBAT 0 FACE_LAST

$moves
MOVE IQUC ERI
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {IQUC, AQOR, ERI, DRAW} AQOR
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {FRIBAT, IQUC, ERI} ERI
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {IQUC, AQOR} ERI
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL AQOR Empty
        PILE ALL FRIBAT Empty
    AND
        PILE ALL ERI Empty
        PILE ALL DRAW Empty
