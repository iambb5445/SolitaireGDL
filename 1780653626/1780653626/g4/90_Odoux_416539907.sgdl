Odoux
$cards
DECK 4 {SPADES, HEARTS}

$initial
PRED 5 FACE_LAST
PRED 7 FACE_LAST
PRED 4 FACE_LAST
PRED 6 FACE_LAST
PRED 9 FACE_LAST
PRED 10 FACE_LAST
PRED 8 FACE_LAST
PRED 1 FACE_LAST
PRED 8 FACE_LAST
PRED 3 FACE_LAST

ZEAMID 5 FACE_ALTERNATE_LAST
ZEAMID 0 FACE_ALTERNATE_LAST
ZEAMID 4 FACE_ALTERNATE_LAST
ZEAMID 3 FACE_ALTERNATE_LAST
ZEAMID 2 FACE_ALTERNATE_LAST

XUIB 5 FACE_HALF
XUIB 3 FACE_HALF
XUIB 0 FACE_HALF
XUIB 5 FACE_HALF
XUIB 3 FACE_HALF

OWEAN 5 FACE_LAST
OWEAN 8 FACE_ALL

$moves
MOVE OWEAN PRED
OR
    AND
        DESTSRC Rank descending
        DEST Empty
    AND
        DESTSRC Suit match
        DEST Suit {HEARTS, SPADES, CLUBS}
MOVE {XUIB, PRED} ZEAMID
OR
    AND
        DEST Empty
        DEST Size < 4
    AND
        DESTSRC Rank add_14
        DEST Suit {SPADES, DIAMONDS, CLUBS}
MOVE_STACK XUIB PRED
SRC Rank K
$win
PILE ALL XUIB Empty
