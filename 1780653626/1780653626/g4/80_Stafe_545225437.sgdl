Stafe
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 3 DEAL ADI
ADI 8 FACE_ALTERNATE_LAST

COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST

UYOR 3 FACE_ALL
UYOR 4 FACE_LAST

$moves
MOVE_STACK UYOR COLUMN
OR
    DEST Size > 3
    SRC Suit {SPADES}
MOVE_STACK UYOR ADI
OR
    DEST Suit {CLUBS, SPADES, DIAMONDS}
    DEST Rank K
DRAW
PILE ALL ADI Size > 0
$win
PILE ALL UYOR Empty
