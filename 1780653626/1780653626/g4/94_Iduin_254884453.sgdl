Iduin
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 12 ROTATE 3 U 2
OZA 8 FACE_ALL
OZA 10 FACE_ALL
OZA 2 FACE_ALL
OZA 1 FACE_ALL
OZA 3 FACE_ALL
OZA 7 FACE_ALL
OZA 9 FACE_ALL
OZA 5 FACE_ALL
OZA 4 FACE_ALL

UTAD 4 FACE_ALTERNATE_LAST
UTAD 4 FACE_ALTERNATE_LAST
UTAD 7 FACE_ALTERNATE_LAST
UTAD 3 FACE_ALTERNATE_LAST
UTAD 0 FACE_ALTERNATE_LAST
UTAD 9 FACE_ALL
UTAD 7 FACE_ALL
UTAD 9 FACE_ALL

$moves
MOVE OZA OZA
AND
    OR
        DESTSRC Suit match_color
        DEST Empty
    AND
        SRC Suit {DIAMONDS}
        SRC Rank 1
MOVE DRAW UTAD
SRC Suit {DIAMONDS, HEARTS}
MOVE_STACK {UTAD, OZA} OZA
OR
    AND
        DEST Empty
        DEST Size >= 6
    SRC Rank 1
MOVE_STACK UTAD UTAD
OR
    SRCSTACK Suit match
    AND
        SRCSTACK Suit match_color
        DESTSRC Rank ascending
$win
AND
    OR
        PILE ALL UTAD Empty
        PILE ALL OZA Empty
    PILE ALL OZA Empty
