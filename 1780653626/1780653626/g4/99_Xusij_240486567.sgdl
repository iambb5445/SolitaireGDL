Xusij
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 81 DEAL {ATA, COLUMN}
COLUMN 1 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 0 FACE_ALL

ATA 2 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {ATA, COLUMN} COLUMN
DEST Size < 4
DRAW
PILE ANY ATA Empty
$win
OR
    AND
        PILE ALL ATA Empty
        PILE ALL ATA Empty
    PILE ALL DRAW Empty
