Trog
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 4 FACE_ALL

IWI 3 FACE_ALTERNATE_LAST
IWI 9 FACE_ALTERNATE_LAST
IWI 7 FACE_ALTERNATE_LAST
IWI 4 FACE_ALTERNATE_LAST
IWI 6 FACE_LAST

PRIOGO 10 FACE_ALTERNATE_LAST
PRIOGO 1 FACE_ALTERNATE_LAST
PRIOGO 7 FACE_LAST
PRIOGO 1 FACE_LAST

$moves
MOVE IWI COLUMN
OR
    AND
        DEST Suit {HEARTS, DIAMONDS, SPADES}
        DEST Suit {SPADES}
    AND
        SRC Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
        DESTSRC Rank add_13
MOVE COLUMN COLUMN
OR
    DEST Size > 6
    AND
        DEST Suit {CLUBS, SPADES, DIAMONDS}
        DESTSRC Rank add_14
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL PRIOGO Empty
    AND
        PILE ALL PRIOGO Empty
        PILE ALL COLUMN Empty
