Yaes
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 3 U 2
COUNOZ 4 FACE_HALF
COUNOZ 6 FACE_HALF
COUNOZ 4 FACE_HALF
COUNOZ 0 FACE_HALF
COUNOZ 6 FACE_HALF
COUNOZ 8 FACE_HALF
COUNOZ 6 FACE_HALF
COUNOZ 2 FACE_HALF

AYEAL 10 FACE_ALTERNATE_LAST
AYEAL 2 FACE_ALTERNATE_LAST
AYEAL 5 FACE_ALTERNATE_LAST
AYEAL 7 FACE_ALTERNATE_LAST
AYEAL 1 FACE_ALTERNATE_LAST
AYEAL 7 FACE_ALTERNATE_LAST

QIOH 8 FACE_ALTERNATE_LAST

UKU 6 FACE_LAST
UKU 10 FACE_LAST
UKU 3 FACE_LAST
UKU 2 FACE_LAST
UKU 6 FACE_LAST

$moves
MOVE COUNOZ AYEAL
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {UKU, QIOH, COUNOZ, DRAW} AYEAL
OR
    SRC Rank 1
    DESTSRC Suit match
MOVE_STACK {COUNOZ, UKU, QIOH} QIOH
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {AYEAL, QIOH} QIOH
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL UKU Empty
        PILE ALL AYEAL Empty
    AND
        PILE ALL QIOH Empty
        PILE ALL DRAW Empty
