Ipaeb
$cards
DECK 4 {SPADES, HEARTS}

$initial
WAIGU 0 FACE_ALL
WAIGU 4 FACE_HALF
WAIGU 9 FACE_HALF

JUJAS 0 FACE_HALF
JUJAS 1 FACE_HALF
JUJAS 0 FACE_HALF
JUJAS 8 FACE_ALTERNATE_LAST

IDA 9 FACE_HALF
IDA 9 FACE_HALF
IDA 5 FACE_HALF
IDA 9 FACE_HALF
IDA 7 FACE_HALF
IDA 1 FACE_HALF
IDA 2 FACE_HALF
IDA 7 FACE_HALF
IDA 2 FACE_HALF
IDA 1 FACE_HALF

COLUMN 2 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 5 FACE_HALF

PAETE 8 FACE_ALL

$moves
MOVE_STACK COLUMN IDA
DEST Empty
MOVE_STACK COLUMN JUJAS
SRC Suit {CLUBS, DIAMONDS, SPADES, HEARTS}
$win
AND
    AND
        PILE ALL IDA Empty
        PILE ALL PAETE Empty
    AND
        PILE ALL IDA Empty
        PILE ALL WAIGU Empty
