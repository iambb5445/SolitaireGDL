Afo
$cards
DECK 1 {SPADES, HEARTS}

$initial
ZIOL 10 FACE_ALL

AKUQ 7 FACE_ALTERNATE_LAST
AKUQ 1 FACE_ALTERNATE_LAST
AKUQ 8 FACE_ALTERNATE_LAST

$moves
MOVE_STACK AKUQ ZIOL
SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
$win
OR
    PILE ALL AKUQ Empty
    AND
        PILE ALL ZIOL Empty
        PILE ALL ZIOL Empty
