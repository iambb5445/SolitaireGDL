Aji
$cards
DECK 2 {SPADES, CLUBS}

$initial
CRAC 2 FACE_ALL
CRAC 9 FACE_ALL
CRAC 3 FACE_ALL
CRAC 9 FACE_ALL
CRAC 4 FACE_ALL
CRAC 6 FACE_ALL
CRAC 0 FACE_ALL
CRAC 8 FACE_ALL

FOTOQ 1 FACE_ALTERNATE_LAST
FOTOQ 1 FACE_ALTERNATE_LAST
FOTOQ 0 FACE_ALTERNATE_LAST
FOTOQ 1 FACE_LAST
FOTOQ 3 FACE_LAST
FOTOQ 5 FACE_LAST

$moves
MOVE_STACK FOTOQ CRAC
AND
    OR
        DESTSRC Rank descending
        DESTSRC Rank ascending
    SRC Rank K
$win
PILE ALL FOTOQ Empty
