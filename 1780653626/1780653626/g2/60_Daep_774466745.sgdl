Daep
$cards
DECK 2 {SPADES, CLUBS}

$initial
CUIQIM 2 FACE_HALF
CUIQIM 9 FACE_HALF
CUIQIM 5 FACE_HALF
CUIQIM 1 FACE_HALF
CUIQIM 10 FACE_HALF
CUIQIM 3 FACE_HALF
CUIQIM 6 FACE_HALF
CUIQIM 6 FACE_HALF
CUIQIM 1 FACE_HALF

COLUMN 5 FACE_LAST
COLUMN 1 FACE_ALL
COLUMN 3 FACE_ALL

$moves
MOVE CUIQIM CUIQIM
OR
    AND
        DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
        DEST Size > 6
    DEST Empty
$win
AND
    OR
        PILE ALL CUIQIM Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
