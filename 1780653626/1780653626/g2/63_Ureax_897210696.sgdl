Ureax
$cards
DECK 1 {SPADES, HEARTS}

$initial
DRAW 18 ROTATE 1 U 2
OZE 8 FACE_ALTERNATE_LAST

$moves
MOVE OZE OZE
DEST Suit {SPADES}
MOVE DRAW OZE
SRC Suit {HEARTS, SPADES, DIAMONDS}
MOVE_STACK OZE OZE
OR
    AND
        DEST Suit {CLUBS, SPADES, DIAMONDS}
        DESTSRC Rank add_13
    AND
        SRCSTACK Size < 2
        DEST Empty
$win
PILE ALL DRAW Empty
