Siom
$cards
DECK 4 {SPADES, CLUBS}

$initial
OHE 0 FACE_ALTERNATE_LAST
OHE 3 FACE_ALTERNATE_LAST
OHE 9 FACE_ALTERNATE_LAST
OHE 5 FACE_ALTERNATE_LAST
OHE 10 FACE_ALTERNATE_LAST

ZEASOZ 9 FACE_HALF
ZEASOZ 4 FACE_HALF
ZEASOZ 10 FACE_HALF
ZEASOZ 0 FACE_HALF
ZEASOZ 2 FACE_HALF
ZEASOZ 9 FACE_HALF

JOVEB 7 FACE_LAST
JOVEB 7 FACE_HALF

COLUMN 1 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 7 FACE_ALL

$moves
MOVE {JOVEB, OHE} JOVEB
OR
    SRC Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
    AND
        SRC Suit {CLUBS}
        DEST Suit {SPADES, HEARTS}
MOVE_STACK JOVEB {ZEASOZ, COLUMN}
OR
    SRC Suit {CLUBS, HEARTS, DIAMONDS}
    AND
        DEST Rank 1
        DESTSRC Suit match
MOVE_STACK {JOVEB, OHE, ZEASOZ} OHE
OR
    DESTSRC Rank equal
    SRCSTACK Suit match_color
$win
PILE ALL ZEASOZ Empty
