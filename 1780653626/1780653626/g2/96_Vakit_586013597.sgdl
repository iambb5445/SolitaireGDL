Vakit
$cards
DECK 8 SPADES

$initial
COLUMN 1 FACE_ALL
COLUMN 8 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 0 FACE_LAST

PAJUZ 9 FACE_ALTERNATE_LAST
PAJUZ 9 FACE_ALTERNATE_LAST
PAJUZ 8 FACE_ALTERNATE_LAST
PAJUZ 7 FACE_ALTERNATE_LAST
PAJUZ 7 FACE_ALTERNATE_LAST

BRIZ 3 FACE_ALL
BRIZ 4 FACE_ALL
BRIZ 1 FACE_ALL
BRIZ 2 FACE_ALTERNATE_LAST
BRIZ 5 FACE_ALTERNATE_LAST

OLI 5 FACE_ALL
OLI 0 FACE_ALL
OLI 7 FACE_ALL
OLI 7 FACE_ALL

$moves
MOVE_STACK {BRIZ, COLUMN, OLI} COLUMN
OR
    AND
        SRCSTACK Size <= 6
        DEST Empty
    AND
        DESTSRC Rank descending
        DEST Rank K
$win
OR
    PILE ALL BRIZ Empty
    AND
        PILE ALL OLI Empty
        PILE ALL COLUMN Empty
