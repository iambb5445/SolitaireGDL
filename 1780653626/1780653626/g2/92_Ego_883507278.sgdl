$moves
MOVE IMO {IMO, COLUMN}
SRC Rank 1
MOVE_STACK IMO IMO
DEST Rank 1
MOVE_STACK COLUMN IMO
DESTSRC Suit alternate_color
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL IMO Empty
        PILE ALL COLUMN Empty
