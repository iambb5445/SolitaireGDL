Ego
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF

IMO 5 FACE_HALF
IMO 2 FACE_HALF
IMO 9 FACE_HALF
IMO 7 FACE_HALF
IMO 1 FACE_HALF
IMO 7 FACE_HALF
IMO 0 FACE_HALF
IMO 4 FACE_HALF
