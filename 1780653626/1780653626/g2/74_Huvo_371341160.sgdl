Huvo
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 2 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 9 FACE_HALF

BROUT 0 FACE_ALL
BROUT 10 FACE_ALTERNATE_LAST
BROUT 1 FACE_ALTERNATE_LAST

YUQE 8 FACE_LAST
YUQE 6 FACE_LAST
YUQE 3 FACE_LAST
YUQE 10 FACE_LAST
YUQE 9 FACE_HALF
YUQE 7 FACE_HALF

$moves
MOVE_STACK BROUT COLUMN
AND
    OR
        SRC Rank 1
        SRC Suit {CLUBS, HEARTS}
    AND
        DESTSRC Suit alternate_color
        SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL BROUT Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL BROUT Empty
        PILE ALL COLUMN Empty
