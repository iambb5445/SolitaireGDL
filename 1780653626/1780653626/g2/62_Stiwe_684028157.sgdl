Stiwe
$cards
DECK 4 {SPADES, HEARTS}

$initial
EZOX 6 FACE_HALF
EZOX 9 FACE_HALF
EZOX 9 FACE_HALF
EZOX 0 FACE_HALF
EZOX 0 FACE_HALF
EZOX 6 FACE_LAST
EZOX 0 FACE_LAST
EZOX 9 FACE_LAST
EZOX 5 FACE_LAST
EZOX 3 FACE_LAST

OMEAF 9 FACE_ALL
OMEAF 3 FACE_ALL
OMEAF 6 FACE_ALL
OMEAF 1 FACE_ALL
OMEAF 9 FACE_ALL
OMEAF 7 FACE_ALL
OMEAF 3 FACE_ALL
OMEAF 9 FACE_ALL
OMEAF 1 FACE_ALL
OMEAF 0 FACE_ALL

FAIPUP 9 FACE_ALL

$moves
MOVE EZOX FAIPUP
DEST Empty
MOVE_STACK OMEAF {EZOX, OMEAF}
DEST Rank K
MOVE_STACK FAIPUP EZOX
AND
    DEST Rank K
    AND
        DEST Size == 6
        SRCSTACK Suit match
$win
OR
    PILE ALL FAIPUP Empty
    AND
        PILE ALL FAIPUP Empty
        PILE ALL OMEAF Empty
