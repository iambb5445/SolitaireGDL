Lioj
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
OXAIX 1 FACE_LAST
OXAIX 6 FACE_LAST
OXAIX 9 FACE_LAST
OXAIX 2 FACE_LAST
OXAIX 1 FACE_LAST
OXAIX 2 FACE_LAST
OXAIX 0 FACE_LAST
OXAIX 2 FACE_LAST
OXAIX 2 FACE_LAST
OXAIX 2 FACE_LAST

COUFIY 7 FACE_ALTERNATE_LAST
COUFIY 3 FACE_ALTERNATE_LAST
COUFIY 1 FACE_ALTERNATE_LAST
COUFIY 2 FACE_ALTERNATE_LAST
COUFIY 4 FACE_ALTERNATE_LAST
COUFIY 8 FACE_ALTERNATE_LAST

$moves
MOVE OXAIX COUFIY
OR
    DESTSRC Rank add_14
    DESTSRC Rank add_14
MOVE COUFIY COUFIY
DESTSRC Rank descending
MOVE_STACK OXAIX COUFIY
DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE_STACK COUFIY OXAIX
OR
    AND
        DEST Empty
        SRC Suit {CLUBS, HEARTS}
    SRC Rank 1
$win
OR
    AND
        PILE ALL OXAIX Empty
        PILE ALL OXAIX Empty
    PILE ALL COUFIY Empty
