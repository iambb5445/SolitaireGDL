Ure
$cards
DECK 4 {SPADES, CLUBS}

$initial
UKIOQ 9 FACE_ALL
UKIOQ 2 FACE_LAST
UKIOQ 5 FACE_LAST

WEMI 0 FACE_ALL
WEMI 4 FACE_ALL

OGAIM 2 FACE_LAST
OGAIM 9 FACE_LAST
OGAIM 2 FACE_HALF
OGAIM 6 FACE_HALF
OGAIM 6 FACE_HALF

TRILU 8 FACE_LAST
TRILU 8 FACE_LAST
TRILU 0 FACE_LAST
TRILU 0 FACE_LAST

IWO 0 FACE_LAST
IWO 7 FACE_LAST
IWO 6 FACE_LAST
IWO 10 FACE_LAST
IWO 1 FACE_LAST
IWO 2 FACE_LAST
IWO 7 FACE_ALL
IWO 6 FACE_ALL
IWO 4 FACE_ALL

$moves
MOVE_STACK TRILU IWO
AND
    OR
        DEST Suit {DIAMONDS, HEARTS, SPADES, CLUBS}
        SRCSTACK Size >= 6
    DEST Empty
MOVE_STACK {TRILU, OGAIM, UKIOQ} WEMI
OR
    AND
        DESTSRC Rank equal
        DEST Suit {DIAMONDS}
    SRCSTACK Rank equal
$win
OR
    AND
        PILE ALL IWO Empty
        PILE ALL WEMI Empty
    AND
        PILE ALL UKIOQ Empty
        PILE ALL OGAIM Empty
