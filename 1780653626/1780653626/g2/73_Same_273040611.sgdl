Same
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 9 DEAL HIOHIN
BROFA 7 FACE_LAST
BROFA 4 FACE_ALTERNATE_LAST
BROFA 4 FACE_ALTERNATE_LAST
BROFA 3 FACE_ALTERNATE_LAST

HIOHIN 6 FACE_HALF
HIOHIN 9 FACE_ALL
HIOHIN 10 FACE_ALL

$moves
MOVE BROFA HIOHIN
DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
MOVE_STACK HIOHIN HIOHIN
AND
    SRC Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
    SRC Rank K
MOVE_STACK BROFA HIOHIN
DESTSRC Suit match
DRAW
PILE ALL DRAW Size > 0
$win
OR
    AND
        PILE ALL BROFA Empty
        PILE ALL BROFA Empty
    PILE ALL HIOHIN Empty
