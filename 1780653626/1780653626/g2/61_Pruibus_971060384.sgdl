Pruibus
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 77 DEAL YEVAS
YEVAS 1 FACE_ALTERNATE_LAST
YEVAS 7 FACE_HALF

CREK 10 FACE_ALTERNATE_LAST
CREK 1 FACE_ALTERNATE_LAST
CREK 2 FACE_ALTERNATE_LAST
CREK 6 FACE_ALTERNATE_LAST

$moves
MOVE CREK CREK
AND
    SRC Suit {DIAMONDS, CLUBS}
    SRC Suit {DIAMONDS}
MOVE_STACK YEVAS YEVAS
OR
    AND
        SRCSTACK Rank descending
        DEST Empty
    DEST Suit {SPADES, HEARTS}
MOVE_STACK CREK CREK
SRC Suit {DIAMONDS}
DRAW
PILE ALL DRAW Size > 0
$win
PILE ALL DRAW Empty
