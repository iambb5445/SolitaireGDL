Triore
$cards
DECK 1 SPADES

$initial
STIONOQ 6 FACE_HALF

COLUMN 7 FACE_HALF
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE STIONOQ COLUMN
OR
    AND
        DESTSRC Rank equal
        DEST Size >= 10
    DEST Rank 1
$win
AND
    AND
        PILE ALL STIONOQ Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
