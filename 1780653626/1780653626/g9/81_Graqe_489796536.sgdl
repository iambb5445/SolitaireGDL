Graqe
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 45 DEAL {TOUH, PREAFAK, COLUMN, ADIOJ}
TOUH 8 FACE_ALTERNATE_LAST

PREAFAK 6 FACE_HALF

COLUMN 10 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 9 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 6 FACE_ALL

ADIOJ 9 FACE_ALL

$moves
MOVE COLUMN {TOUH, ADIOJ}
SRC Rank 1
MOVE_STACK {ADIOJ, COLUMN, TOUH, PREAFAK} PREAFAK
AND
    AND
        DESTSRC Rank add_14
        SRCSTACK Suit alternate_color
    SRC Suit {SPADES}
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
