Yeawe
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 0 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

AMU 1 FACE_ALTERNATE_LAST

XUIHUT 1 FACE_ALTERNATE_LAST

HON 0 FACE_LAST
HON 7 FACE_ALL
HON 6 FACE_ALL

JAEY 9 FACE_ALTERNATE_LAST

UNAZ 10 FACE_HALF
UNAZ 2 FACE_HALF
UNAZ 7 FACE_HALF

ATEQ 8 FACE_ALL
ATEQ 9 FACE_ALL

RUIJ 1 FACE_ALTERNATE_LAST
RUIJ 7 FACE_ALTERNATE_LAST
RUIJ 3 FACE_LAST
RUIJ 3 FACE_LAST
RUIJ 0 FACE_LAST
RUIJ 1 FACE_LAST
RUIJ 4 FACE_LAST

NEDOK 2 FACE_LAST

$moves
MOVE_STACK ATEQ UNAZ
AND
    OR
        SRCSTACK Size >= 1
        DEST Empty
    OR
        DEST Empty
        SRCSTACK Size < 4
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL XUIHUT Empty
    PILE ALL HON Empty
