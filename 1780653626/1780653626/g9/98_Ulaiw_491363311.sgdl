Ulaiw
$cards
DECK 2 {SPADES, CLUBS}

$initial
OKIOY 5 FACE_ALTERNATE_LAST
OKIOY 2 FACE_LAST
OKIOY 8 FACE_LAST
OKIOY 3 FACE_LAST
OKIOY 1 FACE_LAST
OKIOY 8 FACE_LAST
OKIOY 5 FACE_LAST

COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_ALL
COLUMN 0 FACE_ALL

$moves
MOVE OKIOY COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        DEST Size >= 9
    DEST Size == 2
MOVE_STACK {COLUMN, OKIOY} OKIOY
DESTSRC Suit match_color
$win
PILE ALL COLUMN Empty
