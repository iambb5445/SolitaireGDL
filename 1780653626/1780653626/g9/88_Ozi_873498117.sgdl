Ozi
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 11 ROTATE 1 U 1
OPOQ 6 FACE_ALTERNATE_LAST
OPOQ 10 FACE_ALTERNATE_LAST
OPOQ 10 FACE_ALTERNATE_LAST
OPOQ 5 FACE_LAST

OFO 8 FACE_LAST
OFO 9 FACE_LAST
OFO 0 FACE_LAST
OFO 2 FACE_LAST

COLUMN 3 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE OFO COLUMN
AND
    OR
        DEST Empty
        DEST Size > 9
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank descending
MOVE COLUMN OFO
DEST Size >= 8
MOVE_STACK OPOQ COLUMN
DEST Rank K
MOVE_STACK {COLUMN, OPOQ} OFO
OR
    AND
        SRC Rank K
        DEST Size < 0
    AND
        SRCSTACK Suit match_color
        DEST Suit {DIAMONDS, HEARTS, SPADES}
$win
AND
    PILE ALL DRAW Empty
    PILE ALL DRAW Empty
