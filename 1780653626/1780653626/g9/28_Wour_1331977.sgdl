Wour
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 3 U 2
RUYIQ 1 FACE_ALL
RUYIQ 4 FACE_ALL
RUYIQ 6 FACE_ALTERNATE_LAST
RUYIQ 9 FACE_ALTERNATE_LAST
RUYIQ 2 FACE_ALTERNATE_LAST
RUYIQ 6 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 9 FACE_ALTERNATE_LAST
RUYIQ 7 FACE_ALTERNATE_LAST
RUYIQ 4 FACE_ALTERNATE_LAST

UZE 0 FACE_HALF
UZE 3 FACE_HALF
UZE 5 FACE_HALF
UZE 5 FACE_ALL
UZE 6 FACE_ALL
UZE 10 FACE_ALL
UZE 4 FACE_ALL
UZE 1 FACE_ALL
UZE 10 FACE_ALL
UZE 5 FACE_ALL

QEN 0 FACE_ALTERNATE_LAST
QEN 6 FACE_ALTERNATE_LAST

$moves
MOVE UZE UZE
AND
    OR
        SRC Rank K
        DEST Empty
    OR
        DESTSRC Rank descending
        SRC Rank K
MOVE {RUYIQ, QEN, UZE, DRAW} QEN
OR
    OR
        AND
            DESTSRC Rank equal
            DEST Suit {SPADES, DIAMONDS, HEARTS}
        DESTSRC Rank ascending
    DESTSRC Suit match
    DEST Size >= 5
MOVE_STACK {QEN, UZE, RUYIQ} RUYIQ
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {QEN, RUYIQ} QEN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
PILE ALL DRAW Empty
