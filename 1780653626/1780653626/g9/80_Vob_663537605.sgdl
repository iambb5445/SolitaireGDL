Vob
$cards
DECK 8 SPADES

$initial
COLUMN 3 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 10 FACE_LAST

KEV 4 FACE_HALF
KEV 3 FACE_HALF
KEV 6 FACE_HALF

ETE 8 FACE_ALTERNATE_LAST
ETE 3 FACE_ALTERNATE_LAST
ETE 7 FACE_ALTERNATE_LAST
ETE 7 FACE_ALTERNATE_LAST
ETE 9 FACE_ALTERNATE_LAST
ETE 8 FACE_ALTERNATE_LAST
ETE 2 FACE_ALTERNATE_LAST
ETE 9 FACE_ALTERNATE_LAST

ZAEJ 4 FACE_HALF
ZAEJ 0 FACE_HALF
ZAEJ 9 FACE_HALF
ZAEJ 7 FACE_HALF

$moves
MOVE COLUMN {COLUMN, KEV}
OR
    AND
        DEST Suit {HEARTS, DIAMONDS}
        DEST Empty
    DEST Size <= 1
MOVE {ZAEJ, ETE} ZAEJ
OR
    AND
        DEST Size <= 7
        SRC Suit {SPADES, CLUBS}
    DEST Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
MOVE_STACK KEV ZAEJ
OR
    SRCSTACK Suit alternate_color
    SRC Suit {SPADES}
$win
PILE ALL ZAEJ Empty
