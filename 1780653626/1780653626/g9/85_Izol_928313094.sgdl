Izol
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 38 ROTATE 3 U 3
COLUMN 7 FACE_ALTERNATE_LAST

OMO 6 FACE_ALTERNATE_LAST
OMO 1 FACE_ALTERNATE_LAST
OMO 2 FACE_ALTERNATE_LAST
OMO 1 FACE_ALTERNATE_LAST
OMO 8 FACE_ALTERNATE_LAST
OMO 1 FACE_ALTERNATE_LAST
OMO 2 FACE_ALTERNATE_LAST
OMO 3 FACE_ALTERNATE_LAST
OMO 10 FACE_ALTERNATE_LAST
OMO 8 FACE_ALTERNATE_LAST

ADEV 1 FACE_ALL
ADEV 4 FACE_ALL
ADEV 1 FACE_ALL
ADEV 5 FACE_ALL
ADEV 6 FACE_ALL

$moves
MOVE {ADEV, DRAW, OMO} OMO
OR
    AND
        DESTSRC Suit match_color
        DEST Rank 1
    AND
        DESTSRC Suit match
        DESTSRC Rank descending
$win
OR
    AND
        PILE ALL ADEV Empty
        PILE ALL OMO Empty
    AND
        PILE ALL ADEV Empty
        PILE ALL ADEV Empty
