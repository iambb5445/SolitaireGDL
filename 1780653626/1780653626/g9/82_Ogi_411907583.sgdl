Ogi
$cards
DECK 1 {SPADES, HEARTS}

$initial
IJO 8 FACE_ALTERNATE_LAST
IJO 0 FACE_ALTERNATE_LAST
IJO 10 FACE_ALTERNATE_LAST
IJO 3 FACE_ALTERNATE_LAST
IJO 4 FACE_ALTERNATE_LAST
IJO 1 FACE_ALTERNATE_LAST

$moves
MOVE IJO IJO
OR
    AND
        SRC Rank K
        DEST Size > 9
    AND
        DEST Empty
        SRC Rank K
MOVE_STACK IJO IJO
DEST Size == 2
$win
OR
    PILE ALL IJO Empty
    PILE ALL IJO Empty
