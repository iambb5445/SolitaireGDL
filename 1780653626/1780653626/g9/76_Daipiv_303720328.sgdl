Daipiv
$cards
DECK 8 SPADES

$initial
TITOW 9 FACE_LAST
TITOW 4 FACE_LAST
TITOW 0 FACE_LAST
TITOW 10 FACE_LAST
TITOW 6 FACE_LAST
TITOW 1 FACE_LAST
TITOW 2 FACE_LAST

VAF 2 FACE_ALTERNATE_LAST
VAF 6 FACE_LAST
VAF 10 FACE_LAST
VAF 3 FACE_LAST
VAF 7 FACE_LAST
VAF 10 FACE_LAST
VAF 8 FACE_LAST
VAF 4 FACE_LAST
VAF 7 FACE_LAST

ZUYIF 3 FACE_HALF
ZUYIF 3 FACE_HALF
ZUYIF 5 FACE_ALTERNATE_LAST
ZUYIF 4 FACE_ALTERNATE_LAST

$moves
MOVE ZUYIF VAF
OR
    SRC Rank K
    DEST Empty
MOVE VAF {TITOW, ZUYIF, VAF}
SRC Rank 1
MOVE_STACK TITOW ZUYIF
AND
    OR
        SRCSTACK Suit alternate_color
        DEST Size <= 1
    DEST Empty
$win
AND
    AND
        PILE ALL VAF Empty
        PILE ALL VAF Empty
    AND
        PILE ALL TITOW Empty
        PILE ALL ZUYIF Empty
