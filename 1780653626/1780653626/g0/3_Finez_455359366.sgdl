Finez
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
XAY 5 FACE_LAST

COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

SURI 8 FACE_LAST
SURI 10 FACE_LAST
SURI 10 FACE_LAST

DRAEX 9 FACE_LAST
DRAEX 6 FACE_LAST
DRAEX 7 FACE_LAST
DRAEX 1 FACE_LAST
DRAEX 5 FACE_LAST
DRAEX 7 FACE_LAST
DRAEX 4 FACE_LAST
DRAEX 0 FACE_ALL

ICUIK 0 FACE_ALTERNATE_LAST

YIOL 5 FACE_ALTERNATE_LAST
YIOL 9 FACE_ALL
YIOL 0 FACE_ALL
YIOL 0 FACE_ALL

$moves
MOVE ICUIK {DRAEX, COLUMN}
DESTSRC Suit match_color
MOVE XAY DRAEX
DESTSRC Suit match
MOVE_STACK YIOL COLUMN
OR
    AND
        DEST Rank K
        DEST Size >= 7
    DESTSRC Rank equal
$win
AND
    PILE ALL DRAEX Empty
    OR
        PILE ALL SURI Empty
        PILE ALL SURI Empty
