Ela
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 20 ROTATE 1 2 U
COJ 0 FACE_HALF
COJ 8 FACE_HALF
COJ 10 FACE_HALF
COJ 7 FACE_HALF
COJ 10 FACE_HALF
COJ 7 FACE_HALF
COJ 9 FACE_HALF

COLUMN 3 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 9 FACE_ALL
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 1 FACE_HALF

IKIX 5 FACE_LAST
IKIX 0 FACE_LAST
IKIX 3 FACE_LAST
IKIX 1 FACE_HALF

$moves
MOVE COLUMN IKIX
DEST Size <= 8
MOVE {COLUMN, COJ, DRAW} COLUMN
DESTSRC Rank add_14
MOVE_STACK COJ COJ
OR
    AND
        DESTSRC Suit alternate_color
        DEST Rank 1
    SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
