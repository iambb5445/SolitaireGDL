Jiop
$cards
DECK 8 SPADES

$initial
PRISO 6 FACE_HALF
PRISO 9 FACE_HALF
PRISO 3 FACE_HALF
PRISO 6 FACE_HALF

COLUMN 5 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

BRAITA 6 FACE_HALF

AJU 2 FACE_ALTERNATE_LAST
AJU 8 FACE_ALTERNATE_LAST
AJU 9 FACE_HALF
AJU 8 FACE_HALF
AJU 7 FACE_HALF

$moves
MOVE {BRAITA, PRISO, AJU} COLUMN
AND
    OR
        DESTSRC Suit match_color
        DEST Empty
    OR
        DEST Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
        DESTSRC Rank add_13
MOVE {COLUMN, BRAITA, PRISO} BRAITA
DESTSRC Suit alternate_color
MOVE_STACK PRISO PRISO
DEST Rank K
MOVE_STACK PRISO {AJU, COLUMN, BRAITA}
AND
    DEST Suit {CLUBS, DIAMONDS, HEARTS}
    AND
        DEST Size < 2
        DESTSRC Suit alternate_color
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL AJU Empty
        PILE ALL AJU Empty
