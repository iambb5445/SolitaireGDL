Frevoz
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 17 ROTATE 1 1 U
WUIRO 4 FACE_LAST
WUIRO 8 FACE_LAST
WUIRO 10 FACE_LAST

JAILAL 4 FACE_HALF
JAILAL 9 FACE_HALF
JAILAL 8 FACE_HALF
JAILAL 5 FACE_HALF
JAILAL 10 FACE_HALF

VOUNAQ 3 FACE_ALL

COLUMN 5 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 1 FACE_HALF

$moves
MOVE WUIRO {VOUNAQ, JAILAL, WUIRO, COLUMN}
OR
    AND
        DESTSRC Rank add_13
        DESTSRC Rank ascending
    DEST Empty
MOVE {COLUMN, VOUNAQ, JAILAL, DRAW} WUIRO
SRC Rank 1
MOVE_STACK COLUMN JAILAL
OR
    AND
        SRCSTACK Suit match
        SRCSTACK Rank add_13
    AND
        SRCSTACK Suit alternate_color
        DESTSRC Rank add_14
MOVE_STACK WUIRO WUIRO
OR
    DEST Rank 1
    AND
        SRCSTACK Suit match_color
        SRCSTACK Suit alternate_color
$win
OR
    PILE ALL JAILAL Empty
    PILE ALL WUIRO Empty
