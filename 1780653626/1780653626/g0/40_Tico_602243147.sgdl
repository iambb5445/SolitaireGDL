Tico
$cards
DECK 4 SPADES

$initial
TRIJ 2 FACE_ALTERNATE_LAST
TRIJ 2 FACE_ALTERNATE_LAST
TRIJ 4 FACE_ALTERNATE_LAST
TRIJ 4 FACE_ALTERNATE_LAST
TRIJ 0 FACE_ALTERNATE_LAST
TRIJ 2 FACE_ALTERNATE_LAST
TRIJ 7 FACE_ALTERNATE_LAST
TRIJ 2 FACE_ALTERNATE_LAST

VOUGAD 2 FACE_ALTERNATE_LAST
VOUGAD 4 FACE_LAST

ACOUL 2 FACE_ALTERNATE_LAST
ACOUL 1 FACE_ALTERNATE_LAST
ACOUL 9 FACE_ALTERNATE_LAST

CRIGA 6 FACE_ALTERNATE_LAST
CRIGA 5 FACE_HALF

$moves
MOVE {CRIGA, VOUGAD, TRIJ, ACOUL} CRIGA
AND
    DESTSRC Rank equal
    OR
        SRC Suit {SPADES, HEARTS, CLUBS}
        DEST Size > 3
MOVE {ACOUL, CRIGA, VOUGAD} ACOUL
OR
    AND
        SRC Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
        DESTSRC Rank add_13
    SRC Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
$win
PILE ALL TRIJ Empty
