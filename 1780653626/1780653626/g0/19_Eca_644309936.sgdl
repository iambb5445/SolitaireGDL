Eca
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 0 FACE_ALL
COLUMN 9 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 1 FACE_LAST

EKA 7 FACE_ALTERNATE_LAST

$moves
MOVE EKA EKA
OR
    AND
        DEST Rank K
        DESTSRC Rank ascending
    AND
        SRC Rank K
        DEST Size == 9
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL EKA Empty
