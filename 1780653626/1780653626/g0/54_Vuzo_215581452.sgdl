Vuzo
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
NIODE 7 FACE_ALL
NIODE 3 FACE_ALL
NIODE 7 FACE_ALL
NIODE 3 FACE_ALL
NIODE 2 FACE_ALL
NIODE 0 FACE_ALL
NIODE 10 FACE_ALL
NIODE 3 FACE_ALTERNATE_LAST
NIODE 1 FACE_ALTERNATE_LAST

OKE 2 FACE_HALF
OKE 0 FACE_HALF
OKE 0 FACE_HALF
OKE 3 FACE_ALL
OKE 7 FACE_ALL
OKE 4 FACE_ALL

$moves
MOVE OKE NIODE
AND
    DEST Empty
    OR
        DESTSRC Suit match_color
        DEST Size == 10
MOVE_STACK OKE NIODE
AND
    SRC Rank K
    SRCSTACK Rank equal
$win
OR
    PILE ALL NIODE Empty
    PILE ALL NIODE Empty
