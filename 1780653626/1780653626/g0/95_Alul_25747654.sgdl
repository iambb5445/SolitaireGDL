Alul
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
LOUTEH 7 FACE_ALTERNATE_LAST
LOUTEH 1 FACE_ALTERNATE_LAST
LOUTEH 2 FACE_ALTERNATE_LAST
LOUTEH 5 FACE_ALTERNATE_LAST
LOUTEH 7 FACE_ALTERNATE_LAST
LOUTEH 2 FACE_ALTERNATE_LAST
LOUTEH 2 FACE_ALTERNATE_LAST
LOUTEH 9 FACE_ALL

COLUMN 6 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 9 FACE_ALL
COLUMN 0 FACE_ALL

$moves
MOVE LOUTEH COLUMN
OR
    AND
        SRC Rank K
        DESTSRC Rank descending
    AND
        SRC Suit {SPADES}
        DEST Size > 0
MOVE LOUTEH LOUTEH
OR
    AND
        DEST Empty
        SRC Rank 1
    DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
DEST Rank K
$win
PILE ALL LOUTEH Empty
