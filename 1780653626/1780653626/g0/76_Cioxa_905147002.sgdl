Cioxa
$cards
DECK 2 {SPADES, HEARTS}

$initial
DRAW 32 ROTATE 3 U U
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 8 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 5 FACE_LAST

$moves
MOVE DRAW COLUMN
OR
    SRC Rank 1
    AND
        DEST Size > 6
        SRC Rank 1
MOVE COLUMN COLUMN
AND
    AND
        SRC Rank 1
        DEST Rank K
    SRC Suit {HEARTS, DIAMONDS, CLUBS}
MOVE_STACK COLUMN COLUMN
SRC Rank 1
$win
PILE ALL DRAW Empty
