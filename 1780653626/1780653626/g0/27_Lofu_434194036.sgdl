Lofu
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

QUWAB 1 FACE_ALTERNATE_LAST
QUWAB 0 FACE_ALTERNATE_LAST
QUWAB 3 FACE_ALL
QUWAB 1 FACE_ALL

ETO 1 FACE_ALL
ETO 5 FACE_ALL
ETO 3 FACE_ALL
ETO 8 FACE_ALTERNATE_LAST
ETO 3 FACE_ALTERNATE_LAST
ETO 7 FACE_ALTERNATE_LAST

SAIR 4 FACE_ALL
SAIR 3 FACE_ALL
SAIR 7 FACE_ALL
SAIR 0 FACE_ALL
SAIR 10 FACE_ALL
SAIR 0 FACE_ALL
SAIR 3 FACE_ALL

OCA 4 FACE_ALL
OCA 1 FACE_ALL
OCA 6 FACE_ALL

XESOR 6 FACE_HALF
XESOR 4 FACE_ALTERNATE_LAST

$moves
MOVE {QUWAB, XESOR, OCA, COLUMN, ETO} SAIR
OR
    DESTSRC Rank add_13
    AND
        DESTSRC Rank descending
        SRC Rank K
MOVE {COLUMN, OCA, XESOR} XESOR
OR
    DEST Size < 10
    AND
        DESTSRC Rank add_14
        DESTSRC Rank add_14
$win
AND
    AND
        PILE ALL COLUMN Empty
        PILE ALL QUWAB Empty
    AND
        PILE ALL SAIR Empty
        PILE ALL SAIR Empty
