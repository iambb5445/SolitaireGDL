Fiyey
$cards
DECK 1 {SPADES, CLUBS}

$initial
SOHA 2 FACE_HALF
SOHA 0 FACE_HALF
SOHA 3 FACE_LAST

NEAG 3 FACE_ALL
NEAG 1 FACE_ALL
NEAG 7 FACE_ALL
NEAG 1 FACE_ALL
NEAG 9 FACE_ALTERNATE_LAST

$moves
MOVE {NEAG, SOHA} NEAG
OR
    AND
        DEST Empty
        DEST Suit {CLUBS, DIAMONDS}
    DEST Empty
MOVE SOHA SOHA
OR
    AND
        DEST Size > 0
        DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
    AND
        DEST Suit {DIAMONDS}
        DEST Rank 1
MOVE_STACK NEAG NEAG
OR
    DESTSRC Rank add_13
    SRCSTACK Suit match
MOVE_STACK NEAG SOHA
OR
    AND
        SRCSTACK Suit alternate_color
        SRCSTACK Suit match_color
    SRC Suit {CLUBS, DIAMONDS}
$win
AND
    OR
        PILE ALL SOHA Empty
        PILE ALL NEAG Empty
    AND
        PILE ALL SOHA Empty
        PILE ALL SOHA Empty
