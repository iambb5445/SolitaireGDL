Uduf
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 23 ROTATE 1 U 1
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALTERNATE_LAST

FOUX 3 FACE_LAST
FOUX 10 FACE_LAST
FOUX 3 FACE_LAST
FOUX 6 FACE_LAST

HOJE 3 FACE_LAST
HOJE 3 FACE_LAST
HOJE 10 FACE_LAST
HOJE 8 FACE_LAST
HOJE 10 FACE_LAST
HOJE 1 FACE_LAST
HOJE 0 FACE_LAST
HOJE 3 FACE_LAST
HOJE 5 FACE_LAST
HOJE 4 FACE_LAST

ILOUV 0 FACE_HALF

$moves
MOVE DRAW ILOUV
AND
    DEST Size > 9
    AND
        DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
        DEST Rank K
MOVE COLUMN FOUX
OR
    AND
        SRC Rank K
        DESTSRC Suit match
    AND
        SRC Rank K
        DEST Empty
$win
OR
    AND
        PILE ALL ILOUV Empty
        PILE ALL ILOUV Empty
    PILE ALL HOJE Empty
