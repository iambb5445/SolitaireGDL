Uvouj
$cards
DECK 1 {SPADES, CLUBS}

$initial
LER 5 FACE_ALTERNATE_LAST
LER 0 FACE_ALTERNATE_LAST
LER 8 FACE_HALF
LER 7 FACE_HALF
LER 0 FACE_HALF
LER 0 FACE_HALF

BRER 5 FACE_ALL
BRER 1 FACE_ALL

$moves
MOVE BRER LER
OR
    AND
        DESTSRC Rank ascending
        DESTSRC Suit alternate_color
    AND
        DEST Rank K
        DEST Empty
MOVE LER {BRER, LER}
DEST Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
MOVE_STACK LER BRER
DEST Rank K
MOVE_STACK BRER BRER
DEST Size >= 10
$win
PILE ALL BRER Empty
