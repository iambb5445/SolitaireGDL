Vema
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 10 DEAL COLUMN
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
OR
    SRC Suit {DIAMONDS, CLUBS}
    AND
        SRC Suit {SPADES, CLUBS, DIAMONDS}
        DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
OR
    DEST Rank K
    AND
        SRCSTACK Size < 5
        DEST Suit {HEARTS, DIAMONDS, SPADES}
DRAW
PILE ANY DRAW Size > 0
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    OR
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
