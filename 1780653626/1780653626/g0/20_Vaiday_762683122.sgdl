Vaiday
$cards
DECK 4 SPADES

$initial
DRAW 24 ROTATE 3 U 3
FIRU 7 FACE_LAST
FIRU 5 FACE_LAST
FIRU 5 FACE_LAST
FIRU 3 FACE_LAST
FIRU 8 FACE_LAST

$moves
MOVE FIRU FIRU
SRC Suit {DIAMONDS, HEARTS, SPADES, CLUBS}
MOVE DRAW FIRU
AND
    OR
        DESTSRC Suit alternate_color
        DEST Empty
    DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
MOVE_STACK FIRU FIRU
OR
    DEST Empty
    SRC Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
$win
PILE ALL DRAW Empty
