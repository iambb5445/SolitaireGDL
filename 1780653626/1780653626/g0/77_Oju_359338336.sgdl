Oju
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 29 DEAL {IZEM, OMIF}
COLUMN 6 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 2 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 7 FACE_LAST

IZEM 9 FACE_ALL
IZEM 7 FACE_ALL

OMIF 2 FACE_ALL
OMIF 4 FACE_ALL
OMIF 6 FACE_ALL

$moves
MOVE OMIF OMIF
DEST Size > 10
MOVE IZEM IZEM
AND
    AND
        DEST Size >= 4
        SRC Rank K
    OR
        SRC Suit {HEARTS, DIAMONDS, SPADES}
        SRC Rank K
$win
PILE ALL DRAW Empty
