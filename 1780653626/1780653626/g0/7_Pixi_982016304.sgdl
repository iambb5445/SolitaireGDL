Pixi
$cards
DECK 4 SPADES

$initial
DRAW 27 ROTATE 3 U U
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
DESTSRC Rank ascending
MOVE_STACK COLUMN COLUMN
AND
    OR
        DESTSRC Rank ascending
        SRC Rank 1
    SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
