Uhut
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 36 DEAL GROJUX
GROJUX 6 FACE_HALF
GROJUX 1 FACE_ALTERNATE_LAST
GROJUX 5 FACE_ALTERNATE_LAST
GROJUX 4 FACE_ALTERNATE_LAST

$moves
MOVE GROJUX GROJUX
OR
    DEST Suit {HEARTS, CLUBS, DIAMONDS}
    AND
        DEST Size <= 1
        DEST Rank 1
MOVE_STACK GROJUX GROJUX
OR
    SRCSTACK Suit alternate_color
    AND
        SRCSTACK Rank equal
        DESTSRC Rank equal
DRAW
PILE ANY DRAW Empty
$win
PILE ALL GROJUX Empty
