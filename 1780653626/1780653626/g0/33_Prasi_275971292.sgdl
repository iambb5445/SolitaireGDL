Prasi
$cards
DECK 4 {SPADES, HEARTS}

$initial
MAIBAM 5 FACE_ALL
MAIBAM 3 FACE_ALL
MAIBAM 8 FACE_ALTERNATE_LAST
MAIBAM 7 FACE_ALTERNATE_LAST
MAIBAM 6 FACE_ALTERNATE_LAST
MAIBAM 9 FACE_ALTERNATE_LAST
MAIBAM 6 FACE_ALTERNATE_LAST
MAIBAM 8 FACE_ALTERNATE_LAST
MAIBAM 4 FACE_ALTERNATE_LAST
MAIBAM 7 FACE_ALTERNATE_LAST

OBO 8 FACE_ALTERNATE_LAST
OBO 7 FACE_ALTERNATE_LAST
OBO 9 FACE_LAST
OBO 0 FACE_LAST
OBO 3 FACE_LAST

TROUGUC 4 FACE_LAST
TROUGUC 6 FACE_LAST
TROUGUC 4 FACE_ALTERNATE_LAST

$moves
MOVE OBO TROUGUC
OR
    DESTSRC Rank equal
    AND
        DEST Suit {DIAMONDS, CLUBS}
        DEST Empty
$win
OR
    AND
        PILE ALL OBO Empty
        PILE ALL MAIBAM Empty
    PILE ALL MAIBAM Empty
