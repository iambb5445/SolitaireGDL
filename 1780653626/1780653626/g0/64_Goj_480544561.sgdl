Goj
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 70 DEAL COLUMN
COLUMN 0 FACE_LAST
COLUMN 8 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 3 FACE_ALL

$moves
MOVE COLUMN COLUMN
SRC Suit {SPADES, DIAMONDS}
MOVE_STACK COLUMN COLUMN
OR
    AND
        DEST Rank 1
        SRCSTACK Size > 6
    AND
        DEST Suit {DIAMONDS}
        DESTSRC Rank descending
DRAW
PILE ANY DRAW Empty
$win
PILE ALL COLUMN Empty
