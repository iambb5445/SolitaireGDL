Etiz
$cards
DECK 8 SPADES

$initial
DRAW 96 DEAL PUQIM
PUQIM 1 FACE_LAST
PUQIM 7 FACE_ALTERNATE_LAST

$moves
MOVE PUQIM PUQIM
OR
    AND
        DEST Suit {DIAMONDS, HEARTS}
        DEST Rank K
    DESTSRC Suit match_color
MOVE_STACK PUQIM PUQIM
OR
    AND
        SRCSTACK Size >= 6
        DESTSRC Rank equal
    SRCSTACK Suit alternate_color
$win
PILE ALL PUQIM Empty
