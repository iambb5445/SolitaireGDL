Udu
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EKOS 10 FACE_HALF
EKOS 8 FACE_ALTERNATE_LAST
EKOS 4 FACE_ALTERNATE_LAST

COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

OSOUL 2 FACE_HALF
OSOUL 2 FACE_HALF
OSOUL 10 FACE_HALF

EMAEN 9 FACE_HALF

CEW 2 FACE_ALTERNATE_LAST

$moves
MOVE {CEW, EKOS, COLUMN, OSOUL} OSOUL
AND
    OR
        DESTSRC Rank add_13
        SRC Rank K
    DEST Rank 1
$win
AND
    AND
        PILE ALL EMAEN Empty
        PILE ALL EKOS Empty
    AND
        PILE ALL EKOS Empty
        PILE ALL EKOS Empty
