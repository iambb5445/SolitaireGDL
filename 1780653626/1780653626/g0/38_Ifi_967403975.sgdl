Ifi
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 30 DEAL {OKE, RERUF, GEVE}
OKE 5 FACE_ALTERNATE_LAST
OKE 8 FACE_HALF

GEVE 5 FACE_ALL
GEVE 9 FACE_ALL
GEVE 7 FACE_ALL
GEVE 8 FACE_ALL
GEVE 6 FACE_ALL
GEVE 1 FACE_ALL
GEVE 1 FACE_ALL

RERUF 9 FACE_ALTERNATE_LAST
RERUF 5 FACE_ALTERNATE_LAST
RERUF 10 FACE_ALL

$moves
MOVE GEVE RERUF
DESTSRC Rank ascending
MOVE_STACK RERUF GEVE
OR
    SRCSTACK Suit match
    AND
        DEST Size <= 1
        SRC Rank 1
$win
AND
    PILE ALL GEVE Empty
    PILE ALL RERUF Empty
