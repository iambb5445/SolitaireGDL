Deagos
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 33 ROTATE 1 2 U
TRAEWEJ 1 FACE_ALL

ORA 3 FACE_ALL
ORA 6 FACE_ALL
ORA 8 FACE_ALL
ORA 1 FACE_ALL

$moves
MOVE_STACK {ORA, TRAEWEJ} TRAEWEJ
OR
    AND
        DESTSRC Suit match
        SRC Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
    AND
        SRCSTACK Suit alternate_color
        DEST Size > 10
MOVE_STACK {ORA, TRAEWEJ} ORA
SRCSTACK Suit match
$win
AND
    PILE ALL ORA Empty
    PILE ALL TRAEWEJ Empty
