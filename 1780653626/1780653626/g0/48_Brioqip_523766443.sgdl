Brioqip
$cards
DECK 2 {SPADES, CLUBS}

$initial
OVU 7 FACE_HALF
OVU 0 FACE_HALF
OVU 8 FACE_HALF
OVU 6 FACE_HALF
OVU 5 FACE_HALF

COLUMN 7 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 6 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN {OVU, COLUMN}
OR
    SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRC Rank K
MOVE OVU COLUMN
DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
$win
OR
    AND
        PILE ALL OVU Empty
        PILE ALL COLUMN Empty
    PILE ALL OVU Empty
