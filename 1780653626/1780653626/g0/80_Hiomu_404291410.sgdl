Hiomu
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL

MUIX 9 FACE_HALF
MUIX 1 FACE_HALF
MUIX 3 FACE_HALF
MUIX 5 FACE_HALF
MUIX 7 FACE_HALF
MUIX 8 FACE_HALF
MUIX 10 FACE_HALF
MUIX 4 FACE_HALF
MUIX 1 FACE_HALF

$moves
MOVE_STACK {COLUMN, MUIX} MUIX
AND
    SRC Rank 1
    SRC Rank K
MOVE_STACK COLUMN COLUMN
DEST Rank K
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
