Brohe
$cards
DECK 4 {SPADES, HEARTS}

$initial
TAIF 9 FACE_LAST
TAIF 2 FACE_LAST
TAIF 2 FACE_LAST

GAMO 4 FACE_HALF
GAMO 3 FACE_HALF
GAMO 5 FACE_HALF
GAMO 9 FACE_HALF
GAMO 2 FACE_ALTERNATE_LAST
GAMO 9 FACE_ALTERNATE_LAST

PRAIHIM 5 FACE_LAST
PRAIHIM 8 FACE_LAST
PRAIHIM 7 FACE_LAST
PRAIHIM 10 FACE_LAST

LULU 9 FACE_LAST
LULU 1 FACE_LAST
LULU 1 FACE_LAST
LULU 0 FACE_ALTERNATE_LAST
LULU 5 FACE_ALTERNATE_LAST
LULU 4 FACE_ALTERNATE_LAST
LULU 7 FACE_ALTERNATE_LAST
LULU 2 FACE_ALTERNATE_LAST

$moves
MOVE {PRAIHIM, LULU, TAIF} LULU
DEST Empty
MOVE TAIF PRAIHIM
AND
    OR
        SRC Rank 1
        DESTSRC Suit match
    DEST Size <= 2
$win
OR
    PILE ALL LULU Empty
    AND
        PILE ALL LULU Empty
        PILE ALL GAMO Empty
