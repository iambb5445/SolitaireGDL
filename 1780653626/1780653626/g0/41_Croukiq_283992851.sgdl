Croukiq
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 28 DEAL {VACO, COLUMN}
VACO 10 FACE_ALTERNATE_LAST
VACO 9 FACE_ALTERNATE_LAST
VACO 2 FACE_ALTERNATE_LAST
VACO 10 FACE_ALTERNATE_LAST
VACO 0 FACE_ALTERNATE_LAST
VACO 5 FACE_ALTERNATE_LAST
VACO 6 FACE_ALTERNATE_LAST

COLUMN 10 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE VACO COLUMN
OR
    AND
        SRC Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
        DEST Suit {DIAMONDS, SPADES}
    AND
        SRC Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
        DEST Suit {SPADES, CLUBS, HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
