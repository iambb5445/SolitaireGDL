Loudiy
$cards
DECK 8 SPADES

$initial
QASA 1 FACE_ALL
QASA 9 FACE_ALL
QASA 2 FACE_ALL
QASA 9 FACE_ALL
QASA 0 FACE_ALL
QASA 2 FACE_ALL
QASA 7 FACE_ALL
QASA 7 FACE_ALL
QASA 8 FACE_ALL
QASA 8 FACE_ALL

OTEAL 3 FACE_ALTERNATE_LAST
OTEAL 7 FACE_ALTERNATE_LAST
OTEAL 6 FACE_ALTERNATE_LAST
OTEAL 4 FACE_ALTERNATE_LAST
OTEAL 0 FACE_ALTERNATE_LAST

COLUMN 5 FACE_HALF

GREAZE 2 FACE_ALTERNATE_LAST
GREAZE 1 FACE_ALTERNATE_LAST
GREAZE 0 FACE_ALTERNATE_LAST
GREAZE 9 FACE_ALL
GREAZE 7 FACE_ALL
GREAZE 1 FACE_ALL
GREAZE 6 FACE_ALL

$moves
MOVE {QASA, COLUMN, OTEAL} COLUMN
OR
    AND
        DESTSRC Suit match
        DEST Rank 1
    AND
        DESTSRC Suit match_color
        DESTSRC Rank descending
MOVE QASA {GREAZE, OTEAL}
OR
    AND
        DESTSRC Suit alternate_color
        SRC Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
    AND
        DEST Empty
        SRC Rank K
MOVE_STACK GREAZE COLUMN
DEST Suit {HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL OTEAL Empty
