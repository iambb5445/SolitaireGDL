Xiqo
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 7 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 9 FACE_LAST

IHIOD 1 FACE_ALL
IHIOD 4 FACE_LAST
IHIOD 9 FACE_LAST
IHIOD 10 FACE_LAST
IHIOD 2 FACE_LAST

$moves
MOVE IHIOD IHIOD
DEST Size >= 9
MOVE COLUMN IHIOD
SRC Rank 1
MOVE_STACK {IHIOD, COLUMN} COLUMN
DEST Rank 1
MOVE_STACK {IHIOD, COLUMN} IHIOD
OR
    AND
        DEST Size > 3
        SRCSTACK Suit alternate_color
    AND
        DEST Rank K
        DESTSRC Rank add_13
$win
OR
    AND
        PILE ALL IHIOD Empty
        PILE ALL IHIOD Empty
    PILE ALL COLUMN Empty
