Epu
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 54 ROTATE 1 2 U
DRUIKAN 7 FACE_HALF
DRUIKAN 9 FACE_HALF
DRUIKAN 1 FACE_ALL
DRUIKAN 3 FACE_ALL
DRUIKAN 7 FACE_ALL
DRUIKAN 5 FACE_ALL
DRUIKAN 3 FACE_ALL
DRUIKAN 4 FACE_ALL

UWUIQ 3 FACE_LAST

COLUMN 8 FACE_ALL

$moves
MOVE {COLUMN, DRUIKAN, UWUIQ} DRUIKAN
AND
    OR
        DESTSRC Rank equal
        DEST Suit {HEARTS, SPADES, CLUBS}
    OR
        DEST Rank 1
        DEST Rank 1
MOVE DRAW COLUMN
SRC Suit {DIAMONDS, SPADES}
MOVE_STACK DRUIKAN COLUMN
DEST Empty
$win
PILE ALL DRUIKAN Empty
