Drokiy
$cards
DECK 2 {SPADES, HEARTS}

$initial
PUTA 7 FACE_ALTERNATE_LAST
PUTA 7 FACE_ALTERNATE_LAST
PUTA 0 FACE_ALTERNATE_LAST
PUTA 8 FACE_ALTERNATE_LAST
PUTA 4 FACE_LAST
PUTA 5 FACE_LAST
PUTA 6 FACE_LAST
PUTA 4 FACE_LAST
PUTA 3 FACE_LAST

BABOT 8 FACE_HALF
BABOT 0 FACE_LAST

$moves
MOVE_STACK BABOT PUTA
OR
    SRC Rank 1
    AND
        DEST Empty
        SRC Suit {CLUBS, SPADES, DIAMONDS}
MOVE_STACK PUTA BABOT
AND
    OR
        SRCSTACK Suit match
        DEST Size <= 8
    SRCSTACK Rank add_13
$win
AND
    OR
        PILE ALL PUTA Empty
        PILE ALL PUTA Empty
    AND
        PILE ALL BABOT Empty
        PILE ALL BABOT Empty
