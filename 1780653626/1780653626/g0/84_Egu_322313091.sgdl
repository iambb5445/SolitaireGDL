Egu
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
JOUPI 1 FACE_ALL
JOUPI 3 FACE_ALL
JOUPI 4 FACE_ALL
JOUPI 9 FACE_ALL
JOUPI 5 FACE_ALL
JOUPI 2 FACE_ALL
JOUPI 1 FACE_LAST

KOUJIL 10 FACE_LAST
KOUJIL 4 FACE_LAST
KOUJIL 3 FACE_LAST
KOUJIL 4 FACE_ALTERNATE_LAST

IGA 8 FACE_HALF
IGA 9 FACE_HALF
IGA 1 FACE_HALF
IGA 6 FACE_HALF
IGA 4 FACE_HALF
IGA 1 FACE_HALF
IGA 10 FACE_HALF
IGA 8 FACE_HALF

BRAHUX 7 FACE_LAST
BRAHUX 3 FACE_LAST
BRAHUX 1 FACE_LAST

$moves
MOVE_STACK {BRAHUX, IGA, KOUJIL} BRAHUX
AND
    OR
        DEST Size > 9
        SRCSTACK Rank descending
    OR
        SRC Suit {CLUBS, HEARTS, SPADES}
        DEST Rank 1
$win
PILE ALL JOUPI Empty
