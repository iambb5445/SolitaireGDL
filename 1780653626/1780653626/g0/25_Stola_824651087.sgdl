Stola
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 90 DEAL TEBIN
TEBIN 6 FACE_ALTERNATE_LAST
TEBIN 4 FACE_ALTERNATE_LAST
TEBIN 4 FACE_ALTERNATE_LAST

$moves
MOVE TEBIN TEBIN
DEST Suit {DIAMONDS}
DRAW
PILE ANY TEBIN Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL TEBIN Empty
        PILE ALL DRAW Empty
