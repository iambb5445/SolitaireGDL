Graini
$cards
DECK 4 {SPADES, CLUBS}

$initial
YENOC 0 FACE_HALF
YENOC 3 FACE_HALF
YENOC 5 FACE_HALF
YENOC 5 FACE_HALF
YENOC 4 FACE_LAST
YENOC 8 FACE_LAST

EQU 8 FACE_ALL

EQA 5 FACE_HALF
EQA 6 FACE_ALL

COLUMN 8 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 9 FACE_ALL

AFAT 1 FACE_LAST
AFAT 0 FACE_ALTERNATE_LAST
AFAT 1 FACE_ALTERNATE_LAST

AXE 8 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN AFAT
SRC Suit {DIAMONDS, HEARTS, SPADES, CLUBS}
$win
AND
    PILE ALL AFAT Empty
    AND
        PILE ALL EQA Empty
        PILE ALL COLUMN Empty
