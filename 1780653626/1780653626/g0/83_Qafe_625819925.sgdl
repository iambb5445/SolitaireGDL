Qafe
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 47 DEAL {COLUMN, WUICU}
XUIHAN 10 FACE_LAST
XUIHAN 4 FACE_LAST
XUIHAN 8 FACE_LAST

COLUMN 2 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

WUICU 4 FACE_HALF
WUICU 0 FACE_HALF
WUICU 3 FACE_ALTERNATE_LAST
WUICU 6 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, XUIHAN} XUIHAN
OR
    DEST Empty
    DEST Suit {HEARTS}
MOVE WUICU XUIHAN
AND
    OR
        SRC Suit {DIAMONDS}
        DEST Empty
    OR
        DEST Suit {HEARTS, DIAMONDS, CLUBS}
        DEST Size < 6
MOVE_STACK {XUIHAN, COLUMN} WUICU
OR
    AND
        SRC Suit {DIAMONDS, CLUBS, HEARTS}
        DEST Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
    SRC Suit {SPADES}
MOVE_STACK WUICU {COLUMN, WUICU}
DEST Size >= 6
$win
OR
    PILE ALL COLUMN Empty
    PILE ALL XUIHAN Empty
