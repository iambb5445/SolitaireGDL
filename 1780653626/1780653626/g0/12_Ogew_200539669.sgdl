Ogew
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 44 ROTATE 3 U U
COLUMN 2 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank add_13
        DESTSRC Rank ascending
    AND
        DESTSRC Suit match_color
        SRC Suit {SPADES}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
