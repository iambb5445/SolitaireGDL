Fripe
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 2 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 4 FACE_ALL

JINE 4 FACE_HALF
JINE 7 FACE_HALF
JINE 0 FACE_HALF
JINE 5 FACE_HALF
JINE 5 FACE_ALTERNATE_LAST
JINE 5 FACE_ALTERNATE_LAST

ETI 5 FACE_ALTERNATE_LAST
ETI 8 FACE_ALTERNATE_LAST
ETI 4 FACE_ALTERNATE_LAST
ETI 2 FACE_ALTERNATE_LAST
ETI 7 FACE_ALTERNATE_LAST
ETI 5 FACE_ALTERNATE_LAST
ETI 3 FACE_ALTERNATE_LAST
ETI 1 FACE_ALTERNATE_LAST

ECUIQ 3 FACE_LAST
ECUIQ 5 FACE_LAST
ECUIQ 9 FACE_LAST
ECUIQ 2 FACE_LAST

$moves
MOVE {COLUMN, JINE, ECUIQ} COLUMN
OR
    AND
        SRC Suit {CLUBS, DIAMONDS}
        DEST Size > 9
    AND
        DEST Size <= 2
        DEST Suit {HEARTS, SPADES}
MOVE JINE ETI
DESTSRC Rank add_14
$win
AND
    OR
        PILE ALL JINE Empty
        PILE ALL ETI Empty
    PILE ALL ETI Empty
