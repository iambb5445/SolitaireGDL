Toun
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EBAIN 7 FACE_LAST
EBAIN 5 FACE_LAST
EBAIN 8 FACE_LAST
EBAIN 6 FACE_ALTERNATE_LAST
EBAIN 9 FACE_ALTERNATE_LAST
EBAIN 6 FACE_ALTERNATE_LAST

ILUJ 4 FACE_LAST
ILUJ 0 FACE_LAST
ILUJ 5 FACE_LAST
ILUJ 0 FACE_LAST
ILUJ 2 FACE_LAST
ILUJ 0 FACE_LAST

$moves
MOVE EBAIN {EBAIN, ILUJ}
OR
    AND
        DEST Size > 6
        SRC Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
    DEST Suit {SPADES, HEARTS, DIAMONDS}
MOVE ILUJ ILUJ
DESTSRC Rank add_14
MOVE_STACK EBAIN ILUJ
DESTSRC Rank equal
$win
PILE ALL ILUJ Empty
