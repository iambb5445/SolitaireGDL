Efo
$cards
DECK 4 SPADES

$initial
ASA 0 FACE_LAST
ASA 2 FACE_LAST
ASA 10 FACE_HALF
ASA 3 FACE_HALF
ASA 3 FACE_HALF
ASA 9 FACE_HALF
ASA 3 FACE_HALF
ASA 1 FACE_HALF
ASA 5 FACE_HALF
ASA 2 FACE_HALF

TRAEWOY 8 FACE_ALTERNATE_LAST
TRAEWOY 3 FACE_ALTERNATE_LAST

COLUMN 3 FACE_LAST

$moves
MOVE {COLUMN, ASA, TRAEWOY} ASA
SRC Suit {SPADES, HEARTS}
MOVE_STACK {COLUMN, TRAEWOY} ASA
AND
    DEST Rank 1
    SRCSTACK Rank equal
MOVE_STACK TRAEWOY COLUMN
AND
    AND
        DEST Rank 1
        SRCSTACK Rank equal
    OR
        SRCSTACK Rank add_13
        DEST Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    PILE ALL TRAEWOY Empty
