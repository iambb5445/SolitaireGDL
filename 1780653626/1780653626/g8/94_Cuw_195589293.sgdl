Cuw
$cards
DECK 2 SPADES

$initial
COLUMN 9 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
AND
    SRC Suit {CLUBS, HEARTS, DIAMONDS}
    AND
        SRC Suit {SPADES, HEARTS, DIAMONDS}
        SRC Rank K
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRC Suit {DIAMONDS}
        DEST Rank 1
    DEST Rank K
$win
PILE ALL COLUMN Empty
