Frinuj
$cards
DECK 4 {SPADES, CLUBS}

$initial
AZER 6 FACE_LAST
AZER 6 FACE_LAST
AZER 5 FACE_LAST
AZER 6 FACE_LAST
AZER 5 FACE_LAST
AZER 9 FACE_LAST
AZER 4 FACE_LAST
AZER 6 FACE_LAST
AZER 2 FACE_LAST
AZER 8 FACE_LAST

UQOUL 4 FACE_ALL
UQOUL 8 FACE_ALL
UQOUL 9 FACE_ALL
UQOUL 5 FACE_ALL
UQOUL 3 FACE_ALL
UQOUL 4 FACE_ALL
UQOUL 10 FACE_ALL
UQOUL 4 FACE_ALL

$moves
MOVE {UQOUL, AZER} AZER
OR
    AND
        DEST Rank K
        SRC Suit {HEARTS}
    DESTSRC Rank descending
MOVE UQOUL UQOUL
OR
    AND
        DEST Rank K
        DEST Empty
    DESTSRC Rank ascending
MOVE_STACK AZER AZER
SRC Rank 1
MOVE_STACK UQOUL AZER
DESTSRC Suit match
$win
PILE ALL UQOUL Empty
