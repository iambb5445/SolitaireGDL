Jew
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 84 ROTATE 3 U 2
ECU 0 FACE_ALTERNATE_LAST
ECU 10 FACE_ALTERNATE_LAST
ECU 10 FACE_ALTERNATE_LAST

$moves
MOVE DRAW ECU
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {DRAW, ECU} ECU
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK ECU ECU
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
PILE ALL ECU Empty
