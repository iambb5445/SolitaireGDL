Uqoy
$cards
DECK 2 {SPADES, CLUBS}

$initial
UPU 1 FACE_ALL
UPU 8 FACE_LAST
UPU 8 FACE_LAST

AXA 8 FACE_HALF
AXA 1 FACE_ALL
AXA 9 FACE_ALL
AXA 7 FACE_ALL
AXA 6 FACE_ALL
AXA 4 FACE_ALL

$moves
MOVE UPU UPU
DESTSRC Rank add_13
MOVE AXA UPU
OR
    DEST Suit {CLUBS, DIAMONDS}
    DEST Size == 0
$win
OR
    AND
        PILE ALL AXA Empty
        PILE ALL AXA Empty
    PILE ALL UPU Empty
