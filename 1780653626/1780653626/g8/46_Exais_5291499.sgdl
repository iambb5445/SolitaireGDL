Exais
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 0 ROTATE 3 U 2
RUYIQ 0 FACE_ALL
RUYIQ 1 FACE_ALL
RUYIQ 1 FACE_ALTERNATE_LAST
RUYIQ 9 FACE_ALTERNATE_LAST
RUYIQ 2 FACE_ALTERNATE_LAST
RUYIQ 6 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 4 FACE_ALTERNATE_LAST
RUYIQ 6 FACE_ALTERNATE_LAST
RUYIQ 2 FACE_ALTERNATE_LAST

UZE 0 FACE_HALF
UZE 3 FACE_HALF
UZE 1 FACE_HALF
UZE 0 FACE_ALL
UZE 6 FACE_ALL
UZE 3 FACE_ALL
UZE 3 FACE_ALL
UZE 0 FACE_ALL
UZE 0 FACE_ALL

QEN 0 FACE_ALTERNATE_LAST
QEN 0 FACE_ALTERNATE_LAST

$moves
MOVE UZE UZE
AND
    DESTSRC Rank descending
    DESTSRC Suit match_color
MOVE {RUYIQ, QEN, UZE, DRAW} QEN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {QEN, UZE, RUYIQ} RUYIQ
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {QEN, RUYIQ} QEN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL RUYIQ Empty
        PILE ALL UZE Empty
    AND
        PILE ALL QEN Empty
        PILE ALL DRAW Empty
