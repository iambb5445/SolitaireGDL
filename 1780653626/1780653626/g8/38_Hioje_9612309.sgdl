Hioje
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 7 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 6 FACE_HALF

GRUIJUM 7 FACE_LAST
GRUIJUM 9 FACE_LAST
GRUIJUM 9 FACE_LAST
GRUIJUM 3 FACE_LAST
GRUIJUM 2 FACE_LAST
GRUIJUM 1 FACE_LAST
GRUIJUM 7 FACE_LAST
GRUIJUM 3 FACE_LAST
GRUIJUM 8 FACE_LAST
GRUIJUM 1 FACE_LAST

$moves
MOVE GRUIJUM GRUIJUM
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {GRUIJUM, COLUMN} GRUIJUM
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {COLUMN, GRUIJUM} COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK GRUIJUM GRUIJUM
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL GRUIJUM Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL GRUIJUM Empty
    PILE ALL COLUMN Empty
