Iya
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 44 DEAL {VIOTA, SAINEM}
SAINEM 2 FACE_ALTERNATE_LAST
SAINEM 7 FACE_ALTERNATE_LAST
SAINEM 7 FACE_ALTERNATE_LAST
SAINEM 1 FACE_ALTERNATE_LAST
SAINEM 7 FACE_ALTERNATE_LAST
SAINEM 9 FACE_ALTERNATE_LAST
SAINEM 6 FACE_ALTERNATE_LAST
SAINEM 4 FACE_ALTERNATE_LAST

VIOTA 10 FACE_ALTERNATE_LAST
VIOTA 7 FACE_HALF

$moves
MOVE {VIOTA, SAINEM} SAINEM
AND
    SRC Rank 1
    DEST Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE SAINEM VIOTA
OR
    AND
        DEST Rank K
        SRC Suit {SPADES, CLUBS}
    DEST Size > 0
MOVE_STACK SAINEM SAINEM
OR
    DEST Rank K
    AND
        SRCSTACK Rank equal
        DEST Size > 0
$win
PILE ALL VIOTA Empty
