Jar
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 8 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 1 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    DESTSRC Suit match
    AND
        SRC Suit {HEARTS, DIAMONDS, CLUBS, SPADES}
        SRC Rank K
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
