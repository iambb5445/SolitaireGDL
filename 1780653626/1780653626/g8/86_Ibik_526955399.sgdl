Ibik
$cards
DECK 8 SPADES

$initial
DRAW 8 ROTATE 3 U 3
PRUIQOS 2 FACE_HALF
PRUIQOS 1 FACE_ALTERNATE_LAST
PRUIQOS 0 FACE_ALTERNATE_LAST
PRUIQOS 4 FACE_ALTERNATE_LAST

COLUMN 9 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 6 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 0 FACE_LAST

STAY 3 FACE_LAST
STAY 8 FACE_LAST
STAY 10 FACE_LAST
STAY 5 FACE_LAST
STAY 0 FACE_LAST
STAY 1 FACE_LAST
STAY 5 FACE_LAST

YAEN 1 FACE_ALTERNATE_LAST
YAEN 0 FACE_ALTERNATE_LAST
YAEN 7 FACE_ALTERNATE_LAST
YAEN 8 FACE_ALTERNATE_LAST
YAEN 8 FACE_ALTERNATE_LAST

$moves
MOVE YAEN COLUMN
DESTSRC Suit match
MOVE STAY {YAEN, PRUIQOS}
OR
    AND
        DESTSRC Suit alternate_color
        DEST Size == 7
    DEST Suit {SPADES, CLUBS, HEARTS, DIAMONDS}
$win
PILE ALL YAEN Empty
