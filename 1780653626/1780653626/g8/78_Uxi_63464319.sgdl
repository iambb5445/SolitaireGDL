Uxi
$cards
DECK 1 {SPADES, CLUBS}

$initial
EBA 7 FACE_ALTERNATE_LAST
EBA 6 FACE_ALTERNATE_LAST
EBA 9 FACE_ALTERNATE_LAST
EBA 4 FACE_ALTERNATE_LAST

$moves
MOVE EBA EBA
AND
    SRC Rank 1
    OR
        DEST Rank 1
        DEST Rank 1
MOVE_STACK EBA EBA
OR
    AND
        DESTSRC Suit match
        DEST Size <= 2
    AND
        SRCSTACK Size < 6
        DEST Empty
$win
PILE ALL EBA Empty
