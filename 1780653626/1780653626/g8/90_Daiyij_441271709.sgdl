Daiyij
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 1 2 U
GRAZ 7 FACE_ALTERNATE_LAST
GRAZ 9 FACE_ALTERNATE_LAST
GRAZ 5 FACE_ALTERNATE_LAST
GRAZ 4 FACE_ALTERNATE_LAST

$moves
MOVE {GRAZ, DRAW} GRAZ
AND
    AND
        SRC Suit {HEARTS}
        SRC Suit {HEARTS, DIAMONDS}
    OR
        SRC Suit {DIAMONDS, CLUBS}
        DEST Suit {SPADES, CLUBS}
$win
PILE ALL DRAW Empty
