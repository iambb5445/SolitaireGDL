Pruiv
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 5 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 0 FACE_ALL

POUL 4 FACE_ALL
POUL 3 FACE_ALL
POUL 9 FACE_ALL
POUL 6 FACE_ALL
POUL 8 FACE_ALL
POUL 6 FACE_ALL
POUL 7 FACE_ALL
POUL 8 FACE_ALL
POUL 6 FACE_ALL

GRUIPA 7 FACE_ALTERNATE_LAST
GRUIPA 6 FACE_ALTERNATE_LAST
GRUIPA 8 FACE_ALTERNATE_LAST
GRUIPA 10 FACE_ALTERNATE_LAST
GRUIPA 9 FACE_HALF
GRUIPA 1 FACE_HALF

$moves
MOVE COLUMN {GRUIPA, POUL}
DESTSRC Suit match_color
MOVE_STACK {COLUMN, GRUIPA, POUL} GRUIPA
AND
    AND
        DEST Rank 1
        DESTSRC Suit match
    DEST Rank K
$win
OR
    PILE ALL GRUIPA Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL GRUIPA Empty
