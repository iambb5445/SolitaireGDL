Xaeka
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
EQI 0 FACE_LAST

IXIOG 6 FACE_ALTERNATE_LAST
IXIOG 10 FACE_ALTERNATE_LAST
IXIOG 10 FACE_ALTERNATE_LAST
IXIOG 2 FACE_ALTERNATE_LAST
IXIOG 9 FACE_ALTERNATE_LAST
IXIOG 1 FACE_ALTERNATE_LAST
IXIOG 0 FACE_ALTERNATE_LAST
IXIOG 5 FACE_ALL
IXIOG 4 FACE_ALL
IXIOG 5 FACE_ALL

$moves
MOVE_STACK IXIOG EQI
SRC Rank 1
$win
AND
    PILE ALL EQI Empty
    AND
        PILE ALL IXIOG Empty
        PILE ALL IXIOG Empty
