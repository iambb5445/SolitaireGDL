Ubu
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 1 ROTATE 3 U 2
FROUL 1 FACE_ALL
FROUL 1 FACE_ALL
FROUL 2 FACE_ALL
FROUL 9 FACE_ALL
FROUL 7 FACE_ALL
FROUL 0 FACE_ALL
FROUL 8 FACE_ALL
FROUL 7 FACE_ALL
FROUL 1 FACE_ALL
FROUL 3 FACE_HALF

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 8 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 2 FACE_LAST

COURI 4 FACE_ALL
COURI 7 FACE_ALL
COURI 3 FACE_ALL
COURI 8 FACE_ALL
COURI 3 FACE_ALL
COURI 6 FACE_HALF

$moves
MOVE FROUL FROUL
OR
    AND
        DEST Suit {SPADES, CLUBS}
        DEST Size > 10
    DEST Rank K
MOVE {COURI, FROUL, COLUMN, DRAW} COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {FROUL, COURI, COLUMN} COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {FROUL, COURI} COURI
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COURI Empty
    AND
        PILE ALL FROUL Empty
        PILE ALL DRAW Empty
