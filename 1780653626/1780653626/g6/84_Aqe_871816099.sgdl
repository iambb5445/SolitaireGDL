Aqe
$cards
DECK 2 {SPADES, CLUBS}

$initial
DAIFU 8 FACE_ALTERNATE_LAST
DAIFU 8 FACE_ALTERNATE_LAST
DAIFU 1 FACE_ALTERNATE_LAST
DAIFU 1 FACE_ALTERNATE_LAST
DAIFU 4 FACE_ALTERNATE_LAST
DAIFU 8 FACE_ALTERNATE_LAST
DAIFU 6 FACE_ALTERNATE_LAST
DAIFU 6 FACE_ALTERNATE_LAST

COLUMN 7 FACE_LAST
COLUMN 3 FACE_LAST

$moves
MOVE_STACK {COLUMN, DAIFU} DAIFU
AND
    OR
        DEST Empty
        DESTSRC Rank descending
    AND
        DEST Size >= 4
        SRCSTACK Rank equal
MOVE_STACK COLUMN COLUMN
OR
    SRC Rank K
    AND
        SRC Rank K
        SRC Suit {HEARTS, DIAMONDS, SPADES}
$win
PILE ALL DAIFU Empty
