Uhu
$cards
DECK 8 SPADES

$initial
DUIP 7 FACE_LAST
DUIP 10 FACE_LAST
DUIP 5 FACE_LAST
DUIP 0 FACE_ALTERNATE_LAST
DUIP 7 FACE_ALTERNATE_LAST
DUIP 4 FACE_ALTERNATE_LAST

BREAJUV 6 FACE_LAST
BREAJUV 6 FACE_LAST
BREAJUV 6 FACE_LAST
BREAJUV 7 FACE_LAST
BREAJUV 8 FACE_LAST
BREAJUV 3 FACE_LAST
BREAJUV 3 FACE_LAST
BREAJUV 1 FACE_LAST

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

$moves
MOVE DUIP COLUMN
OR
    DESTSRC Suit match
    AND
        SRC Rank 1
        DEST Empty
MOVE COLUMN BREAJUV
AND
    AND
        DESTSRC Suit match_color
        DESTSRC Suit match_color
    OR
        SRC Suit {SPADES, DIAMONDS, HEARTS}
        DESTSRC Suit match
MOVE_STACK BREAJUV DUIP
DEST Size == 4
$win
PILE ALL COLUMN Empty
