Froufev
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 15 ROTATE 3 U 1
COLUMN 1 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST

$moves
MOVE {COLUMN, DRAW} COLUMN
AND
    OR
        SRC Rank K
        DEST Rank 1
    DEST Suit {CLUBS, SPADES, DIAMONDS, HEARTS}
MOVE_STACK COLUMN COLUMN
DEST Suit {DIAMONDS, CLUBS, SPADES, HEARTS}
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
