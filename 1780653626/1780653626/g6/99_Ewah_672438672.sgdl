Ewah
$cards
DECK 8 SPADES

$initial
DRAW 52 ROTATE 1 U 2
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST

$moves
MOVE_STACK COLUMN COLUMN
AND
    OR
        SRCSTACK Size > 1
        DEST Suit {CLUBS, HEARTS, SPADES}
    OR
        SRCSTACK Size == 2
        DEST Size <= 9
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
