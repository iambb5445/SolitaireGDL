Eta
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 23 ROTATE 1 2 U
AQO 0 FACE_ALTERNATE_LAST
AQO 0 FACE_ALTERNATE_LAST
AQO 6 FACE_HALF

TUIDUP 8 FACE_LAST
TUIDUP 9 FACE_LAST
TUIDUP 1 FACE_LAST
TUIDUP 3 FACE_LAST

HUM 1 FACE_ALTERNATE_LAST
HUM 1 FACE_HALF

$moves
MOVE TUIDUP {AQO, HUM}
DESTSRC Suit alternate_color
MOVE_STACK AQO {TUIDUP, HUM, AQO}
OR
    AND
        SRCSTACK Rank ascending
        DEST Rank 1
    AND
        DEST Rank K
        DESTSRC Rank add_13
MOVE_STACK HUM HUM
DESTSRC Rank ascending
$win
PILE ALL HUM Empty
