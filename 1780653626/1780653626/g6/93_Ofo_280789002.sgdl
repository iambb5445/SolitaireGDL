Ofo
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 7 FACE_ALL

GAIBIB 2 FACE_ALL
GAIBIB 6 FACE_ALL
GAIBIB 6 FACE_ALL
GAIBIB 4 FACE_ALL
GAIBIB 3 FACE_ALL

RUIS 7 FACE_HALF
RUIS 8 FACE_HALF
RUIS 2 FACE_HALF
RUIS 10 FACE_HALF
RUIS 3 FACE_HALF
RUIS 2 FACE_HALF
RUIS 2 FACE_HALF
RUIS 3 FACE_HALF

NUXOV 5 FACE_ALL
NUXOV 3 FACE_LAST
NUXOV 1 FACE_LAST
NUXOV 0 FACE_LAST
NUXOV 8 FACE_LAST
NUXOV 1 FACE_LAST
NUXOV 4 FACE_LAST
NUXOV 8 FACE_LAST
NUXOV 8 FACE_LAST
NUXOV 1 FACE_LAST

$moves
MOVE {NUXOV, COLUMN, RUIS, GAIBIB} COLUMN
DEST Size <= 9
MOVE NUXOV GAIBIB
DEST Suit {CLUBS}
$win
OR
    PILE ALL GAIBIB Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL NUXOV Empty
