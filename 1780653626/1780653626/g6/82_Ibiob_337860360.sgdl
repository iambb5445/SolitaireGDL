Ibiob
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 80 ROTATE 1 U 3
FOUH 1 FACE_HALF
FOUH 8 FACE_HALF
FOUH 1 FACE_HALF
FOUH 0 FACE_HALF

OBEAQ 5 FACE_ALTERNATE_LAST
OBEAQ 3 FACE_ALTERNATE_LAST
OBEAQ 3 FACE_ALL
OBEAQ 3 FACE_ALL

$moves
MOVE {DRAW, OBEAQ, FOUH} OBEAQ
AND
    OR
        SRC Rank K
        SRC Rank 1
    OR
        DESTSRC Rank descending
        DEST Empty
MOVE_STACK FOUH FOUH
OR
    SRCSTACK Rank add_13
    SRCSTACK Suit match_color
MOVE_STACK {OBEAQ, FOUH} OBEAQ
OR
    SRC Suit {DIAMONDS, CLUBS, SPADES}
    AND
        SRC Rank K
        SRC Rank 1
$win
