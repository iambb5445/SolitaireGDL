Juin
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 52 ROTATE 3 U 2
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

GOUMI 8 FACE_ALTERNATE_LAST
GOUMI 1 FACE_ALL
GOUMI 1 FACE_ALL
GOUMI 4 FACE_ALL
GOUMI 4 FACE_ALL
GOUMI 3 FACE_ALL
GOUMI 0 FACE_ALL

$moves
MOVE DRAW COLUMN
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {COLUMN, GOUMI, DRAW} GOUMI
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {COLUMN, GOUMI} GOUMI
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL GOUMI Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
