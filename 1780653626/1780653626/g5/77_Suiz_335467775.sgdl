Suiz
$cards
DECK 1 SPADES

$initial
COLUMN 7 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 3 FACE_LAST

$moves
MOVE COLUMN COLUMN
AND
    SRC Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
    DEST Empty
MOVE_STACK COLUMN COLUMN
DESTSRC Suit match_color
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
