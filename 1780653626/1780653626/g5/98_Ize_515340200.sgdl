Ize
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 18 DEAL COLUMN
COLUMN 7 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 0 FACE_LAST

FRUIT 10 FACE_ALTERNATE_LAST
FRUIT 2 FACE_ALTERNATE_LAST
FRUIT 2 FACE_ALTERNATE_LAST
FRUIT 7 FACE_ALTERNATE_LAST

OXI 10 FACE_ALTERNATE_LAST
OXI 10 FACE_ALTERNATE_LAST
OXI 2 FACE_ALTERNATE_LAST
OXI 0 FACE_ALTERNATE_LAST
OXI 9 FACE_LAST
OXI 8 FACE_LAST
OXI 10 FACE_LAST
OXI 1 FACE_LAST

$moves
MOVE {COLUMN, FRUIT} OXI
DESTSRC Suit match
MOVE_STACK COLUMN {FRUIT, OXI, COLUMN}
AND
    DEST Size >= 4
    AND
        DEST Suit {DIAMONDS, CLUBS, HEARTS}
        SRC Rank 1
$win
PILE ALL OXI Empty
