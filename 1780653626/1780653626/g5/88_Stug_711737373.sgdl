Stug
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 2 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 7 FACE_LAST

UQER 6 FACE_HALF
UQER 2 FACE_HALF
UQER 0 FACE_HALF
UQER 4 FACE_HALF
UQER 1 FACE_HALF
UQER 2 FACE_HALF
UQER 7 FACE_HALF
UQER 9 FACE_HALF
UQER 6 FACE_HALF
UQER 3 FACE_HALF

FOJOQ 4 FACE_ALTERNATE_LAST
FOJOQ 0 FACE_ALTERNATE_LAST
FOJOQ 10 FACE_ALTERNATE_LAST
FOJOQ 7 FACE_ALTERNATE_LAST
FOJOQ 6 FACE_ALTERNATE_LAST
FOJOQ 1 FACE_ALTERNATE_LAST
FOJOQ 1 FACE_ALTERNATE_LAST

$moves
MOVE {UQER, FOJOQ} UQER
DESTSRC Suit alternate_color
$win
OR
    AND
        PILE ALL UQER Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL UQER Empty
        PILE ALL FOJOQ Empty
