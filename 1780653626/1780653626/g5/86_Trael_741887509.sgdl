Trael
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 64 ROTATE 3 U 1
UNA 4 FACE_ALL
UNA 7 FACE_ALL
UNA 3 FACE_ALTERNATE_LAST
UNA 3 FACE_ALTERNATE_LAST

COLUMN 3 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 7 FACE_LAST

$moves
MOVE_STACK {UNA, COLUMN} COLUMN
AND
    OR
        SRC Suit {SPADES}
        DEST Size < 2
    OR
        SRC Rank K
        SRCSTACK Rank ascending
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
