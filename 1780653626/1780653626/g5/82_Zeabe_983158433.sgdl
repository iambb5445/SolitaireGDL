Zeabe
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 54 ROTATE 1 U 2
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 5 FACE_ALL
COLUMN 0 FACE_ALL

OYEB 3 FACE_ALL
OYEB 3 FACE_LAST

$moves
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRC Suit {HEARTS, CLUBS, SPADES}
        DEST Size == 9
    AND
        DEST Size <= 4
        DEST Size <= 7
MOVE_STACK OYEB {COLUMN, OYEB}
OR
    AND
        DEST Empty
        DEST Rank K
    AND
        DESTSRC Suit alternate_color
        SRCSTACK Suit match
$win
PILE ALL DRAW Empty
