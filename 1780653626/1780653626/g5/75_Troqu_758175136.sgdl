Troqu
$cards
DECK 4 SPADES

$initial
DRAW 2 DEAL UJA
UJA 4 FACE_LAST
UJA 9 FACE_LAST
UJA 2 FACE_LAST
UJA 6 FACE_ALTERNATE_LAST
UJA 10 FACE_ALTERNATE_LAST
UJA 6 FACE_ALTERNATE_LAST
UJA 9 FACE_ALTERNATE_LAST
UJA 4 FACE_ALTERNATE_LAST

$moves
MOVE_STACK UJA UJA
AND
    OR
        DEST Size == 0
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
    OR
        DEST Suit {DIAMONDS, SPADES, HEARTS}
        DEST Empty
$win
PILE ALL UJA Empty
