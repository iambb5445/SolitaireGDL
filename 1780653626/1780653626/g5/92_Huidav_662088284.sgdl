Huidav
$cards
DECK 2 SPADES

$initial
DRAW 9 DEAL UNOUC
UNOUC 3 FACE_ALL
UNOUC 3 FACE_ALL
UNOUC 0 FACE_ALL
UNOUC 8 FACE_ALL
UNOUC 3 FACE_ALTERNATE_LAST

$moves
MOVE UNOUC UNOUC
OR
    SRC Suit {DIAMONDS, CLUBS}
    DESTSRC Suit match
MOVE_STACK UNOUC UNOUC
OR
    DEST Size >= 4
    AND
        SRCSTACK Size == 2
        DESTSRC Rank add_13
DRAW
PILE ALL UNOUC Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL UNOUC Empty
        PILE ALL DRAW Empty
