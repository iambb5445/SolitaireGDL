Braigo
$cards
DECK 8 SPADES

$initial
TRORU 2 FACE_ALTERNATE_LAST
TRORU 5 FACE_ALTERNATE_LAST
TRORU 7 FACE_ALTERNATE_LAST
TRORU 2 FACE_ALTERNATE_LAST
TRORU 7 FACE_ALTERNATE_LAST
TRORU 1 FACE_ALTERNATE_LAST
TRORU 8 FACE_ALTERNATE_LAST
TRORU 7 FACE_ALTERNATE_LAST
TRORU 7 FACE_ALTERNATE_LAST

JIOYIF 10 FACE_ALL
JIOYIF 7 FACE_ALL
JIOYIF 7 FACE_LAST
JIOYIF 4 FACE_LAST
JIOYIF 3 FACE_LAST
JIOYIF 7 FACE_LAST
JIOYIF 4 FACE_LAST

OCE 1 FACE_ALTERNATE_LAST
OCE 9 FACE_ALTERNATE_LAST
OCE 4 FACE_ALTERNATE_LAST
OCE 2 FACE_ALL

$moves
MOVE TRORU JIOYIF
OR
    AND
        DEST Rank 1
        DESTSRC Rank ascending
    SRC Suit {SPADES, CLUBS, HEARTS, DIAMONDS}
MOVE_STACK OCE JIOYIF
OR
    AND
        DEST Empty
        DESTSRC Rank add_14
    SRCSTACK Rank add_13
MOVE_STACK JIOYIF TRORU
AND
    AND
        SRCSTACK Suit match_color
        SRCSTACK Size < 10
    DEST Rank 1
$win
OR
    PILE ALL TRORU Empty
    AND
        PILE ALL TRORU Empty
        PILE ALL JIOYIF Empty
