Luv
$cards
DECK 2 {SPADES, HEARTS}

$initial
FOUQU 5 FACE_LAST
FOUQU 2 FACE_HALF

AWE 2 FACE_LAST
AWE 3 FACE_LAST
AWE 6 FACE_LAST
AWE 9 FACE_LAST
AWE 5 FACE_LAST
AWE 8 FACE_ALTERNATE_LAST
AWE 10 FACE_ALTERNATE_LAST
AWE 1 FACE_ALTERNATE_LAST
AWE 1 FACE_ALTERNATE_LAST

$moves
MOVE AWE {FOUQU, AWE}
OR
    AND
        DEST Size >= 3
        SRC Rank K
    DEST Rank K
MOVE_STACK FOUQU FOUQU
DEST Empty
MOVE_STACK AWE FOUQU
OR
    SRCSTACK Size == 9
    SRCSTACK Rank equal
$win
OR
    AND
        PILE ALL FOUQU Empty
        PILE ALL AWE Empty
    PILE ALL AWE Empty
