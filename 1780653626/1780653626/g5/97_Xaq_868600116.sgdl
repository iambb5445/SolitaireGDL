Xaq
$cards
DECK 8 SPADES

$initial
DRAW 32 DEAL {COLUMN, ZUN}
COLUMN 7 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 2 FACE_HALF

UYU 6 FACE_ALTERNATE_LAST
UYU 6 FACE_LAST

ZUN 7 FACE_LAST
ZUN 2 FACE_LAST
ZUN 10 FACE_LAST
ZUN 4 FACE_LAST
ZUN 6 FACE_LAST
ZUN 1 FACE_HALF

$moves
MOVE COLUMN COLUMN
DEST Size <= 10
DRAW
PILE ALL ZUN Size > 0
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
