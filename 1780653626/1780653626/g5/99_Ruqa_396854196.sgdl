Ruqa
$cards
DECK 4 SPADES

$initial
GRAQUR 3 FACE_ALTERNATE_LAST
GRAQUR 3 FACE_ALTERNATE_LAST
GRAQUR 2 FACE_ALTERNATE_LAST
GRAQUR 4 FACE_ALL
GRAQUR 4 FACE_ALL
GRAQUR 2 FACE_ALL
GRAQUR 5 FACE_ALL
GRAQUR 0 FACE_ALL
GRAQUR 5 FACE_ALL

COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST

EVU 1 FACE_ALTERNATE_LAST

$moves
MOVE_STACK {COLUMN, EVU, GRAQUR} EVU
AND
    AND
        DEST Rank 1
        DEST Size < 8
    SRCSTACK Suit match_color
MOVE_STACK GRAQUR {COLUMN, GRAQUR}
AND
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank add_13
    OR
        DEST Size < 5
        SRCSTACK Rank descending
$win
OR
    PILE ALL EVU Empty
    PILE ALL GRAQUR Empty
