Foufo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
IBAIJ 6 FACE_ALTERNATE_LAST
IBAIJ 9 FACE_HALF
IBAIJ 7 FACE_HALF

COLUMN 3 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 1 FACE_LAST

IJOQ 8 FACE_ALTERNATE_LAST
IJOQ 5 FACE_ALTERNATE_LAST
IJOQ 7 FACE_ALTERNATE_LAST
IJOQ 5 FACE_ALTERNATE_LAST
IJOQ 10 FACE_ALTERNATE_LAST
IJOQ 4 FACE_ALTERNATE_LAST
IJOQ 6 FACE_ALTERNATE_LAST

$moves
MOVE_STACK IBAIJ IBAIJ
OR
    SRCSTACK Suit alternate_color
    AND
        SRC Suit {DIAMONDS, SPADES}
        SRC Rank 1
MOVE_STACK {IJOQ, COLUMN} IBAIJ
OR
    SRCSTACK Suit match_color
    SRCSTACK Size < 10
$win
OR
    PILE ALL IBAIJ Empty
    PILE ALL IJOQ Empty
