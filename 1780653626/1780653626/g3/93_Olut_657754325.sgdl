Olut
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
ECEK 9 FACE_ALTERNATE_LAST
ECEK 9 FACE_ALTERNATE_LAST
ECEK 7 FACE_ALTERNATE_LAST
ECEK 1 FACE_ALTERNATE_LAST
ECEK 5 FACE_ALTERNATE_LAST
ECEK 4 FACE_ALTERNATE_LAST
ECEK 6 FACE_ALTERNATE_LAST

SIOX 4 FACE_ALL
SIOX 1 FACE_ALL
SIOX 6 FACE_HALF

$moves
MOVE SIOX ECEK
OR
    AND
        DEST Rank 1
        SRC Suit {SPADES, DIAMONDS}
    DEST Suit {HEARTS, CLUBS, DIAMONDS}
$win
AND
    OR
        PILE ALL SIOX Empty
        PILE ALL SIOX Empty
    OR
        PILE ALL SIOX Empty
        PILE ALL ECEK Empty
