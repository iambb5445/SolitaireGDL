Brouka
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 47 DEAL COLUMN
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 7 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 9 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 4 FACE_LAST

OBO 8 FACE_ALTERNATE_LAST

$moves
MOVE OBO {OBO, COLUMN}
DESTSRC Rank ascending
MOVE COLUMN OBO
AND
    OR
        DESTSRC Rank ascending
        DEST Rank 1
    AND
        DEST Size >= 2
        DEST Suit {SPADES, HEARTS, CLUBS, DIAMONDS}
MOVE_STACK {COLUMN, OBO} OBO
SRCSTACK Rank add_13
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Rank add_13
        SRCSTACK Size == 3
    DESTSRC Rank equal
DRAW
PILE ALL COLUMN Size > 0
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
