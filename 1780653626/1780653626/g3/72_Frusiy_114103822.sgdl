Frusiy
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

GIJEX 4 FACE_LAST

UKE 8 FACE_HALF
UKE 3 FACE_HALF
UKE 1 FACE_HALF
UKE 10 FACE_HALF
UKE 10 FACE_HALF
UKE 9 FACE_HALF

$moves
MOVE COLUMN GIJEX
AND
    AND
        SRC Rank K
        DEST Size <= 7
    OR
        SRC Suit {DIAMONDS, CLUBS, HEARTS, SPADES}
        SRC Rank K
MOVE GIJEX GIJEX
OR
    AND
        DEST Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
        DESTSRC Rank equal
    DEST Size <= 1
MOVE_STACK UKE GIJEX
OR
    AND
        DESTSRC Rank equal
        SRC Suit {SPADES}
    SRCSTACK Rank add_13
MOVE_STACK COLUMN COLUMN
AND
    AND
        SRCSTACK Suit match_color
        SRCSTACK Suit match_color
    SRCSTACK Size >= 9
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL GIJEX Empty
