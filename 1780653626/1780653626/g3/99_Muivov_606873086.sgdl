Muivov
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 65 DEAL {CELO, ACI}
CELO 6 FACE_LAST
CELO 3 FACE_LAST

ACI 1 FACE_ALTERNATE_LAST
ACI 3 FACE_ALTERNATE_LAST
ACI 8 FACE_ALTERNATE_LAST
ACI 4 FACE_ALTERNATE_LAST
ACI 6 FACE_ALTERNATE_LAST
ACI 4 FACE_ALTERNATE_LAST
ACI 4 FACE_ALTERNATE_LAST

$moves
MOVE_STACK ACI ACI
OR
    AND
        SRCSTACK Size == 0
        SRCSTACK Suit alternate_color
    AND
        SRCSTACK Rank add_14
        DESTSRC Rank descending
$win
AND
    PILE ALL CELO Empty
    PILE ALL CELO Empty
