Ojab
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AGOUH 9 FACE_ALTERNATE_LAST

COLUMN 8 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 3 FACE_HALF

$moves
MOVE {COLUMN, AGOUH} COLUMN
OR
    AND
        DEST Suit {HEARTS, CLUBS}
        DEST Empty
    AND
        DEST Suit {DIAMONDS, CLUBS, HEARTS}
        DEST Empty
MOVE_STACK COLUMN COLUMN
AND
    DESTSRC Rank add_13
    OR
        SRC Suit {DIAMONDS, HEARTS, CLUBS, SPADES}
        SRCSTACK Size <= 2
$win
AND
    PILE ALL AGOUH Empty
    PILE ALL COLUMN Empty
