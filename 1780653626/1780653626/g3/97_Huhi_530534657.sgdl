Huhi
$cards
DECK 1 {SPADES, HEARTS}

$initial
COLUMN 3 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 2 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    SRC Rank 1
    DEST Empty
MOVE_STACK COLUMN COLUMN
AND
    DESTSRC Suit match
    AND
        DESTSRC Suit match_color
        SRCSTACK Suit alternate_color
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
