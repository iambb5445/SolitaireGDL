Drob
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 55 ROTATE 3 U 2
BOTUX 10 FACE_HALF
BOTUX 1 FACE_HALF
BOTUX 5 FACE_HALF
BOTUX 3 FACE_HALF
BOTUX 1 FACE_HALF
BOTUX 4 FACE_HALF
BOTUX 7 FACE_HALF

PAEQI 9 FACE_ALL
PAEQI 7 FACE_HALF
PAEQI 2 FACE_HALF

$moves
MOVE {PAEQI, BOTUX, DRAW} PAEQI
OR
    DEST Empty
    AND
        DESTSRC Rank descending
        SRC Rank K
MOVE_STACK {BOTUX, PAEQI} BOTUX
OR
    AND
        SRC Suit {DIAMONDS, SPADES}
        DESTSRC Rank ascending
    AND
        SRCSTACK Suit match
        DESTSRC Suit match
$win
OR
    AND
        PILE ALL BOTUX Empty
        PILE ALL PAEQI Empty
    PILE ALL DRAW Empty
