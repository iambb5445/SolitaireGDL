Frap
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 9 DEAL ILID
ILID 0 FACE_ALTERNATE_LAST
ILID 7 FACE_ALTERNATE_LAST
ILID 0 FACE_ALTERNATE_LAST
ILID 8 FACE_ALTERNATE_LAST
ILID 2 FACE_ALTERNATE_LAST
ILID 9 FACE_ALTERNATE_LAST
ILID 8 FACE_ALTERNATE_LAST
ILID 9 FACE_ALTERNATE_LAST

$moves
MOVE ILID ILID
AND
    DEST Empty
    OR
        DEST Empty
        DEST Empty
MOVE_STACK ILID ILID
AND
    OR
        SRCSTACK Size == 1
        DESTSRC Suit alternate_color
    OR
        DEST Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
        SRC Suit {HEARTS, CLUBS}
$win
PILE ALL DRAW Empty
