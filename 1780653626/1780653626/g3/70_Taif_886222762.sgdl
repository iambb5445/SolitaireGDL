Taif
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 67 DEAL COLUMN
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 7 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALL

$moves
MOVE_STACK COLUMN COLUMN
OR
    SRC Suit {DIAMONDS}
    DESTSRC Suit match
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
