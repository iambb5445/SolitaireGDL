Fifo
$cards
DECK 2 {SPADES, HEARTS}

$initial
VAEZ 6 FACE_ALTERNATE_LAST
VAEZ 0 FACE_ALTERNATE_LAST
VAEZ 7 FACE_ALTERNATE_LAST
VAEZ 1 FACE_ALTERNATE_LAST
VAEZ 1 FACE_ALTERNATE_LAST

TIBO 6 FACE_HALF

GRIOVUV 10 FACE_ALTERNATE_LAST
