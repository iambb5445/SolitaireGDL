Ucop
$cards
DECK 4 SPADES

$initial
COLUMN 10 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST

ILEAB 5 FACE_LAST
ILEAB 3 FACE_LAST

$moves
MOVE_STACK ILEAB {COLUMN, ILEAB}
SRCSTACK Rank add_14
MOVE_STACK COLUMN ILEAB
AND
    DEST Size >= 1
    SRCSTACK Rank ascending
$win
PILE ALL ILEAB Empty
