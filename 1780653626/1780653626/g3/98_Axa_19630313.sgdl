Axa
$cards
DECK 2 {SPADES, HEARTS}

$initial
OBO 1 FACE_ALTERNATE_LAST
OBO 8 FACE_ALTERNATE_LAST
OBO 9 FACE_ALTERNATE_LAST
OBO 3 FACE_ALTERNATE_LAST
OBO 8 FACE_ALTERNATE_LAST
OBO 2 FACE_ALTERNATE_LAST
OBO 8 FACE_ALTERNATE_LAST

ATE 9 FACE_HALF
ATE 4 FACE_LAST

$moves
MOVE OBO OBO
OR
    AND
        DESTSRC Rank add_14
        DESTSRC Suit match_color
    DESTSRC Suit match_color
MOVE ATE {OBO, ATE}
SRC Rank K
MOVE_STACK OBO OBO
OR
    AND
        DEST Empty
        SRCSTACK Size > 9
    DEST Size < 4
$win
PILE ALL ATE Empty
