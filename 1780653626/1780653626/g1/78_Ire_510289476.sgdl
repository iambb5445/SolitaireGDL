Ire
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
HIOZUB 5 FACE_LAST
HIOZUB 2 FACE_LAST
HIOZUB 8 FACE_LAST

DROUWO 4 FACE_LAST
DROUWO 1 FACE_LAST
DROUWO 2 FACE_LAST
DROUWO 6 FACE_LAST
DROUWO 3 FACE_LAST

PROGUF 5 FACE_HALF
PROGUF 2 FACE_HALF
PROGUF 4 FACE_HALF
PROGUF 9 FACE_HALF
PROGUF 1 FACE_HALF

$moves
MOVE {PROGUF, DROUWO, HIOZUB} HIOZUB
OR
    SRC Suit {SPADES, HEARTS, CLUBS}
    DESTSRC Rank descending
MOVE_STACK DROUWO {PROGUF, DROUWO, HIOZUB}
OR
    AND
        DEST Rank 1
        SRCSTACK Rank ascending
    AND
        DEST Suit {DIAMONDS}
        DESTSRC Rank add_13
MOVE_STACK HIOZUB {HIOZUB, PROGUF}
OR
    SRCSTACK Size <= 7
    DEST Rank K
$win
OR
    PILE ALL HIOZUB Empty
    AND
        PILE ALL HIOZUB Empty
        PILE ALL DROUWO Empty
