Qifiq
$cards
DECK 1 {SPADES, CLUBS}

$initial
ONEX 5 FACE_HALF
ONEX 1 FACE_HALF
ONEX 9 FACE_HALF
ONEX 10 FACE_HALF
ONEX 1 FACE_ALTERNATE_LAST

$moves
MOVE ONEX ONEX
OR
    AND
        DEST Empty
        DEST Size <= 5
    DESTSRC Suit match_color
MOVE_STACK ONEX ONEX
OR
    AND
        SRCSTACK Suit match
        SRCSTACK Size <= 9
    AND
        DESTSRC Rank descending
        DEST Rank K
$win
OR
    PILE ALL ONEX Empty
    PILE ALL ONEX Empty
