Guir
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 87 ROTATE 3 U 2
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
SRC Suit {DIAMONDS, SPADES, CLUBS}
MOVE DRAW COLUMN
DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRC Rank K
        DEST Size > 7
    AND
        DESTSRC Rank add_14
        SRCSTACK Size >= 2
$win
OR
    PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
