Maedo
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 50 ROTATE 3 U 2
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 9 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 10 FACE_LAST

$moves
MOVE DRAW COLUMN
OR
    AND
        DEST Size >= 0
        SRC Rank K
    DESTSRC Suit alternate_color
MOVE {DRAW, COLUMN} COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK COLUMN COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
