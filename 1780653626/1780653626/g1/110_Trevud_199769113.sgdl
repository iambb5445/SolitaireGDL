Trevud
$cards
DECK 2 SPADES

$initial
JOHI 2 FACE_ALTERNATE_LAST
JOHI 7 FACE_ALTERNATE_LAST
JOHI 8 FACE_ALTERNATE_LAST
JOHI 1 FACE_ALTERNATE_LAST
JOHI 0 FACE_ALTERNATE_LAST

GIJ 0 FACE_HALF
GIJ 0 FACE_HALF
GIJ 7 FACE_ALL
GIJ 0 FACE_ALL
GIJ 1 FACE_ALL

$moves
MOVE JOHI JOHI
DEST Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE JOHI GIJ
OR
    SRC Rank 1
    AND
        DEST Empty
        DESTSRC Suit match_color
MOVE_STACK {GIJ, JOHI} JOHI
SRC Rank K
MOVE_STACK GIJ GIJ
OR
    AND
        DEST Rank K
        DEST Rank 1
    AND
        SRC Rank 1
        DEST Rank 1
$win
PILE ALL JOHI Empty
