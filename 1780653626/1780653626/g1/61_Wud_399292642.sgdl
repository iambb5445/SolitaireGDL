Wud
$cards
DECK 1 {SPADES, CLUBS}

$initial
COLUMN 4 FACE_LAST
COLUMN 2 FACE_LAST

CUNAQ 6 FACE_ALTERNATE_LAST
CUNAQ 5 FACE_ALTERNATE_LAST
CUNAQ 9 FACE_LAST

$moves
MOVE {CUNAQ, COLUMN} COLUMN
AND
    OR
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        SRC Rank K
    OR
        DESTSRC Suit alternate_color
        SRC Suit {CLUBS, SPADES, HEARTS, DIAMONDS}
MOVE_STACK COLUMN {COLUMN, CUNAQ}
OR
    AND
        SRC Suit {HEARTS, DIAMONDS, SPADES, CLUBS}
        DEST Suit {DIAMONDS, HEARTS, SPADES}
    DEST Rank K
MOVE_STACK CUNAQ COLUMN
SRCSTACK Size > 2
$win
OR
    PILE ALL CUNAQ Empty
    PILE ALL COLUMN Empty
