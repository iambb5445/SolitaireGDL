Unaiw
$cards
DECK 4 {SPADES, CLUBS}

$initial
LAESEB 0 FACE_ALTERNATE_LAST
LAESEB 6 FACE_LAST
LAESEB 0 FACE_LAST
LAESEB 5 FACE_LAST
LAESEB 9 FACE_LAST
LAESEB 5 FACE_LAST
LAESEB 2 FACE_LAST
LAESEB 4 FACE_LAST
LAESEB 2 FACE_LAST

COLUMN 9 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 9 FACE_ALL

IDA 10 FACE_HALF
IDA 3 FACE_HALF
IDA 8 FACE_HALF
IDA 0 FACE_LAST
IDA 0 FACE_LAST
IDA 0 FACE_LAST
IDA 8 FACE_LAST
IDA 5 FACE_LAST
IDA 5 FACE_LAST

$moves
MOVE LAESEB IDA
SRC Suit {HEARTS, SPADES, CLUBS}
MOVE LAESEB COLUMN
DEST Empty
$win
OR
    AND
        PILE ALL LAESEB Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
