Utouc
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 4 FACE_LAST
COLUMN 5 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 0 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 1 FACE_LAST

WOGI 4 FACE_ALL
WOGI 2 FACE_ALL
WOGI 3 FACE_ALL

UTUN 3 FACE_ALL

DROUKI 3 FACE_ALTERNATE_LAST
DROUKI 3 FACE_ALTERNATE_LAST
DROUKI 3 FACE_ALTERNATE_LAST
DROUKI 5 FACE_ALTERNATE_LAST
DROUKI 7 FACE_ALTERNATE_LAST
DROUKI 9 FACE_ALTERNATE_LAST
DROUKI 3 FACE_ALTERNATE_LAST
DROUKI 3 FACE_LAST
DROUKI 5 FACE_LAST
DROUKI 9 FACE_LAST

COUV 10 FACE_ALL
COUV 0 FACE_ALL

$moves
MOVE {DROUKI, WOGI, COUV, UTUN, COLUMN} COUV
OR
    DEST Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
    DESTSRC Suit match_color
MOVE DROUKI DROUKI
DEST Empty
MOVE_STACK COLUMN UTUN
OR
    DEST Empty
    AND
        DESTSRC Suit match
        DEST Suit {HEARTS, CLUBS}
$win
PILE ALL DROUKI Empty
