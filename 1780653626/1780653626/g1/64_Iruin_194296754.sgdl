Iruin
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 62 ROTATE 1 U 1
JAQU 8 FACE_LAST
JAQU 0 FACE_LAST
JAQU 9 FACE_LAST
JAQU 8 FACE_LAST
JAQU 2 FACE_LAST

FIOJAT 9 FACE_LAST
FIOJAT 5 FACE_LAST
FIOJAT 1 FACE_LAST

$moves
MOVE JAQU FIOJAT
OR
    DEST Suit {CLUBS, SPADES}
    AND
        DESTSRC Rank ascending
        DEST Suit {HEARTS, SPADES, DIAMONDS}
MOVE_STACK FIOJAT JAQU
AND
    OR
        SRCSTACK Suit match
        SRCSTACK Size > 4
    OR
        DESTSRC Rank descending
        SRCSTACK Rank equal
$win
OR
    PILE ALL FIOJAT Empty
    PILE ALL DRAW Empty
