Dreasiw
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 10 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 2 FACE_LAST

QIOS 6 FACE_HALF
QIOS 9 FACE_HALF
QIOS 7 FACE_HALF
QIOS 4 FACE_HALF
QIOS 9 FACE_ALL
QIOS 5 FACE_ALL
QIOS 4 FACE_ALL
QIOS 9 FACE_ALL

ZUJ 2 FACE_ALL
ZUJ 0 FACE_ALL
ZUJ 10 FACE_ALL
ZUJ 8 FACE_ALL
ZUJ 6 FACE_ALL
ZUJ 8 FACE_ALL
ZUJ 2 FACE_ALL

$moves
MOVE_STACK QIOS {QIOS, ZUJ}
OR
    SRCSTACK Suit match_color
    AND
        DEST Rank 1
        SRC Suit {HEARTS}
MOVE_STACK COLUMN QIOS
SRC Rank 1
$win
OR
    PILE ALL ZUJ Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL ZUJ Empty
