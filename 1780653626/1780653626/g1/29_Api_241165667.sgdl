Api
$cards
DECK 8 SPADES

$initial
KIOTU 8 FACE_LAST
KIOTU 0 FACE_LAST
KIOTU 3 FACE_LAST
KIOTU 5 FACE_LAST
KIOTU 6 FACE_LAST
KIOTU 10 FACE_LAST
KIOTU 5 FACE_LAST
KIOTU 10 FACE_LAST
KIOTU 4 FACE_LAST

PIOHUM 7 FACE_HALF
PIOHUM 0 FACE_HALF
PIOHUM 5 FACE_ALL
PIOHUM 7 FACE_ALL
PIOHUM 3 FACE_ALL
PIOHUM 5 FACE_ALL
PIOHUM 9 FACE_ALL
PIOHUM 7 FACE_ALL

COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST

EHEAF 2 FACE_HALF

$moves
MOVE_STACK KIOTU {PIOHUM, EHEAF, COLUMN, KIOTU}
SRCSTACK Rank add_14
MOVE_STACK COLUMN EHEAF
AND
    DESTSRC Suit match_color
    OR
        SRC Suit {CLUBS, HEARTS, SPADES}
        SRCSTACK Rank add_14
$win
AND
    AND
        PILE ALL COLUMN Empty
        PILE ALL PIOHUM Empty
    OR
        PILE ALL KIOTU Empty
        PILE ALL EHEAF Empty
