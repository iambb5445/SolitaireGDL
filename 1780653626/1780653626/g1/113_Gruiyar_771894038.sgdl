Gruiyar
$cards
DECK 4 {SPADES, HEARTS}

$initial
COLUMN 6 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST

CRAINA 6 FACE_HALF
CRAINA 8 FACE_HALF

STAIMAZ 4 FACE_ALL
STAIMAZ 1 FACE_ALL
STAIMAZ 9 FACE_ALL

TRUJED 5 FACE_HALF
TRUJED 2 FACE_HALF
TRUJED 3 FACE_HALF
TRUJED 2 FACE_HALF
TRUJED 3 FACE_LAST
TRUJED 5 FACE_LAST
TRUJED 1 FACE_LAST
TRUJED 0 FACE_LAST
TRUJED 1 FACE_LAST

APU 5 FACE_ALL

$moves
MOVE_STACK STAIMAZ TRUJED
OR
    DEST Rank K
    DEST Size <= 7
$win
OR
    PILE ALL CRAINA Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL CRAINA Empty
