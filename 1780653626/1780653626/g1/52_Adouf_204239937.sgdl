Adouf
$cards
DECK 8 SPADES

$initial
DRAW 58 DEAL COLUMN
COLUMN 1 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 3 FACE_HALF
COLUMN 1 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 6 FACE_HALF
COLUMN 9 FACE_HALF

$moves
MOVE COLUMN COLUMN
AND
    DEST Empty
    OR
        DEST Size == 9
        DESTSRC Suit match_color
MOVE_STACK COLUMN COLUMN
OR
    AND
        SRC Rank K
        DESTSRC Rank ascending
    SRC Suit {SPADES}
$win
PILE ALL DRAW Empty
