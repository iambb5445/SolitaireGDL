Bov
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AKO 6 FACE_LAST
AKO 0 FACE_LAST
AKO 3 FACE_LAST
AKO 2 FACE_LAST
AKO 4 FACE_LAST
AKO 0 FACE_LAST

QIZEB 0 FACE_HALF
QIZEB 0 FACE_LAST
QIZEB 7 FACE_LAST
QIZEB 0 FACE_LAST
QIZEB 9 FACE_LAST
QIZEB 2 FACE_LAST
QIZEB 8 FACE_LAST
QIZEB 7 FACE_LAST
QIZEB 4 FACE_LAST

$moves
MOVE AKO QIZEB
DEST Rank 1
MOVE QIZEB AKO
OR
    AND
        DEST Empty
        DEST Size <= 3
    AND
        DESTSRC Rank add_13
        SRC Suit {CLUBS, HEARTS, SPADES}
MOVE_STACK QIZEB {QIZEB, AKO}
SRC Suit {SPADES}
MOVE_STACK AKO QIZEB
AND
    SRCSTACK Size == 2
    DEST Suit {CLUBS}
$win
PILE ALL QIZEB Empty
