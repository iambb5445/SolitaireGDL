Iduj
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 29 ROTATE 3 U 2
LUIGO 3 FACE_LAST
LUIGO 10 FACE_HALF

VAEFO 0 FACE_HALF
VAEFO 0 FACE_HALF
VAEFO 5 FACE_HALF
VAEFO 9 FACE_HALF
VAEFO 10 FACE_HALF
VAEFO 2 FACE_ALTERNATE_LAST
VAEFO 2 FACE_ALTERNATE_LAST
VAEFO 2 FACE_ALTERNATE_LAST
VAEFO 9 FACE_ALTERNATE_LAST
VAEFO 10 FACE_HALF
VAEFO 7 FACE_HALF

COLUMN 4 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 1 FACE_LAST

$moves
MOVE LUIGO VAEFO
OR
    AND
        DEST Size >= 0
        SRC Rank K
    DESTSRC Suit alternate_color
MOVE {COLUMN, VAEFO, LUIGO, DRAW} LUIGO
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {LUIGO, COLUMN, VAEFO} VAEFO
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {LUIGO, VAEFO} VAEFO
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL VAEFO Empty
    AND
        PILE ALL LUIGO Empty
        PILE ALL DRAW Empty
