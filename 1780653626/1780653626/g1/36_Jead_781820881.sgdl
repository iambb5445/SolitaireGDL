Jead
$cards
DECK 2 {SPADES, HEARTS}

$initial
COLUMN 3 FACE_LAST

ALIG 9 FACE_ALTERNATE_LAST
ALIG 1 FACE_ALTERNATE_LAST
ALIG 6 FACE_ALTERNATE_LAST
ALIG 7 FACE_ALTERNATE_LAST
ALIG 6 FACE_ALTERNATE_LAST
ALIG 2 FACE_ALTERNATE_LAST
ALIG 1 FACE_ALTERNATE_LAST
ALIG 2 FACE_ALL

HUX 8 FACE_ALL
HUX 7 FACE_HALF
HUX 0 FACE_HALF

$moves
MOVE COLUMN ALIG
OR
    AND
        DEST Suit {CLUBS, DIAMONDS}
        DEST Rank 1
    AND
        DESTSRC Rank equal
        DEST Empty
MOVE HUX HUX
AND
    SRC Suit {DIAMONDS, CLUBS}
    OR
        DEST Size >= 10
        SRC Suit {HEARTS, CLUBS, SPADES}
MOVE_STACK HUX COLUMN
SRCSTACK Suit alternate_color
MOVE_STACK HUX ALIG
DEST Size > 1
$win
AND
    PILE ALL ALIG Empty
    OR
        PILE ALL HUX Empty
        PILE ALL COLUMN Empty
