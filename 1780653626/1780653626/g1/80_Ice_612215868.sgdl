Ice
$cards
DECK 1 SPADES

$initial
COLUMN 2 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 1 FACE_HALF

$moves
MOVE_STACK COLUMN COLUMN
OR
    SRCSTACK Rank descending
    AND
        SRCSTACK Rank add_14
        DEST Suit {DIAMONDS}
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
