Ayuz
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAIJ 2 FACE_LAST
DRAIJ 5 FACE_LAST
DRAIJ 9 FACE_LAST
DRAIJ 6 FACE_ALL
DRAIJ 9 FACE_ALL

COLUMN 1 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 2 FACE_ALTERNATE_LAST

OHUIQ 2 FACE_ALTERNATE_LAST
OHUIQ 9 FACE_ALTERNATE_LAST
OHUIQ 10 FACE_LAST
OHUIQ 5 FACE_LAST
OHUIQ 3 FACE_LAST
OHUIQ 9 FACE_LAST
OHUIQ 4 FACE_LAST
OHUIQ 4 FACE_LAST

$moves
MOVE DRAIJ COLUMN
AND
    OR
        DEST Size == 2
        DEST Empty
    DEST Size > 2
MOVE OHUIQ DRAIJ
OR
    DEST Size > 0
    AND
        DEST Size == 2
        DEST Suit {HEARTS, DIAMONDS}
MOVE_STACK DRAIJ DRAIJ
SRC Rank 1
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL OHUIQ Empty
        PILE ALL DRAIJ Empty
