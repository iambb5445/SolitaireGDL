Baeqoq
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 42 DEAL {TRIOR, COLUMN, UNEY}
UNEY 2 FACE_LAST
UNEY 0 FACE_LAST
UNEY 7 FACE_LAST
UNEY 8 FACE_LAST
UNEY 7 FACE_LAST

COLUMN 3 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 1 FACE_ALL
COLUMN 8 FACE_HALF
COLUMN 0 FACE_HALF

TRIOR 3 FACE_ALTERNATE_LAST
TRIOR 0 FACE_ALTERNATE_LAST
TRIOR 0 FACE_ALTERNATE_LAST
TRIOR 3 FACE_ALL

$moves
MOVE {COLUMN, TRIOR, UNEY} TRIOR
AND
    OR
        DEST Rank 1
        DESTSRC Suit alternate_color
    OR
        DEST Size == 5
        DEST Rank 1
MOVE_STACK UNEY TRIOR
DEST Size >= 3
$win
AND
    OR
        PILE ALL DRAW Empty
        PILE ALL TRIOR Empty
    AND
        PILE ALL UNEY Empty
        PILE ALL COLUMN Empty
