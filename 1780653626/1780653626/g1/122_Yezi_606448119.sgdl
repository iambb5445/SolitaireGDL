Yezi
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 26 ROTATE 3 U 1
IDEW 2 FACE_LAST
IDEW 3 FACE_LAST
IDEW 7 FACE_LAST

COLUMN 7 FACE_ALL
COLUMN 10 FACE_ALL
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 10 FACE_ALTERNATE_LAST

OJAG 4 FACE_LAST
OJAG 10 FACE_LAST
OJAG 9 FACE_LAST
OJAG 8 FACE_LAST
OJAG 3 FACE_LAST
OJAG 0 FACE_LAST
OJAG 2 FACE_LAST
OJAG 3 FACE_LAST

$moves
MOVE_STACK OJAG COLUMN
DESTSRC Rank add_13
MOVE_STACK IDEW OJAG
OR
    AND
        SRCSTACK Size > 5
        DEST Size <= 4
    AND
        DEST Suit {DIAMONDS, SPADES, HEARTS, CLUBS}
        DEST Suit {HEARTS, SPADES}
$win
PILE ALL COLUMN Empty
