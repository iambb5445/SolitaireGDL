Ejuim
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 8 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 7 FACE_ALL

OHA 1 FACE_ALL
OHA 6 FACE_ALL
OHA 3 FACE_ALL
OHA 5 FACE_ALL
OHA 5 FACE_LAST
OHA 3 FACE_LAST
OHA 4 FACE_LAST

$moves
MOVE OHA COLUMN
OR
    AND
        DESTSRC Suit match_color
        SRC Suit {SPADES, CLUBS, HEARTS}
    AND
        DEST Rank K
        DEST Empty
MOVE COLUMN COLUMN
DEST Size >= 2
MOVE_STACK OHA OHA
OR
    AND
        SRCSTACK Suit match_color
        DEST Empty
    SRCSTACK Rank ascending
$win
PILE ALL COLUMN Empty
