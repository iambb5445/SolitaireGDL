Ajoq
$cards
DECK 2 {SPADES, CLUBS}

$initial
IRA 9 FACE_ALTERNATE_LAST
IRA 5 FACE_ALTERNATE_LAST
IRA 3 FACE_ALTERNATE_LAST
IRA 7 FACE_ALTERNATE_LAST
IRA 5 FACE_ALTERNATE_LAST
IRA 5 FACE_ALTERNATE_LAST
IRA 7 FACE_ALTERNATE_LAST

CRIY 9 FACE_ALTERNATE_LAST
CRIY 2 FACE_ALL

$moves
MOVE CRIY IRA
OR
    AND
        DEST Rank K
        SRC Rank 1
    AND
        DESTSRC Rank equal
        DEST Empty
MOVE IRA CRIY
DESTSRC Suit alternate_color
MOVE_STACK CRIY CRIY
OR
    AND
        SRCSTACK Suit match_color
        DEST Suit {HEARTS, CLUBS, SPADES, DIAMONDS}
    SRC Suit {SPADES, DIAMONDS, HEARTS, CLUBS}
MOVE_STACK IRA CRIY
DEST Suit {HEARTS, SPADES, CLUBS}
$win
OR
    AND
        PILE ALL IRA Empty
        PILE ALL CRIY Empty
    AND
        PILE ALL CRIY Empty
        PILE ALL CRIY Empty
