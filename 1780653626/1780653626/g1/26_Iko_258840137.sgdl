Iko
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 65 DEAL COLUMN
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 4 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALTERNATE_LAST
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALL
COLUMN 6 FACE_ALL

$moves
MOVE COLUMN COLUMN
SRC Rank K
MOVE_STACK COLUMN COLUMN
AND
    OR
        DEST Suit {DIAMONDS, SPADES, CLUBS}
        SRCSTACK Rank add_14
    OR
        SRCSTACK Suit match
        SRCSTACK Size <= 0
DRAW
PILE ALL DRAW Empty
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL COLUMN Empty
    PILE ALL COLUMN Empty
