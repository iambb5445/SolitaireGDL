Souk
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
FRAL 6 FACE_ALTERNATE_LAST
FRAL 7 FACE_HALF
FRAL 5 FACE_HALF
FRAL 5 FACE_HALF
FRAL 2 FACE_HALF
FRAL 3 FACE_HALF
FRAL 7 FACE_HALF

OPU 8 FACE_ALL
OPU 2 FACE_ALL
OPU 4 FACE_ALL
OPU 3 FACE_ALL
OPU 8 FACE_ALTERNATE_LAST

APAEX 3 FACE_LAST
APAEX 7 FACE_LAST
APAEX 10 FACE_LAST
APAEX 6 FACE_LAST
APAEX 0 FACE_LAST

IVA 6 FACE_LAST
IVA 6 FACE_LAST
IVA 2 FACE_LAST
IVA 1 FACE_LAST
IVA 3 FACE_LAST

$moves
MOVE_STACK APAEX FRAL
OR
    AND
        SRCSTACK Suit match
        SRC Rank K
    AND
        DEST Suit {SPADES}
        SRC Rank 1
MOVE_STACK {IVA, OPU, APAEX, FRAL} IVA
SRC Rank K
$win
PILE ALL APAEX Empty
