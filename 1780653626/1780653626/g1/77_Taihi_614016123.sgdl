Taihi
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 9 ROTATE 1 2 U
COLUMN 8 FACE_ALTERNATE_LAST
COLUMN 3 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 6 FACE_ALL

OHUQ 1 FACE_ALTERNATE_LAST
OHUQ 6 FACE_ALTERNATE_LAST
OHUQ 7 FACE_ALTERNATE_LAST

$moves
MOVE DRAW COLUMN
DESTSRC Suit match
MOVE_STACK OHUQ OHUQ
OR
    AND
        DEST Suit {SPADES, CLUBS}
        DEST Rank K
    AND
        SRCSTACK Suit alternate_color
        SRCSTACK Rank descending
$win
PILE ALL COLUMN Empty
