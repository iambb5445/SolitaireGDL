Izi
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 3 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 7 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF

OFU 9 FACE_LAST
OFU 9 FACE_LAST
OFU 3 FACE_LAST
OFU 0 FACE_ALL

FIOHIZ 8 FACE_ALTERNATE_LAST
FIOHIZ 4 FACE_ALTERNATE_LAST
FIOHIZ 7 FACE_ALL

$moves
MOVE {COLUMN, OFU, FIOHIZ} COLUMN
AND
    DEST Rank K
    AND
        SRC Suit {CLUBS, SPADES}
        DEST Suit {CLUBS, HEARTS}
MOVE OFU OFU
DESTSRC Suit alternate_color
MOVE_STACK {FIOHIZ, OFU, COLUMN} COLUMN
DEST Rank K
$win
PILE ALL COLUMN Empty
