Oki
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAIBI 9 FACE_ALL
DRAIBI 0 FACE_ALL
DRAIBI 9 FACE_ALL
DRAIBI 0 FACE_HALF
DRAIBI 8 FACE_HALF

OTIW 4 FACE_HALF
OTIW 2 FACE_HALF
OTIW 3 FACE_ALL
OTIW 8 FACE_ALL

AKAIH 4 FACE_ALTERNATE_LAST
AKAIH 0 FACE_ALTERNATE_LAST
AKAIH 9 FACE_ALTERNATE_LAST
AKAIH 3 FACE_ALTERNATE_LAST
AKAIH 7 FACE_ALTERNATE_LAST
AKAIH 1 FACE_ALTERNATE_LAST
AKAIH 3 FACE_ALTERNATE_LAST
AKAIH 3 FACE_LAST
AKAIH 9 FACE_LAST

EKO 3 FACE_ALTERNATE_LAST
EKO 1 FACE_ALTERNATE_LAST
EKO 8 FACE_ALTERNATE_LAST
EKO 6 FACE_ALTERNATE_LAST
EKO 4 FACE_HALF

$moves
MOVE {AKAIH, OTIW} DRAIBI
DEST Rank K
MOVE DRAIBI DRAIBI
AND
    DEST Rank K
    OR
        DESTSRC Rank equal
        DESTSRC Rank ascending
$win
AND
    PILE ALL OTIW Empty
    AND
        PILE ALL DRAIBI Empty
        PILE ALL AKAIH Empty
