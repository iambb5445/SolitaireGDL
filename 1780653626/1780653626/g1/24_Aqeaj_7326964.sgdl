Aqeaj
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 52 ROTATE 3 U 2
COLUMN 0 FACE_LAST
COLUMN 6 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 2 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 3 FACE_LAST
COLUMN 10 FACE_LAST
COLUMN 10 FACE_LAST

DRAERO 6 FACE_LAST
DRAERO 1 FACE_LAST
DRAERO 7 FACE_ALTERNATE_LAST

$moves
MOVE DRAERO DRAERO
OR
    AND
        DEST Size >= 0
        SRC Rank K
    DESTSRC Suit alternate_color
MOVE {DRAERO, DRAW, COLUMN} COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {DRAERO, COLUMN} COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK DRAERO DRAERO
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL DRAERO Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
