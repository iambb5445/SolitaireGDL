Uyer
$cards
DECK 2 {SPADES, CLUBS}

$initial
COLUMN 5 FACE_LAST
COLUMN 8 FACE_LAST
COLUMN 3 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 9 FACE_ALL

DREAVE 4 FACE_LAST
DREAVE 3 FACE_LAST

$moves
MOVE {COLUMN, DREAVE} DREAVE
AND
    OR
        DEST Suit {HEARTS, SPADES}
        DEST Size > 3
    AND
        DESTSRC Rank equal
        DEST Rank K
MOVE_STACK COLUMN DREAVE
DEST Empty
$win
PILE ALL DREAVE Empty
