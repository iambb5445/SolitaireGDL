Pruw
$cards
DECK 4 {SPADES, CLUBS}

$initial
WEALIQ 8 FACE_ALTERNATE_LAST
WEALIQ 4 FACE_ALTERNATE_LAST
WEALIQ 6 FACE_ALTERNATE_LAST
WEALIQ 8 FACE_ALTERNATE_LAST
WEALIQ 4 FACE_ALTERNATE_LAST
WEALIQ 2 FACE_ALL
WEALIQ 5 FACE_ALL
WEALIQ 0 FACE_ALL

EBUC 3 FACE_ALL
EBUC 5 FACE_ALL
EBUC 2 FACE_ALL
EBUC 6 FACE_ALL
EBUC 8 FACE_ALL
EBUC 4 FACE_ALL
EBUC 4 FACE_ALL
EBUC 9 FACE_HALF

STATAY 5 FACE_ALL
STATAY 4 FACE_ALL
STATAY 3 FACE_ALL
STATAY 0 FACE_ALL
STATAY 7 FACE_ALL
STATAY 7 FACE_ALL

$moves
MOVE WEALIQ WEALIQ
AND
    OR
        SRC Suit {DIAMONDS}
        SRC Suit {DIAMONDS, SPADES, CLUBS, HEARTS}
    OR
        DEST Size <= 4
        DEST Size >= 8
MOVE_STACK STATAY {EBUC, STATAY, WEALIQ}
AND
    OR
        DESTSRC Suit match_color
        SRC Rank K
    DEST Empty
$win
AND
    AND
        PILE ALL EBUC Empty
        PILE ALL EBUC Empty
    OR
        PILE ALL WEALIQ Empty
        PILE ALL EBUC Empty
