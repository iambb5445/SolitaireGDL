Wupec
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 78 ROTATE 3 U 2
NIYAS 0 FACE_HALF
NIYAS 0 FACE_HALF
NIYAS 4 FACE_HALF

XOK 7 FACE_LAST
XOK 5 FACE_ALL
XOK 8 FACE_ALL
XOK 2 FACE_ALL

$moves
MOVE NIYAS NIYAS
OR
    AND
        DEST Size >= 0
        SRC Rank K
    DESTSRC Suit alternate_color
MOVE {XOK, NIYAS, DRAW} NIYAS
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {XOK, NIYAS} NIYAS
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {NIYAS, XOK} NIYAS
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL XOK Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL NIYAS Empty
        PILE ALL DRAW Empty
