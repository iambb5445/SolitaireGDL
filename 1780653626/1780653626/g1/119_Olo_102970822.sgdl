Olo
$cards
DECK 2 {SPADES, CLUBS}

$initial
PREWE 6 FACE_LAST
PREWE 0 FACE_ALL
PREWE 3 FACE_ALL

COLUMN 10 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST

IYE 2 FACE_ALL
IYE 4 FACE_ALL
IYE 2 FACE_LAST
IYE 3 FACE_LAST
IYE 8 FACE_LAST
IYE 0 FACE_LAST

$moves
MOVE PREWE PREWE
DEST Size <= 2
MOVE {COLUMN, PREWE, IYE} COLUMN
SRC Suit {CLUBS, HEARTS}
MOVE_STACK {COLUMN, IYE, PREWE} PREWE
OR
    DEST Rank K
    AND
        DEST Suit {SPADES}
        DEST Size < 4
$win
OR
    AND
        PILE ALL COLUMN Empty
        PILE ALL PREWE Empty
    PILE ALL COLUMN Empty
