Ivo
$cards
DECK 1 {SPADES, HEARTS}

$initial
UZI 7 FACE_ALTERNATE_LAST
UZI 9 FACE_ALTERNATE_LAST
UZI 5 FACE_ALTERNATE_LAST
UZI 5 FACE_ALTERNATE_LAST

$moves
MOVE UZI UZI
OR
    DEST Suit {CLUBS, HEARTS}
    AND
        SRC Suit {SPADES}
        DEST Rank K
MOVE_STACK UZI UZI
OR
    AND
        DEST Suit {SPADES, DIAMONDS}
        SRC Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
    AND
        DEST Suit {SPADES}
        DEST Size >= 6
$win
PILE ALL UZI Empty
