Vuit
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
TAIQI 1 FACE_LAST
TAIQI 2 FACE_ALTERNATE_LAST
TAIQI 10 FACE_ALTERNATE_LAST
TAIQI 0 FACE_ALTERNATE_LAST
TAIQI 7 FACE_ALTERNATE_LAST
TAIQI 4 FACE_ALTERNATE_LAST
TAIQI 3 FACE_ALTERNATE_LAST

AVAIK 6 FACE_ALL
AVAIK 7 FACE_ALL
AVAIK 4 FACE_ALL
AVAIK 3 FACE_ALL
AVAIK 5 FACE_ALL

$moves
MOVE {TAIQI, AVAIK} AVAIK
AND
    OR
        DESTSRC Suit alternate_color
        DESTSRC Suit match
    SRC Suit {CLUBS, DIAMONDS, HEARTS}
MOVE_STACK {TAIQI, AVAIK} TAIQI
OR
    AND
        DESTSRC Rank add_14
        SRCSTACK Size == 9
    AND
        SRCSTACK Size >= 0
        SRC Suit {CLUBS, DIAMONDS, HEARTS}
$win
PILE ALL TAIQI Empty
