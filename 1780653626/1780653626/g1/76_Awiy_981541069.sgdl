MOVE DRAW LIBA
AND
    AND
        DEST Size == 10
        SRC Rank 1
    OR
        SRC Rank 1
        SRC Suit {SPADES, CLUBS, DIAMONDS, HEARTS}
$win
OR
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL DRAW Empty
