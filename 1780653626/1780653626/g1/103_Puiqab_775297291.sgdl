Puiqab
$cards
DECK 4 {SPADES, HEARTS}

$initial
DRAW 45 DEAL RIVU
WAXUL 6 FACE_HALF
WAXUL 6 FACE_HALF
WAXUL 7 FACE_HALF
WAXUL 5 FACE_HALF

RIVU 6 FACE_ALTERNATE_LAST
RIVU 10 FACE_ALTERNATE_LAST
RIVU 6 FACE_LAST
RIVU 8 FACE_LAST

COLUMN 5 FACE_ALL

$moves
MOVE RIVU RIVU
OR
    DESTSRC Suit alternate_color
    AND
        SRC Suit {CLUBS, SPADES, HEARTS}
        DEST Suit {CLUBS, SPADES}
MOVE COLUMN RIVU
DEST Rank 1
DRAW
PILE ALL COLUMN Size > 0
$win
OR
    PILE ALL WAXUL Empty
    PILE ALL DRAW Empty
