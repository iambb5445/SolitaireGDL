Emo
$cards
DECK 2 SPADES

$initial
DRAW 20 ROTATE 3 U 2
COLUMN 4 FACE_ALL
COLUMN 0 FACE_ALL
COLUMN 2 FACE_ALTERNATE_LAST

$moves
MOVE DRAW COLUMN
DEST Rank 1
MOVE_STACK COLUMN COLUMN
AND
    AND
        SRCSTACK Suit match
        DESTSRC Rank descending
    AND
        DESTSRC Rank add_14
        DEST Suit {HEARTS, DIAMONDS}
$win
OR
    PILE ALL DRAW Empty
    PILE ALL COLUMN Empty
