Gaipu
$cards
DECK 1 SPADES

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 7 FACE_HALF

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank ascending
        DEST Rank 1
    AND
        SRC Suit {HEARTS, CLUBS}
        DESTSRC Suit alternate_color
MOVE_STACK COLUMN COLUMN
OR
    DESTSRC Suit match
    AND
        SRCSTACK Rank descending
        DEST Size < 9
$win
PILE ALL COLUMN Empty
