Uzo
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 3 FACE_HALF
COLUMN 5 FACE_HALF
COLUMN 7 FACE_HALF

EMU 7 FACE_ALTERNATE_LAST
EMU 8 FACE_ALTERNATE_LAST
EMU 2 FACE_ALTERNATE_LAST
EMU 7 FACE_HALF
EMU 3 FACE_HALF

ECE 6 FACE_ALL
ECE 7 FACE_ALL
ECE 7 FACE_ALL
ECE 9 FACE_ALL
ECE 6 FACE_ALL
ECE 5 FACE_ALL
ECE 0 FACE_ALL
ECE 8 FACE_ALL
ECE 4 FACE_ALL

SAM 2 FACE_ALL
SAM 4 FACE_ALTERNATE_LAST
SAM 1 FACE_ALTERNATE_LAST
SAM 3 FACE_ALTERNATE_LAST

$moves
MOVE EMU {SAM, COLUMN, ECE}
DEST Suit {CLUBS, DIAMONDS, HEARTS, SPADES}
MOVE COLUMN ECE
OR
    SRC Suit {DIAMONDS, HEARTS, CLUBS}
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
        SRC Suit {SPADES}
MOVE_STACK SAM {EMU, COLUMN, ECE, SAM}
AND
    OR
        DESTSRC Rank equal
        DESTSRC Suit match
    AND
        SRCSTACK Size < 6
        DEST Suit {DIAMONDS, CLUBS}
MOVE_STACK {COLUMN, EMU} SAM
AND
    AND
        DESTSRC Rank equal
        SRCSTACK Rank add_14
    OR
        SRCSTACK Size < 10
        SRCSTACK Suit alternate_color
$win
AND
    AND
        PILE ALL COLUMN Empty
        PILE ALL ECE Empty
    PILE ALL COLUMN Empty
