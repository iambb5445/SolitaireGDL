Evaej
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 11 DEAL COLUMN
QOXIH 4 FACE_LAST
QOXIH 5 FACE_LAST

COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 6 FACE_ALL

$moves
MOVE {COLUMN, QOXIH} QOXIH
AND
    OR
        DESTSRC Suit match_color
        SRC Suit {SPADES, HEARTS, CLUBS}
    DEST Size > 1
MOVE COLUMN COLUMN
OR
    AND
        DEST Rank K
        SRC Rank 1
    AND
        DESTSRC Suit alternate_color
        SRC Rank K
$win
PILE ALL COLUMN Empty
