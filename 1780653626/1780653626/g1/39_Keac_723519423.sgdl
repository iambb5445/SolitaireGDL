Keac
$cards
DECK 2 {SPADES, CLUBS}

$initial
DRAW 24 ROTATE 1 2 U
KOUM 4 FACE_LAST
KOUM 2 FACE_LAST
KOUM 6 FACE_LAST
KOUM 8 FACE_LAST
KOUM 2 FACE_LAST

ULED 1 FACE_LAST
ULED 0 FACE_LAST
ULED 0 FACE_LAST
ULED 5 FACE_LAST

$moves
MOVE {DRAW, KOUM} KOUM
OR
    AND
        SRC Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
        DEST Rank 1
    DEST Suit {DIAMONDS, SPADES, HEARTS}
MOVE_STACK KOUM KOUM
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {SPADES}
    SRCSTACK Suit match
$win
OR
    PILE ALL ULED Empty
    AND
        PILE ALL ULED Empty
        PILE ALL KOUM Empty
