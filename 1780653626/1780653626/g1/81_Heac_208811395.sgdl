Heac
$cards
DECK 2 {SPADES, HEARTS}

$initial
MEAF 2 FACE_LAST
MEAF 3 FACE_LAST

CEAF 5 FACE_ALTERNATE_LAST
CEAF 2 FACE_ALTERNATE_LAST
CEAF 6 FACE_ALTERNATE_LAST
CEAF 3 FACE_ALTERNATE_LAST
CEAF 3 FACE_ALTERNATE_LAST
CEAF 10 FACE_ALL
CEAF 5 FACE_ALL
CEAF 7 FACE_ALL

COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 4 FACE_LAST
COLUMN 1 FACE_LAST
COLUMN 0 FACE_LAST

$moves
MOVE MEAF COLUMN
OR
    DEST Suit {SPADES, CLUBS, DIAMONDS}
    AND
        DEST Size <= 3
        DEST Empty
MOVE_STACK COLUMN CEAF
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
        DEST Empty
    AND
        DEST Rank K
        SRCSTACK Suit match
$win
AND
    OR
        PILE ALL COLUMN Empty
        PILE ALL MEAF Empty
    OR
        PILE ALL MEAF Empty
        PILE ALL COLUMN Empty
