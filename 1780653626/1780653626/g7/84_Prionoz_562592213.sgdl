Prionoz
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
AJAIP 0 FACE_ALTERNATE_LAST
AJAIP 10 FACE_ALTERNATE_LAST
AJAIP 2 FACE_ALTERNATE_LAST
AJAIP 1 FACE_ALTERNATE_LAST
AJAIP 5 FACE_ALTERNATE_LAST
AJAIP 5 FACE_ALTERNATE_LAST

INEAT 2 FACE_HALF
INEAT 9 FACE_HALF
INEAT 6 FACE_HALF
INEAT 10 FACE_HALF
INEAT 2 FACE_HALF

$moves
MOVE INEAT INEAT
DEST Suit {HEARTS, CLUBS}
MOVE AJAIP {INEAT, AJAIP}
DESTSRC Rank ascending
MOVE_STACK {AJAIP, INEAT} INEAT
OR
    DESTSRC Suit alternate_color
    AND
        SRC Rank K
        DESTSRC Suit match
MOVE_STACK {AJAIP, INEAT} AJAIP
DESTSRC Rank equal
$win
AND
    OR
        PILE ALL AJAIP Empty
        PILE ALL AJAIP Empty
    OR
        PILE ALL AJAIP Empty
        PILE ALL INEAT Empty
