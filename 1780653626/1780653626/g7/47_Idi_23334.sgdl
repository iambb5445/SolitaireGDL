Idi
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 0 ROTATE 3 U 2
RUYIQ 0 FACE_ALL
RUYIQ 0 FACE_ALL
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 9 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 1 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST
RUYIQ 1 FACE_ALTERNATE_LAST
RUYIQ 0 FACE_ALTERNATE_LAST

UZE 0 FACE_HALF
UZE 1 FACE_HALF
UZE 0 FACE_HALF
UZE 5 FACE_ALL
UZE 0 FACE_ALL
UZE 6 FACE_ALL
UZE 0 FACE_ALL
UZE 0 FACE_ALL
UZE 2 FACE_ALL
UZE 1 FACE_ALL

QEN 0 FACE_ALTERNATE_LAST
QEN 0 FACE_ALTERNATE_LAST

$moves
MOVE UZE UZE
AND
    DESTSRC Rank descending
    DEST Empty
MOVE {RUYIQ, QEN, UZE, DRAW} QEN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
MOVE_STACK {QEN, RUYIQ} QEN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL RUYIQ Empty
        PILE ALL UZE Empty
    AND
        PILE ALL QEN Empty
        PILE ALL DRAW Empty
