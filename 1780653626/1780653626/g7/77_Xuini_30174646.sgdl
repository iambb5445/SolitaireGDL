Xuini
$cards
DECK 2 {SPADES, CLUBS}

$initial
VAEWU 10 FACE_HALF
VAEWU 6 FACE_HALF
VAEWU 9 FACE_HALF
VAEWU 1 FACE_HALF
VAEWU 1 FACE_LAST

WARO 1 FACE_LAST
WARO 2 FACE_LAST
WARO 4 FACE_LAST
WARO 4 FACE_ALL
WARO 8 FACE_ALL
WARO 6 FACE_ALL

$moves
MOVE VAEWU WARO
OR
    DESTSRC Rank ascending
    AND
        DEST Empty
        SRC Suit {HEARTS}
$win
OR
    AND
        PILE ALL WARO Empty
        PILE ALL VAEWU Empty
    AND
        PILE ALL WARO Empty
        PILE ALL VAEWU Empty
