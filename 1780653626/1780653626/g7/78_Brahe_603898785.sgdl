Brahe
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
SEKAN 0 FACE_HALF
SEKAN 2 FACE_HALF
SEKAN 10 FACE_HALF
SEKAN 5 FACE_HALF
SEKAN 5 FACE_HALF
SEKAN 9 FACE_ALTERNATE_LAST
SEKAN 1 FACE_ALTERNATE_LAST
SEKAN 9 FACE_ALTERNATE_LAST
SEKAN 0 FACE_ALTERNATE_LAST
SEKAN 6 FACE_ALTERNATE_LAST

IZION 5 FACE_LAST

$moves
MOVE {SEKAN, IZION} IZION
OR
    DEST Suit {SPADES, DIAMONDS, CLUBS}
    AND
        DESTSRC Suit match
        SRC Suit {HEARTS, SPADES, DIAMONDS, CLUBS}
MOVE SEKAN SEKAN
DEST Size >= 4
MOVE_STACK {SEKAN, IZION} SEKAN
AND
    OR
        SRC Rank 1
        SRCSTACK Rank descending
    SRCSTACK Size >= 5
$win
AND
    OR
        PILE ALL SEKAN Empty
        PILE ALL IZION Empty
    OR
        PILE ALL IZION Empty
        PILE ALL IZION Empty
