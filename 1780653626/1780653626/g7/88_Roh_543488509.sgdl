Roh
$cards
DECK 4 SPADES

$initial
EQAEX 4 FACE_LAST
EQAEX 1 FACE_LAST
EQAEX 5 FACE_LAST

IXAF 7 FACE_HALF
IXAF 6 FACE_HALF
IXAF 8 FACE_HALF
IXAF 2 FACE_HALF
IXAF 9 FACE_HALF
IXAF 2 FACE_HALF
IXAF 0 FACE_HALF
IXAF 6 FACE_HALF

IQEAH 0 FACE_HALF
IQEAH 2 FACE_ALTERNATE_LAST

$moves
MOVE EQAEX {EQAEX, IQEAH, IXAF}
DEST Size == 10
MOVE_STACK IQEAH IQEAH
AND
    DESTSRC Rank add_13
    AND
        DESTSRC Suit match
        SRCSTACK Suit alternate_color
$win
OR
    AND
        PILE ALL IQEAH Empty
        PILE ALL EQAEX Empty
    AND
        PILE ALL EQAEX Empty
        PILE ALL IXAF Empty
