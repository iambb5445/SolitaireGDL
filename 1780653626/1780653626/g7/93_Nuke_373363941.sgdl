Nuke
$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 12 DEAL DEWI
DEWI 9 FACE_LAST
DEWI 3 FACE_LAST
DEWI 7 FACE_LAST
DEWI 0 FACE_LAST
DEWI 10 FACE_LAST
DEWI 3 FACE_ALTERNATE_LAST
DEWI 3 FACE_ALTERNATE_LAST
DEWI 5 FACE_ALTERNATE_LAST

$moves
MOVE DEWI DEWI
SRC Rank K
MOVE_STACK DEWI DEWI
AND
    OR
        DEST Suit {CLUBS}
        DEST Empty
    OR
        DEST Suit {CLUBS, SPADES, HEARTS}
        SRC Rank 1
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DEWI Empty
        PILE ALL DRAW Empty
