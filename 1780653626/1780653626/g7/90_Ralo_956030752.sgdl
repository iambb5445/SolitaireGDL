Ralo
$cards
DECK 2 {SPADES, HEARTS}

$initial
IMIK 3 FACE_ALL
IMIK 6 FACE_ALL
IMIK 4 FACE_ALL
IMIK 9 FACE_ALL
IMIK 3 FACE_ALL
IMIK 9 FACE_HALF
IMIK 10 FACE_HALF

UKIF 4 FACE_ALTERNATE_LAST
UKIF 4 FACE_ALTERNATE_LAST

$moves
MOVE {UKIF, IMIK} IMIK
OR
    AND
        SRC Suit {HEARTS, SPADES, CLUBS, DIAMONDS}
        DESTSRC Rank equal
    AND
        SRC Suit {HEARTS, CLUBS, DIAMONDS, SPADES}
        DEST Suit {SPADES, HEARTS}
MOVE {IMIK, UKIF} UKIF
DEST Rank K
MOVE_STACK IMIK IMIK
AND
    DEST Suit {HEARTS}
    SRC Suit {CLUBS}
MOVE_STACK UKIF UKIF
OR
    SRC Rank 1
    AND
        DESTSRC Suit alternate_color
        DESTSRC Rank add_14
$win
OR
    AND
        PILE ALL UKIF Empty
        PILE ALL IMIK Empty
    AND
        PILE ALL IMIK Empty
        PILE ALL IMIK Empty
