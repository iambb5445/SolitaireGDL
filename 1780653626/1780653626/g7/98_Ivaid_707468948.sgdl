Ivaid
$cards
DECK 1 {SPADES, HEARTS}

$initial
BAEJOH 7 FACE_HALF
BAEJOH 2 FACE_HALF
BAEJOH 2 FACE_HALF
BAEJOH 2 FACE_HALF
BAEJOH 8 FACE_HALF
BAEJOH 5 FACE_HALF
BAEJOH 0 FACE_ALL

$moves
MOVE BAEJOH BAEJOH
AND
    SRC Suit {SPADES, HEARTS, DIAMONDS}
    SRC Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
MOVE_STACK BAEJOH BAEJOH
SRC Suit {CLUBS, HEARTS, SPADES}
$win
PILE ALL BAEJOH Empty
