Ehaew
$cards
DECK 4 {SPADES, CLUBS}

$initial
DRAW 56 ROTATE 3 U 2
GRITUD 3 FACE_ALL
GRITUD 8 FACE_ALL
GRITUD 6 FACE_HALF
GRITUD 9 FACE_HALF
GRITUD 1 FACE_HALF
GRITUD 6 FACE_HALF
GRITUD 6 FACE_HALF

COLUMN 9 FACE_HALF
COLUMN 0 FACE_HALF
COLUMN 0 FACE_HALF

$moves
MOVE DRAW COLUMN
OR
    AND
        DESTSRC Suit alternate_color
        SRC Suit {DIAMONDS, HEARTS, SPADES, CLUBS}
    AND
        SRC Rank 1
        DESTSRC Rank ascending
MOVE {GRITUD, COLUMN, DRAW} COLUMN
OR
    AND
        DESTSRC Rank add_14
        DEST Size >= 5
    DESTSRC Suit match
    DEST Size >= 5
MOVE_STACK {COLUMN, GRITUD} COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {GRITUD, COLUMN} GRITUD
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL GRITUD Empty
        PILE ALL GRITUD Empty
    AND
        PILE ALL COLUMN Empty
        PILE ALL DRAW Empty
