Fuibu
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 9 FACE_ALTERNATE_LAST

VIOZOJ 0 FACE_ALTERNATE_LAST

UCEAR 10 FACE_ALTERNATE_LAST
UCEAR 2 FACE_ALTERNATE_LAST
UCEAR 8 FACE_ALTERNATE_LAST

VUIPAS 10 FACE_LAST
VUIPAS 7 FACE_HALF
VUIPAS 6 FACE_HALF
VUIPAS 9 FACE_HALF
VUIPAS 7 FACE_HALF

ARIC 2 FACE_ALTERNATE_LAST
ARIC 1 FACE_ALTERNATE_LAST
ARIC 4 FACE_ALL
ARIC 6 FACE_ALL
ARIC 7 FACE_ALL
ARIC 2 FACE_ALL
ARIC 8 FACE_ALL
ARIC 1 FACE_ALL

$moves
MOVE {ARIC, VUIPAS, VIOZOJ, UCEAR, COLUMN} UCEAR
SRC Rank K
MOVE {VIOZOJ, UCEAR, COLUMN, ARIC} ARIC
OR
    DESTSRC Rank ascending
    AND
        SRC Suit {SPADES, DIAMONDS, CLUBS, HEARTS}
        DESTSRC Suit match
MOVE_STACK UCEAR VUIPAS
AND
    OR
        SRCSTACK Size < 7
        SRC Rank K
    OR
        SRCSTACK Suit match_color
        DESTSRC Rank equal
MOVE_STACK VIOZOJ VIOZOJ
AND
    OR
        DESTSRC Rank equal
        SRCSTACK Size <= 1
    OR
        SRCSTACK Size > 0
        DEST Suit {CLUBS, HEARTS, DIAMONDS, SPADES}
$win
PILE ALL ARIC Empty
