Boubob
$cards
DECK 1 SPADES

$initial
COLUMN 6 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALTERNATE_LAST

$moves
MOVE COLUMN COLUMN
AND
    OR
        DESTSRC Rank add_14
        SRC Rank K
    AND
        DESTSRC Rank add_14
        DEST Rank 1
MOVE_STACK COLUMN COLUMN
DEST Rank 1
$win
AND
    PILE ALL COLUMN Empty
    OR
        PILE ALL COLUMN Empty
        PILE ALL COLUMN Empty
