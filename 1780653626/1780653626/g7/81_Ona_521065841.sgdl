Ona
$cards
DECK 1 {SPADES, CLUBS}

$initial
DRAW 4 DEAL {OTO, COLUMN}
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 5 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 2 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 1 FACE_ALL

OTO 8 FACE_HALF
OTO 0 FACE_HALF

$moves
MOVE COLUMN OTO
DEST Rank K
MOVE {COLUMN, OTO} COLUMN
DEST Rank K
MOVE_STACK {OTO, COLUMN} COLUMN
DEST Size <= 9
$win
OR
    PILE ALL DRAW Empty
    AND
        PILE ALL DRAW Empty
        PILE ALL OTO Empty
