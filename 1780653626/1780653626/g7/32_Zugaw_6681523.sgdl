Zugaw
$cards
DECK 4 {SPADES, CLUBS}

$initial
COLUMN 4 FACE_HALF
COLUMN 4 FACE_HALF
COLUMN 9 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 10 FACE_HALF
COLUMN 2 FACE_HALF
COLUMN 10 FACE_ALTERNATE_LAST
COLUMN 1 FACE_ALTERNATE_LAST
COLUMN 3 FACE_HALF
COLUMN 8 FACE_HALF
COLUMN 1 FACE_HALF

PRES 6 FACE_LAST
PRES 5 FACE_HALF
PRES 10 FACE_LAST
PRES 10 FACE_LAST
PRES 1 FACE_HALF

$moves
MOVE COLUMN COLUMN
OR
    AND
        DEST Suit {HEARTS, CLUBS, DIAMONDS}
        AND
            DEST Rank 1
            DESTSRC Suit alternate_color
    DESTSRC Suit alternate_color
MOVE {COLUMN, PRES} PRES
OR
    SRC Rank 1
    DESTSRC Suit match
MOVE_STACK {COLUMN, PRES} COLUMN
OR
    DESTSRC Suit alternate_color
    AND
        DESTSRC Rank descending
        SRCSTACK Rank add_14
MOVE_STACK {PRES, COLUMN} COLUMN
OR
    AND
        SRCSTACK Rank descending
        SRC Suit {CLUBS, HEARTS, SPADES, DIAMONDS}
    SRCSTACK Rank ascending
$win
OR
    AND
        PILE ALL PRES Empty
        PILE ALL COLUMN Empty
    AND
        PILE ALL PRES Empty
        PILE ALL PRES Empty
