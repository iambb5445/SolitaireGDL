Drotal
$cards
DECK 2 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 90 ROTATE 3 U 1
QURU 5 FACE_HALF
QURU 0 FACE_HALF
QURU 2 FACE_ALTERNATE_LAST
QURU 1 FACE_ALTERNATE_LAST
QURU 6 FACE_ALTERNATE_LAST

COLUMN 0 FACE_ALTERNATE_LAST
COLUMN 0 FACE_ALL

$moves
MOVE {COLUMN, QURU, DRAW} QURU
AND
    OR
        SRC Suit {DIAMONDS}
        DEST Suit {CLUBS}
    SRC Suit {HEARTS, DIAMONDS}
$win
PILE ALL DRAW Empty
