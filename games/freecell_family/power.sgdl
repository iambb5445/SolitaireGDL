$moves
MOVE {CELL, COLUMN} COLUMN
OR
    AND
        OR
            DESTSRC Rank descending
            AND
                DEST Rank 1
                SRC Rank K
        DESTSRC Suit match
    DEST Empty
MOVE COLUMN CELL
DEST Empty
MOVE COLUMN FOUNDATION
AND
    OR
        DESTSRC Rank ascending
        AND
            DEST Rank K
            SRC Rank 1
    DESTSRC Suit match

$win
AND
    PILE ALL COLUMN Empty
    PILE ALL CELL Empty