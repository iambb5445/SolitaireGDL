FreeCell~~

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
CELL 0
CELL 0
CELL 0
CELL 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL

$moves
MOVE {CELL, COLUMN} COLUMN
OR
    AND
        DESTSRC Rank descending
        DESTSRC Suit alternate_color
    DEST Empty # empty destination won't pass DESTSRC rules, to prevent problems in games such as klondike
MOVE COLUMN CELL
DEST Empty
MOVE COLUMN FOUNDATION
OR
    AND
        DEST Empty
        SRC Rank 1
    AND
        DESTSRC Suit match
        DESTSRC Rank ascending

$auto
MOVE_STACK COLUMN FOUNDATION
AND
    SRCSTACK Suit match
    SRCSTACK Rank descending
    SRCSTACK Size == 13
    DEST Empty

$win
# alternatively, can be defined with PILE ALL FOUNDATION Size == 13
AND
    PILE ALL COLUMN Empty
    PILE ALL CELL Empty