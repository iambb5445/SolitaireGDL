Friendly Spider

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 24 DEAL COLUMN # deals to all columns
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST

$moves
MOVE COLUMN COLUMN
OR
    DESTSRC Rank descending
    DEST Empty
MOVE_STACK COLUMN COLUMN
AND
    OR
        DEST Empty
        DESTSRC Rank descending
    SRCSTACK Rank descending
DRAW
PILE ALL COLUMN Size > 0

$auto
MOVE_STACK COLUMN FOUNDATION
AND
    SRCSTACK Suit match
    SRCSTACK Rank descending
    SRCSTACK Size == 13
    DEST Empty

$win
# alternatively, can be defined with PILE ALL FOUNDATION Size == 13
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty