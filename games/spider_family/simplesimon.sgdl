Simple Simon

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 8 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 1 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    DESTSRC Rank descending
    DEST Empty # empty destination won't pass DESTSRC rules, to prevent problems in games such as klondike
MOVE_STACK COLUMN COLUMN
AND
    OR
        DEST Empty
        DESTSRC Rank descending
    SRCSTACK Suit match
    SRCSTACK Rank descending

$auto
MOVE_STACK COLUMN FOUNDATION
AND
    SRCSTACK Suit match
    SRCSTACK Rank descending
    SRCSTACK Size == 13
    DEST Empty

$win
# alternatively, can be defined with PILE ALL FOUNDATION Size == 13
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty