Wasp

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 3 DEAL COLUMN # deals to all columns
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_LAST
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 7 FACE_ALL

$moves
MOVE COLUMN COLUMN
OR
    AND
        DESTSRC Rank descending
        DESTSRC Suit match
    DEST Empty
MOVE_STACK COLUMN COLUMN
OR
    AND
        DESTSRC Rank descending
        DESTSRC Suit match
    DEST Empty
DRAW
PILE ALL COLUMN Size > 0

$auto
MOVE_STACK COLUMN FOUNDATION
AND
    SRCSTACK Suit match
    SRCSTACK Rank descending
    SRCSTACK Size == 13
    DEST Empty

$win
# alternatively, can be defined with PILE ALL FOUNDATION Size == 13
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty