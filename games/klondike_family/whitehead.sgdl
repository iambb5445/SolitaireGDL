Whitehead

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
DRAW 24 ROTATE 1 3 U # 3 at a time, stack of 3, unlimited redeals
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
FOUNDATION 0
COLUMN 1 FACE_ALL
COLUMN 2 FACE_ALL
COLUMN 3 FACE_ALL
COLUMN 4 FACE_ALL
COLUMN 5 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL

$moves
MOVE {DRAW, COLUMN} COLUMN
OR
    AND
        DESTSRC Suit match_color
        DESTSRC Rank descending
    DEST Empty
MOVE {COLUMN, DRAW} FOUNDATION
OR
    AND
        DEST Empty
        SRC Rank 1 # the card you’re moving is Ace
    AND
        DESTSRC Suit match
        DESTSRC Rank ascending
MOVE_STACK COLUMN COLUMN
AND
    SRCSTACK Suit match_color
    SRCSTACK Rank descending
    OR
        AND
            DESTSRC Suit match_color
            DESTSRC Rank descending
        DEST Empty

$win
AND
    PILE ALL COLUMN Empty
    PILE ALL DRAW Empty