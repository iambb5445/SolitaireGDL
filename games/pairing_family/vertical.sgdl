Vertical

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 7 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
COLUMN 6 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
RESERVE 1 FACE_ALL
DISCARD 0

$moves
MOVE {COLUMN, RESERVE} {COLUMN, RESERVE}
DESTSRC Rank equal

$auto
MOVE_STACK {COLUMN, RESERVE} DISCARD
AND
    SRCSTACK Size == 2
    SRCSTACK Rank equal

$win
AND
    PILE ALL COLUMN Empty
    PILE ALL RESERVE Empty