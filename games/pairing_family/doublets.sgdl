Doublets

$cards
DECK 1 {SPADES, HEARTS, CLUBS, DIAMONDS}

$initial
TALON 4
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
COLUMN 4 FACE_LAST
DISCARD 0

$moves
MOVE COLUMN COLUMN
OR
    DESTSRC Rank equal

$auto
MOVE_STACK COLUMN DISCARD
AND
    SRCSTACK Size == 2
    SRCSTACK Rank equal # don't need this most likely
MOVE TALON COLUMN
DEST Empty

$win
PILE ALL COLUMN Empty
#    PILE ALL TALON Empty no need, because talon automatically moves to column